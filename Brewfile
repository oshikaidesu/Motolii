# What Motolii's build asks of Homebrew (Homebrew Bundle:  brew bundle).  Xcode, Python 3 and Flutter 3.47.2 are not from here.
# To build: filament/dawn_probe/build.sh, filament/edit.sh
brew "cmake"
brew "ninja"
brew "meson"
brew "pkgconf"
# What the editor links: films (GStreamer), the document (SQLite), AviUtl's scripts (LuaJIT), effects and recipes (QuickJS-ng)
brew "gstreamer"
brew "sqlite"
brew "luajit"
brew "quickjs-ng"
# What the editor runs: writing a film (ffmpeg makes the mp4, kit_draw.h's film)
brew "ffmpeg"
# (the tools only the checks use are in Brewfile.checks)
