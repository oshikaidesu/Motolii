#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)
def Xform "World"
{
    def Camera "cam"
    {
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def DomeLight "env"
    {
        float inputs:intensity = 1
    }
    def Sphere "ball"
    {
        double radius = 1
        color3f[] primvars:displayColor = [(0.9, 0.3, 0.2)]
    }
}
