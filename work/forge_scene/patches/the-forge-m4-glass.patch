@@ -0,0 +1,74 @@
+// Raw MSL. Adobe's OpenPBR BSDF (as-is, from github.com/adobe/openpbr-bsdf) behind three value-passing calls.
+// Included from includes/metal.h (after FSL translation): FSL's function table rejects overloaded functions, so the header must not pass through it.
+#pragma once
+#if defined(__METAL_RAYTRACING)
+#define OPENPBR_LANGUAGE_TARGET_MSL 1
+#include "/Users/member_ottoto/rust_ae/_ext/openpbr-bsdf/openpbr.h"
+
+struct PbrSampleOut
+{
+    float3 L;
+    float3 W;
+    float  pdf;
+    float3 emission;
+};
+
+inline PbrSampleOut pbr_sample(uint matId, float3 N, float3 V, float3 xi)
+{
+    OpenPBR_ResolvedInputs inputs = openpbr_make_default_resolved_inputs();
+    float3 T = normalize(abs(N.y) < 0.99f ? cross(float3(0.0f, 1.0f, 0.0f), N) : cross(float3(1.0f, 0.0f, 0.0f), N));
+    float3 B = cross(N, T);
+    inputs.geometry_basis = OPENPBR_MAKE_STRUCT_3(OpenPBR_Basis, T, B, N);
+    inputs.geometry_coat_basis = inputs.geometry_basis;
+    if (matId == 0u)
+    {
+        inputs.base_color = float3(0.0f);
+        inputs.specular_roughness = 0.02f;
+        inputs.specular_ior = 1.5f;
+        inputs.transmission_weight = 1.0f;
+        inputs.transmission_color = float3(0.06f, 0.30f, 1.0f);
+        inputs.transmission_depth = 0.9f;
+    }
+    else
+    {
+        inputs.base_color = float3(0.02f, 0.025f, 0.03f);
+        inputs.specular_roughness = 0.12f;
+    }
+    OpenPBR_PreparedBsdf prepared =
+        openpbr_prepare(inputs, float3(1.0f), OpenPBR_BaseRgbWavelengths_nm, OpenPBR_VacuumIor, V);
+    PbrSampleOut o;
+    OpenPBR_DiffuseSpecular w;
+    OpenPBR_BsdfLobeType lt;
+    openpbr_sample(prepared, xi, o.L, w, o.pdf, lt);
+    o.W = openpbr_get_sum_of_diffuse_specular(w);
+    o.emission = prepared.emission;
+    return o;
+}
+
+// Beer-Lambert extinction of the glass interior (the material's own volume), as OpenPBR derives it.
+inline float3 pbr_glass_extinction()
+{
+    OpenPBR_ResolvedInputs inputs = openpbr_make_default_resolved_inputs();
+    inputs.base_color = float3(0.0f);
+    inputs.transmission_weight = 1.0f;
+    inputs.transmission_color = float3(0.06f, 0.30f, 1.0f);
+    inputs.transmission_depth = 0.9f;
+    OpenPBR_PreparedBsdf prepared =
+        openpbr_prepare(inputs, float3(1.0f), OpenPBR_BaseRgbWavelengths_nm, OpenPBR_VacuumIor, float3(0.0f, 0.0f, 1.0f));
+    return prepared.volume.extinction_coefficient;
+}
+
+inline float3 pbr_transmittance(float3 extinction, float distance)
+{
+    return openpbr_calculate_transmittance_at_distance(extinction, distance);
+}
+
+// Stateless PCG-style hash -> [0,1). Not a renderer: three numbers per bounce for the BSDF's sampler.
+inline float pbr_rng(uint a, uint b, uint c)
+{
+    uint v = a * 747796405u + b * 2891336453u + c * 277803737u + 1013904223u;
+    v = ((v >> ((v >> 28u) + 4u)) ^ v) * 277803737u;
+    v = (v >> 22u) ^ v;
+    return float(v) * (1.0f / 4294967296.0f);
+}
+#endif
