+// ---- Motolii driver: a frame index in, a PNG out. Values only; the renderer is The Forge's, the decoder is ffmpeg. ----
+struct MotoliiDriver
+{
+    bool     batch = false;
+    int      start = 0;
+    int      end = 0;
+    int      spp = 64;
+    int      frame = 0;
+    int      accum = 0;
+    float    fps = 30.0f;
+    float    videoOffset = 0.0f;
+    char     video[1024] = {};
+    Texture* pBoard = NULL;
+    // Per-frame values handed over by the world (Rerun): eye, look-at, video time. Nothing is derived here.
+    struct Row
+    {
+        float eye[3];
+        float at[3];
+        float videoSec;
+    };
+    Row*     rows = NULL;
+    int      rowCount = 0;
+    bool     serve = false;   // stay up; `seek N` on stdin renders frame N, `ready N` on stdout says it is in Screenshots/
+    bool     shotDone = true;
+};
+static MotoliiDriver gMD;
+static volatile int gServeSeek = -1;
+static volatile int gServeQuit = 0;
+
+static void* motoliiServeReader(void*)
+{
+    char line[256];
+    while (fgets(line, sizeof(line), stdin))
+    {
+        int n = 0;
+        if (sscanf(line, "seek %d", &n) == 1)
+            __atomic_store_n(&gServeSeek, n, __ATOMIC_SEQ_CST);
+        else if (strncmp(line, "quit", 4) == 0)
+        {
+            __atomic_store_n(&gServeQuit, 1, __ATOMIC_SEQ_CST);
+            break;
+        }
+    }
+    __atomic_store_n(&gServeQuit, 1, __ATOMIC_SEQ_CST);
+    return NULL;
+}
+
+static const MotoliiDriver::Row* motoliiRow(int frame)
+{
+    if (!gMD.rows || gMD.rowCount == 0)
+        return NULL;
+    return &gMD.rows[frame < 0 ? 0 : (frame >= gMD.rowCount ? gMD.rowCount - 1 : frame)];
+}
+static const uint32_t MOTOLII_BOARD_W = 1920;
+static const uint32_t MOTOLII_BOARD_H = 1080;
+
+static void motoliiInitDriver()
+{
+    const char* v = getenv("MOTOLII_VIDEO");
+    if (v)
+        strncpy(gMD.video, v, sizeof(gMD.video) - 1);
+    if (getenv("MOTOLII_VIDEO_AT"))
+        gMD.videoOffset = (float)atof(getenv("MOTOLII_VIDEO_AT"));
+    if (const char* pf = getenv("MOTOLII_PARAMS")) // csv from the world: frame,ex,ey,ez,ax,ay,az,video_sec
+    {
+        if (FILE* f = fopen(pf, "r"))
+        {
+            char line[512];
+            int  cap = 0;
+            fgets(line, sizeof(line), f); // header
+            while (fgets(line, sizeof(line), f))
+            {
+                int   fr = 0;
+                float v[7] = {};
+                if (sscanf(line, "%d,%f,%f,%f,%f,%f,%f,%f", &fr, &v[0], &v[1], &v[2], &v[3], &v[4], &v[5], &v[6]) != 8)
+                    continue;
+                if (fr >= cap)
+                {
+                    int newCap = fr + 256;
+                    MotoliiDriver::Row* nr = (MotoliiDriver::Row*)tf_calloc(newCap, sizeof(MotoliiDriver::Row));
+                    if (gMD.rows)
+                    {
+                        memcpy(nr, gMD.rows, cap * sizeof(MotoliiDriver::Row));
+                        tf_free(gMD.rows);
+                    }
+                    gMD.rows = nr;
+                    cap = newCap;
+                }
+                MotoliiDriver::Row& r = gMD.rows[fr];
+                r.eye[0] = v[0]; r.eye[1] = v[1]; r.eye[2] = v[2];
+                r.at[0] = v[3]; r.at[1] = v[4]; r.at[2] = v[5];
+                r.videoSec = v[6];
+                if (fr + 1 > gMD.rowCount)
+                    gMD.rowCount = fr + 1;
+            }
+            fclose(f);
+            LOGF(eINFO, "MOTOLII params: %d rows from %s", gMD.rowCount, pf);
+        }
+    }
+    if (getenv("MOTOLII_SERVE"))
+    {
+        gMD.serve = true;
+        const char* sp = getenv("MOTOLII_SPP");
+        gMD.spp = sp ? atoi(sp) : 32;
+        const char* ff = getenv("MOTOLII_FPS");
+        gMD.fps = ff ? (float)atof(ff) : 30.0f;
+        pthread_t th;
+        pthread_create(&th, NULL, motoliiServeReader, NULL);
+        pthread_detach(th);
+    }
+    const char* b = getenv("MOTOLII_BATCH"); // "start,end,fps,spp"
+    if (b)
+    {
+        int   s = 0, e = 0, sp = 0;
+        float f = 0.0f;
+        if (sscanf(b, "%d,%d,%f,%d", &s, &e, &f, &sp) == 4)
+        {
+            gMD.batch = true;
+            gMD.start = s;
+            gMD.end = e;
+            gMD.fps = f;
+            gMD.spp = sp;
+            gMD.frame = s;
+        }
+    }
+}
