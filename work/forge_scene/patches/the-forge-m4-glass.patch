+// ThorVG (the existing owner of SVG) through its C API, loaded at run time: the SVG stays a document, only its raster is a texture.
+static bool motoliiRasterizeSvg(const char* svgPath, uint32_t w, uint32_t h, uint8_t* rgba)
+{
+    // ThorVG 1.1.2 from Homebrew: software raster engine (the repo's own build is GPU-only and has no sw canvas)
+    void* lib = dlopen("/opt/homebrew/opt/thorvg/lib/libthorvg-1.dylib", RTLD_NOW);
+    if (!lib)
+    {
+        LOGF(eERROR, "MOTOLII thorvg: %s", dlerror());
+        return false;
+    }
+    typedef int (*FnInit)(unsigned);
+    typedef void* (*FnCanvas)(int);
+    typedef int (*FnTarget)(void*, uint32_t*, uint32_t, uint32_t, uint32_t, int);
+    typedef void* (*FnPic)(void);
+    typedef int (*FnLoad)(void*, const char*);
+    typedef int (*FnSize)(void*, float, float);
+    typedef int (*FnAdd)(void*, void*);
+    typedef int (*FnDraw)(void*, bool);
+    typedef int (*FnSync)(void*);
+    FnInit   engineInit = (FnInit)dlsym(lib, "tvg_engine_init");
+    FnCanvas canvasCreate = (FnCanvas)dlsym(lib, "tvg_swcanvas_create");
+    FnTarget setTarget = (FnTarget)dlsym(lib, "tvg_swcanvas_set_target");
+    FnPic    picNew = (FnPic)dlsym(lib, "tvg_picture_new");
+    FnLoad   picLoad = (FnLoad)dlsym(lib, "tvg_picture_load");
+    FnSize   picSize = (FnSize)dlsym(lib, "tvg_picture_set_size");
+    FnAdd    canvasAdd = (FnAdd)dlsym(lib, "tvg_canvas_add");
+    FnDraw   canvasDraw = (FnDraw)dlsym(lib, "tvg_canvas_draw");
+    FnSync   canvasSync = (FnSync)dlsym(lib, "tvg_canvas_sync");
+    if (!engineInit || !canvasCreate || !setTarget || !picNew || !picLoad || !picSize || !canvasAdd || !canvasDraw || !canvasSync)
+    {
+        LOGF(eERROR, "MOTOLII thorvg: missing symbols");
+        return false;
+    }
+    memset(rgba, 0, (size_t)w * h * 4);
+    int er = engineInit(0);
+    void* canvas = canvasCreate(1 /* TVG_ENGINE_OPTION_DEFAULT */);
+    int tr = canvas ? setTarget(canvas, (uint32_t*)rgba, w, w, h, 2 /* TVG_COLORSPACE_ABGR8888S: bytes are r,g,b,a, straight alpha */) : -1;
+    LOGF(eINFO, "MOTOLII thorvg: init=%d canvas=%p target=%d", er, canvas, tr);
+    if (tr != 0)
+        return false;
+    void* pic = picNew();
+    int   lr = picLoad(pic, svgPath);
+    if (lr != 0)
+    {
+        LOGF(eERROR, "MOTOLII thorvg: load %s failed (%d)", svgPath, lr);
+        return false;
+    }
+    int sr = picSize(pic, (float)w, (float)h);
+    int ar = canvasAdd(canvas, pic);
+    int dr = canvasDraw(canvas, true);
+    int yr = canvasSync(canvas);
+    LOGF(eINFO, "MOTOLII thorvg: size=%d add=%d draw=%d sync=%d px0=%02x%02x%02x%02x pxC=%02x%02x%02x%02x", sr, ar, dr, yr, rgba[0], rgba[1], rgba[2], rgba[3],
+         rgba[((h / 2) * w + w / 2) * 4], rgba[((h / 2) * w + w / 2) * 4 + 1], rgba[((h / 2) * w + w / 2) * 4 + 2], rgba[((h / 2) * w + w / 2) * 4 + 3]);
+    return true;
+}
+
+static void motoliiUploadVideoFrame(int frame)
+{
+    if (!gMD.pBoard || !gMD.video[0])
+        return;
+    const size_t bytes = (size_t)MOTOLII_BOARD_W * MOTOLII_BOARD_H * 4;
+    char         cmd[2048];
+    snprintf(cmd, sizeof(cmd),
+             "/opt/homebrew/bin/ffmpeg -v error -ss %.6f -i \"%s\" -frames:v 1 -vf scale=%u:%u -f rawvideo -pix_fmt rgba -",
+             motoliiRow(frame) ? motoliiRow(frame)->videoSec : gMD.videoOffset + frame / gMD.fps, gMD.video, MOTOLII_BOARD_W, MOTOLII_BOARD_H);
+    FILE* p = popen(cmd, "r");
+    if (!p)
+        return;
+    uint8_t* px = (uint8_t*)tf_malloc(bytes);
+    size_t   got = 0;
+    while (got < bytes)
+    {
+        size_t n = fread(px + got, 1, bytes - got, p);
+        if (n == 0)
+            break;
+        got += n;
+    }
+    pclose(p);
+    if (got != bytes)
+    {
+        LOGF(eERROR, "MOTOLII video frame %d: ffmpeg gave %u of %u bytes", frame, (uint32_t)got, (uint32_t)bytes);
+        tf_free(px);
+        return;
+    }
+    motoliiUploadRGBA(gMD.pBoard, px, MOTOLII_BOARD_W, MOTOLII_BOARD_H);
+    tf_free(px);
+}
