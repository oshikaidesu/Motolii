+// Motolii fixture: the scene is a glTF from Blender (curve->tube) converted by The Forge's own AssetPipelineCmd.
+static Scene* initTubeScene(const GeometryLoadDesc* pTemplate, SyncToken& token)
+{
+    Scene* scene = (Scene*)tf_calloc(1, sizeof(Scene));
+    GeometryLoadDesc loadDesc = *pTemplate;
+    loadDesc.mFlags |= GEOMETRY_LOAD_FLAG_SHADOWED;
+    loadDesc.pFileName = "tube_scene/scene.bin";
+    loadDesc.ppGeometryData = &scene->geomData;
+    loadDesc.ppGeometry = &scene->geom;
+    addResource(&loadDesc, &token);
+    waitForToken(&token);
+    const uint32_t n = scene->geom->mDrawArgCount;
+    {
+        GeometryData* gd = scene->geomData;
+        if (gd && gd->pShadow)
+        {
+            const float*    pos = (const float*)gd->pShadow->pAttributes[SEMANTIC_POSITION];
+            const uint32_t* idx = (const uint32_t*)gd->pShadow->pIndices;
+            const uint32_t  vc = (uint32_t)scene->geom->mVertexCount;
+            for (uint32_t v = (vc > 8 ? vc - 8 : 0); v < vc; ++v)
+                LOGF(eINFO, "TUBE vtx %u: %.2f %.2f %.2f", v, pos[v * 3 + 0], pos[v * 3 + 1], pos[v * 3 + 2]);
+            for (uint32_t d = 1; d < n; ++d)
+            {
+                uint32_t st = scene->geom->pDrawArgs[d].mStartIndex;
+                LOGF(eINFO, "TUBE idx draw %u: %u %u %u %u %u %u", d, idx[st], idx[st + 1], idx[st + 2], idx[st + 3], idx[st + 4], idx[st + 5]);
+            }
+            LOGF(eINFO, "TUBE vtx 0: %.2f %.2f %.2f", pos[0], pos[1], pos[2]);
+        }
+        else
+            LOGF(eINFO, "TUBE no shadow data");
+    }
+    scene->materialCount = n;
+    scene->materialFlags = (MaterialFlags*)tf_calloc(n, sizeof(MaterialFlags));
+    scene->textures = (char**)tf_calloc(n, sizeof(char*));
+    scene->normalMaps = (char**)tf_calloc(n, sizeof(char*));
+    scene->specularMaps = (char**)tf_calloc(n, sizeof(char*));
+    for (uint32_t i = 0; i < n; ++i)
+    {
+        scene->textures[i] = (char*)tf_calloc(32, sizeof(char));
+        strcpy(scene->textures[i], (i == 2) ? "video_0012.tex" : "Palette_Sky.tex");
+    }
+    return scene;
+}
