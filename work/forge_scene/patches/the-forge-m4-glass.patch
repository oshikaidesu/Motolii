+static Texture* motoliiMakeTexture(uint32_t w, uint32_t h, const char* name)
+{
+    TextureDesc bd = {};
+    bd.mWidth = w;
+    bd.mHeight = h;
+    bd.mDepth = 1;
+    bd.mArraySize = 1;
+    bd.mMipLevels = 1;
+    bd.mSampleCount = SAMPLE_COUNT_1;
+    bd.mFormat = TinyImageFormat_R8G8B8A8_SRGB;
+    bd.mStartState = RESOURCE_STATE_SHADER_RESOURCE;
+    bd.mDescriptors = DESCRIPTOR_TYPE_TEXTURE;
+    bd.pName = name;
+    Texture*        tex = NULL;
+    TextureLoadDesc bl = {};
+    bl.pDesc = &bd;
+    bl.ppTexture = &tex;
+    addResource(&bl, NULL);
+    waitForAllResourceLoads();
+    return tex;
+}
+
+static void motoliiUploadRGBA(Texture* tex, const uint8_t* rgba, uint32_t w, uint32_t h)
+{
+    TextureUpdateDesc u = { tex };
+    u.mCurrentState = RESOURCE_STATE_SHADER_RESOURCE;
+    beginUpdateResource(&u);
+    TextureSubresourceUpdate sub = u.getSubresourceUpdateDesc(0, 0);
+    for (uint32_t r = 0; r < h; ++r)
+        memcpy((uint8_t*)sub.pMappedData + (size_t)r * sub.mDstRowStride, rgba + (size_t)r * w * 4, (size_t)w * 4);
+    endUpdateResource(&u);
+}
