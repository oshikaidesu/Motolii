{
  "dartRoot": "motolii/ui/lib",
  "modules": {
    "app": {
      "dependsOn": [
        "controls",
        "effects",
        "input",
        "inspector",
        "session",
        "theme",
        "workspace"
      ],
      "owns": "Application and window lifecycle, app entry (lib/main.dart), top bar, sheets"
    },
    "browser": {
      "dependsOn": [
        "colors",
        "controls",
        "effects",
        "fonts",
        "session",
        "theme"
      ],
      "owns": "Browser panel: create shelf, media catalog and explore views"
    },
    "colors": {
      "dependsOn": [
        "browser",
        "controls",
        "session",
        "theme"
      ],
      "owns": "Color shelf, color field and instruments"
    },
    "controls": {
      "dependsOn": [
        "theme"
      ],
      "owns": "Shared control widgets: leaves, menus, dialogs, panels, sheets"
    },
    "desks": {
      "dependsOn": [
        "browser",
        "controls",
        "session",
        "theme"
      ],
      "owns": "Desk tools (blend, depth, ease, history, notes, relations, web)"
    },
    "effects": {
      "dependsOn": [
        "browser",
        "controls",
        "desks",
        "inspector",
        "session",
        "theme"
      ],
      "owns": "Effect shelf, effect cards and parameter surfaces"
    },
    "fonts": {
      "dependsOn": [
        "browser",
        "session",
        "theme"
      ],
      "owns": "Font shelf"
    },
    "input": {
      "dependsOn": [
        "app",
        "session"
      ],
      "owns": "Global shortcuts and gesture momentum"
    },
    "inspector": {
      "dependsOn": [
        "browser",
        "controls",
        "desks",
        "effects",
        "session",
        "theme"
      ],
      "owns": "Inspector panel: property rows, value controls, transform, camera and layout sections"
    },
    "session": {
      "dependsOn": [
        "bridge"
      ],
      "owns": "Authoritative snapshot reception, playback scheduling, command queue and editor actions"
    },
    "bridge": {
      "dependsOn": [],
      "owns": "Native transport and typed operation protocol"
    },
    "stage": {
      "dependsOn": [
        "controls",
        "session",
        "theme"
      ],
      "owns": "Stage panel: viewport view, overlay, camera and spatial gestures"
    },
    "theme": {
      "dependsOn": [
        "controls"
      ],
      "owns": "Theme tokens, palettes, glyphs and surface styling"
    },
    "timeline": {
      "dependsOn": [
        "controls",
        "input",
        "session",
        "theme"
      ],
      "owns": "Timeline panel: rows, geometry and face"
    },
    "workspace": {
      "dependsOn": [
        "app",
        "browser",
        "controls",
        "desks",
        "effects",
        "inspector",
        "session",
        "stage",
        "theme",
        "timeline"
      ],
      "owns": "Dock layout, tabs, resize, panel focus and panel seats"
    }
  },
  "nativeEditor": "motolii/ui/native/src/editor",
  "readOnlyPlayback": "motolii/crates/motolii-render/src/playback.rs",
  "readOnlyDocumentConsumers": [
    "motolii/crates/motolii-render",
    "motolii/crates/motolii-jobs"
  ],
  "readOnlyModels": [
    "motolii/crates/motolii-doc/src/store/view.rs",
    "motolii/crates/motolii-doc/src/store/layout.rs",
    "motolii/crates/motolii-doc/src/store/read.rs",
    "motolii/crates/motolii-doc/src/store/recording.rs",
    "motolii/crates/motolii-doc/src/store/text_read.rs",
    "motolii/crates/motolii-render/src/extensions",
    "motolii/crates/motolii-doc/src/store/ids.rs",
    "motolii/ui/native/src/viewer.rs",
    "motolii/crates/motolii-jobs/src"
  ],
  "coreProcessState": {
    "root": "motolii/crates/motolii-doc/src",
    "owners": {
      "vector/text.rs": [
        "SYSTEM",
        "KNOWN"
      ]
    }
  },
  "editingHouse": "motolii/crates/motolii-edit",
  "effectRegistration": {
    "root": "motolii/ui/native/src",
    "owner": "lib.rs",
    "calls": [
      "blank_project",
      "Document::load"
    ]
  },
  "coreSolvers": {
    "root": "motolii/crates/motolii-render/src",
    "owners": {
      "taffy": "picture/flow.rs"
    }
  },
  "isolatedExtensions": {
    "motolii/crates/motolii-script": [
      "rquickjs",
      "serde_json"
    ]
  },
  "history": "docs/product/history/retired-source.md",
  "legacyPolicy": "retired to pinned Git history; changes target nativeEditor"
}
