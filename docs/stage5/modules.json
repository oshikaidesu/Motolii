{
  "dartRoot": "motolii/ui/lib",
  "modules": {
    "app": {"dependsOn": ["foundation", "input", "workspace", "panels", "session"], "owns": "Application and window lifecycle; OS window orchestration"},
    "workspace": {"dependsOn": ["foundation"], "owns": "Dock layout, tabs, resize and panel focus"},
    "input": {"dependsOn": ["session"], "owns": "Global shortcuts and gesture momentum"},
    "foundation": {"dependsOn": [], "owns": "Theme, controls and text/numeric draft widgets"},
    "panels": {"dependsOn": ["foundation", "session", "input"], "owns": "Panel-specific presentation and intent requests"},
    "session": {"dependsOn": ["bridge"], "owns": "Authoritative snapshot reception, playback scheduling and command queue"},
    "bridge": {"dependsOn": [], "owns": "Native transport and typed operation protocol"}
  },
  "nativeEditor": "motolii/ui/native/src/editor",
  "readOnlyPlayback": "motolii/crates/motolii-render/src/playback.rs",
  "readOnlyDocumentConsumers": ["motolii/crates/motolii-render", "motolii/ui/extensions/jobs"],
  "readOnlyModels": [
    "motolii/crates/motolii-doc/src/store/view.rs",
    "motolii/crates/motolii-doc/src/store/view",
    "motolii/crates/motolii-doc/src/store/layout.rs",
    "motolii/crates/motolii-doc/src/store/read.rs",
    "motolii/crates/motolii-doc/src/store/recording.rs",
    "motolii/crates/motolii-doc/src/store/text_read.rs",
    "motolii/crates/motolii-doc/src/extensions",
    "motolii/crates/motolii-doc/src/store/ids.rs",
    "motolii/ui/native/src/viewer.rs",
    "motolii/ui/extensions/jobs/src"
  ],
  "isolatedExtensions": {
    "motolii/ui/extensions/script": ["rquickjs", "serde_json"]
  },
  "history": "docs/stage5/history/retired-source.md",
  "legacyPolicy": "retired to pinned Git history; changes target nativeEditor"
}
