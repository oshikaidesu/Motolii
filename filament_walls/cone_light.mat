// Step two of the light of the cones: ONE mesh (beam::cone_mesh), drawn once per (cone, colour step, way). What
// became of each corner is read from the texture that cone_walk.mat has just written; here the corner's brightness
// is worked out from itself and its six neighbours (beam::cone_bright) and the light is told how much to soften
// (beam::cone_light). Nothing about a cone comes from the CPU.
// Output as beam_light.mat: rgb = the light, a = light * distance flown (for the softening pass).
//
// Receivers (walls, blocks; see "Receivers" in beam_glass.h, recv_plane.glsl, recv_lands.glsl). With a stage
// (roomCount > 0) cone_walk.mat has dropped every corner on the plane it meets first and written three texels for it,
// `kinds` lines per cone, colour step and way (see there); this renderable draws the lines of its `kind` (0: the
// light on the room, 1: on the blocks), and each pixel asks recvKeep whether it is on something. With roomCount 0
// (not set) nothing changes: the floor alone.
material {
    name : cone_light,
    shadingModel : unlit,
    blending : add,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    instanced : true,
    variables : [ light, owner ],
    parameters : [
        { type : sampler2d, name : walk, precision : high, format : float },    // written by cone_walk.mat
        { type : float4[32], name : steps },                                    // rgb, index of refraction
        { type : float,  name : stepCount },
        { type : float,  name : wayCount },
        { type : float4, name : rows },                                         // beam::CONE_ROWS
        { type : float4, name : cols },                                         // beam::CONE_COLS
        { type : float,  name : first },                                        // the first cone of this renderable
        { type : float3, name : sunDir },
        { type : float,  name : sunTan },
        { type : float,  name : floorY },
        { type : float,  name : cap },                                          // beam::CONE_CAP
        { type : float4[6], name : room, precision : high },                    // the stage: see recv_plane.glsl
        { type : float,  name : roomCount },
        { type : float4[16], name : blocks, precision : high },
        { type : float,  name : blockCount },
        { type : float,  name : kinds },                                        // cone_walk.mat's lines per cone, colour step and way: 1 (or 0), or 2
        { type : float,  name : kind },                                         // which of them this renderable draws
        { type : float,  name : pxScale }                                       // tan(half the sun's width) * pixels per unit at distance 1
    ]
}

vertex {
    float rowsOf(int pch) { return pch == 0 ? materialParams.rows.x : (pch == 1 ? materialParams.rows.y : materialParams.rows.z); }
    float colsOf(int pch) { return pch == 0 ? materialParams.cols.x : (pch == 1 ? materialParams.cols.y : materialParams.cols.z); }
    // texel `part` (0 or 1) of corner (i, j) of a patch, for an instance
    vec4 cornerAt(int pch, float i, float j, int inst, int part) {
        int size0 = int(materialParams.rows.x + 1.5) * int(materialParams.cols.x + 1.5);
        int size1 = int(materialParams.rows.y + 1.5) * int(materialParams.cols.y + 1.5);
        int corner = (pch > 0 ? size0 : 0) + (pch > 1 ? size1 : 0) + int(i + 0.5) * int(colsOf(pch) + 1.5) + int(j + 0.5);
        return texelFetch(materialParams_walk, ivec2(corner * (materialParams.roomCount > 0.5 ? 3 : 2) + part, inst), 0);
    }
    void materialVertex(inout MaterialVertexInputs material) {
        int stepCount = int(materialParams.stepCount), wayCount = int(materialParams.wayCount);
        int per = stepCount * wayCount;
        int inst = int(materialParams.first) * per + getInstanceIndex();
        int rest = inst - (inst / per) * per;
        if (materialParams.kinds > 1.5) inst = ((inst / per) * 2 + (materialParams.kind > 0.5 ? 1 : 0)) * per + rest;   // (cone, kind, colour step, way)
        bool stage = materialParams.roomCount > 0.5;
        int stepAt = rest / wayCount;
        vec3 L = materialParams.sunDir;
        float i = mesh_position.x, j = mesh_position.y;
        int pch = int(mesh_position.z + 0.5);
        float rows = rowsOf(pch), cols = colsOf(pch);

        vec4 land = cornerAt(pch, i, j, inst, 0), on = cornerAt(pch, i, j, inst, 1);
        vec3 q = vec3(land.x, land.z, land.y), P = on.xyz;   // q: x, distance flown, z
        vec3 X = land.xyz;                                   // on a stage: where it lands, in space (and the distance flown is land.w)
        if (stage) q.y = land.w;
        float weight = land.w, faces = floor(on.w), fade = on.w - faces;
        if (stage) weight = fract(cornerAt(pch, i, j, inst, 2).w);
        if (fade > 0.9985) fade = 1.0;
        float e = 0.0, fly = q.y;
        if (faces > 0.5) {
            // the corners around this one (beam::cone_around) and what became of them (beam::cone_bright)
            float fi[6];
            float fj[6];
            fi[0] = i + 1.0; fj[0] = j;
            fi[1] = i + 1.0; fj[1] = j + 1.0;
            fi[2] = i;       fj[2] = j + 1.0;
            fi[3] = i - 1.0; fj[3] = j;
            fi[4] = i - 1.0; fj[4] = j - 1.0;
            fi[5] = i;       fj[5] = j - 1.0;
            vec3 Pk[6];
            vec3 Xk[6];
            vec2 qk[6];
            bool same[6];
            float least = fade;
            for (int m = 0; m < 6; m++) {
                same[m] = false;
                Pk[m] = P;
                Xk[m] = X;
                qk[m] = q.xz;
                if (!(fi[m] > -0.5 && fi[m] < rows + 0.5 && fj[m] > -0.5 && fj[m] < cols + 0.5)) continue;   // no such corner
                vec4 lk = cornerAt(pch, fi[m], fj[m], inst, 0), ok = cornerAt(pch, fi[m], fj[m], inst, 1);
                float ck = floor(ok.w), fk = ok.w - ck;
                if (fk > 0.9985) fk = 1.0;
                Pk[m] = ok.xyz;
                Xk[m] = lk.xyz;
                qk[m] = lk.xy;
                same[m] = abs(ck - faces) < 0.5;
                least = min(least, same[m] ? fk : 0.0);
            }
            float before = 0.0, after = 0.0;
            for (int m = 0; m < 6; m++) {
                int o = m < 5 ? m + 1 : 0;
                if (!same[m] || !same[o]) continue;
                before += abs(dot(cross(Pk[m] - P, Pk[o] - P), L));
                if (stage) after += length(cross(Xk[m] - X, Xk[o] - X));   // (the corners around may lie on other planes)
                else after += abs((qk[m].x - q.x) * (qk[o].y - q.z) - (qk[m].y - q.z) * (qk[o].x - q.x));
            }
            if (before > 0.0) e = weight * least * (after * materialParams.cap > before ? before / after : materialParams.cap);
            if (fade > 0.0) {
                // soften by half the gap to where the neighbouring colour lands, so that the colour steps run into one another
                int other = stepAt + 1 < stepCount ? inst + wayCount : (stepAt > 0 ? inst - wayCount : inst);
                vec4 ln = cornerAt(pch, i, j, other, 0), on2 = cornerAt(pch, i, j, other, 1);
                float cn = floor(on2.w);
                if (cn > 0.5 && on2.w - cn > 0.0) fly += 0.5 * (stage ? length(ln.xyz - X) : length(ln.xy - q.xz)) / materialParams.sunTan;
            }
        }
        material.light = vec4(materialParams.steps[stepAt].rgb * e, fly);
        material.owner = vec4(-1.0, 1.0, 0.0, 0.0);
        if (stage) {
            float what = floor(cornerAt(pch, i, j, inst, 2).w) - 1.0;
            material.owner = vec4(what, what * what, 0.0, 0.0);
        }
        material.worldPosition = mulMat4x4Float3(getWorldFromModelMatrix(), stage ? X : vec3(q.x, materialParams.floorY, q.z));
        // on a stage the softening pass is told how far to spread in pixels, so that it need not know what the light lies on
        if (stage) material.light.a *= materialParams.pxScale / length(material.worldPosition.xyz - getWorldCameraPosition());
    }
}

fragment {
#include "recv_lands.glsl"
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 c = variable_light;
        if (materialParams.roomCount > 0.5) c = recvKeep(c, variable_owner.xy);
        material.baseColor = vec4(c.rgb, (c.r + c.g + c.b) / 3.0 * c.a);
    }
}
