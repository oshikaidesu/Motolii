// A lit floor that also receives the glass's light from a screen-sized buffer (beam_light.mat drawn with the
// same camera). The buffer holds irradiance in units of the sun's; `gain` turns it into what a matte floor
// sends back (sun illuminance / pi, times the sun's colour).
material {
    name : floor_beam,
    shadingModel : lit,
    culling : none,
    doubleSided : true,
    specularAntiAliasing : true,
    parameters : [
        { type : float4, name : color },
        { type : float, name : roughness },
        { type : float, name : reflectance },
        { type : float3, name : gain },
        { type : sampler2d, name : light, format : float }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = materialParams.color;
        material.roughness = materialParams.roughness;
        material.metallic = 0.0;
        material.reflectance = materialParams.reflectance;
        vec2 uv = uvToRenderTargetUV(getNormalizedViewportCoord().xy);
        // may be negative: that is the block's shadow, taken out of the sunlight this floor receives
        vec3 c = textureLod(materialParams_light, uv, 0.0).rgb;
        material.emissive = vec4(materialParams.color.rgb * c * materialParams.gain, 1.0);
    }
}
