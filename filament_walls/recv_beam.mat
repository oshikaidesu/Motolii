// A lit matte surface that receives the glass's light and shadow from a screen-sized buffer: what floor_beam.mat is
// for the floor alone, for anything (floor, wall, block). The buffer (beam_soften.mat with `split`) holds in rgb the
// light, in units of the sun's irradiance ON this surface, and in alpha how much of the sun is cut off here (0 to 1).
// How much sunlight that takes away depends on how the surface faces the sun, which only the surface knows.
// `gain` turns irradiance into what a matte surface sends back (sun illuminance / pi, times the sun's colour).
material {
    name : recv_beam,
    shadingModel : lit,
    culling : none,
    doubleSided : true,
    specularAntiAliasing : true,
    parameters : [
        { type : float4, name : color },
        { type : float, name : roughness },
        { type : float, name : reflectance },
        { type : float3, name : gain },
        { type : float3, name : sunTo },
        { type : sampler2d, name : light, format : float }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = materialParams.color;
        material.roughness = materialParams.roughness;
        material.metallic = 0.0;
        material.reflectance = materialParams.reflectance;
        vec2 uv = uvToRenderTargetUV(getNormalizedViewportCoord().xy);
        vec4 c = textureLod(materialParams_light, uv, 0.0);
        float facing = max(dot(getWorldGeometricNormalVector(), materialParams.sunTo), 0.0);
        material.emissive = vec4(materialParams.color.rgb * (c.rgb - vec3(c.a * facing)) * materialParams.gain, 1.0);
    }
}
