// The floor light of beam_glass.h: flat-coloured triangles, added on top of each other. No blur, no lookup.
// Drawn with the picture's own camera into a float buffer, so the light is as sharp as the screen.
material {
    name : beam_light,
    shadingModel : unlit,
    blending : add,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    requires : [ color ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // rgb = the light. a = light * distance flown (the vertex carries the distance in its colour's alpha),
        // so that a later pass can tell how far the light at a pixel travelled (beam_soften.mat).
        vec4 c = getColor();
        material.baseColor = vec4(c.rgb, (c.r + c.g + c.b) / 3.0 * c.a);
    }
}
