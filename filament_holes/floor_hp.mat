// Single-channel caustic dispersion, reimplemented from the published function
// GetHPWaterCaustic() in HPWaterCausticSampleFunction.hlsl (MPL-2.0):
// https://github.com/AshenOneArt/HPWater
// Core_Source_Preview/HanPiWater/Caustic/HPWaterCausticSampleFunction.hlsl
// The UV offset is computed on the CPU from this scene's light and glass
// normal, in the floor illuminance UV. The water normal atlas and the water
// cascade matrix are not used.
material {
    name : floor_hp,
    shadingModel : lit,
    culling : none,
    doubleSided : true,
    coloredPenumbra : true,
    specularAntiAliasing : true,
    parameters : [
        { type : float4, name : color },
        { type : float, name : roughness },
        { type : float, name : disperse },
        { type : float2, name : uvOffset },
        { type : sampler2d, name : caustic, format : float }
    ],
    requires : [ uv0 ]
}

fragment {
    float monoAt(vec2 uv) {
        vec2 c = clamp(uv, vec2(0.0), vec2(1.0));
        vec3 s = texture(materialParams_caustic, c).rgb;
        return max(s.r, max(s.g, s.b));
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = materialParams.color;
        material.roughness = materialParams.roughness;
        material.metallic = 0.0;
        material.reflectance = 0.35;
        vec2 uv = getUV0();
        vec3 c;
        if (materialParams.disperse > 0.5) {
            c = vec3(monoAt(uv + materialParams.uvOffset),
                     monoAt(uv),
                     monoAt(uv - materialParams.uvOffset));
        } else {
            c = texture(materialParams_caustic, uv).rgb;
        }
        material.emissive = vec4(c, 1.0);
    }
}
