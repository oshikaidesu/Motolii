// Step two of the light of solids with dents and holes (beam_extrude.h): what becomes of the light at the five
// points of every stretch of wall that the strips are hung on (its start, and just before and just after the two
// places that extrude_find.mat found). One texel per stretch across, EX_ROWS lines per solid down:
//   EX_ROW_SHADOW          (shadow at points 0, 1, 2, 3),   EX_ROW_SHADOW + 1  (shadow at point 4, 0, 0, 0)
//   EX_ROW_MIRROR + point  (behind, next wall at, that wall's normal x, y)
//   EX_ROW_WALL + 10 step + 2 point      (shade on the wall, way inside, where it comes out x, y)
//   EX_ROW_WALL + 10 step + 2 point + 1  (which way x, y; how much is left; how far from the next colour's way)
//   EX_ROW_CUT + 2 (step + EX_STEPS if the rim at -z)      (lands: inner edge x, z, outer edge x, z)    [point 0 only]
//   EX_ROW_CUT + ... + 1                                   (light per unit, how much is drawn, flown, key)
// This is beam::detail::ex_walk_texel; change them together.
material {
    name : extrude_walk,
    shadingModel : unlit,
    vertexDomain : device,
    blending : add,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    flipUV : false,
    parameters : [
        { type : sampler2d, name : shapes, precision : high, format : float },
        { type : sampler2d, name : poses, precision : high, format : float },
        { type : sampler2d, name : find, precision : high, format : float },      // written by extrude_find.mat
        { type : float4[8], name : steps },
        { type : float4[4], name : capSteps },
        { type : float3, name : sunDir },
        { type : float,  name : floorY }
    ]
}

fragment {
#define EX_WITH_POSES
#include "extrude_common.glsl"

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        ivec2 px = ivec2(gl_FragCoord.xy);
        int column = px.x, solid = px.y / EX_ROWS, line = px.y - solid * EX_ROWS;
        ExCtx c = exCtx(solid, materialParams.sunDir, materialParams.floorY);
        vec4 outv = vec4(0.0);
        material.baseColor = outv;
        if (column >= c.s.stretches) return;
        vec3 st = exStretch(c.s, column);
        ExEdge ed = exEdge(c.s, int(st.x + 0.5));
        float side = ed.r == 0.0 ? exCross(c.sh, ed.b - ed.a) : 0.0;
        if (line < EX_ROW_MIRROR) {
            if (!(c.lat > 1e-6) || side < 0.0) return;
            vec4 f = texelFetch(materialParams_find, ivec2(column, solid * EX_FIND_ROWS), 0);
            if (line == EX_ROW_SHADOW) {
                outv = vec4(exShadowAt(c, ed, exPointU(st, f, 0)).x, exShadowAt(c, ed, exPointU(st, f, 1)).x, exShadowAt(c, ed, exPointU(st, f, 2)).x, exShadowAt(c, ed, exPointU(st, f, 3)).x);
            } else {
                outv.x = exShadowAt(c, ed, exPointU(st, f, 4)).x;
            }
        } else if (line < EX_ROW_WALL) {
            if (!(c.lat > 1e-6) || side < 0.0) return;
            vec4 f = texelFetch(materialParams_find, ivec2(column, solid * EX_FIND_ROWS + 1), 0);
            float longest = 0.0;
            for (int k = 0; k < EX_CAP_STEPS; k++) longest = max(longest, exCapStep(c, materialParams.capSteps[k].w));
            ExMirror m = exMirrorAt(c, ed, exPointU(st, f, line - EX_ROW_MIRROR), longest);
            outv = vec4(min(m.back, EX_BIG), min(m.at1, EX_BIG), m.n1);
        } else if (line < EX_ROW_CUT) {
            int k = (line - EX_ROW_WALL) / 10, rest = line - EX_ROW_WALL - k * 10, which = rest / 2;
            bool second = rest - which * 2 == 1;
            if (!(c.lat > 1e-6) || side > 0.0) {
                if (second) outv.z = -1.0;
                material.baseColor = outv;
                return;
            }
            vec4 f = texelFetch(materialParams_find, ivec2(column, solid * EX_FIND_ROWS + 2 + k), 0);
            float u = exPointU(st, f, which);
            ExWall m = exWallAt(c, ed, u, materialParams.steps[k].w);
            if (second) {
                // how far apart this colour and its neighbour leave: the light is softened by half of that as well,
                // so that the colour steps run into one another. Measured a quarter of the way to the neighbour (to
                // one side or the other, whichever takes the same way). If neither does, this colour is about to be
                // kept in by the glass altogether, and there the colours fly apart without limit: as soft as it gets.
                float gap = 0.0;
                if (m.weight >= 0.0) {
                    float n0 = materialParams.steps[k].w, quarter = 0.25 * (materialParams.steps[exNextStep(k)].w - n0);
                    ExWall o = exWallAt(c, ed, u, n0 + quarter);
                    if (o.key != m.key) o = exWallAt(c, ed, u, n0 - quarter);
                    gap = o.key == m.key ? min(EX_GAP, 4.0 * length(o.o - m.o)) : EX_GAP;
                }
                outv = vec4(m.o, m.weight, gap);
            } else {
                outv = vec4(min(m.lift, EX_BIG), m.path, m.q);
            }
        } else {
            if (!(c.s.leg > 0.0)) return;
            int k2 = (line - EX_ROW_CUT) / 2;
            bool second = line - EX_ROW_CUT - k2 * 2 == 1;
            int k = k2 < EX_STEPS ? k2 : k2 - EX_STEPS;
            ExCut m = exCutAt(c, ed, st.y, k2 < EX_STEPS ? 1.0 : -1.0, materialParams.steps[k].w);
            outv = second ? vec4(m.e, m.fade, m.fly, float(m.key)) : vec4(m.qin, m.qout);
        }
        material.baseColor = outv;
    }
}
