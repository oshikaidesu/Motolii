// The body of the chamfered glass block of beam_glass.h, seen from the camera.
// `kind` 0: any convex flat-faced solid; `planes` are its faces in the mesh's own space (xyz = outward normal,
// w = offset), `planeCount` of them. `kind` 1: a ball of radius dims.x. `kind` 2: a round bar along Y, radius
// dims.x, half length dims.y. `kind` 3: a cone along Y, base radius dims.x, height dims.y, its own origin half way
// up (all in the mesh's own space). `kind` 4: an outline with dents and holes pushed through a thickness
// (beam_extrude.h): the outline in x, y, the thickness along z; its edges are read from `shapes` (the line of the
// shape is in the solid's row of `scene`). The solid's place, turn and size come from the renderable's own
// transform (uniform scale).
//
// Each pixel follows its sight line through the same solid the light was traced through: bend in, walk to the
// next face, mirror while the glass cannot let it out (total reflection), bend out. What it then looks at is
// the real scene: the floor (with the block's light and shadow on it) from `backdrop`, a picture of the scene
// without the block taken by the same camera, or the room (`env`, the scene's own environment map, plus a plain `sky` colour, both in nits).
//
// Other glass: `scene` is a small float texture with one row per solid of the picture, in world space
// (texel 0 = bounding sphere xyz + radius, texel 1 = number of faces, kind, radius, half length (cone: height),
// texel 2 = axis, texels 3.. = faces as xyz normal, w offset; for a cone texel 3 = the middle of its base; for
// kind 4 texel 3 = the outline's origin + size, texel 4 = where its x axis points + the line of its shape).
// A sight line that leaves this solid and meets another one goes on through it (up to SEGS solids in a row), so
// glass is seen through glass. `self` is this solid's row; `solidCount` 0 or 1 switches the search off.
//
// Borrowed, translated to Filament GLSL:
//   bounce loop       - N8python/diamonds `totalInternalReflection` (MIT, (c) 2022 N8python), its BVH lookup
//                       replaced by the plane list of this solid
//   colour weights    - Wyman, Sloan, Shirley, JCGT 2013 (CIE fit), as in beam_glass.h
// See third_party/NOTICE-glassbox.md.
material {
    name : glass_solid,
    shadingModel : unlit,
    blending : opaque,
    culling : back,
    variables : [ boxC, boxX, boxY ],
    parameters : [
        { type : sampler2d, name : backdrop, precision : medium },
        { type : samplerCubemap, name : env, precision : medium },
        { type : float, name : ior },
        { type : float, name : abbe },
        { type : float4[40], name : planes },
        { type : int, name : planeCount },
        { type : int, name : kind },
        { type : float4, name : dims },
        { type : sampler2d, name : scene, precision : high },
        { type : sampler2d, name : shapes, precision : high, format : float },   // beam::ex_shape_table (kind 4)
        { type : int, name : solidCount },
        { type : int, name : self },
        { type : float, name : spread },
        { type : float3, name : sunTo },
        { type : float3, name : sunGlint },
        { type : float, name : sunCos },
        { type : float, name : floorY },
        { type : float, name : envGain },
        { type : float3, name : sky },
        { type : float3, name : absorption }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        mat4 m = getWorldFromModelMatrix();
        float lx = length(m[0].xyz), ly = length(m[1].xyz);
        material.boxC = vec4(m[3].xyz, lx);            // centre, edge length
        material.boxX = vec4(m[0].xyz / lx, 0.0);
        material.boxY = vec4(m[1].xyz / ly, 0.0);
    }
}

fragment {
    const int WAVES = 9;
    const int BOUNCES = 6;

    float iorAt(float nm) {
        // two-term Cauchy from the Abbe number, as beam::Glass::n
        float B = (materialParams.ior - 1.0) / (materialParams.abbe * (1.0 / (486.13 * 486.13) - 1.0 / (656.27 * 656.27)));
        return materialParams.ior + B * (1.0 / (nm * nm) - 1.0 / (587.56 * 587.56));
    }
    float lobe(float x, float mu, float s1, float s2) {
        float t = (x - mu) * (x < mu ? s1 : s2);
        return exp(-0.5 * t * t);
    }
    vec3 waveRgb(float nm) {
        float X = 1.056 * lobe(nm, 599.8, 0.0264, 0.0323) + 0.362 * lobe(nm, 442.0, 0.0624, 0.0374) - 0.065 * lobe(nm, 501.1, 0.0490, 0.0382);
        float Y = 0.821 * lobe(nm, 568.8, 0.0213, 0.0247) + 0.286 * lobe(nm, 530.9, 0.0613, 0.0322);
        float Z = 1.217 * lobe(nm, 437.0, 0.0845, 0.0278) + 0.681 * lobe(nm, 459.0, 0.0385, 0.0725);
        return vec3(3.2406 * X - 1.5372 * Y - 0.4986 * Z, -0.9689 * X + 1.8758 * Y + 0.0415 * Z, 0.0557 * X - 0.2040 * Y + 1.0570 * Z);
    }
    // unpolarised Fresnel reflectance, n1 -> n2, 1 on total reflection
    float fresnel(float ci, float n1, float n2) {
        float s2 = (n1 / n2) * (n1 / n2) * (1.0 - ci * ci);
        if (s2 >= 1.0) return 1.0;
        float ct = sqrt(1.0 - s2);
        float rs = (n1 * ci - n2 * ct) / (n1 * ci + n2 * ct);
        float rp = (n1 * ct - n2 * ci) / (n1 * ct + n2 * ci);
        return 0.5 * (rs * rs + rp * rp);
    }

    const int MAXP = 40;

    // Every place a line o + t d crosses a cone (c: middle of the base, a: axis towards the tip, r, h), side or
    // base: how far and the outward normal there, nearest first. Returns how many (0 to 2). As beam::cone_crossings.
    int coneCross(vec3 c, vec3 a, float r, float h, vec3 o, vec3 d, out float t0, out vec3 n0, out float t1, out vec3 n1) {
        t0 = 0.0; t1 = 0.0;
        n0 = a; n1 = a;
        vec3 w = o - c;
        float k = r / h, y0 = dot(w, a), da = dot(d, a);
        vec3 wp = w - a * y0, dp = d - a * da;
        float A = dot(dp, dp) - k * k * da * da, B = dot(wp, dp) + k * da * (r - k * y0), C = dot(wp, wp) - (r - k * y0) * (r - k * y0);
        float root0 = 0.0, root1 = 0.0;
        int roots = 0;
        if (abs(A) > 1e-7) {
            float disc = B * B - A * C;
            if (disc > 0.0) {
                float sq = sqrt(disc);
                root0 = (-B - sq) / A;
                root1 = (-B + sq) / A;
                roots = 2;
            }
        } else if (abs(B) > 1e-7) {
            root0 = -C / (2.0 * B);
            roots = 1;
        }
        float slope = inversesqrt(1.0 + k * k);
        int count = 0;
        for (int i = 0; i < 2; i++) {
            if (i >= roots) break;
            float tt = i == 0 ? root0 : root1;
            float y = y0 + tt * da;
            if (y < 0.0 || y > h) continue;
            vec3 q = wp + dp * tt;
            float ql = length(q);
            vec3 nn = ql > 1e-6 * r ? (q / ql + a * k) * slope : a;
            if (count == 0) { t0 = tt; n0 = nn; } else { t1 = tt; n1 = nn; }
            count++;
        }
        if (abs(da) > 1e-7 && count < 2) {
            float tb = -y0 / da;
            vec3 q = wp + dp * tb;
            if (dot(q, q) <= r * r) {
                if (count == 0) { t0 = tb; n0 = -a; } else { t1 = tb; n1 = -a; }
                count++;
            }
        }
        if (count == 2 && t1 < t0) {
            float ts = t0; t0 = t1; t1 = ts;
            vec3 ns = n0; n0 = n1; n1 = ns;
        }
        return count;
    }
    // from a point in or on the cone along d: distance to its surface and the outward normal there
    float coneExit(vec3 c, vec3 a, float r, float h, vec3 o, vec3 d, out vec3 n) {
        float t0, t1;
        vec3 n0, n1;
        int count = coneCross(c, a, r, h, o, d, t0, n0, t1, n1);
        n = a;
        if (count >= 1 && t0 > 1e-5 * r && dot(n0, d) > 0.0) { n = n0; return t0; }
        if (count >= 2 && t1 > 1e-5 * r && dot(n1, d) > 0.0) { n = n1; return t1; }
        // nothing found (a sight line along the surface): leave where it stands
        n = normalize(d);
        return 0.0;
    }

    // ---- kind 4: an outline with dents and holes (beam_extrude.h)
#define EX_WITH_SOLID
#include "extrude_common.glsl"
    vec3 exFlat = vec3(0.0, 0.0, 1.0);   // the normal of the mesh's triangle under the pixel (set in material())
    vec3 exSnap = vec3(0.0);             // the pixel put on the true wall (set by faceAt)
    ExShape exOwn() { return exShape(int(texelFetch(materialParams_scene, ivec2(4, materialParams.self), 0).w + 0.5)); }
    // solid k of the table: a ray of the world into the outline's own frame (d keeps its length, so t stays in world units / size)
    void exLocal(int k, vec3 o, vec3 d, out ExShape s, out vec3 lo, out vec3 ld, out mat3 R, out float size) {
        vec4 a = texelFetch(materialParams_scene, ivec2(3, k), 0), b = texelFetch(materialParams_scene, ivec2(4, k), 0);
        vec3 ez = texelFetch(materialParams_scene, ivec2(2, k), 0).xyz;
        R = mat3(b.xyz, cross(ez, b.xyz), ez);
        size = a.w;
        s = exShape(int(b.w + 0.5));
        lo = ((o - a.xyz) * R) / size;
        ld = d * R;
    }

    // the face a surface point lies on: the plane it is closest to
    vec3 faceAt(vec3 p) {
        if (materialParams.kind == 4) return exFace(exOwn(), p, exFlat, exSnap);
        if (materialParams.kind == 1) return normalize(p);
        if (materialParams.kind == 2) {
            float side = materialParams.dims.x - length(p.xz), end = materialParams.dims.y - abs(p.y);
            return side < end ? normalize(vec3(p.x, 0.0, p.z)) : vec3(0.0, p.y < 0.0 ? -1.0 : 1.0, 0.0);
        }
        if (materialParams.kind == 3) {
            float r = materialParams.dims.x, h = materialParams.dims.y, k = r / h;
            float up = p.y + 0.5 * h, across = length(p.xz);
            float side = (r - k * up - across) * inversesqrt(1.0 + k * k);
            if (up < side) return vec3(0.0, -1.0, 0.0);
            return across > 1e-6 * r ? normalize(vec3(p.x / across, k, p.z / across)) : vec3(0.0, 1.0, 0.0);
        }
        float best = 1e9;
        vec3 n = vec3(0.0, 1.0, 0.0);
        for (int i = 0; i < MAXP; i++) {
            if (i >= materialParams.planeCount) break;
            vec4 pl = materialParams.planes[i];
            float s = pl.w - dot(pl.xyz, p);
            if (s < best) { best = s; n = pl.xyz; }
        }
        return n;
    }
    // from a point in or on the solid along d: distance to the surface, and the outward normal there
    float exitAt(vec3 o, vec3 d, out vec3 n) {
        float t = 1e9;
        n = vec3(0.0, 1.0, 0.0);
        if (materialParams.kind == 1) {
            float r = materialParams.dims.x, b = dot(o, d);
            t = -b + sqrt(max(b * b - (dot(o, o) - r * r), 0.0));
            n = normalize(o + d * t);
            return max(t, 0.0);
        }
        if (materialParams.kind == 2) {
            float r = materialParams.dims.x, h = materialParams.dims.y;
            float tS = 1e9, tC = 1e9;
            if (d.y > 1e-6) tS = (h - o.y) / d.y;
            else if (d.y < -1e-6) tS = (-h - o.y) / d.y;
            float A = dot(d.xz, d.xz), B = dot(o.xz, d.xz), C = dot(o.xz, o.xz) - r * r;
            if (A > 1e-9) tC = (-B + sqrt(max(B * B - A * C, 0.0))) / A;
            if (tC <= tS) {
                vec3 q = o + d * tC;
                n = normalize(vec3(q.x, 0.0, q.z));
                return max(tC, 0.0);
            }
            n = vec3(0.0, d.y > 0.0 ? 1.0 : -1.0, 0.0);
            return max(tS, 0.0);
        }
        if (materialParams.kind == 3)
            return coneExit(vec3(0.0, -0.5 * materialParams.dims.y, 0.0), vec3(0.0, 1.0, 0.0), materialParams.dims.x, materialParams.dims.y, o, d, n);
        if (materialParams.kind == 4) return exLeave(exOwn(), o, d, n);
        for (int i = 0; i < MAXP; i++) {
            if (i >= materialParams.planeCount) break;
            vec4 pl = materialParams.planes[i];
            float den = dot(pl.xyz, d);
            if (den > 1e-6) {
                float ti = (pl.w - dot(pl.xyz, o)) / den;
                if (ti < t) { t = ti; n = pl.xyz; }
            }
        }
        return max(t, 0.0);
    }

    const int SEGS = 3;
    const int MAXS = 64;
    vec4 sceneAt(int x, int row) { return texelFetch(materialParams_scene, ivec2(x, row), 0); }
    // does a sight line in the air meet solid k? how far, and the face normal there
    bool meets(int k, vec3 o, vec3 d, out float t, out vec3 n) {
        vec4 info = sceneAt(1, k);
        int kind = int(info.y + 0.5);
        n = vec3(0.0, 1.0, 0.0);
        t = 0.0;
        if (kind == 1) {
            vec3 w = o - sceneAt(0, k).xyz;
            float b = dot(w, d), disc = b * b - (dot(w, w) - info.z * info.z);
            if (disc <= 0.0) return false;
            t = -b - sqrt(disc);
            if (t < -1e-5) return false;
            n = normalize(w + d * t);
            return true;
        }
        if (kind == 2) {
            vec3 a = sceneAt(2, k).xyz, w = o - sceneAt(0, k).xyz;
            float wa = dot(w, a), da = dot(d, a);
            vec3 wp = w - a * wa, dp = d - a * da;
            float tinS = -1e9, toutS = 1e9, tinC = -1e9, toutC = 1e9;
            if (abs(da) > 1e-6) {
                float t1 = (-info.w - wa) / da, t2 = (info.w - wa) / da;
                tinS = min(t1, t2);
                toutS = max(t1, t2);
            } else if (abs(wa) > info.w) return false;
            float A = dot(dp, dp), B = dot(wp, dp), C = dot(wp, wp) - info.z * info.z;
            if (A > 1e-9) {
                float disc = B * B - A * C;
                if (disc <= 0.0) return false;
                float sq = sqrt(disc);
                tinC = (-B - sq) / A;
                toutC = (-B + sq) / A;
            } else if (C > 0.0) return false;
            float tin = max(tinS, tinC), tout = min(toutS, toutC);
            if (tin >= tout || tin < -1e-5) return false;
            t = tin;
            if (tinC >= tinS) {
                vec3 q = w + d * t;
                n = normalize(q - a * dot(q, a));
            } else {
                n = da < 0.0 ? a : -a;
            }
            return true;
        }
        if (kind == 3) {
            float t1;
            vec3 n1;
            int count = coneCross(sceneAt(3, k).xyz, sceneAt(2, k).xyz, info.z, info.w, o, d, t, n, t1, n1);
            return count == 2 && t >= -1e-5 && dot(n, d) < 0.0;
        }
        if (kind == 4) {
            ExShape s;
            vec3 lo, ld, ln;
            mat3 R;
            float size;
            exLocal(k, o, d, s, lo, ld, R, size);
            if (!exMeet(s, lo, ld, t, ln)) return false;
            t *= size;
            n = R * ln;
            return true;
        }
        int cnt = int(info.x + 0.5);
        float tin = -1e9, tout = 1e9;
        for (int j = 0; j < MAXP; j++) {
            if (j >= cnt) break;
            vec4 pl = sceneAt(3 + j, k);
            float dj = dot(pl.xyz, d), off = pl.w - dot(pl.xyz, o);
            if (dj < -1e-6) { float tt = off / dj; if (tt > tin) { tin = tt; n = pl.xyz; } }
            else if (dj > 1e-6) tout = min(tout, off / dj);
            else if (off < 0.0) return false;
        }
        t = tin;
        return tin < tout && tin >= -1e-5;
    }
    // the next solid a sight line in the air meets (not `from`): which one, how far, and the face normal there
    bool nextSolid(vec3 o, vec3 d, int from, out int S, out float t, out vec3 n) {
        t = 1e9;
        S = -1;
        n = vec3(0.0, 1.0, 0.0);
        for (int k = 0; k < MAXS; k++) {
            if (k >= materialParams.solidCount) break;
            if (k == from && sceneAt(1, k).y < 3.5) continue;   // (a solid with dents may be met again across a dent)
            vec4 sp = sceneAt(0, k);
            vec3 rel = sp.xyz - o;
            float along = dot(rel, d);
            if (along < -sp.w || dot(rel, rel) - along * along > sp.w * sp.w) continue;
            float tk;
            vec3 nk;
            if (meets(k, o, d, tk, nk) && tk < t) { t = tk; S = k; n = nk; }
        }
        return S >= 0;
    }
    // from a point in or on solid k (world space) along d: distance to its surface and the outward normal there
    float exitWorld(int k, vec3 o, vec3 d, out vec3 n) {
        float t = 1e9;
        n = vec3(0.0, 1.0, 0.0);
        vec4 info = sceneAt(1, k);
        int kind = int(info.y + 0.5);
        if (kind == 1) {
            vec3 w = o - sceneAt(0, k).xyz;
            float b = dot(w, d);
            t = -b + sqrt(max(b * b - (dot(w, w) - info.z * info.z), 0.0));
            n = normalize(w + d * t);
            return max(t, 0.0);
        }
        if (kind == 2) {
            vec3 a = sceneAt(2, k).xyz, w = o - sceneAt(0, k).xyz;
            float wa = dot(w, a), da = dot(d, a);
            vec3 wp = w - a * wa, dp = d - a * da;
            float tS = 1e9, tC = 1e9;
            if (da > 1e-6) tS = (info.w - wa) / da;
            else if (da < -1e-6) tS = (-info.w - wa) / da;
            float A = dot(dp, dp), B = dot(wp, dp), C = dot(wp, wp) - info.z * info.z;
            if (A > 1e-9) tC = (-B + sqrt(max(B * B - A * C, 0.0))) / A;
            if (tC <= tS) {
                vec3 q = w + d * tC;
                n = normalize(q - a * dot(q, a));
                return max(tC, 0.0);
            }
            n = da > 0.0 ? a : -a;
            return max(tS, 0.0);
        }
        if (kind == 3) return coneExit(sceneAt(3, k).xyz, sceneAt(2, k).xyz, info.z, info.w, o, d, n);
        if (kind == 4) {
            ExShape s;
            vec3 lo, ld, ln;
            mat3 R;
            float size;
            exLocal(k, o, d, s, lo, ld, R, size);
            t = exLeave(s, lo, ld, ln) * size;
            n = R * ln;
            return t;
        }
        int cnt = int(info.x + 0.5);
        for (int j = 0; j < MAXP; j++) {
            if (j >= cnt) break;
            vec4 pl = sceneAt(3 + j, k);
            float den = dot(pl.xyz, d);
            if (den > 1e-6) {
                float ti = (pl.w - dot(pl.xyz, o)) / den;
                if (ti < t) { t = ti; n = pl.xyz; }
            }
        }
        return max(t, 0.0);
    }

    // What a sight line that has left the glass at p (Filament world space) along d sees.
    vec3 lookup(vec3 p, vec3 d, float floorY) {
        if (d.y < -1e-4) {
            float t = (floorY - p.y) / d.y;
            if (t >= 0.0) {
                highp vec4 clip = getClipFromWorldMatrix() * vec4(p + d * t, 1.0);
                if (clip.w > 1e-4) {
                    vec2 uv = clamp(clip.xy / clip.w * 0.5 + 0.5, vec2(0.001), vec2(0.999));
                    return textureLod(materialParams_backdrop, uvToRenderTargetUV(uv), 0.0).rgb;
                }
            }
        }
        // the sun itself, when the sight line ends up pointing at it: the flash of a face that catches the sun
        // (sunCos is the cosine of how wide the sun is taken to be; a little wider than the real one reads better)
        float sun = smoothstep(materialParams.sunCos, mix(materialParams.sunCos, 1.0, 0.5), dot(d, materialParams.sunTo));
        return (textureLod(materialParams_env, d, 0.0).rgb * materialParams.envGain + materialParams.sky + materialParams.sunGlint * sun) * getExposure();
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 c = variable_boxC.xyz;
        float e = variable_boxC.w;
        vec3 ax = normalize(variable_boxX.xyz);
        vec3 ay = normalize(variable_boxY.xyz - ax * dot(ax, variable_boxY.xyz));
        mat3 R = mat3(ax, ay, cross(ax, ay));                 // solid -> world (turn only)

        vec3 P = getWorldPosition();
        vec3 shift = getUserWorldPosition() - P;                                     // Filament's world space is the user's, moved
        float floorY = materialParams.floorY - shift.y;                              // the floor in Filament's world space
        vec3 view = normalize(P - getWorldCameraPosition());
        vec3 pl = ((P - c) * R) / e;
        vec3 dl = view * R;
        exFlat = normalize(cross(dFdx(pl), dFdy(pl)));
        if (dot(exFlat, dl) > 0.0) exFlat = -exFlat;
        vec3 nl = faceAt(pl);
        // A round solid is drawn as a many-sided mesh; the pixel is a hair inside the true surface. Put it on the
        // surface, or the flat sides of the mesh show in what is seen through the glass.
        if (materialParams.kind == 1) {
            pl = normalize(pl) * materialParams.dims.x;
        } else if (materialParams.kind == 2 && abs(nl.y) < 0.5) {
            pl.xz *= materialParams.dims.x / max(length(pl.xz), 1e-6);
        } else if (materialParams.kind == 3 && nl.y > -0.5) {
            float up = clamp(pl.y + 0.5 * materialParams.dims.y, 0.0, materialParams.dims.y);
            pl.xz *= materialParams.dims.x * (1.0 - up / materialParams.dims.y) / max(length(pl.xz), 1e-6);
        } else if (materialParams.kind == 4) {
            pl = exSnap;
        }
        float ci = clamp(-dot(dl, nl), 0.0, 1.0);

        float F = fresnel(ci, 1.0, materialParams.ior);
        vec3 mirrored = lookup(P, R * reflect(dl, nl), floorY);

        // One sight line, followed once with the middle of the spectrum: through this solid, then on through
        // whatever other glass it meets. The colours are only told apart where it finally leaves the glass
        // (the last bend is done once per colour). Plausible, not exact: following every colour all the way
        // costs nine times as much and looks the same.
        float n0 = materialParams.ior;
        vec3 rd = refract(dl, nl, 1.0 / n0), ro = pl;
        float path = 0.0, through = 1.0;
        vec3 lastIn = vec3(0.0), lastN = vec3(0.0, 1.0, 0.0), wo = vec3(0.0);
        bool outOk = false;
        for (int b = 0; b < BOUNCES; b++) {
            vec3 fn;
            float t = exitAt(ro, rd, fn);
            ro += rd * t;
            path += t * e;
            vec3 o1 = refract(rd, -fn, n0);
            if (dot(o1, o1) > 0.0) {
                lastIn = R * rd;
                lastN = R * fn;
                wo = c + R * (ro * e);
                outOk = true;
                break;
            }
            rd = reflect(rd, fn);
        }
        if (outOk && materialParams.solidCount > 1) {
            // the scene table is in the user's world space
            int cur = materialParams.self;
            for (int seg = 1; seg < SEGS; seg++) {
                vec3 wd = refract(lastIn, -lastN, n0);
                int nx;
                float tn;
                vec3 nn;
                if (!nextSolid(wo + shift, wd, cur, nx, tn, nn)) break;
                through *= 1.0 - fresnel(dot(lastIn, lastN), n0, 1.0);
                vec3 q = wo + shift + wd * tn;
                through *= 1.0 - fresnel(clamp(-dot(wd, nn), 0.0, 1.0), 1.0, n0);
                wd = refract(wd, nn, 1.0 / n0);
                cur = nx;
                bool left = false;
                for (int b = 0; b < BOUNCES; b++) {
                    vec3 fn;
                    float t = exitWorld(cur, q, wd, fn);
                    q += wd * t;
                    path += t;
                    vec3 o2 = refract(wd, -fn, n0);
                    if (dot(o2, o2) > 0.0) {
                        lastIn = wd;
                        lastN = fn;
                        wo = q - shift;
                        left = true;
                        break;
                    }
                    wd = reflect(wd, fn);
                }
                if (!left) { outOk = false; break; }
            }
        }
        vec3 acc = vec3(0.0), wsum = vec3(0.0);
        // a sight line still caught inside after the allowed mirrors would get out a little later anyway:
        // let it look where it is heading, instead of leaving a black sliver
        vec3 caught = outOk ? vec3(0.0) : lookup(c + R * (ro * e), R * rd, floorY) * exp(-materialParams.absorption * path);
        for (int i = 0; i < WAVES; i++) {
            float nm = mix(430.0, 670.0, (float(i) + 0.5) / float(WAVES));
            vec3 w = max(waveRgb(nm), vec3(0.0));
            wsum += w;
            if (!outOk) { acc += w * caught; continue; }
            float n = n0 + (iorAt(nm) - n0) * materialParams.spread;
            vec3 outDir = refract(lastIn, -lastN, n);
            // a colour the glass would not let out here leaves with the middle of the spectrum instead: every
            // colour must come out somewhere, or the glass turns yellow
            if (dot(outDir, outDir) <= 0.0) outDir = refract(lastIn, -lastN, n0);
            acc += w * lookup(wo, outDir, floorY);
        }
        if (outOk) acc *= exp(-materialParams.absorption * path) * through * (1.0 - fresnel(dot(lastIn, lastN), n0, 1.0));
        vec3 transmitted = acc / max(wsum, vec3(1e-5));
        material.baseColor = vec4(transmitted * (1.0 - F) + mirrored * F, 1.0);
    }
}
