// Draws the caustic as triangles. One instance = one light-view cell (two triangles); one draw vertex
// = (band, corner). Each vertex looks up the three refracted corners of its triangle, so the triangle
// is rebuilt identically at all three vertices and brightness = oldArea / newArea (energy conserved).
// mode 0: caustic, 6 bands, rgb = CIE XYZ. mode 1: footprint of the glass on the receiver, r = 1.
// Filament caps the instance count of one renderable at 32767, so the cells are split into chunks of renderables,
// each starting at instanceBase.
// The camera sits at the origin looking down -z with an ortho box of [-1,1]^2, so receiver uv maps
// straight to clip space and nothing depends on Filament's camera-relative world origin.
material {
    name : tri,
    shadingModel : unlit,
    culling : none,
    blending : add,
    depthWrite : false,
    depthCulling : false,
    variables : [ col ],
    parameters : [
        { type : sampler2d, name : hitTex, precision : high, format : float, filter : nearest },
        { type : float3, name : origin },
        { type : float3, name : dir },
        { type : float3, name : right },
        { type : float3, name : up },
        { type : float,  name : extent },
        { type : float,  name : captureSize },
        { type : float3, name : rOrigin },
        { type : float3, name : rNormal },
        { type : float3, name : rTangent },
        { type : float3, name : rBitangent },
        { type : float,  name : rSize },
        { type : float,  name : intensity },
        { type : float,  name : mode },
        { type : float,  name : ratioCap },
        { type : float,  name : instanceBase },
        { type : float,  name : pad }
    ]
}

vertex {
    const vec3 XYZ[6] = vec3[6](
        vec3(0.03671527, 0.01357357, 0.00000000), vec3(0.30218842, 0.14160332, 0.00008598),
        vec3(0.36062779, 0.40239216, 0.00124922), vec3(0.07092146, 0.36745709, 0.04500246),
        vec3(0.08806719, 0.06954351, 0.58510595), vec3(0.09195043, 0.00543034, 0.45738513));

    vec3 hitAt(float px, float py, float band) {
        float n = materialParams.captureSize;
        return textureLod(materialParams_hitTex, (vec2(px * 7.0 + band, py) + 0.5) / vec2(7.0 * n, n), 0.0).xyz;
    }
    vec2 oldUv(float px, float py) {
        float n = materialParams.captureSize;
        vec2 uv = (vec2(px, py) + 0.5) / n;
        vec3 o = materialParams.origin
               + materialParams.right * ((uv.x * 2.0 - 1.0) * materialParams.extent)
               + materialParams.up    * ((1.0 - uv.y * 2.0) * materialParams.extent);
        float t = dot(materialParams.rOrigin - o, materialParams.rNormal) / dot(materialParams.dir, materialParams.rNormal);
        vec3 rel = o + materialParams.dir * t - materialParams.rOrigin;
        return vec2(dot(rel, materialParams.rTangent), dot(rel, materialParams.rBitangent)) / materialParams.rSize + 0.5;
    }
    float triArea(vec2 a, vec2 b, vec2 c) {
        vec2 e1 = b - a, e2 = c - a;
        return 0.5 * abs(e1.x * e2.y - e1.y * e2.x);
    }
    void materialVertex(inout MaterialVertexInputs material) {
        float n = materialParams.captureSize;
        float cells = n - 1.0;
        int vi = getVertexIndex();
        int corner = vi - (vi / 6) * 6;
        float band = materialParams.mode > 0.5 ? 6.0 : float(vi / 6);
        #if defined(TARGET_METAL_ENVIRONMENT) || defined(TARGET_VULKAN_ENVIRONMENT) || defined(TARGET_WEBGPU_ENVIRONMENT)
        int inst = gl_InstanceIndex + int(materialParams.instanceBase);
#else
        int inst = gl_InstanceID + int(materialParams.instanceBase);
#endif
        float cy = float(inst / int(cells));
        float cx = float(inst - int(cy) * int(cells));
        int tri = corner / 3;
        int local = corner - tri * 3;
        float ox0 = tri == 0 ? 0.0 : 1.0, oy0 = 0.0;
        float ox1 = 1.0,                 oy1 = tri == 0 ? 0.0 : 1.0;
        float ox2 = 0.0,                 oy2 = 1.0;
        vec3 h0 = hitAt(cx + ox0, cy + oy0, band);
        vec3 h1 = hitAt(cx + ox1, cy + oy1, band);
        vec3 h2 = hitAt(cx + ox2, cy + oy2, band);
        vec2 o0 = oldUv(cx + ox0, cy + oy0);
        vec2 o1 = oldUv(cx + ox1, cy + oy1);
        vec2 o2 = oldUv(cx + ox2, cy + oy2);
        vec2 n0 = h0.xy, n1 = h1.xy, n2 = h2.xy;
        bool ok;
        vec4 col;
        vec2 uv;
        if (materialParams.mode > 0.5) {
            ok = h0.x > 0.5 && h1.x > 0.5 && h2.x > 0.5;
            uv = local == 0 ? o0 : (local == 1 ? o1 : o2);
            col = vec4(1.0, 0.0, 0.0, 1.0);
        } else {
            ok = h0.z > 0.0 && h1.z > 0.0 && h2.z > 0.0;
            uv = local == 0 ? n0 : (local == 1 ? n1 : n2);
            // Grow the triangle by `pad` (uv units) away from its centroid, and divide the light by the grown area:
            // energy is unchanged, but a sliver thinner than a texel can no longer slip between pixel centres.
            vec2 cen = (n0 + n1 + n2) / 3.0;
            vec2 g0 = n0 - cen, g1 = n1 - cen, g2 = n2 - cen;
            float l0 = length(g0), l1 = length(g1), l2 = length(g2);
            vec2 e0 = n0 + (l0 > 1e-9 ? g0 / l0 : vec2(0.0)) * materialParams.pad;
            vec2 e1 = n1 + (l1 > 1e-9 ? g1 / l1 : vec2(0.0)) * materialParams.pad;
            vec2 e2 = n2 + (l2 > 1e-9 ? g2 / l2 : vec2(0.0)) * materialParams.pad;
            n0 = e0; n1 = e1; n2 = e2;
            uv = local == 0 ? n0 : (local == 1 ? n1 : n2);
            float areaNew = triArea(n0, n1, n2);
            float areaOld = triArea(o0, o1, o2);
            float ratio = min(areaOld / max(areaNew, 1e-10), materialParams.ratioCap);
            float trans = (h0.z + h1.z + h2.z) / 3.0;
            col = vec4(XYZ[int(band)] * (materialParams.intensity * trans * ratio), 1.0);
        }
        material.col = col;
        material.worldPosition = ok ? vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, -1.0, 1.0) : vec4(8.0, 8.0, -1.0, 1.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = variable_col;
    }
}
