// For every light-view texel and wavelength band: where does the refracted ray land on the receiver?
// Texture rows run top to bottom (row 0 = top, as Metal stores render targets); v = 0 is the +up side of the light view.
// Output texel (px*7+band, py) = (newU, newV, transmission). Transmission 0 = no exit found.
// band 6 = entry marker (x = 1 when the texel hits the glass at all), used for the footprint.
// Ray-marching against the back-face map is derived from visgl/luma.gl (MIT) findExitSurface.
material {
    name : hits,
    shadingModel : unlit,
    culling : none,
    blending : opaque,
    depthWrite : false,
    depthCulling : false,
    requires : [ uv0 ],
    parameters : [
        { type : sampler2d, name : frontFace, precision : high, format : float, filter : nearest },
        { type : sampler2d, name : backFace,  precision : high, format : float, filter : nearest },
        { type : float3, name : origin },
        { type : float3, name : dir },
        { type : float3, name : right },
        { type : float3, name : up },
        { type : float,  name : extent },
        { type : float,  name : captureSize },
        { type : float,  name : ior },
        { type : float,  name : dispersion },
        { type : float3, name : absorption },
        { type : float3, name : rOrigin },
        { type : float3, name : rNormal },
        { type : float3, name : rTangent },
        { type : float3, name : rBitangent },
        { type : float,  name : rSize },
        { type : float3, name : boxCenter },
        { type : float3, name : boxAxis0 },
        { type : float3, name : boxAxis1 },
        { type : float3, name : boxAxis2 },
        { type : float,  name : boxHalf }
    ]
}

fragment {
    const float WL[6] = float[6](664.46, 618.64, 574.60, 528.33, 468.28, 434.72);
    const vec3 ABS_W[6] = vec3[6](
        vec3(1.0, 0.0, 0.0), vec3(0.78, 0.22, 0.0), vec3(0.28, 0.72, 0.0),
        vec3(0.0, 0.82, 0.18), vec3(0.0, 0.28, 0.72), vec3(0.12, 0.0, 0.88));

    vec3 octDecode(vec2 e) {
        vec2 f = e * 2.0 - 1.0;
        vec3 n = vec3(f.xy, 1.0 - abs(f.x) - abs(f.y));
        if (n.z < 0.0) n.xy = (vec2(1.0) - abs(n.yx)) * sign(n.xy);
        return normalize(n);
    }
    vec3 texelRayOrigin(vec2 uv) {
        return materialParams.origin
             + materialParams.right * ((uv.x * 2.0 - 1.0) * materialParams.extent)
             + materialParams.up    * ((1.0 - uv.y * 2.0) * materialParams.extent);
    }
    vec2 receiverUv(vec3 p) {
        vec3 o = p - materialParams.rOrigin;
        return vec2(dot(o, materialParams.rTangent), dot(o, materialParams.rBitangent)) / materialParams.rSize + 0.5;
    }
    // Opaque oriented box (boxHalf <= 0: none). True when the segment p + d*t, 0 < t < tmax, passes through it.
    bool hitsBox(vec3 p, vec3 d, float tmax) {
        float h = materialParams.boxHalf;
        if (h <= 0.0) return false;
        vec3 o = p - materialParams.boxCenter;
        vec3 lo = vec3(dot(o, materialParams.boxAxis0), dot(o, materialParams.boxAxis1), dot(o, materialParams.boxAxis2));
        vec3 ld = vec3(dot(d, materialParams.boxAxis0), dot(d, materialParams.boxAxis1), dot(d, materialParams.boxAxis2));
        vec3 safe = mix(ld, vec3(1e-9), vec3(lessThan(abs(ld), vec3(1e-9))));
        vec3 t1 = (-h - lo) / safe;
        vec3 t2 = (h - lo) / safe;
        vec3 tn3 = min(t1, t2), tf3 = max(t1, t2);
        float tn = max(max(tn3.x, tn3.y), tn3.z);
        float tf = min(min(tf3.x, tf3.y), tf3.z);
        return tn <= tf && tf > 0.0 && tn < tmax;
    }
    // true when p lies at or behind the nearest back face seen from the light at p's texel
    bool behindBack(vec3 p) {
        float n = materialParams.captureSize;
        vec3 rel = p - materialParams.origin;
        vec2 cuv = vec2(dot(rel, materialParams.right), -dot(rel, materialParams.up)) / materialParams.extent * 0.5 + 0.5;
        if (any(lessThan(cuv, vec2(0.0))) || any(greaterThan(cuv, vec2(1.0)))) return false;
        vec2 cpuv = (clamp(floor(cuv * n), vec2(0.0), vec2(n - 1.0)) + 0.5) / n;
        vec4 b = textureLod(materialParams_backFace, cpuv, 0.0);
        return b.b > 0.0 && dot(rel, materialParams.dir) + 8.0 >= b.b - 0.0015;
    }
    vec3 captureHit(vec4 t, vec2 uv) { return texelRayOrigin(uv) + materialParams.dir * (t.b - 8.0); }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        float n = materialParams.captureSize;
        vec2 pix = floor(getUV0() * vec2(7.0 * n, n));
        float px = floor(pix.x / 7.0);
        float band = pix.x - px * 7.0;
        vec2 uv = (vec2(px, pix.y) + 0.5) / n;
        vec4 front = textureLod(materialParams_frontFace, uv, 0.0);
        vec4 outv = vec4(0.0);
        if (front.b > 0.0 && !hitsBox(captureHit(front, uv), -materialParams.dir, 20.0)) {
            if (band > 5.5) {
                outv = vec4(1.0, 0.0, 0.0, 1.0);
            } else {
                vec3 dir = materialParams.dir;
                vec3 entry = captureHit(front, uv);
                vec3 N = octDecode(front.rg);
                if (dot(dir, N) > 0.0) N = -N;
                float lam = WL[int(band)];
                float r = lam > 0.0 ? 550.0 / lam : 1.0;
                float eta = max(materialParams.ior + materialParams.dispersion * (r * r - 1.0), 1.0001);
                vec3 inside = refract(dir, N, 1.0 / eta);
                if (dot(inside, inside) > 1e-6) {
                    inside = normalize(inside);
                    vec4 sourceBack = textureLod(materialParams_backFace, uv, 0.0);
                    bool found = false;
                    vec3 exitPos = vec3(0.0);
                    vec3 exitN = vec3(0.0);
                    if (sourceBack.b > 0.0) {
                        // March the refracted ray through the capture volume until it is behind the back-face map,
                        // then bisect the bracket. The reach is the object size, not a multiple of the straight
                        // thickness: grazing rays bend hard and their chord is >2x the vertical thickness.
                        float reach = materialParams.extent * 3.0;
                        float lo = 0.0, hi = -1.0;
                        for (int s = 1; s <= 24; s++) {
                            float t = reach * float(s) / 24.0;
                            if (behindBack(entry + inside * t)) { hi = t; break; }
                            lo = t;
                        }
                        if (hi > 0.0) {
                            for (int k = 0; k < 6; k++) {
                                float mid = 0.5 * (lo + hi);
                                if (behindBack(entry + inside * mid)) hi = mid; else lo = mid;
                            }
                            vec3 rel = entry + inside * hi - materialParams.origin;
                            vec2 cuv = vec2(dot(rel, materialParams.right), -dot(rel, materialParams.up)) / materialParams.extent * 0.5 + 0.5;
                            vec2 cpuv = (clamp(floor(cuv * n), vec2(0.0), vec2(n - 1.0)) + 0.5) / n;
                            vec4 bk = textureLod(materialParams_backFace, cpuv, 0.0);
                            found = true;
                            exitPos = captureHit(bk, cpuv);
                            exitN = octDecode(bk.rg);
                        }
                    }
                    if (found) {
                        if (dot(inside, exitN) < 0.0) exitN = -exitN;
                        vec3 outd = refract(inside, -exitN, eta);
                        float den = dot(outd, materialParams.rNormal);
                        if (dot(outd, outd) > 1e-6 && abs(den) > 1e-5) {
                            float t = dot(materialParams.rOrigin - exitPos, materialParams.rNormal) / den;
                            if (t > 0.0 && !hitsBox(exitPos, outd, t)) {
                                vec2 newUv = receiverUv(exitPos + outd * t);
                                float k = max(dot(materialParams.absorption, ABS_W[int(band)]), 0.0);
                                float trans = max(exp(-k * distance(entry, exitPos)), 1e-6);
                                outv = vec4(newUv, trans, 1.0);
                            }
                        }
                    }
                }
            }
        }
        material.baseColor = outv;
    }
}
