// A floor that receives, with nothing uploaded from the CPU:
//   light  - the GPU light map from caustic_tri.h (rgb = CIE XYZ, 1.0 = unrefracted sunlight), mapped by world x/z
//   mirror - the scene seen by the camera mirrored in the floor (planar reflection), looked up by screen position
material {
    name : stage_floor,
    shadingModel : lit,
    culling : none,
    doubleSided : true,
    postLightingBlending : add,
    parameters : [
        { type : float4, name : color },
        { type : float, name : roughness },
        { type : float, name : lightScale },
        { type : float, name : lightBlur },
        { type : float, name : lightSize },
        { type : float, name : mirrorStrength },
        { type : sampler2d, name : light, format : float },
        { type : sampler2d, name : mirror, precision : medium }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = materialParams.color;
        material.roughness = materialParams.roughness;
        material.metallic = 0.0;
        material.reflectance = 0.35;
        vec2 uv = getUserWorldPosition().xz / materialParams.lightSize + 0.5;
        vec3 xyz = vec3(0.0);
        float wsum = 0.0;
        for (int j = -2; j <= 2; j++) {
            for (int i = -2; i <= 2; i++) {
                float w = exp(-float(i * i + j * j) * 0.22);
                xyz += w * max(texture(materialParams_light, uv + vec2(float(i), float(j)) * materialParams.lightBlur).rgb, vec3(0.0));
                wsum += w;
            }
        }
        xyz /= wsum;
        // W3C D65 XYZ -> linear sRGB, as in luma.gl
        vec3 rgb = max(vec3(
             3.2409699 * xyz.x - 1.5373832 * xyz.y - 0.4986108 * xyz.z,
            -0.9692436 * xyz.x + 1.8759675 * xyz.y + 0.0415551 * xyz.z,
             0.0556301 * xyz.x - 0.2039770 * xyz.y + 1.0569715 * xyz.z), vec3(0.0));
        material.emissive = vec4(min(rgb * materialParams.lightScale, vec3(60000.0)), 1.0);
        // never touch the mirror texture while it is unused: an unrendered target can hold NaN
        if (materialParams.mirrorStrength > 0.0) {
            vec3 refl = textureLod(materialParams_mirror, uvToRenderTargetUV(getNormalizedViewportCoord().xy), 0.0).rgb;
            float grazing = pow(1.0 - clamp(dot(getWorldNormalVector(), getWorldViewVector()), 0.0, 1.0), 3.0);
            material.postLightingColor = vec4(refl * materialParams.mirrorStrength * mix(0.35, 1.0, grazing), 1.0);
        } else {
            material.postLightingColor = vec4(0.0, 0.0, 0.0, 1.0);
        }
    }
}
