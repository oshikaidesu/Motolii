// Step one of the light of the flat-faced solids (see "Flat faces on the GPU" in beam_glass.h): for every piece of
// every face of every such solid, and every colour step, where the light of that piece goes. It is beam::route /
// beam::send of beam_glass.h (one ray from the middle of the piece: bent in, mirrored inside while the glass
// cannot let it out, bent out, on through any other solid it meets, down to the floor), worked out here instead
// of on the CPU. Three texels per piece across (three of its corners carried along that way: x, z where the corner
// lands, the distance it flew; in the first of the three how bright the piece is, 0 if it has no light, and in
// the second a number that tells which way it went: the same way gives the same number), one line per
// (solid, step) down; the last step of each solid is the white light mirrored off the outside.
// flat_light.mat draws the pieces from this. Added onto a cleared target, so that all four numbers arrive as they are.
material {
    name : flat_walk,
    shadingModel : unlit,
    vertexDomain : device,
    blending : add,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    flipUV : false,
    parameters : [
        { type : sampler2d, name : pose, precision : high, format : float },    // per solid (column): axis x + size; axis y + shape line (-1: not flat); axis z + pieces; place
        { type : sampler2d, name : pieces, precision : high, format : float },  // beam::FlatShape::table, one line per shape
        { type : sampler2d, name : scene, precision : high, format : float },   // every solid's faces in world space (as glass_solid.mat)
        { type : int,    name : solidCount },
        { type : float4[64], name : spheres },                                  // every solid's bounding ball (as texel 0 of `scene`)
        { type : float4[16], name : steps },                                    // rgb, index of refraction
        { type : float,  name : stepCount },                                    // colour steps + 1
        { type : float3, name : sunDir },                                       // the way the sunlight travels
        { type : float,  name : floorY }
    ]
}

fragment {
    // unpolarised Fresnel reflectance, n1 -> n2, 1 on total reflection
    float fresnel(float ci, float n1, float n2) {
        float s2 = (n1 / n2) * (n1 / n2) * (1.0 - ci * ci);
        if (s2 >= 1.0) return 1.0;
        float ct = sqrt(1.0 - s2);
        float rs = (n1 * ci - n2 * ct) / (n1 * ci + n2 * ct);
        float rp = (n1 * ct - n2 * ci) / (n1 * ct + n2 * ci);
        return 0.5 * (rs * rs + rp * rp);
    }

    const int MAXP = 40;

    // Every place a line o + t d crosses a cone (c: middle of the base, a: axis towards the tip, r, h), side or
    // base: how far and the outward normal there, nearest first. Returns how many (0 to 2). As beam::cone_crossings.
    int coneCross(vec3 c, vec3 a, float r, float h, vec3 o, vec3 d, out float t0, out vec3 n0, out float t1, out vec3 n1) {
        t0 = 0.0; t1 = 0.0;
        n0 = a; n1 = a;
        vec3 w = o - c;
        float k = r / h, y0 = dot(w, a), da = dot(d, a);
        vec3 wp = w - a * y0, dp = d - a * da;
        float A = dot(dp, dp) - k * k * da * da, B = dot(wp, dp) + k * da * (r - k * y0), C = dot(wp, wp) - (r - k * y0) * (r - k * y0);
        float root0 = 0.0, root1 = 0.0;
        int roots = 0;
        if (abs(A) > 1e-7) {
            float disc = B * B - A * C;
            if (disc > 0.0) {
                float sq = sqrt(disc);
                root0 = (-B - sq) / A;
                root1 = (-B + sq) / A;
                roots = 2;
            }
        } else if (abs(B) > 1e-7) {
            root0 = -C / (2.0 * B);
            roots = 1;
        }
        float slope = inversesqrt(1.0 + k * k);
        int count = 0;
        for (int i = 0; i < 2; i++) {
            if (i >= roots) break;
            float tt = i == 0 ? root0 : root1;
            float y = y0 + tt * da;
            if (y < 0.0 || y > h) continue;
            vec3 q = wp + dp * tt;
            float ql = length(q);
            vec3 nn = ql > 1e-6 * r ? (q / ql + a * k) * slope : a;
            if (count == 0) { t0 = tt; n0 = nn; } else { t1 = tt; n1 = nn; }
            count++;
        }
        if (abs(da) > 1e-7 && count < 2) {
            float tb = -y0 / da;
            vec3 q = wp + dp * tb;
            if (dot(q, q) <= r * r) {
                if (count == 0) { t0 = tb; n0 = -a; } else { t1 = tb; n1 = -a; }
                count++;
            }
        }
        if (count == 2 && t1 < t0) {
            float ts = t0; t0 = t1; t1 = ts;
            vec3 ns = n0; n0 = n1; n1 = ns;
        }
        return count;
    }
    // from a point in or on the cone along d: distance to its surface and the outward normal there
    float coneExit(vec3 c, vec3 a, float r, float h, vec3 o, vec3 d, out vec3 n) {
        float t0, t1;
        vec3 n0, n1;
        int count = coneCross(c, a, r, h, o, d, t0, n0, t1, n1);
        n = a;
        if (count >= 1 && t0 > 1e-5 * r && dot(n0, d) > 0.0) { n = n0; return t0; }
        if (count >= 2 && t1 > 1e-5 * r && dot(n1, d) > 0.0) { n = n1; return t1; }
        // nothing found (a sight line along the surface): leave where it stands
        n = normalize(d);
        return 0.0;
    }

    const int MAXS = 64;
    vec4 sceneAt(int x, int row) { return texelFetch(materialParams_scene, ivec2(x, row), 0); }
    // does a sight line in the air meet solid k? how far, and the face normal there
    bool meets(int k, vec3 o, vec3 d, out float t, out vec3 n) {
        vec4 info = sceneAt(1, k);
        int kind = int(info.y + 0.5);
        n = vec3(0.0, 1.0, 0.0);
        t = 0.0;
        if (kind == 1) {
            vec3 w = o - sceneAt(0, k).xyz;
            float b = dot(w, d), disc = b * b - (dot(w, w) - info.z * info.z);
            if (disc <= 0.0) return false;
            t = -b - sqrt(disc);
            if (t < -1e-5) return false;
            n = normalize(w + d * t);
            return true;
        }
        if (kind == 2) {
            vec3 a = sceneAt(2, k).xyz, w = o - sceneAt(0, k).xyz;
            float wa = dot(w, a), da = dot(d, a);
            vec3 wp = w - a * wa, dp = d - a * da;
            float tinS = -1e9, toutS = 1e9, tinC = -1e9, toutC = 1e9;
            if (abs(da) > 1e-6) {
                float t1 = (-info.w - wa) / da, t2 = (info.w - wa) / da;
                tinS = min(t1, t2);
                toutS = max(t1, t2);
            } else if (abs(wa) > info.w) return false;
            float A = dot(dp, dp), B = dot(wp, dp), C = dot(wp, wp) - info.z * info.z;
            if (A > 1e-9) {
                float disc = B * B - A * C;
                if (disc <= 0.0) return false;
                float sq = sqrt(disc);
                tinC = (-B - sq) / A;
                toutC = (-B + sq) / A;
            } else if (C > 0.0) return false;
            float tin = max(tinS, tinC), tout = min(toutS, toutC);
            if (tin >= tout || tin < -1e-5) return false;
            t = tin;
            if (tinC >= tinS) {
                vec3 q = w + d * t;
                n = normalize(q - a * dot(q, a));
            } else {
                n = da < 0.0 ? a : -a;
            }
            return true;
        }
        if (kind == 3) {
            float t1;
            vec3 n1;
            int count = coneCross(sceneAt(3, k).xyz, sceneAt(2, k).xyz, info.z, info.w, o, d, t, n, t1, n1);
            return count == 2 && t >= -1e-5 && dot(n, d) < 0.0;
        }
        int cnt = int(info.x + 0.5);
        float tin = -1e9, tout = 1e9;
        for (int j = 0; j < MAXP; j++) {
            if (j >= cnt) break;
            vec4 pl = sceneAt(3 + j, k);
            float dj = dot(pl.xyz, d), off = pl.w - dot(pl.xyz, o);
            if (dj < -1e-6) { float tt = off / dj; if (tt > tin) { tin = tt; n = pl.xyz; } }
            else if (dj > 1e-6) tout = min(tout, off / dj);
            else if (off < 0.0) return false;
        }
        t = tin;
        return tin < tout && tin >= -1e-5;
    }
    // the next solid a sight line in the air meets (not `from`): which one, how far, and the face normal there
    bool nextSolid(vec3 o, vec3 d, int from, out int S, out float t, out vec3 n) {
        t = 1e9;
        S = -1;
        n = vec3(0.0, 1.0, 0.0);
        for (int k = 0; k < MAXS; k++) {
            if (k >= materialParams.solidCount) break;
            if (k == from) continue;
            vec4 sp = materialParams.spheres[k];   // (the same numbers as texel 0 of the table, without a lookup per solid per pixel)
            vec3 rel = sp.xyz - o;
            float along = dot(rel, d);
            if (along < -sp.w || dot(rel, rel) - along * along > sp.w * sp.w) continue;
            float tk;
            vec3 nk;
            if (meets(k, o, d, tk, nk) && tk < t) { t = tk; S = k; n = nk; }
        }
        return S >= 0;
    }
    // from a point in or on solid k (world space) along d: distance to its surface and the outward normal there
    float exitWorld(int k, vec3 o, vec3 d, out vec3 n) {
        float t = 1e9;
        n = vec3(0.0, 1.0, 0.0);
        vec4 info = sceneAt(1, k);
        int kind = int(info.y + 0.5);
        if (kind == 1) {
            vec3 w = o - sceneAt(0, k).xyz;
            float b = dot(w, d);
            t = -b + sqrt(max(b * b - (dot(w, w) - info.z * info.z), 0.0));
            n = normalize(w + d * t);
            return max(t, 0.0);
        }
        if (kind == 2) {
            vec3 a = sceneAt(2, k).xyz, w = o - sceneAt(0, k).xyz;
            float wa = dot(w, a), da = dot(d, a);
            vec3 wp = w - a * wa, dp = d - a * da;
            float tS = 1e9, tC = 1e9;
            if (da > 1e-6) tS = (info.w - wa) / da;
            else if (da < -1e-6) tS = (-info.w - wa) / da;
            float A = dot(dp, dp), B = dot(wp, dp), C = dot(wp, wp) - info.z * info.z;
            if (A > 1e-9) tC = (-B + sqrt(max(B * B - A * C, 0.0))) / A;
            if (tC <= tS) {
                vec3 q = w + d * tC;
                n = normalize(q - a * dot(q, a));
                return max(tC, 0.0);
            }
            n = da > 0.0 ? a : -a;
            return max(tS, 0.0);
        }
        if (kind == 3) return coneExit(sceneAt(3, k).xyz, sceneAt(2, k).xyz, info.z, info.w, o, d, n);
        int cnt = int(info.x + 0.5);
        for (int j = 0; j < MAXP; j++) {
            if (j >= cnt) break;
            vec4 pl = sceneAt(3 + j, k);
            float den = dot(pl.xyz, d);
            if (den > 1e-6) {
                float ti = (pl.w - dot(pl.xyz, o)) / den;
                if (ti < t) { t = ti; n = pl.xyz; }
            }
        }
        return max(t, 0.0);
    }


    // Light entering solid A at `start` (outward normal nStart): its way to the floor. `ref` is carried along that
    // way (in: a point of the same flat piece; out: x, distance flown, z where it lands). Returns how bright the
    // piece lands, as a multiple of the sun; 0: no light.
    float route(int A, vec3 start, vec3 nStart, float n, bool mirrored, inout vec3 ref, out float way) {
        way = 1.0;
        vec3 L = materialParams.sunDir;
        vec3 p = start, d = L;
        float ci = -dot(nStart, d);
        if (!(ci > 1e-6)) return 0.0;
        if (materialParams.solidCount > 1) {
            // does another solid take the sun before it gets here?
            int S0;
            float t0;
            vec3 n0;
            if (nextSolid(start - L * 100.0, L, -1, S0, t0, n0) && (S0 != A || abs(t0 - 100.0) > 2e-3)) return 0.0;
        }
        float irr = ci, cosOn = ci;
        int S = A, entries = 0;
        vec3 ng = nStart;
        bool outside = true;
        for (int guard = 0; guard < 8; guard++) {
            if (outside) {
                ci = -dot(ng, d);
                float Rf = fresnel(ci, 1.0, n);
                if (mirrored && guard == 0) {
                    irr *= Rf;
                    d = d + ng * (2.0 * ci);
                    cosOn = ci;
                } else {
                    if (entries >= 4) return 0.0;
                    entries++;
                    irr *= 1.0 - Rf;
                    d = refract(d, ng, 1.0 / n);
                    cosOn = abs(dot(ng, d));
                    bool left = false;
                    for (int b = 0; b < 5; b++) {
                        vec3 nj;
                        float tb = exitWorld(S, p, d, nj);
                        if (tb > 1e8) return 0.0;
                        p += d * tb;
                        float db = dot(nj, d);
                        if (!(db > 1e-6)) return 0.0;
                        ref += d * (dot(nj, p - ref) / db);
                        way = way * 1.37 + dot(nj, vec3(1.0, 2.0, 4.0)) + float(S);
                        irr *= db / cosOn;
                        float Ri = fresnel(db, n, 1.0);
                        if (Ri < 1.0) {
                            irr *= 1.0 - Ri;
                            d = refract(d, -nj, n);
                            cosOn = abs(dot(nj, d));
                            left = true;
                            break;
                        }
                        d = d - nj * (2.0 * db);
                        cosOn = db;
                    }
                    if (!left) return 0.0;
                }
                outside = false;
            }
            int S2;
            float t2;
            vec3 n2;
            if (materialParams.solidCount > 1 && nextSolid(p, d, S, S2, t2, n2)) {
                p += d * t2;
                float dn = dot(n2, d);
                if (!(dn < -1e-6)) return 0.0;
                ref += d * (dot(n2, p - ref) / dn);
                way = way * 1.37 + dot(n2, vec3(1.0, 2.0, 4.0)) + float(S2) + 0.5;
                irr *= -dn / cosOn;
                S = S2;
                ng = n2;
                outside = true;
                continue;
            }
            if (d.y > -1e-6) return 0.0;
            float tf = max(0.0, (materialParams.floorY - ref.y) / d.y);
            ref = vec3(ref.x + d.x * tf, tf, ref.z + d.z * tf);
            return irr * (-d.y) / cosOn;
        }
        return 0.0;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        ivec2 px = ivec2(gl_FragCoord.xy);
        int piece = px.x / 3;
        int part = px.x - piece * 3;
        int stepsAll = int(materialParams.stepCount);
        int solid = px.y / stepsAll;
        int stepAt = px.y - solid * stepsAll;
        vec4 result = vec4(0.0);
        if (solid < materialParams.solidCount) {
            vec4 ax = texelFetch(materialParams_pose, ivec2(solid, 0), 0);
            vec4 ay = texelFetch(materialParams_pose, ivec2(solid, 1), 0);
            vec4 az = texelFetch(materialParams_pose, ivec2(solid, 2), 0);
            vec3 at = texelFetch(materialParams_pose, ivec2(solid, 3), 0).xyz;
            int shape = int(floor(ay.w + 0.5));
            if (shape >= 0 && piece < int(az.w + 0.5)) {
                vec3 mid = texelFetch(materialParams_pieces, ivec2(piece * 5, shape), 0).xyz;
                vec3 nf = texelFetch(materialParams_pieces, ivec2(piece * 5 + 1, shape), 0).xyz;
                vec3 corner = texelFetch(materialParams_pieces, ivec2(piece * 5 + 2 + part, shape), 0).xyz;
                vec3 start = (ax.xyz * mid.x + ay.xyz * mid.y + az.xyz * mid.z) * ax.w + at;
                vec3 ref = (ax.xyz * corner.x + ay.xyz * corner.y + az.xyz * corner.z) * ax.w + at;
                vec3 nw = ax.xyz * nf.x + ay.xyz * nf.y + az.xyz * nf.z;
                bool mirrored = stepAt == stepsAll - 1;
                float n = materialParams.steps[mirrored ? (stepsAll - 1) / 2 : stepAt].w;
                float way;
                float gain = route(solid, start, nw, n, mirrored, ref, way);
                if (gain > 0.0) result = vec4(ref.x, ref.z, ref.y, part == 0 ? gain : (part == 1 ? way : 0.0));
            }
        }
        material.baseColor = result;
    }
}
