// Floor that receives two caustics: `caustic` is the cube prism's (CPU-traced, already in lux), `tubeCaustic` is
// the GPU map from caustic_tri.h (rgb = CIE XYZ, irradiance relative to unrefracted sunlight).
// tubeScale = sun illuminance on the floor (lux * cos of the sun's angle), so both end up in the same units.
material {
    name : floor_glass,
    shadingModel : lit,
    culling : none,
    doubleSided : true,
    coloredPenumbra : true,
    specularAntiAliasing : true,
    parameters : [
        { type : float4, name : color },
        { type : float, name : roughness },
        { type : float, name : tubeScale },
        { type : float, name : tubeBlur },
        { type : sampler2d, name : caustic, format : float },
        { type : sampler2d, name : tubeCaustic, format : float }
    ],
    requires : [ uv0 ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = materialParams.color;
        material.roughness = materialParams.roughness;
        material.metallic = 0.0;
        material.reflectance = 0.35;
        vec3 c = texture(materialParams_caustic, getUV0()).rgb;
        // Looks over physics: a 5x5 Gaussian turns the sampling dots of the thin glass into a soft spectral glow.
        vec3 xyz = vec3(0.0);
        float wsum = 0.0;
        for (int j = -2; j <= 2; j++) {
            for (int i = -2; i <= 2; i++) {
                float w = exp(-float(i * i + j * j) * 0.22);
                xyz += w * max(texture(materialParams_tubeCaustic, getUV0() + vec2(float(i), float(j)) * materialParams.tubeBlur).rgb, vec3(0.0));
                wsum += w;
            }
        }
        xyz /= wsum;
        // W3C D65 XYZ -> linear sRGB, as in luma.gl
        vec3 rgb = max(vec3(
             3.2409699 * xyz.x - 1.5373832 * xyz.y - 0.4986108 * xyz.z,
            -0.9692436 * xyz.x + 1.8759675 * xyz.y + 0.0415551 * xyz.z,
             0.0556301 * xyz.x - 0.2039770 * xyz.y + 1.0569715 * xyz.z), vec3(0.0));
        c += min(rgb * materialParams.tubeScale, vec3(60000.0));
        material.emissive = vec4(c, 1.0);
    }
}
