// Official Filament only: no custom lighting. A clear solid with cubemap refraction (the IBL is what it refracts),
// Beer-Lambert absorption, KHR-style dispersion, and optional thin-film iridescence.
material {
    name : gem2,
    shadingModel : lit,
    blending : fade,
    refractionMode : cubemap,
    refractionType : solid,
    doubleSided : false,
    specularAntiAliasing : true,
    parameters : [
        { type : float, name : ior },
        { type : float, name : thickness },
        { type : float, name : dispersion },
        { type : float, name : roughness },
        { type : float, name : film },
        { type : float3, name : absorption }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = vec4(1.0);
        material.roughness = materialParams.roughness;
        material.metallic = 0.0;
        material.reflectance = 0.5;
        material.clearCoat = 1.0;
        material.clearCoatRoughness = 0.0;
        material.iridescence = materialParams.film;
        material.iridescenceIor = 1.3;
        material.iridescenceThickness = 300.0;
        material.transmission = 1.0;
        material.ior = materialParams.ior;
        material.thickness = materialParams.thickness;
        material.dispersion = materialParams.dispersion;
        material.absorption = materialParams.absorption;
    }
}
