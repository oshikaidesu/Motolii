+fn captured_target_suffix(args: &[String]) -> &'static str {
+    let mut expect_type = false;
+    for arg in args {
+        let kinds = if expect_type {
+            expect_type = false;
+            Some(arg.as_str())
+        } else if arg == "--crate-type" {
+            expect_type = true;
+            None
+        } else {
+            arg.strip_prefix("--crate-type=")
+        };
+        if kinds.is_some_and(|types| types.split(',').any(|kind| matches!(kind, "lib" | "rlib"))) {
+            return "lib";
+        }
+    }
+    "bin"
+}
