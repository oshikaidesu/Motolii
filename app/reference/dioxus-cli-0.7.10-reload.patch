+fn native_tls_initializers(obj: &File<'_>) -> Result<(Vec<u8>, HashMap<String, (u64, u64)>)> {
+    let mut data = Vec::new();
+    let mut sizes = HashMap::new();
+    for section in obj.sections().filter(|section| matches!(section.name(), Ok(".tdata" | "__thread_data" | "__thread_bss"))) {
+        let base = data.len() as u64;
+        let length = section.size();
+        if section.name()? == "__thread_bss" {
+            data.resize(data.len() + length as usize, 0);
+        } else {
+            data.extend_from_slice(section.data()?);
+        }
+        let mut symbols: Vec<_> = obj.symbols().filter_map(|symbol| {
+            if symbol.section_index() != Some(section.index()) { return None; }
+            Some((symbol.address().saturating_sub(section.address()), symbol.name().ok()?.to_owned()))
+        }).collect();
+        symbols.sort_by_key(|(offset, _)| *offset);
+        for (offset, name) in &symbols {
+            let end = symbols.iter().find(|(next, _)| next > offset).map_or(length, |(next, _)| *next);
+            sizes.insert(name.clone(), (base + offset, end.saturating_sub(*offset)));
+        }
+    }
+    Ok((data, sizes))
