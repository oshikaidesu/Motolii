+    #[tokio::test]
+    async fn rust_before_or_after_css_does_not_skip_asset_copy_or_notification() {
+        for names in [["host.rs", "styles.css"], ["styles.css", "host.rs"]] {
+            let files = names.map(PathBuf::from);
+            let copied = RefCell::new(Vec::new());
+            let assets = collect_asset_changes(&files, |path| {
+                copied.borrow_mut().push(path.clone());
+                std::future::ready((path.extension().unwrap() == "css").then(|| vec![PathBuf::from("styles-hash.css")]))
+            }).await;
+            assert_eq!(copied.into_inner(), files);
+            assert_eq!(assets, [PathBuf::from("/assets/styles-hash.css")]);
+        }
+    }
+}
