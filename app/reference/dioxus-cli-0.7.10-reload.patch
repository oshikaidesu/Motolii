+async fn collect_asset_changes<F, Fut>(files: &[PathBuf], mut copy: F) -> Vec<PathBuf>
+where
+    F: FnMut(PathBuf) -> Fut,
+    Fut: std::future::Future<Output = Option<Vec<PathBuf>>>,
+{
+    let mut assets = Vec::new();
+    for path in files {
+        if let Some(names) = copy(path.clone()).await {
+            assets.extend(names.into_iter().map(|name| PathBuf::from("/assets/").join(name)));
+        }
+    }
+    assets.sort();
+    assets.dedup();
+    assets
+}
+
