@@ -0,0 +1,89 @@
+use std::{fs::OpenOptions, io::Write, path::PathBuf};
+
+pub(crate) fn enabled() -> bool {
+    true
+}
+
+pub(crate) fn event(class: &str, decision: &str, reason: &str, files: &[PathBuf]) {
+    if !enabled() { return; }
+    let record = serde_json::json!({
+        "schema": 1, "event": "reload_decision", "execution_class": class,
+        "decision": decision, "reason": reason, "files": files,
+        "pid": std::process::id(),
+        "unix_ms": std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_millis(),
+    });
+    tracing::warn!("MOTOLII_RELOAD {record}");
+    if let Some(path) = std::env::var_os("MOTOLII_RELOAD_EVENTS") {
+        match OpenOptions::new().create(true).append(true).open(path) {
+            Ok(mut file) => { if let Err(error) = writeln!(file, "{record}") { tracing::error!("reload receipt write failed: {error}"); } }
+            Err(error) => tracing::error!("reload receipt unavailable: {error}"),
+        }
+    }
+}
+
+pub(crate) fn baseline(cause: &str) -> bool {
+    if !enabled() { return true; }
+    let permit = std::env::var_os("MOTOLII_BASELINE_PERMIT").map(PathBuf::from);
+    let accepted = permit.and_then(|path| {
+        let bytes = std::fs::read(&path).ok()?;
+        let record: serde_json::Value = serde_json::from_slice(&bytes).ok()?;
+        if record.get("cause")?.as_str()? != cause { return None; }
+        for field in ["build_need", "external_ruler", "hotpatch_or_check_gap", "repair_owner"] {
+            if record.get(field)?.as_str()?.trim().is_empty() { return None; }
+        }
+        let consumed = path.with_extension(format!("{}.consumed.json", std::process::id()));
+        std::fs::rename(path, consumed).ok()?;
+        Some(record)
+    });
+    if let Some(record) = accepted {
+        event("FULL_BASELINE", "permitted", &format!("{cause}: {record}"), &[]);
+        true
+    } else {
+        event("FULL_BASELINE", "blocked", cause, &[]);
+        tracing::error!("HOT_ROUTE_GAP: {cause}; the running app and patch baseline are retained. A one-use baseline record with BUILD_NEED, EXTERNAL_RULER, HOTPATCH_OR_CHECK_GAP and repair owner is required.");
+        false
+    }
+}
+
+pub(crate) async fn bounded<T>(class: &str, work: impl std::future::Future<Output = crate::Result<T>>) -> crate::Result<T> {
+    let target_ms = if class == "THIN_PATCH" { 5_000 } else { 60_000 };
+    let started = std::time::Instant::now();
+    let result = work.await;
+    let elapsed = started.elapsed().as_millis();
+    event(class, if result.is_err() { "failed" } else if elapsed > target_ms { "slow_completed" } else { "compiled" },
+        &format!("elapsed_ms={elapsed}; target_ms={target_ms}; no_timeout_abort"), &[]);
+    result
+}
+
+#[cfg(test)]
+mod motolii_guard_tests {
+    use super::baseline;
+    #[test]
+    fn baseline_record_is_cause_specific_and_consumed_once() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("permit.json");
+        std::env::set_var("MOTOLII_BASELINE_PERMIT", &path);
+        assert!(!baseline("initial_baseline"));
+        let permit = serde_json::json!({"cause":"initial_baseline", "build_need":"driver test baseline", "external_ruler":"pinned CLI Fat branch", "hotpatch_or_check_gap":"missing test baseline", "repair_owner":"cli"});
+        std::fs::write(&path, permit.to_string()).unwrap();
+        assert!(!baseline("patch_error_fallback"));
+        assert!(path.exists());
+        assert!(baseline("initial_baseline"));
+        assert!(!baseline("initial_baseline"));
+        assert!(!path.exists());
+        std::env::remove_var("MOTOLII_BASELINE_PERMIT");
+    }
+}
+
+pub(crate) fn runtime_owned(path: &std::path::Path, app_pid: Option<u32>) -> bool {
+    if !matches!(path.extension().and_then(|v| v.to_str()), Some("wgsl" | "fs")) { return false; }
+    let Some(pid) = app_pid else { return false; };
+    let Some(registration) = std::env::var_os("MOTOLII_RUNTIME_SOURCE_REGISTRATION") else { return false; };
+    let Some(session) = std::env::var("MOTOLII_RELOAD_SESSION").ok() else { return false; };
+    let Some(value) = std::fs::read(registration).ok().and_then(|s| serde_json::from_slice::<serde_json::Value>(&s).ok()) else { return false; };
+    if value.get("app_pid").and_then(|v| v.as_u64()) != Some(pid as u64)
+        || value.get("session").and_then(|v| v.as_str()) != Some(session.as_str()) { return false; }
+    let Ok(path) = path.canonicalize() else { return false; };
+    value.get("roots").and_then(|v| v.as_array()).is_some_and(|roots| roots.iter()
+        .filter_map(|v| v.as_str()).any(|root| path.starts_with(root)))
+}
