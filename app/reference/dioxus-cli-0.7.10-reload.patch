+fn find_emitted_rlib(out_dir: &Path, crate_name: &str, extra_filename: Option<&str>) -> Result<PathBuf> {
+        let exact = out_dir.join(format!("lib{crate_name}{}.rlib", extra_filename.unwrap_or("")));
+        if exact.exists() { return Ok(exact); }
 
