+            vec!["--crate-type", "dylib", "--crate-type", "rlib"],
+            vec!["--crate-type", "rlib,dylib"],
+            vec!["--crate-type=dylib,rlib"],
+        ] {
+            assert_eq!(captured_target_suffix(&args.into_iter().map(String::from).collect::<Vec<_>>()), "lib");
