+#[cfg(test)]
+mod motolii_tls_tests {
+    use super::*;
+    #[test]
+    fn macho_zero_fill_tls_does_not_copy_unrelated_initialized_borrow_flag() {
+        let mut obj = object::write::Object::new(object::BinaryFormat::MachO, object::Architecture::Aarch64, Endianness::Little);
+        let initialized = obj.section_id(StandardSection::Tls);
+        let zero_fill = obj.section_id(StandardSection::UninitializedTls);
+        let make_symbol = |name: &[u8]| Symbol { name: name.to_vec(), value: 0, size: 0, scope: SymbolScope::Linkage,
+            kind: SymbolKind::Tls, weak: false, section: SymbolSection::Undefined, flags: SymbolFlags::None };
+        let counter = obj.add_symbol(make_symbol(b"counter"));
+        obj.add_symbol_data(counter, initialized, &2u64.to_le_bytes(), 8);
+        let owner = obj.add_symbol(make_symbol(b"zero_refcell_owner"));
+        obj.add_symbol_bss(owner, zero_fill, 24, 8);
+        let bytes = obj.write().unwrap();
+        let parsed = File::parse(bytes.as_slice()).unwrap();
+        let (data, sizes) = native_tls_initializers(&parsed).unwrap();
+        let &(offset, size) = sizes.iter().find(|(name, _)| name.contains("zero_refcell_owner$tlv$init")).unwrap().1;
+        assert_eq!(size, 24);
+        assert_eq!(&data[offset as usize..(offset + size) as usize], &[0; 24]);
+        let &(offset, size) = sizes.iter().find(|(name, _)| name.contains("counter$tlv$init")).unwrap().1;
+        assert_eq!(size, 8);
+        assert_eq!(&data[offset as usize..(offset + size) as usize], &2u64.to_le_bytes());
+    }
