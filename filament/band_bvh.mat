// band.mm, model D (a probe, not a look): can an EXISTING mesh BVH be asked from a Filament material?
// The tree and its four textures are three-mesh-bvh's own (bvh_probe/build_bvh.mjs lets it build and pack them);
// the functions that walk it are three-mesh-bvh's own GLSL, included word for word. What is written here is only
// the loop drei's MeshRefractionMaterial has: bend in, ask the mesh for the next surface, leave if Snell's law
// lets the line out, mirror and ask again if not. One colour, no branching, no noise, nothing kept between frames.
material {
    name : band_bvh,
    shadingModel : unlit,
    blending : opaque,
    requires : [ tangents ],
    parameters : [
        { type : sampler2d, name : bvhPosition, precision : high, format : float },   // MeshBVHUniformStruct.position
        { type : sampler2d, name : bvhIndex, precision : high, format : uint },       // .index
        { type : sampler2d, name : bvhBounds, precision : high, format : float },     // .bvhBounds
        { type : sampler2d, name : bvhContents, precision : high, format : uint },    // .bvhContents
        { type : samplerCubemap, name : studio },
        { type : float, name : studioGain },
        { type : float, name : ior },
        { type : float, name : most },   // mirrorings inside a line may have; one that still cannot leave is NOT counted as out
        // checks (band.mm): 0 the picture (studio where the line leaves; magenta: still inside after `most`; red: no surface ahead).
        // 1: (way to the first surface inside, its normal x, y). 2: that triangle's three corners (numbers of vertices).
        // 3: (mirrorings before leaving, or 99: still inside, or -1: no surface ahead; way inside in all; normal z of the first surface)
        { type : float, name : show }
    ]
}

fragment {
#define BVH_STACK_DEPTH 60
    precision highp usampler2D;   // (three.js says these for its shaders; the included text counts on it)
    precision highp isampler2D;
#include "bvh_probe/three_mesh_bvh.glsl"

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // the scene's own coordinates: the mesh in the tree is in them
        vec3 P = getUserWorldPosition();
        mat3 toScene = mat3(getUserWorldFromWorldMatrix());
        vec3 d = normalize(toScene * (getWorldPosition() - getWorldCameraPosition()));
        vec3 N = normalize(toScene * getWorldGeometricNormalVector());
        if (dot(N, d) > 0.0) N = -N;
        float n = materialParams.ior;

        vec3 rayDirection = refract(d, N, 1.0 / n);
        vec3 rayOrigin = P + rayDirection * 0.001;
        uvec4 faceIndices = uvec4(0u);
        vec3 faceNormal = vec3(0.0, 0.0, 1.0), barycoord = vec3(0.0);
        float side = 1.0, dist = 0.0;

        float firstDist = -1.0, way = 0.0, count = 99.0;
        vec3 firstNormal = vec3(0.0);
        uvec3 firstCorners = uvec3(0u);
        for (int b = 0; b <= 32; b++) {
            if (float(b) > materialParams.most) break;
            if (!_bvhIntersectFirstHit(materialParams_bvhPosition, materialParams_bvhIndex, materialParams_bvhBounds, materialParams_bvhContents,
                                       rayOrigin, rayDirection, faceIndices, faceNormal, barycoord, side, dist)) {
                count = -1.0;
                break;
            }
            way += dist + 0.001;
            if (b == 0) {
                firstDist = dist + 0.001;
                firstNormal = faceNormal;
                firstCorners = faceIndices.xyz;
            }
            vec3 out1 = refract(rayDirection, faceNormal, n);   // (faceNormal faces the line; zero: past the critical angle)
            if (dot(out1, out1) > 0.0) {
                rayDirection = out1;
                count = float(b);
                break;
            }
            vec3 hit = rayOrigin + rayDirection * dist;
            rayDirection = reflect(rayDirection, faceNormal);
            rayOrigin = hit + rayDirection * 0.001;
        }

        vec3 c;
        if (materialParams.show > 2.5) c = vec3(count, way, firstNormal.z);
        else if (materialParams.show > 1.5) c = vec3(firstCorners);
        else if (materialParams.show > 0.5) c = vec3(firstDist, firstNormal.x, firstNormal.y);
        else if (count < -0.5) c = vec3(1.0, 0.0, 0.0);
        else if (count > 98.0) c = vec3(1.0, 0.0, 1.0);
        else c = textureLod(materialParams_studio, rayDirection * transpose(toScene), 0.0).rgb * materialParams.studioGain;
        material.baseColor = vec4(c, 1.0);
    }
}
