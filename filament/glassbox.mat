// Drop-in clear glass box. Put it on a unit cube (positions +-0.5); the box's centre, axes and size are read
// from the renderable's own transform, so moving / rotating / scaling the entity is all the setup there is.
//
// Borrowed, translated to Filament GLSL:
//   internal reflection loop  - N8python/diamonds `totalInternalReflection` (MIT, (c) 2022 N8python),
//                               with its BVH lookup replaced by the box slab exit below
//   box exit + spectral maths - Saqoosha/Spectral-Glass `cubeAnalyticExit`, `cauchyIor`, `cieXyz`,
//                               `xyzToSrgb`, `schlickFresnel` (MIT, (c) 2026 Saqoosha)
// See third_party/NOTICE-glassbox.md.
//
// What the glass shows: rays that leave the box look up `backdrop` (the scene rendered without the glass) where
// they head into the picture, and a small built-in studio (grey walls, bright strips, black flags) elsewhere.
// The built-in studio is what gives clear glass its bright planes and dark edge lines on any background.
material {
    name : glassbox,
    shadingModel : unlit,
    blending : opaque,
    culling : back,
    variables : [ boxC, boxX, boxY ],
    parameters : [
        { type : sampler2d, name : backdrop, precision : medium },
        { type : float, name : ior },
        { type : float, name : abbe },
        { type : float, name : reach },
        { type : float, name : envGain },
        { type : float, name : sceneMix },
        { type : float3, name : absorption },
        { type : float, name : round },      // the edges' rounding, as a part of half the edge (0: sharp; the mesh has the same)
        { type : float, name : lean },       // how far the faces lean from flat, slowly, this way and that (0: dead flat)
        { type : float, name : plainSky },   // 1: the built-in studio is a plain bright sky over a pale ground (no lamps, no black flags)
        { type : float, name : bySize }      // 1: work as hard as the block shows large (see `across` below); 0: always 8 colours, 4 mirrorings
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        mat4 m = getWorldFromModelMatrix();
        float lx = length(m[0].xyz), ly = length(m[1].xyz), lz = length(m[2].xyz);
        material.boxC = vec4(m[3].xyz, 0.5 * lx);          // centre, half size x
        material.boxX = vec4(m[0].xyz / lx, 0.5 * ly);     // axis x,  half size y
        material.boxY = vec4(m[1].xyz / ly, 0.5 * lz);     // axis y,  half size z
    }
}

fragment {
    const int WAVES = 8;
    const int BOUNCES = 4;
    const int MOST_WAVES = 12;

#include "spectrum.glsl"
    float schlickFresnel(float cosT, float n_d) {
        float f0 = pow((n_d - 1.0) / (n_d + 1.0), 2.0);
        float k = 1.0 - clamp(cosT, 0.0, 1.0);
        return f0 + (1.0 - f0) * k * k * k * k * k;
    }

    // --- the bundled studio: what clear glass needs to read as glass (bright field + black lines)
    float band(float x, float centre, float halfWidth, float soft) {
        float d = abs(x - centre);
        d = min(d, 6.2831853 - d);
        return 1.0 - smoothstep(halfWidth, halfWidth + soft, d);
    }
    vec3 studio(vec3 d) {
        if (materialParams.plainSky > 0.5) return vec3(d.y < 0.0 ? mix(0.62, 0.45, smoothstep(0.0, -0.6, d.y)) : mix(1.0, 0.6, smoothstep(0.0, 0.9, d.y)));   // bright at the horizon, dimmer overhead and on the ground
        float el = asin(clamp(d.y, -1.0, 1.0));
        float az = atan(d.z, d.x) + 3.14159265;
        float wall = mix(0.62, 0.30, smoothstep(0.0, 1.25, el));           // pale near the horizon, grey overhead
        float v = d.y < 0.0 ? mix(wall, 0.66, smoothstep(0.0, -0.2, d.y)) : wall;
        float rise = smoothstep(0.02, 0.12, el) * (1.0 - smoothstep(1.0, 1.2, el));
        v *= 1.0 - 0.92 * rise * (band(az, 1.35, 0.16, 0.05) + band(az, 3.55, 0.14, 0.05) + band(az, 5.35, 0.16, 0.05));
        v += rise * (7.0 * band(az, 0.95, 0.10, 0.03) + 5.0 * band(az, 3.15, 0.07, 0.03) + 4.0 * band(az, 4.95, 0.10, 0.03));
        v += 2.2 * smoothstep(1.15, 1.35, el);                              // overhead softbox
        return vec3(v);
    }
    vec3 lookup(vec3 p, vec3 d, vec3 view) {
        vec3 env = studio(d) * materialParams.envGain;
        highp vec4 clip = getClipFromWorldMatrix() * vec4(p + d * materialParams.reach, 1.0);
        if (clip.w <= 1e-4) return env;
        vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
        vec2 e = min(uv, 1.0 - uv);
        float w = smoothstep(0.0, 0.06, min(e.x, e.y)) * smoothstep(0.05, 0.35, dot(d, view)) * materialParams.sceneMix;
        if (w <= 0.0) return env;
        return mix(env, textureLod(materialParams_backdrop, uvToRenderTargetUV(uv), 0.0).rgb, w);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 c = variable_boxC.xyz;
        vec3 ax = normalize(variable_boxX.xyz);
        vec3 ay = normalize(variable_boxY.xyz - ax * dot(ax, variable_boxY.xyz));
        mat3 R = mat3(ax, ay, cross(ax, ay));                              // box -> world
        vec3 h = vec3(variable_boxC.w, variable_boxX.w, variable_boxY.w);

        vec3 P = getWorldPosition();
        vec3 view = normalize(P - getWorldCameraPosition());
        vec3 pl = (P - c) * R;                                              // world -> box
        vec3 dl = view * R;
        vec3 q = abs(pl) / h;
        vec3 nl = (q.x > q.y && q.x > q.z) ? vec3(sign(pl.x), 0.0, 0.0)
                : (q.y > q.z ? vec3(0.0, sign(pl.y), 0.0) : vec3(0.0, 0.0, sign(pl.z)));
        // real blocks: round edges (the way in is bent by the rounding; inside, the block is the plain box) and
        // faces that are not dead flat
        vec3 core = clamp(pl, -h * (1.0 - materialParams.round), h * (1.0 - materialParams.round));
        if (materialParams.round > 0.0 && dot(pl - core, pl - core) > 1e-12) nl = normalize(pl - core);
        vec3 s = 6.2832 * pl / h;
        nl = normalize(nl + materialParams.lean * vec3(sin(0.6 * s.y + 1.0) + sin(0.45 * s.z), sin(0.6 * s.z + 2.0) + sin(0.45 * s.x), sin(0.6 * s.x + 3.0) + sin(0.45 * s.y)));

        float F = schlickFresnel(-dot(dl, nl), materialParams.ior);
        vec3 reflected = lookup(P, R * reflect(dl, nl), view);

        // How large the block shows, as Filament sizes things for its own blur levels: world size over the distance to
        // the camera's plane, against one pixel's size at that distance. A block a few pixels wide shows neither its
        // inner mirrorings nor a fine rainbow, and a block that fills the screen shows eight colours as eight steps.
        // Up to the size the look was set at (an edge of some 265 pixels) the colours keep the same number of pixels
        // between them, 8 at most; only a block larger than half the screen's height gets more, 12 at most.
        int waves = WAVES, bounces = BOUNCES;
        if (materialParams.bySize > 0.5) {
            float away = max(-mulMat4x4Float3(getViewFromWorldMatrix(), c).z, 1e-3);
            float across = min(h.x, min(h.y, h.z)) / away * getClipFromViewMatrix()[1][1] * getResolution().y;   // the edge, in pixels
            waves = int(clamp(across / 33.0, 3.0, float(WAVES)) + clamp((across - 530.0) / 130.0, 0.0, float(MOST_WAVES - WAVES)) + 0.5);
            bounces = int(clamp(across / 24.0, 1.0, float(BOUNCES)));
        }
        vec3 acc = vec3(0.0), wsum = vec3(0.0);
        for (int i = 0; i < MOST_WAVES; i++) {
            if (i >= waves) break;
            float lambda = mix(400.0, 700.0, (float(i) + 0.5) / float(waves));
            float n = cauchyIor(lambda, materialParams.ior, materialParams.abbe);
            // N8python totalInternalReflection: refract in, then bounce until a refraction out succeeds
            vec3 rd = refract(dl, nl, 1.0 / n);
            vec3 ro = pl;
            float path = 0.0;
            for (int b = 0; b < BOUNCES; b++) {
                if (b >= bounces) break;
                // Spectral-Glass cubeAnalyticExit: slab exit of an axis-aligned box, from inside
                vec3 inv = 1.0 / rd;
                vec3 tHi = (h - ro) * inv, tLo = (-h - ro) * inv;
                vec3 tA = max(tHi, tLo);
                float t;
                vec3 fn;
                if (tA.x <= tA.y && tA.x <= tA.z) { t = tA.x; fn = vec3(tHi.x >= tLo.x ? 1.0 : -1.0, 0.0, 0.0); }
                else if (tA.y <= tA.z)            { t = tA.y; fn = vec3(0.0, tHi.y >= tLo.y ? 1.0 : -1.0, 0.0); }
                else                              { t = tA.z; fn = vec3(0.0, 0.0, tHi.z >= tLo.z ? 1.0 : -1.0); }
                ro += rd * t;
                path += t;
                vec3 tempDir = refract(rd, -fn, n);
                if (dot(tempDir, tempDir) > 0.0) { rd = tempDir; break; }
                rd = reflect(rd, fn);
            }
            vec3 w = max(xyzToSrgb(cieXyz(lambda)), vec3(0.0));
            acc += w * lookup(c + R * ro, R * rd, view) * exp(-materialParams.absorption * path);
            wsum += w;
        }
        vec3 transmitted = acc / max(wsum, vec3(1e-5));
        material.baseColor = vec4(mix(transmitted, reflected, F), 1.0);
    }
}
