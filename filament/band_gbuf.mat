// band.mm, models B and C: one side of the bands as numbers for the glass pass to read: which way the surface faces
// (the solid's outward normal, in two numbers) and how far from the camera it is (view depth). Nothing is lit.
// (Image-space refraction through the real far side: Wyman 2005; Oliveira and Brauwers 2007.)
material {
    name : band_gbuf,
    shadingModel : unlit,
    blending : opaque,
    requires : [ tangents ],
    parameters : [
        { type : float, name : flip }    // -1: the mesh is the inside-out one (its normals point inward)
    ]
}

fragment {
    vec2 oct(vec3 n) {
        n /= abs(n.x) + abs(n.y) + abs(n.z);
        vec2 e = n.z >= 0.0 ? n.xy : (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
        return e * 0.5 + 0.5;
    }
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 n = normalize(getWorldGeometricNormalVector()) * materialParams.flip;
        vec3 p = getWorldPosition() + getWorldOffset();
        float z = -mulMat4x4Float3(getViewFromWorldMatrix(), p).z;
        material.baseColor = vec4(oct(n), z, 1.0);
    }
}
