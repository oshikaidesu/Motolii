// points.mat: a point cloud's splats (points.h) as antimatter15/splat draws them (MIT, Copyright (c) 2023 Kevin Kwok):
// a square a slot; the slot's splat read from the order table, its data from the splat texture; its spread laid on the
// screen through the eye's turn and the projection's slope (J W S W^T J^T), the square stretched along the 2x2's two
// axes, faded out by exp(-r^2) times how much it is seen; laid from the farthest with Filament's see-through blending.
// `dissolve`: each splat thrown out its own way (fixed by which splat it is) as far as it says (点云飘散); `grain`:
// drawn so many times its own size. Unlit: the colours are the capture's own light.
material {
    name : points,
    shadingModel : unlit,
    variables : [ corner, tint ],
    culling : none,
    blending : transparent,
    depthWrite : false,
    parameters : [
        { type : sampler2d, name : splats, precision : high },
        { type : sampler2d, name : order, precision : high },
        { type : mat4, name : fit },
        { type : float, name : dissolve },
        { type : float, name : grain }
    ]
}

vertex {
    float hash(float n) { return fract(sin(n) * 43758.5453); }
    // PlayCanvas's helpers for its splat effects (engine shader chunk gsplatHelpers, MIT, Copyright (c) 2011-2026 PlayCanvas Ltd.)
    void gsplatMakeSpherical(inout vec3 scale, float size) { scale = vec3(size); }
    float gsplatGetSizeFromScale(vec3 scale) { return sqrt((scale.x * scale.x + scale.y * scale.y + scale.z * scale.z) / 3.0); }
    //@effect (a PlayCanvas splat effect's GLSL goes here as it is: points.h)
#ifndef SPLAT_EFFECT
    void modifySplatCenter(inout vec3 center) {}
    void modifySplatRotationScale(vec3 originalCenter, vec3 modifiedCenter, inout vec4 rotation, inout vec3 scale) {}
    void modifySplatColor(vec3 center, inout vec4 color) {}
#endif
    void materialVertex(inout MaterialVertexInputs material) {
        vec3 c = getPosition().xyz;   // (corner x, corner y in -2..2; the slot)
        int slot = int(c.z + 0.5);
        int which = int(texelFetch(materialParams_order, ivec2(slot % 4096, slot / 4096), 0).r + 0.5);
        int at = which * 4;
        vec4 t0 = texelFetch(materialParams_splats, ivec2(at % 4096, at / 4096), 0);
        vec4 t1 = texelFetch(materialParams_splats, ivec2((at + 1) % 4096, (at + 1) / 4096), 0);
        vec4 t2 = texelFetch(materialParams_splats, ivec2((at + 2) % 4096, (at + 2) / 4096), 0);
        vec4 t3 = texelFetch(materialParams_splats, ivec2((at + 3) % 4096, (at + 3) / 4096), 0);
        // (as PlayCanvas hands a splat to its effects: middle, turn (x y z w), size, colour with how much it is seen)
        vec3 center = t0.xyz, original = t0.xyz;
        modifySplatCenter(center);
        vec4 rotation = t1;
        vec3 scale = t2.xyz;
        modifySplatRotationScale(original, center, rotation, scale);
        vec4 colour = vec4(t2.w, t3.x, t3.y, t0.w);
        modifySplatColor(center, colour);
        float x = rotation.x, y = rotation.y, z = rotation.z, w = rotation.w;
        mat3 turn = mat3(1.0 - 2.0 * (y * y + z * z), 2.0 * (x * y + w * z), 2.0 * (x * z - w * y),
                         2.0 * (x * y - w * z), 1.0 - 2.0 * (x * x + z * z), 2.0 * (y * z + w * x),
                         2.0 * (x * z + w * y), 2.0 * (y * z - w * x), 1.0 - 2.0 * (x * x + y * y));
        mat3 grown = turn * mat3(scale.x, 0.0, 0.0, 0.0, scale.y, 0.0, 0.0, 0.0, scale.z);
        mat3 spread = grown * transpose(grown);   // (its spread in the file's own space)
        mat4 place = getWorldFromModelMatrix() * materialParams.fit;
        float seed = float(which % 100003) * 0.731;
        vec3 way = normalize(vec3(hash(seed * 12.9898) - 0.5, hash(seed * 78.233) - 0.5, hash(seed * 39.425) - 0.5) + vec3(0.0, 0.35, 0.0));
        float far = materialParams.dissolve * (0.3 + 1.4 * hash(seed * 7.137));
        material.worldPosition = vec4((getWorldFromModelMatrix() * vec4((materialParams.fit * vec4(center, 1.0)).xyz + way * far, 1.0)).xyz, 1.0);
        mat4 view = getViewFromWorldMatrix();
        vec3 cam = (view * vec4(material.worldPosition.xyz, 1.0)).xyz;
        float d = max(-cam.z, 1e-4);   // (Filament's eye looks down -z)
        vec4 res = getResolution();
        mat4 clip = getClipFromViewMatrix();
        float fx = clip[0][0] * 0.5 * res.x, fy = clip[1][1] * 0.5 * res.y;
        mat3 W = mat3(view) * mat3(place);
        mat3 J = mat3(fx / d, 0.0, 0.0, 0.0, fy / d, 0.0, fx * cam.x / (d * d), fy * cam.y / (d * d), 0.0);
        mat3 T = J * W;
        mat3 onScreen = T * spread * transpose(T);
        float c00 = onScreen[0][0] + 0.3, c11 = onScreen[1][1] + 0.3, c01 = onScreen[0][1];
        float mid = 0.5 * (c00 + c11), radius = length(vec2(0.5 * (c00 - c11), c01));
        float l1 = mid + radius, l2 = max(mid - radius, 0.1);
        vec2 along = vec2(c01, l1 - c00);
        along = dot(along, along) > 1e-12 ? normalize(along) : vec2(1.0, 0.0);
        vec2 major = min(sqrt(2.0 * l1), 1024.0) * along, minor = min(sqrt(2.0 * l2), 1024.0) * vec2(along.y, -along.x);
        vec2 px = (c.x * major + c.y * minor) * materialParams.grain;
        mat4 eye = getWorldFromViewMatrix();
        material.worldPosition.xyz += mulMat3x3Float3(eye, vec3(px.x * d / fx, px.y * d / fy, 0.0));
        material.corner = vec4(c.xy, clamp(colour.a, 0.0, 1.0), 0.0);
        material.tint = vec4(max(colour.rgb, vec3(0.0)), 1.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        float r = dot(variable_corner.xy, variable_corner.xy);
        if (r > 4.0) discard;
        float a = exp(-r) * variable_corner.z;
        material.baseColor = vec4(pow(variable_tint.rgb, vec3(2.2)) * a, a);   // (premultiplied; the capture's colours are the screen's numbers: back to light)
    }
}
