// Light and shadow outlines that do NOT come from a shared shape on the GPU, on a stage (walls, blocks; see
// "Receivers" in beam_glass.h): what beam_light.mat is for the floor alone. It draws the very same vertex buffer,
// once per receiver (instanced), and the vertex part moves every corner from the floor to that receiver's plane.
// Nothing is worked out per frame on the CPU for it.
//
// Why once per receiver, when ball_light.mat lets every corner choose: these triangles are large (a quarter of a
// face of a solid), and a large triangle laid across a crease like a chord is visibly wrong. Dropped whole on one
// plane and cut per pixel to the part of the plane that is surface, it is exact: in a convex room a ray meets a
// plane first exactly where its landing point lies in front of the other planes, and a face of a block exactly
// where its landing point lies within the block (recvOn).
// Receiver r = recvFirst + instance: the room's plane r (floor, walls) for r < roomCount - 1; after those three per
// block, one for each of its axes: the face across that axis that is turned towards the sun (a block shows the sun
// three faces at most). (Two renderables: the room's planes, drawn with the blocks in the depth buffer so that what
// lies behind a block is not drawn over it; and the blocks' faces, which ask recvSeen instead.)
//
// What a corner is (`source`):
//   0  light the CPU put on the floor (beam::trace_cheap): position = x, -, z; colour = rgb, distance flown.
//   1  an outline the CPU put on the floor (beam::silhouette_triangles): the same, rgb = 1.
//   2  a corner of a block's face, as it stands (a mesh made once): colour = the face's normal, the block's number.
//      Faces turned to the sun are slid along the sun onto the receiver: the block's outline. Not onto itself.
// THE LIE for source 0: a corner is taken back from the floor ALONG THE SUN to where it started, and from there
// along the sun to the receiver, because the buffer does not say which way the light flew. For the outlines (1, 2)
// that is exact. For the light it is exact for what went straight through the glass and wrong for what the glass
// bent: that lands on a wall or a block as if the floor's picture had been thrown on it by a projector standing in
// the sun. It meets the floor's own picture along every crease, so nothing breaks; it is in the wrong place by
// (height above the floor) x (how far the light was bent). Light that never comes down to the floor is not in the
// buffer and so not on any wall. A material that knows the true way of its light (ball_light.mat, cone_light.mat)
// has neither fault; this one is the stopgap for the CPU's triangles.
//
// What is drawn (`cover`):
//   0  light:   rgb = the light, a = light * how far the softening pass is to spread it, in pixels
//   1  outline (the sun cut off): red = 1, a = the spread in pixels (green is left alone: recv_mask.mat's marks)
material {
    name : recv_light,
    shadingModel : unlit,
    blending : add,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    instanced : true,
    requires : [ color ],
    variables : [ light, good, exit ],
    parameters : [
        { type : float,  name : source },
        { type : float,  name : cover },
        { type : float,  name : floorY },
        { type : float,  name : recvFirst },
        { type : float4[6], name : room, precision : high },                    // the stage: see recv_plane.glsl
        { type : float,  name : roomCount },
        { type : float4[16], name : blocks, precision : high },
        { type : float,  name : blockCount },
        { type : float3, name : recvSun },                                      // the way the sunlight travels
        { type : float,  name : pxScale }                                       // tan(half the sun's width) * pixels per unit at distance 1
    ]
}

vertex {
    // Is X within `margin` of the part of the receiver's plane that is surface? (A triangle with a corner further
    // out than any triangle is long is not drawn: it would only be rasterised to be cut away.)
    bool nearReceiver(highp vec3 X, float owner, float margin) {
        if (owner < -0.5) {
            for (int j = 0; j < 6; j++) {
                if (float(j) >= materialParams.roomCount) break;
                highp vec4 pl = materialParams.room[j];
                if (dot(pl.xyz, X) + pl.w < -margin) return false;
            }
            return true;
        }
        int own = int(owner + 0.5);
        highp vec3 rel = X - materialParams.blocks[4 * own].xyz;
        for (int k = 1; k <= 3; k++) {
            highp vec4 ax = materialParams.blocks[4 * own + k];
            if (abs(dot(ax.xyz, rel)) > ax.w + margin) return false;
        }
        return true;
    }
    void materialVertex(inout MaterialVertexInputs material) {
        highp vec3 L = materialParams.recvSun;
        // this instance's receiver (see the top)
        highp vec4 N;
        float owner = -1.0;
        int inst = int(materialParams.recvFirst + 0.5) + getInstanceIndex(), planes = int(materialParams.roomCount + 0.5) - 1;
        if (inst < planes) {
            highp vec4 pl = materialParams.room[inst];
            N = vec4(pl.xyz, -pl.w);
        } else {
            int b = (inst - planes) / 3;
            highp vec4 ax = materialParams.blocks[4 * b + 1 + (inst - planes) - b * 3];
            highp vec3 n = dot(ax.xyz, L) > 0.0 ? -ax.xyz : ax.xyz;
            N = vec4(n, dot(n, materialParams.blocks[4 * b].xyz) + ax.w);
            owner = float(b);
        }
        vec4 c = mesh_color;
        highp vec3 E;        // where the corner started
        vec3 rgb = c.rgb;
        bool ok = true;
        if (materialParams.source > 1.5) {
            E = mesh_position.xyz;
            rgb = vec3(1.0);
            ok = dot(c.xyz, L) < -1e-4 && abs(c.a - owner) > 0.5;
        } else {
            E = vec3(mesh_position.x, materialParams.floorY, mesh_position.z) - L * c.a;
        }
        highp float heading = -dot(N.xyz, L);
        if (!(heading > 0.02)) ok = false;
        highp float t = ok ? (dot(N.xyz, E) - N.w) / heading : 0.0;
        highp vec3 X = E + L * t;
        // the buffer holds what the FLOOR gets; a receiver turned otherwise to the light gets more of it or less
        if (materialParams.source < 0.5) rgb *= heading / max(-L.y, 1e-4);
        if (ok && !nearReceiver(X, owner, owner < -0.5 ? 0.6 : 0.4)) ok = false;
        if (!ok) X = N.xyz * N.w;
        // Does this corner's light pass any block closely enough that a pixel must ask whether the block is in its
        // way (recvBlocked)? Most do not, and their pixels are spared the asking. (Closely: within the ball round the
        // block and as much again as a triangle is long.)
        float ask = 0.0;
        int count = int(materialParams.blockCount + 0.5);
        for (int i = 0; i < 4; i++) {
            if (i >= count || !ok) break;
            highp vec3 rel = materialParams.blocks[4 * i].xyz - E;
            highp float along = dot(rel, L), side2 = dot(rel, rel) - along * along;
            highp float size = length(vec3(materialParams.blocks[4 * i + 1].w, materialParams.blocks[4 * i + 2].w, materialParams.blocks[4 * i + 3].w)) + 0.4;
            if (side2 < size * size) ask = 1.0;
        }
        material.light = vec4(rgb, t);
        material.good = vec4(ok ? 1.0 : 0.0, owner, owner * owner, ask);
        material.exit = vec4(E, 0.0);
        material.worldPosition = mulMat4x4Float3(getWorldFromModelMatrix(), X);
    }
}

fragment {
#include "recv_lands.glsl"
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 c = variable_light * step(0.9995, variable_good.x);
        highp vec3 X = getUserWorldPosition(), eye = getWorldCameraPosition() + (X - getWorldPosition());
        // not behind where it started, only where this receiver really is, and only where the camera sees it
        if (c.a < 0.0 || !recvOn(X, variable_good.y) || (variable_good.y > -0.5 && !recvSeen(X, variable_good.y, eye))) c = vec4(0.0);
        else if (materialParams.cover < 0.5 && variable_good.w > 0.0 && recvBlocked(X, variable_exit.xyz, materialParams.recvSun)) c = vec4(0.0);
        // the softening pass is told how far to spread in pixels, so it need not know what the light lies on
        float px = c.a * materialParams.pxScale / length(X - eye);
        if (materialParams.cover > 0.5) material.baseColor = vec4(c.r, 0.0, 0.0, c.r * px);
        else material.baseColor = vec4(c.rgb, (c.r + c.g + c.b) / 3.0 * px);
    }
}
