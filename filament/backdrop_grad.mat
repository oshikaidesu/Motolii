// band.mm: a plain studio backdrop, one colour at the bottom of the quad and another at the top.
material {
    name : backdrop_grad,
    shadingModel : unlit,
    requires : [ uv0 ],
    culling : none,
    parameters : [
        { type : float4, name : low },
        { type : float4, name : high },
        { type : float,  name : bend }     // how the change is spread: 1 even, more = stays low longer
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        float t = pow(clamp(getUV0().y, 0.0, 1.0), materialParams.bend);
        material.baseColor = vec4(mix(materialParams.low.rgb, materialParams.high.rgb, t), 1.0);
    }
}
