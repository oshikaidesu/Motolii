// The glass body of a profile pushed along a path and turned as it goes (beam_sweep.h). Every pixel takes the bar to
// be STRAIGHT where it is: the profile's sides as they stand there (the path's point and the profile's two axes come
// along with the mesh). The sight line is bent in, mirrored inside while the glass cannot let it out, and bent out,
// once per colour at the last side; then it looks at `backdrop`, the scene without the glass, as glass_solid.mat does.
// Left out on purpose: that the path bends and the profile turns while the sight line is inside; other glass seen
// through this one (and this one seen through other glass).
material {
    name : sweep_glass,
    shadingModel : unlit,
    blending : opaque,
    culling : none,
    doubleSided : true,
    requires : [ uv0, uv1, custom0, custom1 ],
    variables : [ ctr, axU, axV ],
    parameters : [
        { type : sampler2d, name : backdrop, precision : medium },
        { type : samplerCubemap, name : env, precision : medium },
        { type : float4[4], name : pose, precision : high },                    // where the bar stands: axis x + size; axis y; axis z; place
        { type : float4[8], name : profile },                                   // beam::Sweep::profile
        { type : float, name : sides },
        { type : float, name : ior },
        { type : float, name : abbe },
        { type : float, name : spread },
        { type : float3, name : sunTo },
        { type : float3, name : sunGlint },
        { type : float, name : sunCos },
        { type : float, name : floorY },
        { type : float, name : envGain },
        { type : float3, name : sky },
        { type : float3, name : absorption },
        { type : float4[6], name : room, precision : high },
        { type : float, name : roomCount },
        { type : float4[16], name : blocks, precision : high },
        { type : float, name : blockCount }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        vec3 ax = materialParams.pose[0].xyz, ay = materialParams.pose[1].xyz, az = materialParams.pose[2].xyz, at = materialParams.pose[3].xyz;
        float size = materialParams.pose[0].w;
        vec3 c0 = mesh_position.xyz, u0 = mesh_custom0.xyz, v0 = mesh_custom1.xyz;
        vec3 ctr = (ax * c0.x + ay * c0.y + az * c0.z) * size + at;
        vec3 U = ax * u0.x + ay * u0.y + az * u0.z, V = ax * v0.x + ay * v0.y + az * v0.z;
        vec3 P = ctr + (U * mesh_uv0.x + V * mesh_uv0.y) * size;
        material.ctr = vec4(ctr, size);   // (the user's world space)
        material.axU = vec4(U, 0.0);
        material.axV = vec4(V, 0.0);
        material.worldPosition = mulMat4x4Float3(getWorldFromModelMatrix(), P);
    }
}

fragment {
    const int WAVES = 9;
    const int BOUNCES = 6;

    float iorAt(float nm) {
        // two-term Cauchy from the Abbe number, as beam::Glass::n
        float B = (materialParams.ior - 1.0) / (materialParams.abbe * (1.0 / (486.13 * 486.13) - 1.0 / (656.27 * 656.27)));
        return materialParams.ior + B * (1.0 / (nm * nm) - 1.0 / (587.56 * 587.56));
    }
    float lobe(float x, float mu, float s1, float s2) {
        float t = (x - mu) * (x < mu ? s1 : s2);
        return exp(-0.5 * t * t);
    }
    vec3 waveRgb(float nm) {
        float X = 1.056 * lobe(nm, 599.8, 0.0264, 0.0323) + 0.362 * lobe(nm, 442.0, 0.0624, 0.0374) - 0.065 * lobe(nm, 501.1, 0.0490, 0.0382);
        float Y = 0.821 * lobe(nm, 568.8, 0.0213, 0.0247) + 0.286 * lobe(nm, 530.9, 0.0613, 0.0322);
        float Z = 1.217 * lobe(nm, 437.0, 0.0845, 0.0278) + 0.681 * lobe(nm, 459.0, 0.0385, 0.0725);
        return vec3(3.2406 * X - 1.5372 * Y - 0.4986 * Z, -0.9689 * X + 1.8758 * Y + 0.0415 * Z, 0.0557 * X - 0.2040 * Y + 1.0570 * Z);
    }
    // unpolarised Fresnel reflectance, n1 -> n2, 1 on total reflection
    float fresnel(float ci, float n1, float n2) {
        float s2 = (n1 / n2) * (n1 / n2) * (1.0 - ci * ci);
        if (s2 >= 1.0) return 1.0;
        float ct = sqrt(1.0 - s2);
        float rs = (n1 * ci - n2 * ct) / (n1 * ci + n2 * ct);
        float rp = (n1 * ct - n2 * ci) / (n1 * ct + n2 * ci);
        return 0.5 * (rs * rs + rp * rp);
    }

    highp vec3 gShift;   // the user's world space is Filament's, moved by this
    // The first matte thing a sight line from o along d meets (user's world space): how far, or -1.0 for none.
    float recvFirst(highp vec3 o, highp vec3 d) {
        highp float best = 1e9;
        int rc = int(materialParams.roomCount + 0.5), bc = int(materialParams.blockCount + 0.5), met = -1;
        // the room is convex and seen from inside: the nearest of its planes that the line runs into
        for (int j = 0; j < 6; j++) {
            if (j >= rc) break;
            highp vec4 pl = materialParams.room[j];
            highp float den = dot(pl.xyz, d);
            if (den > -1e-5) continue;
            highp float t = max(0.0, -(dot(pl.xyz, o) + pl.w) / den);
            if (t < best) { best = t; met = j; }
        }
        if (met == rc - 1) best = 1e9;   // (the last plane is where the walls end: nothing matte there)
        for (int i = 0; i < 4; i++) {
            if (i >= bc) break;
            highp vec3 c = materialParams.blocks[4 * i].xyz;
            highp float t0 = 0.0, t1 = best;
            bool miss = false;
            for (int k = 1; k <= 3; k++) {
                highp vec4 ax = materialParams.blocks[4 * i + k];
                highp float off = dot(ax.xyz, o - c), dd = dot(ax.xyz, d);
                if (abs(dd) < 1e-7) {
                    if (abs(off) > ax.w) miss = true;
                    continue;
                }
                highp float ta = (-ax.w - off) / dd, tb = (ax.w - off) / dd;
                t0 = max(t0, min(ta, tb));
                t1 = min(t1, max(ta, tb));
            }
            if (!miss && t0 < t1) best = t0;
        }
        return best < 1e8 ? best : -1.0;
    }

    // What a sight line that has left the glass at p (Filament world space) along d sees.
    vec3 lookup(vec3 p, vec3 d, float floorY) {
        if (materialParams.roomCount > 0.5) {
            float t = recvFirst(p + gShift, d);
            if (t >= 0.0) {
                highp vec4 clip = getClipFromWorldMatrix() * vec4(p + d * t, 1.0);
                if (clip.w > 1e-4) {
                    vec2 uv = clamp(clip.xy / clip.w * 0.5 + 0.5, vec2(0.001), vec2(0.999));
                    return textureLod(materialParams_backdrop, uvToRenderTargetUV(uv), 0.0).rgb;
                }
            }
        } else if (d.y < -1e-4) {
            float t = (floorY - p.y) / d.y;
            if (t >= 0.0) {
                highp vec4 clip = getClipFromWorldMatrix() * vec4(p + d * t, 1.0);
                if (clip.w > 1e-4) {
                    vec2 uv = clamp(clip.xy / clip.w * 0.5 + 0.5, vec2(0.001), vec2(0.999));
                    return textureLod(materialParams_backdrop, uvToRenderTargetUV(uv), 0.0).rgb;
                }
            }
        }
        // the sun itself, when the sight line ends up pointing at it: the flash of a face that catches the sun
        // (sunCos is the cosine of how wide the sun is taken to be; a little wider than the real one reads better)
        float sun = smoothstep(materialParams.sunCos, mix(materialParams.sunCos, 1.0, 0.5), dot(d, materialParams.sunTo));
        return (textureLod(materialParams_env, d, 0.0).rgb * materialParams.envGain + materialParams.sky + materialParams.sunGlint * sun) * getExposure();
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 P = getWorldPosition();
        vec3 Pu = getUserWorldPosition();
        vec3 shift = Pu - P;                                                         // Filament's world space is the user's, moved
        gShift = shift;
        float floorY = materialParams.floorY - shift.y;                              // the floor in Filament's world space
        vec3 view = normalize(P - getWorldCameraPosition());
        vec3 ctr = variable_ctr.xyz;
        float size = variable_ctr.w;
        vec3 U = normalize(variable_axU.xyz);
        vec3 V = normalize(variable_axV.xyz - U * dot(U, variable_axV.xyz));
        int K = int(materialParams.sides + 0.5);
        // the side of the profile this pixel is on: the one it is least far inside
        vec3 nl = U;
        float least = -1e9;
        for (int k = 0; k < 8; k++) {
            if (k >= K) break;
            vec4 pr = materialParams.profile[k];
            vec3 nk = U * pr.x + V * pr.y;
            float out1 = dot(nk, Pu - ctr) - pr.z * size;
            if (out1 > least) { least = out1; nl = nk; }
        }
        if (dot(nl, view) > 0.0) {
            // (a back side showing through a gap of the mesh: nothing to enter)
            material.baseColor = vec4(lookup(P, view, floorY), 1.0);
            return;
        }
        float ci = clamp(-dot(view, nl), 0.0, 1.0);
        float n0 = materialParams.ior;
        float F = fresnel(ci, 1.0, n0);
        vec3 mirrored = lookup(P, reflect(view, nl), floorY);

        vec3 rd = refract(view, nl, 1.0 / n0), ro = Pu;
        float path = 0.0;
        vec3 lastIn = rd, lastN = nl;
        bool outOk = false;
        for (int b = 0; b < BOUNCES; b++) {
            float t = 1e9;
            vec3 nj = nl;
            for (int k = 0; k < 8; k++) {
                if (k >= K) break;
                vec4 pr = materialParams.profile[k];
                vec3 nk = U * pr.x + V * pr.y;
                float den = dot(nk, rd);
                if (den > 1e-5) {
                    float tk = (pr.z * size - dot(nk, ro - ctr)) / den;
                    if (tk < t) { t = tk; nj = nk; }
                }
            }
            if (t > 1e8) break;
            t = clamp(t, 0.0, 12.0 * size * materialParams.profile[0].z);   // (a sight line running along the bar: out before the bar has bent away)
            ro += rd * t;
            path += t;
            vec3 o1 = refract(rd, -nj, n0);
            lastIn = rd;
            lastN = nj;
            if (dot(o1, o1) > 0.0) {
                outOk = true;
                break;
            }
            rd = reflect(rd, nj);
        }
        vec3 wo = ro - shift;
        vec3 acc = vec3(0.0), wsum = vec3(0.0);
        for (int i = 0; i < WAVES; i++) {
            float nm = mix(430.0, 670.0, (float(i) + 0.5) / float(WAVES));
            vec3 w = max(waveRgb(nm), vec3(0.0));
            wsum += w;
            float n = n0 + (iorAt(nm) - n0) * materialParams.spread;
            vec3 outDir = refract(lastIn, -lastN, n);
            // a colour the glass would not let out here leaves with the middle of the spectrum, or straight on:
            // every colour must come out somewhere, or the glass turns yellow or black
            if (dot(outDir, outDir) <= 0.0) outDir = refract(lastIn, -lastN, n0);
            if (dot(outDir, outDir) <= 0.0) outDir = lastIn;
            acc += w * lookup(wo, outDir, floorY);
        }
        acc *= exp(-materialParams.absorption * path);
        if (outOk) acc *= 1.0 - fresnel(dot(lastIn, lastN), n0, 1.0);
        vec3 transmitted = acc / max(wsum, vec3(1e-5));
        material.baseColor = vec4(transmitted * (1.0 - F) + mirrored * F, 1.0);
    }
}
