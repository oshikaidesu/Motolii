// Fake inner reflections for a glass solid: the solid's BACK faces drawn once more as a mirror-like layer, added on top
// of Filament's own refraction (which bends once at entry and has no inner bounce). Culling is set to FRONT on the
// instance; doubleSided flips the normal so the inner face is lit as seen from inside. Not optics: a look.
material {
    name : glass_back,
    shadingModel : lit,
    blending : add,
    doubleSided : true,
    depthWrite : false,
    parameters : [
        { type : float3, name : tint },
        { type : float, name : roughness }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = vec4(materialParams.tint, 1.0);
        material.metallic = 1.0;
        material.roughness = materialParams.roughness;
    }
}
