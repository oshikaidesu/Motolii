+//A clipper standing for an alpha matte that is one opaque, unstroked solid shape and nothing else (Motolii, thorvg_matte_clip.patch)
+static Shape* _matteClipper(LottieLayer* target)
+{
+    if (target->type != LottieLayer::Shape || target->masks.count > 0 || !target->effects.empty() || target->matteTarget || target->blendMethod != BlendMethod::Normal) return nullptr;
+    Paint* paint = target->scene;
+    auto m = paint->transform();
+    while (true) {
+        if (paint->opacity() < 255 || PAINT(paint)->clipper || PAINT(paint)->maskData) return nullptr;
+        if (paint->type() != Type::Scene) break;
+        auto& paints = static_cast<Scene*>(paint)->paints();
+        if (paints.size() != 1) return nullptr;
+        paint = paints.front();
+        m = m * paint->transform();
+    }
+    if (paint->type() != Type::Shape) return nullptr;
+    auto shape = static_cast<Shape*>(paint);
+    uint8_t a = 0;
+    if (shape->fill() || shape->fill(nullptr, nullptr, nullptr, &a) != Result::Success || a < 255 || shape->strokeWidth() > 0.0f) return nullptr;
+    auto clipper = static_cast<Shape*>(shape->duplicate());
+    clipper->transform(m);
+    return clipper;
+}
