+bool RawLoader::open(void* gpu, uint32_t w, uint32_t h)
+{
+    if (!gpu || w == 0 || h == 0) return false;
+    this->w = (float)w;
+    this->h = (float)h;
+    this->owner = Ownership::Borrow;
+    surface.setup(nullptr, w, w, h, sizeof(uint32_t), ColorSpace::ABGR8888);
+    surface.premultiplied = true;
+    surface.gpu = gpu;
+    return true;
+}
