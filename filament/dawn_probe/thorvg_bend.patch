@@ -23,6 +23,30 @@
 #include "tvgWgShaderSrc.h"
 #include <string>
 
+// (Motolii, thorvg_bend.patch) the view as a block: its matrix, then a canvas's bends (WgCanvas::bend). bend[0]: the
+// canvas's width to its height, how many bends; then each bend two vec4: its kind and seven numbers. Points are bent
+// where the matrix has put them, in shares of the canvas's height from its middle (y up), so fills and strokes bend alike.
+#define WG_BEND_SRC R"(
+struct WgView { mat: mat4x4f, bend: array<vec4f, 12> };
+fn bend(q: vec4f) -> vec4f {
+    let n = i32(uView.bend[0].y);
+    if (n == 0) { return q; }
+    let aspect = uView.bend[0].x;
+    var p = vec2f(q.x * aspect, q.y) * 0.5;
+    for (var i = 0; i < n; i++) {
+        let a = uView.bend[1 + 2 * i];
+        let b = uView.bend[2 + 2 * i];
+        let kind = i32(a.x);
+        if (kind == 1) {   // wave: so far to its side (a.y), so long a wave (a.z), so far along (a.w, in waves), running at angle b.x (radians)
+            let dir = vec2f(cos(b.x), sin(b.x));
+            p += vec2f(-dir.y, dir.x) * a.y * sin(6.2831853 * (dot(p, dir) / max(a.z, 1e-4) + a.w));
+        }
+    }
+    return vec4f(p.x * 2.0 / aspect, p.y * 2.0, q.z, q.w);
+}
+fn view(p: vec2f) -> vec4f { return bend(uView.mat * vec4f(p, 0.0, 1.0)); }
+)"
