+void WebGPUDriver::dispatchCompute(Handle<HwProgram> programHandle, math::uint3 workGroupCount) {
+    FWGPU_SYSTRACE_SCOPE();
+    FILAMENT_CHECK_PRECONDITION(!mRenderPassEncoder)
+            << "dispatchCompute must be called outside a render pass";
+    const auto program{ handleCast<WebGPUProgram>(programHandle) };
+    FILAMENT_CHECK_PRECONDITION(program->computeShaderModule)
+            << "dispatchCompute called with a program that has no compute shader";
+    if (!program->computePipeline) {
+        std::array<wgpu::BindGroupLayout, MAX_DESCRIPTOR_SET_COUNT> bindGroupLayouts{};
+        size_t bindGroupLayoutCount{ 0 };
+        for (size_t i{ 0 }; i < MAX_DESCRIPTOR_SET_COUNT; i++) {
+            if (mCurrentDescriptorSets[i].bindGroup) {
+                bindGroupLayouts[i] = mCurrentDescriptorSets[i].layout;
+                bindGroupLayoutCount = i + 1;
+            }
+        }
+        const WebGPUPipelineLayoutCache::PipelineLayoutRequest pipelineLayoutRequest{
+            .label = program->name,
+            .bindGroupLayouts = bindGroupLayouts,
+            .bindGroupLayoutCount = bindGroupLayoutCount,
+        };
+        const wgpu::ComputePipelineDescriptor descriptor{
+            .label = wgpu::StringView(program->name.c_str_safe()),
+            .layout = mPipelineLayoutCache.getOrCreatePipelineLayout(pipelineLayoutRequest),
+            .compute = { .module = program->computeShaderModule },
+        };
+        program->computePipeline = mDevice.CreateComputePipeline(&descriptor);
+        FILAMENT_CHECK_POSTCONDITION(program->computePipeline)
+                << "Failed to create compute pipeline for " << descriptor.label;
+    }
+    const wgpu::ComputePassEncoder pass{ mQueueManager.getCommandEncoder().BeginComputePass() };
+    pass.SetPipeline(program->computePipeline);
+    for (size_t i{ 0 }; i < MAX_DESCRIPTOR_SET_COUNT; i++) {
+        auto& binding{ mCurrentDescriptorSets[i] };
+        if (binding.bindGroup) {
+            pass.SetBindGroup(i, binding.bindGroup, binding.offsetCount, binding.offsets.data());
+        }
+    }
+    pass.DispatchWorkgroups(workGroupCount.x, workGroupCount.y, workGroupCount.z);
+    pass.End();
