diff --git a/filament/backend/src/webgpu/WebGPUDriver.cpp b/filament/backend/src/webgpu/WebGPUDriver.cpp
index ad409d39..b13d0fdc 100644
--- a/filament/backend/src/webgpu/WebGPUDriver.cpp
