+        program->computePipeline = mDevice.CreateComputePipeline(&descriptor);
+        FILAMENT_CHECK_POSTCONDITION(program->computePipeline)
+                << "Failed to create compute pipeline for " << descriptor.label;
+    }
+    const wgpu::ComputePassEncoder pass{ mQueueManager.getCommandEncoder().BeginComputePass() };
+    pass.SetPipeline(program->computePipeline);
+    for (size_t i{ 0 }; i < MAX_DESCRIPTOR_SET_COUNT; i++) {
+        auto& binding{ mCurrentDescriptorSets[i] };
+        if (binding.bindGroup) {
+            pass.SetBindGroup(i, binding.bindGroup, binding.offsetCount, binding.offsets.data());
+        }
+    }
+    pass.DispatchWorkgroups(workGroupCount.x, workGroupCount.y, workGroupCount.z);
+    pass.End();
