@@ -1820,8 +1820,47 @@ void WebGPUDriver::readTextureToBuffer(wgpu::Texture srcTexture, uint32_t level,
 
 void WebGPUDriver::readBufferSubData(Handle<HwBufferObject> bufferObjectHandle,
         const uint32_t offset, const uint32_t size, backend::BufferDescriptor&& bufferDescriptor) {
-    // todo
-    scheduleDestroy(std::move(bufferDescriptor));
+    // The same way readPixels does it: copy to a mappable buffer, submit, map, copy out.
+    const auto bufferObject{ handleCast<WebGPUBufferObject>(bufferObjectHandle) };
+    const uint32_t paddedSize{ (size + 3u) & ~3u };
+    const wgpu::BufferDescriptor stagingDescriptor{
+        .label = "read_buffer_staging",
+        .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+        .size = paddedSize,
+    };
+    wgpu::Buffer stagingBuffer{ mDevice.CreateBuffer(&stagingDescriptor) };
+    mQueueManager.getCommandEncoder().CopyBufferToBuffer(bufferObject->getBuffer(), offset,
+            stagingBuffer, 0, paddedSize);
+    struct UserData final {
+        BufferDescriptor bufferDescriptor;
+        wgpu::Buffer buffer;
+        uint32_t size;
+        WebGPUDriver* driver;
+    };
+    auto userData = std::make_unique<UserData>(UserData{
+            .bufferDescriptor = std::move(bufferDescriptor),
+            .buffer = std::move(stagingBuffer),
+            .size = size,
+            .driver = this,
+    });
+    mReadPixelMapsCounter.startTask();
+    mQueueManager.flush();
+    userData->buffer.MapAsync(
+            wgpu::MapMode::Read, 0, paddedSize, wgpu::CallbackMode::AllowProcessEvents,
+            [](wgpu::MapAsyncStatus status, wgpu::StringView message, UserData* userdata) {
+                std::unique_ptr<UserData> data(static_cast<UserData*>(userdata));
+                if (UTILS_LIKELY(status == wgpu::MapAsyncStatus::Success)) {
+                    memcpy(data->bufferDescriptor.buffer,
+                            data->buffer.GetConstMappedRange(0, data->buffer.GetSize()),
+                            std::min<size_t>(data->size, data->bufferDescriptor.size));
+                    data->buffer.Unmap();
+                } else {
+                    FWGPU_LOGE << "Failed to map staging buffer: " << std::string_view(message);
+                }
+                data->driver->scheduleDestroy(std::move(data->bufferDescriptor));
+                data->driver->mReadPixelMapsCounter.finishTask();
+            },
+            userData.release());
 }
 
