+/************************************************************************/
+/* Bezier3 functions                                                    */
+/************************************************************************/
+
+//a Bezier in space (the path of a 3D layer), under Bezier's own names: the same code leads a thing along either
+struct Bezier3
+{
+    Point3 start, ctrl1, ctrl2, end;
+
+    //the heading of what is flat of it
+    float angle(float t) const
+    {
+        if (t < 0 || t > 1) return 0;
+        auto pt = tangent(t);
+        return rad2deg(tvg::atan(Point{pt.x, pt.y}));
+    }
+
+    Point3 tangent(float t) const
+    {
+        auto mt = 1.0f - t;
+        auto d = t * t;
+        auto a = -mt * mt;
+        auto b = 1.0f - 4.0f * t + 3.0f * d;
+        auto c = 2.0f * t - 3.0f * d;
+        return (start * a + ctrl1 * b + ctrl2 * c + end * d) * 3.0f;
+    }
+
+    Point3 at(float t) const
+    {
+        auto it = 1.0f - t;
+        return start * (it * it * it) + ctrl1 * (3.0f * it * it * t) + ctrl2 * (3.0f * it * t * t) + end * (t * t * t);
+    }
+
+    //by 150 chords (0.07 px off on a 3400 px arch): the whole length, or (with `at`) where the length `at` is reached
+    float measure(const float* at) const
+    {
+        const auto chords = 150;
+        auto prev = start;
+        auto done = 0.0f;
+        for (auto i = 1; i <= chords; ++i) {
+            auto d = this->at(float(i) / chords) - prev;
+            auto len = sqrtf(d.x * d.x + d.y * d.y + d.z * d.z);
+            if (at && done + len >= *at) return (i - 1 + (len > 0.0f ? (*at - done) / len : 0.0f)) / chords;
+            done += len;
+            prev = prev + d;
+        }
+        return at ? 1.0f : done;
+    }
+
+    float lengthApprox() const { return measure(nullptr); }
+    float atApprox(float at, TVG_UNUSED float length) const { return measure(&at); }
+};
+
 /************************************************************************/
 /* Interpolation functions                                              */
 /************************************************************************/
