+//a 3D layer's property is read whole, and what is flat of it is handed to the 2D property, which is all as before
+static void _flat(LottieVectorFrame<Point3>& from, LottieVectorFrame<Point>& to)
+{
+    to.inTangent = {from.inTangent.x, from.inTangent.y};
+    to.outTangent = {from.outTangent.x, from.outTangent.y};
+    to.hasTangent = from.hasTangent;
+}
+
+static void _flat(LottieScalarFrame<Point3>& from, LottieScalarFrame<Point>& to) {}
+
+template<typename T3, typename T>
+static void _flat(T3& deep, T& flat)
+{
+    flat.value = {deep.value.x, deep.value.y};
+    if (!deep.frames) return;
+    for (auto from = deep.frames->begin(); from < deep.frames->end(); ++from) {
+        auto& to = flat.newFrame();
+        to.value = {from->value.x, from->value.y};
+        to.no = from->no;
+        to.interpolator = from->interpolator;
+        to.hold = from->hold;
+        _flat(*from, to);
+    }
+    flat.prepare();
+}
+
+
+template<typename T3, typename T>
+void LottieParser::parseProperty3(T3& deep, T& flat, LottieObject* obj)
+{
+    enterObject();
+    while (auto key = nextObjectKey()) {
+        if (KEY_AS("k")) {
+            parsePropertyInternal(deep);
+            _flat(deep, flat);
+        } else if (parseCommon(obj, flat, key)) continue;
+        else skip();
+    }
+}
