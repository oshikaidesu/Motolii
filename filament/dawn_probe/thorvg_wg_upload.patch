+// motolii: a write larger than Dawn's upload ring (4 MiB) took another way in Dawn that aborted (a long line finely
+// dashed: ~4.8 MB of vertices); written a ring's size at a time it stays on the ring's way.
+static void writeInRingSizes(WGPUQueue queue, WGPUBuffer buffer, const void* data, uint64_t size)
+{
+    const uint64_t ring = 4ull << 20;
+    for (uint64_t at = 0; at < size; at += ring) {
+        const uint64_t n = size - at < ring ? size - at : ring;
+        wgpuQueueWriteBuffer(queue, buffer, at, (const uint8_t*)data + at, n);
+    }
+}
