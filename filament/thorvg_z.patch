+template<typename T3, typename T>
+void LottieParser::parseProperty3(T3& deep, T& flat, LottieObject* obj)
+{
+    enterObject();
+    while (auto key = nextObjectKey()) {
+        if (KEY_AS("k")) {
+            parsePropertyInternal(deep);
+            _flat(deep, flat);
+        } else if (parseCommon(obj, flat, key)) continue;
+        else skip();
+    }
+}
