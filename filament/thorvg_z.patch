+//a position keyed in space (a 3D layer's): the same curve as in the plane, measured by its chords
+static inline Point3 _along3(LottieVectorFrame<Point3>* cur, LottieVectorFrame<Point3>* next, float want, float* total, Point3* heading)
+{
+    auto prev = cur->value;
+    auto done = 0.0f;
+    for (auto i = 1; i <= 64; ++i) {
+        auto t = i / 64.0f, u = 1.0f - t;
+        auto pt = cur->value * (u * u * u) + (cur->value + cur->outTangent) * (3.0f * u * u * t) + (next->value + cur->inTangent) * (3.0f * u * t * t) + next->value * (t * t * t);
+        auto d = pt - prev;
+        auto len = sqrtf(d.x * d.x + d.y * d.y + d.z * d.z);
+        if (heading && len > 0.0f) *heading = d;
+        if (!total && done + len >= want) return len > 0.0f ? prev + d * ((want - done) / len) : prev;
+        done += len;
+        prev = pt;
+    }
+    if (total) *total = done;
+    return next->value;
+}
+
+template<> inline void LottieVectorFrame<Point3>::prepare(LottieVectorFrame<Point3>* next)
+{
+    _along3(this, next, 0.0f, &length, nullptr);
+}
+
+template<> inline Point3 LottieVectorFrame<Point3>::interpolate(LottieVectorFrame<Point3>* next, float frameNo)
+{
+    auto t = (frameNo - no) / (next->no - no);
+    if (interpolator) t = interpolator->progress(t);
+    if (hold) return (t < 1.0f) ? value : next->value;
+    if (hasTangent) return _along3(this, next, t * length, nullptr, nullptr);
+    return tvg::lerp(value, next->value, t);
+}
+
+template<> inline float LottieVectorFrame<Point3>::angle(LottieVectorFrame<Point3>* next, float frameNo)
+{
+    auto heading = next->value - value;
+    if (hasTangent) {
+        auto t = (frameNo - no) / (next->no - no);
+        if (interpolator) t = interpolator->progress(t);
+        _along3(this, next, t * length, nullptr, &heading);
+    }
+    return rad2deg(tvg::atan(Point{heading.x, heading.y}));
+}
