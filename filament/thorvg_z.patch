+bool LottieLoader::pose(uint32_t id, float* out, uint32_t* parent, int* kind)
+{
+    if (!ready()) return false;
+    done();
+    LottieLayer* layer = nullptr;
+    ARRAY_FOREACH(p, comp->root->children) {   //(the id that is public is the name's hash cut to 32 bits)
+        if ((*p)->type == LottieObject::Type::Layer && (uint32_t)(*p)->id == id) layer = static_cast<LottieLayer*>(*p);
+    }
+    if (!layer || !layer->transform) return false;
+    auto t = layer->transform;
+    *parent = layer->parent ? (uint32_t)layer->parent->id : 0;
+    *kind = t->ddd ? ((int)layer->type == 13 ? (t->ddd->aimed ? 2 : 3) : 1) : 0;
+    if (!t->ddd) return true;
+    auto no = layer->cache.frameNo;   //the layer's own time, as it was last worked out
+    auto& tween = builder->tween;
+    auto exps = builder->exps;
+    auto p = t->ddd->position(no, tween, exps);
+    if (t->coords) p = {t->coords->x(no, tween, exps), t->coords->y(no, tween, exps), t->coords->z(no, tween, exps)};
+    auto a = t->ddd->anchor(no, tween, exps), s = t->ddd->scale(no, tween, exps), o = t->ddd->orient(no, tween, exps);
+    float all[19] = {p.x, p.y, p.z, a.x, a.y, a.z, s.x, s.y, s.z, o.x, o.y, o.z,
+                     t->ddd->rx(no, tween, exps), t->ddd->ry(no, tween, exps), t->rotation(no, tween, exps),
+                     t->skewAngle(no, tween, exps), t->skewAxis(no, exps),
+                     layer->autoOrient ? t->ddd->position.angle(no, tween) : 0.0f, layer->zoom(no, tween, exps)};
+    memcpy(out, all, sizeof(all));
+    return true;
+}
