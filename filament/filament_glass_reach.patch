+#if REFRACTION_MODE != REFRACTION_MODE_CUBEMAP
+// MOTOLII: the light is followed on from the point where it leaves the solid, in the direction it leaves in, for
+// `reach` (material.microThickness; 0 = Filament as it was), and the picture is read where it arrives. Where that
+// is outside the picture, the environment is read in that direction instead.
+#if defined(MOTOLII_FAR_SIDE)
+// MOTOLII_FAR_SIDE (a define given to matc): the material carries two pictures drawn by the application,
+// `farSide` (the solid's far side) and `sceneBehind` (the scene without the solid), each xy = outward normal in two
+// numbers, z = view depth, 0 where nothing is. The light is then taken through the REAL far side (the search of
+// Oliveira and Brauwers 2007, as in band_two.mat) and on to the REAL depth of the scene behind.
+vec3 motoliiUnoct(vec2 e) {
+    e = e * 2.0 - 1.0;
+    vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
+    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
+    return normalize(n);
+}
+vec3 motoliiPlace(highp vec3 p) {   // where a point is in those pictures (uv) and its view depth
+    highp vec4 c = mulMat4x4Float3(getClipFromWorldMatrix(), p);
+    return vec3(uvToRenderTargetUV(c.xy * (0.5 / c.w) + 0.5), -mulMat4x4Float3(getViewFromWorldMatrix(), p).z);
+}
+// from p along d inside the solid: the length to the far side (a march, then halving); found 0 if it is not met
+float motoliiMeetFar(highp vec3 p, vec3 d, float reach, out vec3 normalOut, out float found) {
+#if !defined(MOTOLII_STEPS)
+#define MOTOLII_STEPS 20
+#endif
+#if !defined(MOTOLII_HALVE)
+#define MOTOLII_HALVE 6
+#endif
+    const int STEPS = MOTOLII_STEPS;
+    float dt = reach / float(STEPS), t0 = 0.0, t1 = 0.0;
+    found = 0.0;
+    normalOut = vec3(0.0, 1.0, 0.0);
+    for (int i = 1; i <= STEPS; i++) {
+        float t = dt * float(i);
+        vec3 q = motoliiPlace(p + d * t);
+        float z = textureLod(materialParams_farSide, q.xy, 0.0).z;
+        if (z > 0.0 && q.z >= z) { t1 = t; t0 = t - dt; found = 1.0; break; }
+    }
+    if (found < 0.5) return reach;
+    for (int i = 0; i < MOTOLII_HALVE; i++) {
+        float t = 0.5 * (t0 + t1);
+        vec3 q = motoliiPlace(p + d * t);
+        float z = textureLod(materialParams_farSide, q.xy, 0.0).z;
+        if (z > 0.0 && q.z >= z) t1 = t; else t0 = t;
+    }
+    normalOut = motoliiUnoct(textureLod(materialParams_farSide, motoliiPlace(p + d * t1).xy, 0.0).xy);
+    return t1;
+}
+#endif
+
+#if defined(MOTOLII_FAR_SIDE)
+// how far along the leaving direction the scene behind lies: read from its depth, twice. none = 1: it heads back
+// towards the camera, or nothing is there.
+float motoliiBehind(highp vec3 p, vec3 d, out float none) {
+    vec3 q = motoliiPlace(p);
+    float dz = motoliiPlace(p + d).z - q.z;   // view depth gained per unit of length
+    float zs = textureLod(materialParams_sceneBehind, q.xy, 0.0).z;
+    none = zs <= 0.0 ? 1.0 : 1.0 - smoothstep(0.0, 0.25, dz);   // (heading back: the room, little by little)
+    if (none >= 1.0) return 1.0;
+    float reach = (zs - q.z) / dz;
+    float z1 = textureLod(materialParams_sceneBehind, motoliiPlace(p + d * reach).xy, 0.0).z;
+    if (z1 > 0.0) reach = (z1 - q.z) / dz;
+    return max(reach, 0.0);
+}
+#endif
+
+vec3 refractedScene(const Refraction ray, float reach, float none, float lod, highp mat4 clipFromWorld) {
+    highp vec4 p = mulMat4x4Float3(clipFromWorld, ray.position + ray.direction * reach);
+    vec2 ndc = p.xy / max(p.w, 1e-4);
+    vec3 t = textureLod(sampler0_ssr, vec3(uvToRenderTargetUV(ndc * 0.5 + 0.5), 0.0), lod).rgb;
+    if (none > 0.0) t = mix(t, prefilteredRadiance(ray.direction, 0.0) * frameUniforms.iblLuminance, none);
+    return t;
+}
+#endif
