// band.mm: clear glass with Filament's own screen-space refraction and dispersion (as glass_layer.mat), plus
// Filament's own thin-film iridescence on what the surface mirrors: the pale rainbow sheen. The film's thickness
// drifts along the band (a slow wave of the place in space), so the sheen's colours change along it.
material {
    name : band_glass,
    shadingModel : lit,
    blending : fade,
    refractionMode : screenspace,
    refractionType : solid,
    doubleSided : false,
    specularAntiAliasing : true,
    parameters : [
        { type : float, name : ior },
        { type : float, name : transmission },
        { type : float, name : thickness },
        { type : float, name : dispersion },
        { type : float, name : reflectance },
        { type : float3, name : absorption },
        { type : float, name : sheen },          // 0..1: how much of the thin film
        { type : float2, name : film },          // the film's thickness, from .. to (nanometres)
        { type : float, name : filmWave }        // how fast it drifts along the band
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = vec4(1.0, 1.0, 1.0, 1.0);
        material.roughness = 0.0;
        material.metallic = 0.0;
        material.reflectance = materialParams.reflectance;
        material.absorption = materialParams.absorption;
        material.transmission = materialParams.transmission;
        material.ior = materialParams.ior;
        material.thickness = materialParams.thickness;
        material.dispersion = materialParams.dispersion;
        vec3 p = getWorldPosition() + getWorldOffset();
        float w = 0.5 + 0.5 * sin(dot(p, vec3(1.7, 2.3, 1.1)) * materialParams.filmWave + 0.6 * sin(dot(p, vec3(-2.1, 0.9, 1.6)) * materialParams.filmWave));
        material.iridescence = materialParams.sheen;
        material.iridescenceIor = 1.3;
        material.iridescenceThickness = mix(materialParams.film.x, materialParams.film.y, w);
    }
}
