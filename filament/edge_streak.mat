// EXPERIMENT (STREAK=1): the bright lines a solid with an outline (letters, stars, rings) throws on the floor, drawn from
// the outline itself with no table pass.
// One path of light only: in through the cap that faces the sun, mirrored once by the inside of a wall, out through the
// other cap. The two caps are parallel, so what comes out travels exactly along the sun's direction mirrored in the wall,
// whatever the colour; only how wide a rim of the cap sends its light to that wall depends on the colour (the bend at the
// cap), which is where the coloured edge of each line comes from.
// Mesh: one four-cornered piece per straight bit of the outline: position = (a.x, a.y, corner 0..3), uv0 = b, custom0 = the
// way out of the glass at a and at b (on an arc these differ, so the pieces of an arc join into one curved band); the piece
// runs from the wall (corners 0, 1) inwards to the width of that rim (corners 2, 3), lies on the far cap, and is dropped
// on the floor along the mirrored direction. Instance = (solid of this shape, colour step).
// mode 1 is a second path of the same kind: out through the cut between that wall and the far cap, the only pair of
// faces here that is not square to each other, so the only place where the colours part.
// mode 2 and 3 serve edge_fill.mat (the window and the shadow of the caps): the rim of the far cap that gets no light
// straight through, as light of the opposite sign, and each wall's own shadow.
// Left out on purpose: whatever stands in the way of that light (other walls of the same solid, other solids), every
// other path. Output as beam_light.mat: rgb = the light, a = light * distance flown.
material {
    name : edge_streak,
    shadingModel : unlit,
    blending : add,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    instanced : true,
    flipUV : false,
    requires : [ uv0, custom0 ],
    variables : [ light ],
    parameters : [
        { type : sampler2d, name : pose, precision : high, format : float },   // per solid (column): axis x + size; axis y; axis z; place
        { type : float4[16], name : solids },                                   // which solids have this shape, 4 per entry
        { type : float4[16], name : steps },                                    // rgb, index of refraction
        { type : float,  name : stepCount },
        { type : float3, name : sunDir },                                       // the way the sunlight travels
        { type : float,  name : halfThick },                                    // half the thickness, in the outline's own units
        { type : float,  name : mode },                                         // 0: mirrored by the wall, 1: out through the cut on the rim
        { type : float,  name : chamfer },                                      // flat width of that cut, in the outline's own units
        { type : float,  name : gain },
        { type : float,  name : cap },                                          // brightest a piece may get (where a curved wall gathers its light to a line)
        { type : float,  name : floorY }
    ]
}

vertex {
    vec3 toWorld(vec3 v, vec4 ax, vec3 ay, vec3 az) { return ax.xyz * v.x + ay * v.y + az * v.z; }
    // One end of a bit of wall (p on the outline, nrm the way out of the glass there), for light of index n (and, for the
    // far edge of a coloured band, n2): where on the floor its two edges land (X0, X1), how wide a strip of the near cap
    // sends its light there (w; 0: none), and how far the light flew (t).
    // mode 0: mirrored once by the inside of the wall, out by the far cap. X0: the wall's own line, X1: the inner edge of the rim.
    // mode 1: out through the cut (chamfer) between the wall and the far cap, where the colours part. X0: the cut's edge
    //         on the wall for index n, X1: its edge on the cap for index n2, so that one colour's band reaches the next.
    void wallEnd(vec2 p, vec2 nrm, vec3 sL, float n, float n2, vec4 ax, vec3 ay, vec3 az, vec3 at, out vec3 X0, out vec3 X1, out float w, out float t) {
        float h = materialParams.halfThick;
        float far = sL.z > 0.0 ? 1.0 : -1.0;            // which cap the light leaves by
        vec3 din = refract(sL, vec3(0.0, 0.0, -far), 1.0 / n);
        float drift = dot(din.xy, nrm) / max(abs(din.z), 1e-4);   // sideways towards the wall, per unit of thickness crossed
        vec3 p0, p1, r0, r1;
        if (materialParams.mode > 2.5) {                // 3: the wall's own shadow, from its near edge to its far edge
            w = 1.0;
            r0 = materialParams.sunDir;
            r1 = r0;
            p0 = vec3(p, -far * h);
            p1 = vec3(p, far * h);
        } else if (materialParams.mode > 1.5) {         // 2: the rim of the far cap that no light reaches straight through
            w = clamp(-2.0 * h * drift, 0.0, 6.0 * h);  //    (it drifts away from this wall as it crosses the thickness)
            r0 = materialParams.sunDir;
            r1 = r0;
            p0 = vec3(p, far * h);
            p1 = vec3(p - nrm * w, far * h);
        } else if (materialParams.mode < 0.5) {
            w = clamp(2.0 * h * drift, 0.0, 6.0 * h);
            vec3 rL = sL - vec3(nrm * (2.0 * dot(sL.xy, nrm)), 0.0);   // the sun mirrored in the wall
            r0 = toWorld(rL, ax, ay, az);
            r1 = r0;
            p0 = vec3(p, far * h);
            p1 = vec3(p - nrm * w, far * h);
        } else {
            float c = materialParams.chamfer;
            vec3 nc = normalize(vec3(nrm, far));        // out of the glass through the cut
            vec3 din2 = refract(sL, vec3(0.0, 0.0, -far), 1.0 / n2);
            vec3 o0 = refract(din, -nc, n), o1 = refract(din2, -nc, n2);
            w = max(0.0, c * (1.0 + drift));
            if (dot(o0, o0) < 0.5 || dot(o1, o1) < 0.5 || dot(din, nc) < 0.02) w = 0.0;   // (the glass lets nothing out here)
            r0 = toWorld(o0, ax, ay, az);
            r1 = toWorld(o1, ax, ay, az);
            p0 = vec3(p, far * (h - c));
            p1 = vec3(p - nrm * c, far * h);
        }
        if ((abs(sL.z) < 0.05 && materialParams.mode < 2.5) || r0.y > -0.02 || r1.y > -0.02) w = 0.0;
        vec3 w0 = toWorld(p0, ax, ay, az) * ax.w + at, w1 = toWorld(p1, ax, ay, az) * ax.w + at;
        t = clamp((materialParams.floorY - w0.y) / min(r0.y, -0.02), 0.0, 8.0);
        X0 = w0 + r0 * t;
        X1 = w1 + r1 * clamp((materialParams.floorY - w1.y) / min(r1.y, -0.02), 0.0, 8.0);
    }
    void materialVertex(inout MaterialVertexInputs material) {
        int stepsAll = int(materialParams.stepCount);
        int inst = getInstanceIndex();
        int which = inst / stepsAll;
        int stepAt = inst - which * stepsAll;
        int solid = int(materialParams.solids[which / 4][which - (which / 4) * 4] + 0.5);
        vec4 ax = texelFetch(materialParams_pose, ivec2(solid, 0), 0);
        vec3 ay = texelFetch(materialParams_pose, ivec2(solid, 1), 0).xyz;
        vec3 az = texelFetch(materialParams_pose, ivec2(solid, 2), 0).xyz;
        vec3 at = texelFetch(materialParams_pose, ivec2(solid, 3), 0).xyz;

        vec2 a = mesh_position.xy, b = mesh_uv0;
        int corner = int(mesh_position.z + 0.5);
        vec3 sun = materialParams.sunDir;
        vec3 sL = vec3(dot(sun, ax.xyz), dot(sun, ay), dot(sun, az));   // the sun in the outline's own frame (z: the thickness)
        bool plain = materialParams.mode > 1.5;         // modes 2 and 3: one draw, no colours
        float n = materialParams.steps[plain ? 4 : stepAt].w;
        // the next colour's index (past the last step: as far again as from the one before)
        float n2 = stepAt + 1 < stepsAll ? materialParams.steps[stepAt + 1].w : 2.0 * n - materialParams.steps[max(stepAt - 1, 0)].w;
        vec3 A0, A1, B0, B1;
        float wa, wb, ta, tb;
        wallEnd(a, normalize(getCustom0().xy), sL, n, n2, ax, ay, az, at, A0, A1, wa, ta);
        wallEnd(b, normalize(getCustom0().zw), sL, n, n2, ax, ay, az, at, B0, B1, wb, tb);
        // As bright as the light it carries over the floor it lands on: the strip of the near cap as the sun sees it,
        // over the four-cornered patch on the floor. Light that fans out gets dimmer, light that is gathered brighter.
        float strip = 0.5 * (wa + wb) * length(b - a) * ax.w * ax.w * abs(sL.z);
        vec2 d1 = (B1 - A0).xz, d2 = (A1 - B0).xz;
        float landed = 0.5 * abs(d1.x * d2.y - d1.y * d2.x);   // (the light buffer is in units of the sun met square on)
        float gain = min(materialParams.gain * strip / max(landed, 1e-9), materialParams.cap);
        bool atA = corner == 0 || corner == 3;
        float lit = (atA ? wa : wb) > 0.0 ? 1.0 : 0.0;
        vec3 X = corner == 0 ? A0 : (corner == 1 ? B0 : (corner == 2 ? B1 : A1));
        vec3 rgb = materialParams.steps[stepAt].rgb * (gain * lit);
        if (plain) {
            // mode 2 takes out of the window what edge_fill.mat (mode 0) put there; mode 3 is shadow
            float ci = abs(sL.z), ct = sqrt(max(0.0, 1.0 - (1.0 - ci * ci) / (n * n)));
            float rs = (ci - n * ct) / (ci + n * ct), rp = (ct - n * ci) / (ct + n * ci);
            float through = 1.0 - 0.5 * (rs * rs + rp * rp);
            rgb = materialParams.mode > 2.5 ? vec3(1.0) : vec3(-through * through * lit * max(-sun.y, 0.0));
        }
        material.light = vec4(rgb, atA ? ta : tb);
        material.worldPosition = mulMat4x4Float3(getWorldFromModelMatrix(), X);   // (a corner with no light stays in place, dark)
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 c = variable_light;
        material.baseColor = vec4(c.rgb, (c.r + c.g + c.b) / 3.0 * c.a);
    }
}
