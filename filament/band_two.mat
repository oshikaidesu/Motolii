// band.mm, models B and C: glass as what it is. A pixel of the near side sends its sight line INTO the solid by
// Snell's law, follows it straight to the REAL far side (found in the picture of that side's depth: a march, then
// halving), bends it out there by Snell's law with the far side's own normal, and takes what lies that way: the
// scene's picture where the line stays on screen, the studio around it otherwise. Every colour step does this on its
// own (its own index of refraction, so its own way and its own far point). Mirrored light of the near surface
// (Fresnel) comes from the studio. Model C adds one mirroring inside: at the far side the part that does not leave
// (all of it past the critical angle) is followed back to the real near side and out.
// Method: Wyman, "An Approximate Image-Space Approach for Interactive Refraction" (2005); the search for the far side
// as in Oliveira and Brauwers, "Real-Time Refraction Through Deformable Objects" (2007); the inner mirroring as in
// Davis and Wyman, "Interactive Refractions with Total Internal Reflection" (2007).
// No noise, nothing kept between frames.
material {
    name : band_two,
    shadingModel : unlit,
    blending : opaque,
    requires : [ tangents ],
    parameters : [
        { type : sampler2d, name : scene, precision : medium },                  // the frame without glass (already exposed)
        { type : sampler2d, name : farSide, precision : high, format : float },  // band_gbuf.mat of the far sides
        { type : sampler2d, name : nearSide, precision : high, format : float }, // ... of the near sides (model C)
        { type : samplerCubemap, name : studio },
        { type : float,  name : studioGain },    // the studio's brightness as the camera sees it
        { type : float,  name : studioTurn },    // the studio turned about the up axis (radians), as the scene's light is
        { type : float3, name : sunTo },         // towards the sun
        { type : float,  name : sunGain },
        { type : float,  name : ior },
        { type : float,  name : spread },        // index of refraction, violet minus red
        { type : float3, name : absorb },        // per unit of length inside
        { type : float,  name : reach },         // how far a line may go inside before it is given up (world units)
        { type : float,  name : beyond },        // how far behind the glass the scene is taken to lie (world units)
        { type : float,  name : inner }          // 1: model C
    ]
}

fragment {
    vec3 unoct(vec2 e) {
        e = e * 2.0 - 1.0;
        vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
        if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
        return normalize(n);
    }
    vec3 place(vec3 p) {   // screen uv and view depth of a point in the world
        highp vec4 c = mulMat4x4Float3(getClipFromWorldMatrix(), p);
        return vec3(uvToRenderTargetUV(c.xy * (0.5 / c.w) + 0.5), -mulMat4x4Float3(getViewFromWorldMatrix(), p).z);
    }
    vec3 studio(vec3 d) {
        float c = cos(materialParams.studioTurn), s = sin(materialParams.studioTurn);
        return textureLod(materialParams_studio, vec3(c * d.x - s * d.z, d.y, s * d.x + c * d.z), 0.0).rgb * materialParams.studioGain;
    }
    // what is seen from p along d, outside the glass
    vec3 outside(vec3 p, vec3 d) {
        vec3 q = place(p + d * materialParams.beyond);
        vec2 edge = min(q.xy, 1.0 - q.xy);
        float on = smoothstep(0.0, 0.06, min(edge.x, edge.y)) * step(0.0, q.z);
        vec3 far = studio(d);
        return on > 0.0 ? mix(far, textureLod(materialParams_scene, q.xy, 0.0).rgb, on) : far;
    }
    float fres(float ci, float n1, float n2) {
        float s2 = (n1 / n2) * (n1 / n2) * (1.0 - ci * ci);
        if (s2 >= 1.0) return 1.0;
        float ct = sqrt(1.0 - s2);
        float rs = (n1 * ci - n2 * ct) / (n1 * ci + n2 * ct), rp = (n1 * ct - n2 * ci) / (n1 * ct + n2 * ci);
        return 0.5 * (rs * rs + rp * rp);
    }
    // From p along d inside the glass: where the surface kept in `side` is met. away: +1 the far side (the line goes
    // away from the camera through it), -1 the near side. Returns the length gone; `found` 0 if nothing was met.
    float meet(sampler2D side, vec3 p, vec3 d, float away, out vec3 normalOut, out float found) {
        const int STEPS = 20;
        float dt = materialParams.reach / float(STEPS), t0 = 0.0, t1 = 0.0;
        found = 0.0;
        normalOut = vec3(0.0, 1.0, 0.0);
        for (int i = 1; i <= STEPS; i++) {
            float t = dt * float(i);
            vec3 q = place(p + d * t);
            vec4 g = textureLod(side, q.xy, 0.0);
            if (g.z > 0.0 && (q.z - g.z) * away >= 0.0) { t1 = t; t0 = t - dt; found = 1.0; break; }
        }
        if (found < 0.5) return materialParams.reach;
        for (int i = 0; i < 6; i++) {
            float t = 0.5 * (t0 + t1);
            vec3 q = place(p + d * t);
            vec4 g = textureLod(side, q.xy, 0.0);
            if (g.z > 0.0 && (q.z - g.z) * away >= 0.0) t1 = t; else t0 = t;
        }
        vec3 q = place(p + d * t1);
        normalOut = unoct(textureLod(side, q.xy, 0.0).xy);
        return t1;
    }
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 P = getWorldPosition() + getWorldOffset();
        vec3 V = normalize(P - getWorldCameraPosition());     // the sight line, going in
        vec3 N = normalize(getWorldGeometricNormalVector());
        if (dot(N, V) > 0.0) N = -N;
        float ci = -dot(N, V);

        // the six colour steps: red .. violet, their shares of red, green and blue adding up to white
        const vec3 share[6] = vec3[6](vec3(0.60, 0.00, 0.00), vec3(0.40, 0.25, 0.00), vec3(0.00, 0.50, 0.00),
                                      vec3(0.00, 0.25, 0.30), vec3(0.00, 0.00, 0.50), vec3(0.00, 0.00, 0.20));
        vec3 through = vec3(0.0);
        float mirrorNear = 0.0;
        for (int j = 0; j < 6; j++) {
            float n = materialParams.ior + materialParams.spread * (float(j) / 5.0 - 0.5);
            float F1 = fres(ci, 1.0, n);
            mirrorNear += F1 / 6.0;
            vec3 T1 = refract(V, N, 1.0 / n);
            vec3 N2;
            float found;
            float len = meet(materialParams_farSide, P, T1, 1.0, N2, found);
            vec3 P2 = P + T1 * len;
            vec3 got;
            if (found < 0.5) {
                got = outside(P2, T1);                           // (left by the solid's outline: nothing known of that surface)
            } else {
                if (dot(N2, T1) < 0.0) N2 = -N2;                 // (outward, the way the line goes)
                float c2 = dot(N2, T1);
                float F2 = fres(c2, n, 1.0);
                vec3 T2 = refract(T1, -N2, n);
                vec3 leaves = F2 < 1.0 ? outside(P2, T2) : vec3(0.0);
                vec3 stays = vec3(0.0);
                if (materialParams.inner > 0.5) {                // model C: the mirrored part, back to the near side and out
                    vec3 R = reflect(T1, -N2), N3;
                    float found3;
                    float len3 = meet(materialParams_nearSide, P2 + R * 0.002, R, -1.0, N3, found3);
                    vec3 P3 = P2 + R * len3;
                    if (dot(N3, R) < 0.0) N3 = -N3;
                    float F3 = fres(dot(N3, R), n, 1.0);
                    vec3 T3 = refract(R, -N3, n);
                    stays = (F3 < 1.0 ? outside(P3, T3) * (1.0 - F3) : studio(reflect(R, -N3))) * exp(-materialParams.absorb * len3);
                    got = leaves * (1.0 - F2) + stays * F2;
                } else {
                    got = F2 < 1.0 ? leaves : outside(P2, reflect(T1, -N2));   // model B: past the critical angle, taken as leaving mirrored
                }
            }
            through += share[j] * got * (1.0 - F1) * exp(-materialParams.absorb * len);
        }
        // the near surface as a mirror: the studio, and the sun's disc
        vec3 R1 = reflect(V, N);
        vec3 mirrored = studio(R1) + vec3(materialParams.sunGain) * smoothstep(0.9997, 0.99995, dot(R1, materialParams.sunTo));
        material.baseColor = vec4(through + mirrored * mirrorNear, 1.0);
    }
}
