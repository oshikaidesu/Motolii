material {
    name : robust_gpu,
    shadingModel : unlit,
    blending : opaque,
    culling : none,
    doubleSided : true,
    variables : [
        section
    ],
    parameters : [
        { type : sampler2d, name : controls, precision : high, format : float, filter : nearest },
        { type : sampler2d, name : frames, precision : high, format : float, filter : nearest },
        { type : float, name : samples },
        { type : float, name : sides },
        { type : float, name : spans },
        { type : float, name : radius },
        { type : float, name : texWidth },
        { type : float, name : texHeight },
        { type : float, name : frameHeight }
    ]
}

vertex {
    float4 controlAt(int index) {
        int w = int(materialParams.texWidth + 0.5);
        int x = index - (index / w) * w;
        int y = index / w;
        return textureLod(materialParams_controls,
            float2((float(x) + 0.5) / materialParams.texWidth, (float(y) + 0.5) / materialParams.texHeight), 0.0);
    }
    float4 frameAt(int index) {
        int w = int(materialParams.texWidth + 0.5);
        int x = index - (index / w) * w;
        int y = index / w;
        return textureLod(materialParams_frames,
            float2((float(x) + 0.5) / materialParams.texWidth, (float(y) + 0.5) / materialParams.frameHeight), 0.0);
    }

    void materialVertex(inout MaterialVertexInputs material) {
        int sides = int(materialParams.sides + 0.5);
        int samples = int(materialParams.samples + 0.5);
        int spanCount = int(materialParams.spans + 0.5);
        int v = getVertexIndex();
        int ring = v / sides;
        int k = v - ring * sides;
        int interior = spanCount * samples;
        int src = ring >= interior ? 0 : ring;
        int span = clamp(src / samples, 0, spanCount - 1);
        int i = src - span * samples;
        float t = float(i) / float(samples);
        float ang = float(k) / float(sides) * 6.2831853;
        float4 p0 = controlAt(span * 4 + 0);
        float4 p1 = controlAt(span * 4 + 1);
        float4 p2 = controlAt(span * 4 + 2);
        float4 p3 = controlAt(span * 4 + 3);
        float u = 1.0 - t;
        float3 b = ((u * u * u) * p0.xyz) + ((3.0 * u * u * t) * p1.xyz)
                 + ((3.0 * u * t * t) * p2.xyz) + ((t * t * t) * p3.xyz);
        float3 N = frameAt(ring * 2).xyz;
        float3 B = frameAt(ring * 2 + 1).xyz;
        float3 radial = cos(ang) * N + sin(ang) * B;
        material.worldPosition.xyz += b + materialParams.radius * radial;
        material.section = float4(ang, t, float(span), 1.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        float ang = variable_section.x;
        material.baseColor = float4(0.55 + 0.4 * cos(ang), 0.4 + 0.35 * sin(ang), 0.72, 1.0);
    }
}
