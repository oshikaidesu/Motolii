// PAIRS=1: the light that goes into a flat-faced solid by one face and out by another, with NO cutting done by us.
// (And the white light mirrored off the outside.) Nothing bounced inside is here: this is the first, small proof.
//
// For a pair of faces (A in, B out) the light that leaves through B is: B itself, less whatever of it the light that
// came in through A does not reach. That light is a straight tube with A as its cross-section; its walls are flat,
// one per edge of A. So: draw B, and give the GPU's own clipper the walls of that tube as clip planes (the built-in
// clip distances, 8 per draw: clip_probe.mat). The clipper cuts; no polygon is cut here, in the vertex stage or in
// the fragment stage. A pair that carries no light is clipped away whole (or is told apart at once: A not in the
// sun, B not ahead, the light mirrored back in at B) and draws nothing: nobody has to know which pairs carry light.
// Colours: every colour step is its own instance; the vertex stage bends the light for that colour by the plain
// formula, so each colour's patch is exactly that colour's (no in-between guessing), however far the colours spread.
//
// Mesh (glass_scene.mm): for every ordered pair of faces (A, B) of the shape, and every (A, A) for the mirrored light,
// B as a fan of triangles; position = (A, B, which corner of B).
// Instance = (solid of this shape, colour step). Output as beam_light.mat: rgb = the light, a = light * distance flown.
// The band of sun (STRIP) is one number per vertex (how far the light's way in lies from the band's middle) and one
// comparison per pixel: the same thing the floor's own bands of sun are (beam_soften.mat).
material {
    name : pair_light,
    shadingModel : unlit,
    blending : add,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    instanced : true,
    variables : [ light, band ],
    parameters : [
        { type : sampler2d, name : faces, precision : high, format : float },   // per face (line): corners 0..7 in the shape's own frame (w of the first: how many), then its plane (normal out, offset)
        { type : float4[64], name : steps },                                     // rgb, index of refraction
        { type : float,  name : stepCount },
        { type : float4[64], name : poseX, precision : high },                   // per solid: axis x, size
        { type : float4[64], name : poseY, precision : high },                   // axis y
        { type : float4[64], name : poseZ, precision : high },                   // axis z
        { type : float4[64], name : poseAt, precision : high },                  // place
        { type : float3, name : sunDir },
        { type : float4, name : strip },                                         // the band of sun: across (x, z), middle, half width (0: none)
        { type : float,  name : stripEvery },
        { type : float,  name : gain },                                          // the coloured light this many times brighter than it is
        { type : float,  name : floorY },
        { type : float,  name : probe }                                          // timing only. 1: every vertex gives up at once; 2: after the quick tests (A in the sun, B ahead)
    ]
}

vertex {
#ifndef GL_ES
#define CLIP(k, value) gl_ClipDistance[k] = (value)
#else
#define CLIP(k, value)
#endif
    float fres(float ci, float n1, float n2) {
        float s2 = (n1 / n2) * (n1 / n2) * (1.0 - ci * ci);
        if (s2 >= 1.0) return 1.0;
        float ct = sqrt(1.0 - s2);
        float rs = (n1 * ci - n2 * ct) / (n1 * ci + n2 * ct), rp = (n1 * ct - n2 * ci) / (n1 * ct + n2 * ci);
        return 0.5 * (rs * rs + rp * rp);
    }
    void materialVertex(inout MaterialVertexInputs material) {
        if (materialParams.probe > 0.5 && materialParams.probe < 1.5) {
            CLIP(0, -1.0); CLIP(1, -1.0); CLIP(2, -1.0); CLIP(3, -1.0); CLIP(4, -1.0); CLIP(5, -1.0); CLIP(6, -1.0); CLIP(7, -1.0);
            material.light = vec4(0.0);
            material.band = vec4(0.0);
            material.worldPosition = vec4(0.0, 0.0, 0.0, 1.0);
            return;
        }
        int A = int(mesh_position.x + 0.5), B = int(mesh_position.y + 0.5), corner = int(mesh_position.z + 0.5);
        int stepsAll = int(materialParams.stepCount);
        int inst = getInstanceIndex();
        int solid = inst / stepsAll, stepAt = inst - solid * stepsAll;
        vec4 ax = materialParams.poseX[solid];
        vec3 ay = materialParams.poseY[solid].xyz, az = materialParams.poseZ[solid].xyz, at = materialParams.poseAt[solid].xyz;
        vec3 L = materialParams.sunDir;
        vec3 sunL = normalize(vec3(dot(L, ax.xyz), dot(L, ay), dot(L, az)));
        float n = materialParams.steps[stepAt].w;

        vec4 planeA = texelFetch(materialParams_faces, ivec2(8, A), 0);
        vec4 planeB = texelFetch(materialParams_faces, ivec2(8, B), 0);
        vec4 a0 = texelFetch(materialParams_faces, ivec2(0, A), 0);
        int cornersA = int(a0.w + 0.5);
        vec3 p = texelFetch(materialParams_faces, ivec2(corner, B), 0).xyz;      // this corner of B, in the solid's own frame
        vec3 nA = planeA.xyz, nB = planeB.xyz;

        bool ok = true;
        float ci = -dot(nA, sunL);
        if (!(ci > 1e-6)) ok = false;
        vec3 d1 = sunL, d2 = sunL;
        vec3 rgb = vec3(0.0);
        float side[8];
        for (int e = 0; e < 8; e++) side[e] = 1.0;
        if (ok && A == B) {
            // mirrored off the outside: white, once (with the first colour step)
            if (stepAt != 0) ok = false;
            d2 = sunL + nA * (2.0 * ci);
            rgb = vec3(fres(ci, 1.0, materialParams.steps[stepsAll / 2].w));
        } else if (ok) {
            d1 = refract(sunL, nA, 1.0 / n);
            float db = dot(nB, d1);
            if (!(db > 1e-7)) ok = false;
            if (materialParams.probe > 1.5) ok = false;
            float Ri = ok ? fres(db, n, 1.0) : 1.0;
            if (!(Ri < 1.0)) ok = false;                                         // mirrored back in at B: not this material's light
            if (ok) {
                d2 = refract(d1, -nB, n);
                float irr = ci * (1.0 - fres(ci, 1.0, n)) * db / abs(dot(nA, d1)) * (1.0 - Ri);
                rgb = materialParams.steps[stepAt].rgb * (materialParams.gain * irr / abs(dot(nB, d2)));   // (times how steeply it comes down: below)
                // the walls of the tube of light that came in through A: one per edge of A, along d1
                vec3 mid = vec3(0.0);
                for (int e = 0; e < 8; e++) {
                    if (e >= cornersA) break;
                    mid += texelFetch(materialParams_faces, ivec2(e, A), 0).xyz;
                }
                mid /= float(cornersA);
                for (int e = 0; e < 8; e++) {
                    if (e >= cornersA) break;
                    vec3 a = texelFetch(materialParams_faces, ivec2(e, A), 0).xyz;
                    vec3 b = texelFetch(materialParams_faces, ivec2(e + 1 == cornersA ? 0 : e + 1, A), 0).xyz;
                    vec3 wall = cross(b - a, d1);
                    side[e] = dot(wall, p - a) * sign(dot(wall, mid - a));
                }
            }
        }
        // the corner, down to the floor
        vec3 Pw = (ax.xyz * p.x + ay * p.y + az * p.z) * ax.w + at;
        vec3 dW = ax.xyz * d2.x + ay * d2.y + az * d2.z;
        if (!(dW.y < -1e-6)) ok = false;
        float fl = ok ? (materialParams.floorY - Pw.y) / dW.y : 0.0;
        vec3 X = Pw + dW * fl;
        if (!ok) {
            X = vec3(0.0);
            rgb = vec3(0.0);
            for (int e = 0; e < 8; e++) side[e] = -1.0;
        }
        CLIP(0, side[0]); CLIP(1, side[1]); CLIP(2, side[2]); CLIP(3, side[3]);
        CLIP(4, side[4]); CLIP(5, side[5]); CLIP(6, side[6]); CLIP(7, side[7]);

        // where the light of this corner came in (on A's plane), against the band of sun
        vec3 q = A == B ? p : p - d1 * ((dot(nA, p) - planeA.w) / dot(nA, d1));
        vec3 mW = vec3(materialParams.strip.x, -(materialParams.strip.x * L.x + materialParams.strip.y * L.z) / min(L.y, -1e-6), materialParams.strip.y);
        vec3 Qw = (ax.xyz * q.x + ay * q.y + az * q.z) * ax.w + at;
        material.band = vec4(dot(mW, Qw) - materialParams.strip.z, 0.0, 0.0, 0.0);
        material.light = vec4(rgb * -dW.y, fl);
        material.worldPosition = mulMat4x4Float3(getWorldFromModelMatrix(), vec3(X.x, materialParams.floorY, X.z));
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        if (materialParams.strip.w > 0.0) {
            float g = variable_band.x;
            if (materialParams.stripEvery > 0.0) g -= materialParams.stripEvery * floor(g / materialParams.stripEvery + 0.5);
            if (abs(g) > materialParams.strip.w) discard;
        }
        vec4 c = variable_light;
        material.baseColor = vec4(c.rgb, (c.r + c.g + c.b) / 3.0 * c.a);
    }
}
