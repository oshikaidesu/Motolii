// boxlight.mat: the light a glass box throws on the floor in the sun, the way the makers of such pictures do it
// (a finely cut surface, every corner's light bent and landed, brightness from how the cut is squeezed):
// the mesh is the box's own round-edged surface, cut fine. Each corner in the sun takes its ray into the box, through
// it (mirrored inside where it cannot leave), out, and down to the floor: the corner is drawn THERE. Where the landed
// cuts are squeezed together the light is gathered and bright, where they are pulled apart it is thin: that ratio is
// read off per pixel from how fast the two positions change across the screen. Every colour is its own copy, bent by
// its own index, and the indices are set far apart on purpose: the round edges are thin prisms and throw rainbows,
// the faces lean a little and gather their light into bright lines. Nothing here follows light exactly; nothing is
// worked out on the CPU.
// Not here: light that goes on through another box, light on anything but the floor, a box in another's shadow
// (it throws its light all the same).
// Mesh: kit.h's cube, cut fine (positions +-0.5). Copy (instance) = box * colours + colour. 64 boxes at most.
material {
    name : boxlight,
    shadingModel : unlit,
    blending : add,
    depthWrite : false,
    culling : none,
    instanced : true,
    variables : [ { name : tint, precision : high }, { name : where, precision : high }, { name : more, precision : high } ],
    parameters : [
        { type : float4[64], name : poseX, precision : high },   // per box: axis x, half size along it
        { type : float4[64], name : poseY, precision : high },
        { type : float4[64], name : poseZ, precision : high },
        { type : float4[64], name : poseAt, precision : high },  // its middle
        { type : float3, name : sunWay },                        // the way the sunlight travels
        { type : float3, name : sunOnFloor },                    // what the sun adds to the bare floor at noon: floor colour * lux / pi
        { type : float,  name : colours },                       // copies per box
        { type : float,  name : ior },
        { type : float,  name : abbe },                          // how far apart the colours' indices lie (small: far)
        { type : float,  name : round },                         // the edges' rounding, as a part of half the edge (the mesh has the same)
        { type : float,  name : lean },                          // how far the faces lean from flat (glassbox.mat's, here often more)
    }
}
