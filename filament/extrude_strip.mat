// The strips of light (and of shadow) that run along the walls of solids with dents and holes (beam_extrude.h).
// ONE mesh for all shapes (beam::ex_strip_mesh), drawn once per (solid, colour step); every corner is placed from
// the two textures extrude_find.mat and extrude_walk.mat have just written, and its brightness is the light its
// piece of wall catches over the floor it lands on, measured on the pieces to both sides of it.
// `family`: 0 the walls' own shadows, 1 light from the cap mirrored by the walls, 2 light from the cap out through
// the chamfer at a wall's foot, 3 light through the walls, 4 the sun mirrored off the outside of the walls, 5 light
// in through the chamfers. This is beam::detail::ex_strip_vertex, line for line; change them together.
// Output as beam_light.mat: rgb = the light, a = light * distance flown.
material {
    name : extrude_strip,
    shadingModel : unlit,
    blending : add,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    instanced : true,
    variables : [ light, land, there ],
    parameters : [
        { type : sampler2d, name : shapes, precision : high, format : float },
        { type : sampler2d, name : poses, precision : high, format : float },
        { type : sampler2d, name : find, precision : high, format : float },
        { type : sampler2d, name : walk, precision : high, format : float },
        { type : float4[8], name : steps },        // rgb, index of refraction
        { type : float4[4], name : capSteps },
        { type : float3, name : sunDir },
        { type : float,  name : sunTan },
        { type : float4[6], name : room, precision : high },                    // the stage: see recv_drop.glsl
        { type : float,  name : roomCount },
        { type : float4[16], name : blocks, precision : high },
        { type : float,  name : blockCount },
        { type : float,  name : recvCount },
        { type : float,  name : recvChooses },
        { type : float3, name : recvSun },
        { type : float,  name : pxScale },
        { type : float,  name : floorY },
        { type : float,  name : first },           // the first solid of this renderable
        { type : float,  name : per },             // instances per solid (colour steps)
        { type : float,  name : stepBase },        // the colour step of the first instance of each solid
        { type : float,  name : family },
        { type : float,  name : chamfer }          // flat width of the chamfer, in the outline's own units
    ]
}

vertex {
#include "recv_drop.glsl"
#define EX_WITH_POSES
#include "extrude_common.glsl"

    ExCtx gC;
    ExEdge gEd;
    int gSolid;
    int gFind;    // the line of step one's texture the strips of this family are cut by

    vec4 findAt(int m) { return texelFetch(materialParams_find, ivec2(m, gSolid * EX_FIND_ROWS + gFind), 0); }
    vec4 walkAt(int m, int line) { return texelFetch(materialParams_walk, ivec2(m, gSolid * EX_ROWS + line), 0); }

    // beam::detail::ExChain
    struct ExAt {
        int m;
        int which;
        bool is;
    };
    ExAt exAt(int m, int which) {
        ExAt a;
        a.m = m;
        a.which = which;
        a.is = true;
        return a;
    }
    ExAt exNone() {
        ExAt a;
        a.m = 0;
        a.which = 0;
        a.is = false;
        return a;
    }
    bool chTorn(int m, int i) {
        vec4 f = findAt(m);
        return (i == 0 ? f.y : f.w) < 0.0;
    }
    bool chEnds(int m) {
        vec3 st = exStretch(gC.s, m);
        return !(st.z > st.y);
    }
    bool chFirst(int m) {
        if (m == 0) return true;
        return exStretch(gC.s, m - 1).x != exStretch(gC.s, m).x;
    }
    float chU(ExAt a) { return exPointAt(exStretch(gC.s, a.m), findAt(a.m), a.which); }
    ExAt chPrev(ExAt a) {
        if (a.which == 0) return chFirst(a.m) ? exNone() : exAt(a.m - 1, 4);
        if (a.which == 1) return exAt(a.m, 0);
        if (a.which == 2) return chTorn(a.m, 0) ? exNone() : exAt(a.m, 0);
        if (a.which == 3) return exAt(a.m, 2);
        return chTorn(a.m, 1) ? exNone() : exAt(a.m, 2);
    }
    ExAt chNext(ExAt a) {
        if (a.which == 0) return chEnds(a.m) ? exNone() : exAt(a.m, 1);
        if (a.which == 1) return chTorn(a.m, 0) ? exNone() : exAt(a.m, 3);
        if (a.which == 2) return exAt(a.m, 3);
        if (a.which == 3) return chTorn(a.m, 1) ? exNone() : exAt(a.m + 1, 0);
        return exAt(a.m + 1, 0);
    }

    // beam::detail::ex_mirror_pt
    struct MirrorPt {
        vec2 p;
        vec2 n;
        vec2 dir0;
        vec2 dir1;
        float back;
        float at1;
    };
    MirrorPt mirrorPt(ExAt a) {
        float u = chU(a);
        vec4 t = walkAt(a.m, EX_ROW_MIRROR + a.which);
        MirrorPt m;
        m.p = exPoint(gEd, u);
        m.n = exNormal(gEd, u);
        float sn = dot(gC.sh, m.n);
        m.dir0 = gC.sh - m.n * (2.0 * sn);
        m.back = t.x;
        m.at1 = t.y;
        m.dir1 = m.dir0 - t.zw * (2.0 * dot(m.dir0, t.zw));
        return m;
    }
    // beam::detail::ex_mirror_cell
    struct MirrorCell {
        float lo;
        float hi;
        float fade;
        vec3 qlo;
        vec3 qhi;
    };
    MirrorCell mirrorCell(MirrorPt m, int cell, float S) {
        float first = max(0.0, S - m.back), mid = min(max(m.at1, first), S);
        MirrorCell r;
        vec2 plo, phi, d;
        if (cell == 0) {
            r.lo = first;
            r.hi = mid;
            d = m.dir0;
            plo = m.p + d * min(r.lo, m.at1);
            phi = m.p + d * min(r.hi, m.at1);
        } else {
            r.lo = mid;
            r.hi = S;
            d = m.dir1;
            if (m.at1 < S) {
                vec2 hit = m.p + m.dir0 * m.at1;
                plo = hit + d * (r.lo - m.at1);
                phi = hit + d * (r.hi - m.at1);
            } else {
                plo = m.p + m.dir0 * S;
                phi = plo;
                d = m.dir0;
            }
        }
        float ze = -gC.top * gC.s.h;
        vec3 D = exDir(gC, vec3(d * gC.lat, gC.L.z));
        r.qlo = exLand(gC, exWorld(gC, plo, ze), D);
        r.qhi = exLand(gC, exWorld(gC, phi, ze), D);
        r.fade = D.y < -1e-6 ? exFade(gC, 0.5 * (r.qlo.y + r.qhi.y), -D.y) : 0.0;
        return r;
    }
    // beam::detail::ex_foot
    struct Foot {
        vec3 qin;
        vec3 qout;
        float e;
        float fade;
        float fly;
    };
    Foot foot(MirrorPt m, int k) {
        Foot f;
        f.qin = vec3(0.0);
        f.qout = vec3(0.0);
        f.e = 0.0;
        f.fade = 0.0;
        f.fly = 0.0;
        float n = materialParams.steps[k].w, n2 = materialParams.steps[exNextStep(k)].w, cosCap = abs(gC.L.z), ze = -gC.top * gC.s.h, leg = gC.s.leg;
        float dz = sqrt(1.0 - gC.lat * gC.lat / (n * n)), dz2 = sqrt(1.0 - gC.lat * gC.lat / (n2 * n2));
        vec3 d = vec3(gC.sh * (gC.lat / n), -gC.top * dz), d2 = vec3(gC.sh * (gC.lat / n2), -gC.top * dz2);
        vec3 cut = vec3(m.n, -gC.top) * 0.70710678;
        float cm = dot(d, cut);
        if (!(cm > 1e-6)) return f;
        vec3 o = refract(d, -cut, n);
        if (dot(o, o) < 0.5) return f;
        vec3 D = exDir(gC, o);
        if (!(D.y < -1e-6)) return f;
        vec3 Pin = exWorld(gC, m.p - m.n * leg, ze), Pout = exWorld(gC, m.p, ze + gC.top * leg);
        f.qin = exLand(gC, Pin, D);
        f.qout = exLand(gC, Pout, D);
        // is there glass all the way back to where this light came in?
        float S = exCapStep(gC, n), open = clamp((m.back - 0.85 * S) / (0.15 * S), 0.0, 1.0);
        f.e = (1.0 - exFresnel(cosCap, 1.0, n)) * (1.0 - exFresnel(cm, n, 1.0)) * exLet(n * n * (1.0 - cm * cm)) * cosCap / dz * cm * open;
        f.fade = exFade(gC, 0.5 * (f.qin.y + f.qout.y), -D.y);
        // how far the next colour lands from this one: the line is softened by half of that as well
        vec3 o2 = refract(d2, -cut, n2);
        if (dot(o2, o2) > 0.5) {
            vec3 D2 = exDir(gC, o2);
            if (D2.y < -1e-6) f.fly = min(0.5 * length(exLand(gC, Pin, D2).xz - f.qin.xz), EX_SOFT * gC.size) / materialParams.sunTan;
        }
        return f;
    }
    // beam::detail::ex_wall_pt
    struct WallPt {
        vec2 p;
        vec2 n;
        vec2 q;
        vec2 o;
        float ci;
        float lo;
        float hi;
        float shift;
        float weight;
        float gap;
    };
    WallPt wallPt(ExAt a, int k) {
        float u = chU(a), h = gC.s.h;
        int base = EX_ROW_WALL + 10 * k + 2 * a.which;
        vec4 t0 = walkAt(a.m, base), t1 = walkAt(a.m, base + 1);
        WallPt m;
        m.p = exPoint(gEd, u);
        m.n = exNormal(gEd, u);
        m.ci = -gC.lat * dot(gC.sh, m.n);
        m.lo = -h;
        m.hi = h;
        if (gC.top > 0.0) m.lo = max(-h, h - t0.x);
        else m.hi = min(h, t0.x - h);
        m.shift = t0.y * gC.L.z / materialParams.steps[k].w;
        m.q = t0.zw;
        m.o = t1.xy;
        m.weight = t1.z;
        m.gap = t1.w;
        return m;
    }
    // beam::detail::ex_wall_fold
    struct WallFold {
        vec3 qlo;
        vec3 qhi;
        float height;
        float fade;
        bool down;
    };
    WallFold wallFold(WallPt m, int j) {
        WallFold f;
        f.qlo = vec3(0.0);
        f.qhi = vec3(0.0);
        f.height = 0.0;
        f.fade = 0.0;
        f.down = false;
        bool turned = (j - (j / 2) * 2) != 0;
        vec3 D = normalize(exDir(gC, vec3(m.o, turned ? -gC.L.z : gC.L.z)));
        if (!(m.weight >= 0.0) || !(D.y < -1e-6)) return f;
        float h = gC.s.h, fj = float(j);
        float ylo = min(max((2.0 * fj - 1.0) * h, m.lo + m.shift), m.hi + m.shift), yhi = min(max((2.0 * fj + 1.0) * h, m.lo + m.shift), m.hi + m.shift);
        f.qlo = exLand(gC, exWorld(gC, m.q, turned ? 2.0 * fj * h - ylo : ylo - 2.0 * fj * h), D);
        f.qhi = exLand(gC, exWorld(gC, m.q, turned ? 2.0 * fj * h - yhi : yhi - 2.0 * fj * h), D);
        f.height = max(0.0, yhi - ylo);
        f.fade = exFade(gC, 0.5 * (f.qlo.y + f.qhi.y), -D.y);
        f.down = true;
        return f;
    }
    // beam::detail::ex_glint
    struct Glint {
        vec3 qlo;
        vec3 qhi;
        float fade;
    };
    Glint glint(WallPt m) {
        Glint g;
        g.qlo = vec3(0.0);
        g.qhi = vec3(0.0);
        g.fade = 0.0;
        if (!(m.ci > 1e-6) || !(m.hi > m.lo)) return g;
        vec3 D = exDir(gC, vec3(gC.L.xy + m.n * (2.0 * m.ci), gC.L.z));
        if (!(D.y < -1e-6)) return g;
        g.qlo = exLand(gC, exWorld(gC, m.p, m.lo), D);
        g.qhi = exLand(gC, exWorld(gC, m.p, m.hi), D);
        g.fade = exFade(gC, 0.5 * (g.qlo.y + g.qhi.y), -D.y);
        return g;
    }
    float squeeze(float num, float den) { return den * EX_CAP > num ? num / den : EX_CAP; }

    // beam::detail::ex_strip_vertex. Returns false if the strip this corner belongs to is not drawn.
    bool stripVertex(int family, int k, int m, int part, int corner, int slot, out vec3 q, out vec3 rgb, out float fly) {
        q = vec3(0.0);
        rgb = vec3(0.0);
        fly = 0.0;
        if (m >= gC.s.stretches || !(gC.Lw.y < -1e-6)) return false;
        float h = gC.s.h, ze = -gC.top * h, cosCap = abs(gC.L.z), down = -gC.Lw.y;
        vec3 st = exStretch(gC.s, m);
        if (!(st.z > st.y)) return false;
        gEd = exEdge(gC.s, int(st.x + 0.5));
        bool end = corner >= 2, far = corner == 1 || corner == 2;
        ExAt self = end ? (part == 2 ? exAt(m + 1, 0) : exAt(m, 2 * part + 1)) : exAt(m, 2 * part);
        if (family == 5) {
            // no place of change is looked for here: the line is thin; it goes dark towards a change instead
            if (part != 0 || !(gC.s.leg > 0.0)) return false;
            int stepAt = k < EX_STEPS ? k : k - EX_STEPS;
            int base = EX_ROW_CUT + 2 * k, baseNext = EX_ROW_CUT + 2 * (k - stepAt + exNextStep(stepAt));
            int ms = end ? m + 1 : m, mo = end ? m : m + 1;
            vec4 s0 = walkAt(ms, base), s1 = walkAt(ms, base + 1), o1 = walkAt(mo, base + 1);
            if (!(s1.x > 0.0) || !(o1.x > 0.0) || s1.w != o1.w || !(s1.y > 0.0) || !(o1.y > 0.0)) return false;
            vec2 ps = exPoint(gEd, exStretch(gC.s, ms).y);
            float num = 0.0, den = 0.0, low = s1.y;
            for (int i = 0; i < 2; i++) {
                int mn = i == 0 ? ms - 1 : ms + 1;
                if (i == 0 ? chFirst(ms) : chEnds(ms)) continue;
                vec4 n0 = walkAt(mn, base), n1 = walkAt(mn, base + 1);
                if (!(n1.x > 0.0) || n1.w != s1.w) {
                    low = 0.0;   // the line ends, or changes its way, next to this point
                    continue;
                }
                low = min(low, n1.y);
                vec2 pn = exPoint(gEd, exStretch(gC.s, mn).y);
                num += length(pn - ps) * materialParams.chamfer * gC.sc * gC.sc;
                den += exArea(vec3(s0.x, 0.0, s0.y), vec3(s0.z, 0.0, s0.w), vec3(n0.z, 0.0, n0.w), vec3(n0.x, 0.0, n0.y));
            }
            vec4 g0 = walkAt(ms, baseNext), g1 = walkAt(ms, baseNext + 1);
            fly = s1.z;
            if (g1.x > 0.0 && g1.w == s1.w) fly += min(0.5 * length(0.5 * (g0.xy + g0.zw - s0.xy - s0.zw)), EX_SOFT * gC.size) / materialParams.sunTan;
            q = far ? vec3(s0.z, s1.z, s0.w) : vec3(s0.x, s1.z, s0.y);
            rgb = materialParams.steps[stepAt].rgb * (s1.x * low * squeeze(num, den));
            return true;
        }
        ExAt before = chPrev(self), after = chNext(self);
        ExAt nb[2];
        nb[0] = before;
        nb[1] = after;
        int oi = end ? 0 : 1;   // which of the two neighbours is the other end of this part
        if (!nb[oi].is) return false;
        if (family == 0) {
            if (!(gC.lat > 1e-6)) return false;
            vec2 p = exPoint(gEd, chU(self)), po = exPoint(gEd, chU(nb[oi]));
            if (!(exCross(gC.sh, end ? p - po : po - p) > 0.0)) return false;
            float up = self.which < 4 ? walkAt(self.m, EX_ROW_SHADOW)[self.which] : walkAt(self.m, EX_ROW_SHADOW + 1).x;
            // (it starts a hair inside the outline, so that no crack can open between the two)
            q = exLand(gC, far ? exWorld(gC, p, ze + gC.top * up) : exWorld(gC, p - gC.sh * EX_OVER, ze), gC.Lw);
            rgb = vec3(1.0);
            fly = q.y;
            return true;
        }
        if (family == 1 || family == 2) {
            if (!(gC.lat > 1e-6) || !(cosCap > 1e-6)) return false;
            MirrorPt ms = mirrorPt(self);
            MirrorPt mn[2];
            bool has[2];
            for (int i = 0; i < 2; i++) {
                mn[i] = ms;
                has[i] = false;
                if (!nb[i].is) continue;
                mn[i] = mirrorPt(nb[i]);
                has[i] = exCross(gC.sh, i == 0 ? ms.p - mn[i].p : mn[i].p - ms.p) > 0.0;   // (the wall between must look away from the sun)
            }
            if (!has[oi]) return false;
            if (family == 1) {
                float n = materialParams.capSteps[k].w, S = exCapStep(gC, n), T = (1.0 - exFresnel(cosCap, 1.0, n)) * (1.0 - exFresnel(cosCap, 1.0, n));
                if (slot == 0) return false;   // (what the walls take out of the window: only the CPU's copy draws that, see beam::detail::ex_window)
                int cell = slot - 1;
                MirrorCell cs = mirrorCell(ms, cell, S);
                float num = 0.0, den = 0.0, low = cs.fade;
                bool drawn = cs.fade > 0.0;
                for (int i = 0; i < 2; i++) {
                    if (!has[i]) continue;
                    MirrorCell cn = mirrorCell(mn[i], cell, S);
                    low = min(low, cn.fade);
                    if (i == oi) drawn = drawn && cn.fade > 0.0;
                    vec2 u0 = ms.p + gC.sh * cs.lo, u1 = ms.p + gC.sh * cs.hi, u2 = mn[i].p + gC.sh * cn.hi, u3 = mn[i].p + gC.sh * cn.lo;
                    num += 0.5 * abs(exCross(u2 - u0, u3 - u1)) * gC.sc * gC.sc * cosCap;
                    den += exArea(cs.qlo, cs.qhi, cn.qhi, cn.qlo);
                }
                if (!drawn) return false;   // (a strip that is dark at either end is not drawn at all)
                q = far ? cs.qhi : cs.qlo;
                rgb = materialParams.capSteps[k].rgb * (T * low * squeeze(num, den));
                fly = q.y;
                return true;
            }
            if (!(gC.s.leg > 0.0)) return false;
            Foot fs = foot(ms, k);
            float num = 0.0, den = 0.0, low = fs.fade;
            bool drawn = fs.fade > 0.0;
            for (int i = 0; i < 2; i++) {
                if (!has[i]) continue;
                Foot fn = foot(mn[i], k);
                low = min(low, fn.fade);   // (where the line ends it is dark already)
                if (i == oi) drawn = drawn && fn.fade > 0.0;
                num += length(mn[i].p - ms.p) * materialParams.chamfer * gC.sc * gC.sc;
                den += exArea(fs.qin, fs.qout, fn.qout, fn.qin);
            }
            if (!drawn) return false;
            q = far ? fs.qout : fs.qin;
            rgb = materialParams.steps[k].rgb * (fs.e * low * squeeze(num, den));
            fly = q.y + fs.fly;
            return true;
        }
        // 3: through the walls, 4: mirrored off them
        if (!(gC.lat > 1e-6)) return false;
        WallPt ws = wallPt(self, k);
        WallPt wn[2];
        bool has[2];
        for (int i = 0; i < 2; i++) {
            wn[i] = ws;
            has[i] = nb[i].is;
            if (has[i]) wn[i] = wallPt(nb[i], k);
        }
        if (family == 4) {
            Glint gs = glint(ws);
            float num = 0.0, den = 0.0, low = gs.fade;
            bool drawn = gs.fade > 0.0;
            for (int i = 0; i < 2; i++) {
                if (!has[i]) continue;
                Glint gn = glint(wn[i]);
                if (i == oi) drawn = drawn && gn.fade > 0.0;
                if (!(wn[i].ci > 1e-6)) continue;
                low = min(low, gn.fade);
                num += length(wn[i].p - ws.p) * 0.5 * (ws.hi - ws.lo + wn[i].hi - wn[i].lo) * gC.sc * gC.sc;
                den += exArea(gs.qlo, gs.qhi, gn.qhi, gn.qlo);
            }
            if (!drawn) return false;
            q = far ? gs.qhi : gs.qlo;
            rgb = vec3(ws.ci * exFresnel(ws.ci, 1.0, materialParams.steps[k].w) * low * squeeze(num, den));
            fly = q.y;
            return true;
        }
        if (!(ws.weight >= 0.0) || !(wn[oi].weight >= 0.0)) return false;
        // Three folds are drawn, from the lowest that the piece between this point and the other end of the part reaches.
        int j = int(floor((min(ws.lo + ws.shift, wn[oi].lo + wn[oi].shift) + h) / (2.0 * h))) + slot;
        WallFold fs = wallFold(ws, j);
        // how bright: the sun this fold's piece of wall catches over the floor it lands on, on both sides of this point
        float num = 0.0, den = 0.0, low = fs.fade;
        bool drawn = fs.fade > 0.0;
        for (int i = 0; i < 2; i++) {
            if (!has[i] || !(wn[i].weight >= 0.0)) continue;
            WallFold fn = wallFold(wn[i], j);
            low = min(low, fn.fade);
            if (i == oi) drawn = drawn && fn.fade > 0.0;
            if (!fn.down || !fs.down) continue;
            num += length(wn[i].p - ws.p) * 0.5 * (fs.height + fn.height) * gC.sc * gC.sc;
            den += exArea(fs.qlo, fs.qhi, fn.qhi, fn.qlo);
        }
        if (!drawn) return false;
        q = far ? fs.qhi : fs.qlo;
        rgb = materialParams.steps[k].rgb * (ws.ci * ws.weight * low * squeeze(num, den));
        fly = q.y + min(0.5 * q.y * ws.gap, EX_SOFT * gC.size) / materialParams.sunTan;
        return true;
    }

    void materialVertex(inout MaterialVertexInputs material) {
        int receivers = recvPer();
        int recv = getInstanceIndex() - (getInstanceIndex() / receivers) * receivers;   // which receiver this instance draws on (recv_drop.glsl)
        int per = int(materialParams.per + 0.5), inst = getInstanceIndex() / receivers;
        int which = inst / per;
        int k = int(materialParams.stepBase + 0.5) + inst - which * per;
        int family = int(materialParams.family + 0.5);
        gSolid = int(materialParams.first + 0.5) + which;
        gC = exCtx(gSolid, materialParams.sunDir, materialParams.floorY);
        gFind = family == 0 ? 0 : (family == 1 || family == 2 ? 1 : (family == 5 ? 0 : 2 + k));
        int m = int(mesh_position.x + 0.5), pc = int(mesh_position.y + 0.5), slot = int(mesh_position.z + 0.5);
        int part = pc / 4;
        vec3 q, rgb;
        float fly;
        if (!stripVertex(family, k, m, part, pc - part * 4, slot, q, rgb, fly)) {
            // not drawn: all four corners of the strip go to one point
            q = vec3(gC.O.x, 0.0, gC.O.z);
            rgb = vec3(0.0);
            fly = 0.0;
        }
        float t, ok, owner;
        highp vec3 start;
        highp vec3 X = recvDrop(recv, q.xz, q.y, family != 0, rgb, t, ok, owner, start);
        material.light = vec4(rgb, t + (fly - q.y));   // (as far as it flew to there, and the softening that joins the colour steps)
        material.land = vec4(start, owner);
        material.there = vec4(ok);
        material.worldPosition = recvNearer(mulMat4x4Float3(getWorldFromModelMatrix(), X), owner);
    }
}

fragment {
#include "recv_lands.glsl"
#include "recv_finish.glsl"
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 c = variable_light;
        material.baseColor = recvFinish(c, variable_there.x, floor(variable_land.w + 0.5), variable_land.xyz, materialParams.family < 0.5);
    }
}
