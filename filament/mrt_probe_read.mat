// MRT probe, second stage (see mrt_probe.mm): reads the three outputs of mrt_probe.mat and puts one number of each
// into a single output.
material {
    name : mrt_probe_read,
    shadingModel : unlit,
    vertexDomain : device,
    blending : opaque,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    flipUV : false,
    parameters : [
        { type : sampler2d, name : first, precision : high, format : float },
        { type : sampler2d, name : second, precision : high, format : float },
        { type : sampler2d, name : third, precision : high, format : float }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        ivec2 px = ivec2(gl_FragCoord.xy);
        material.baseColor = vec4(texelFetch(materialParams_first, px, 0).x, texelFetch(materialParams_second, px, 0).x,
                                  texelFetch(materialParams_third, px, 0).x, texelFetch(materialParams_third, px, 0).w);
    }
}
