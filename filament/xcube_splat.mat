// Quads reuse the hit texture. No ray is walked here.
material {
    name : xcube_splat,
    shadingModel : unlit,
    blending : add,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    parameters : [
        { type : sampler2d, name : hits, precision : high, format : float },
        { type : float, name : hitW },
        { type : float, name : hitH },
        { type : float, name : extent },
        { type : float, name : grid },
        { type : float, name : bands },
        { type : float, name : lux }
    ],
    requires : [ uv0 ]
}

vertex {
    vec4 load_hit(int ix, int iy, int band, int path) {
        float grid = materialParams.grid;
        float u = (float(ix + band * int(grid)) + 0.5) / materialParams.hitW;
        float v = (float(iy + path * int(grid)) + 0.5) / materialParams.hitH;
        return textureLod(materialParams_hits, vec2(u, v), 0.0);
    }

    float tri_area(vec3 a, vec3 b, vec3 c) {
        return 0.5 * abs((b.x - a.x) * (c.y - a.y) - (c.x - a.x) * (b.y - a.y));
    }

    float dist2(vec3 a, vec3 b) {
        vec2 d = a.xy - b.xy;
        return dot(d, d);
    }

    vec3 spot(vec4 s) { return vec3(s.x, s.y, s.z); }

    void materialVertex(inout MaterialVertexInputs material) {
        int v = getVertexIndex();
        int corner = v - (v / 6) * 6;
        int rest = v / 6;
        int path = rest - (rest / 8) * 8;
        rest = rest / 8;
        int nb = int(materialParams.bands);
        int band = rest - (rest / nb) * nb;
        int id = rest / nb;
        int cells = int(materialParams.grid) - 1;
        int gx = id - (id / cells) * cells;
        int gy = id / cells;
        vec4 sa = load_hit(gx, gy, band, path);
        vec4 sc = load_hit(gx + 1, gy, band, path);
        vec4 sb = load_hit(gx, gy + 1, band, path);
        vec4 sd = load_hit(gx + 1, gy + 1, band, path);
        vec3 a = spot(sa);
        vec3 c = spot(sc);
        vec3 b = spot(sb);
        vec3 d = spot(sd);
        bool ok = sa.w > 0.5 && sc.w > 0.5 && sb.w > 0.5 && sd.w > 0.5;
        float lim = 0.55 * 0.55;
        if (dist2(a, c) > lim || dist2(a, b) > lim || dist2(c, d) > lim || dist2(b, d) > lim) ok = false;
        float area = corner < 3 ? tri_area(a, c, d) : tri_area(a, d, b);
        if (area < 1e-8) ok = false;
        vec3 hit = corner == 1 ? c : (corner == 5 ? b : ((corner == 2 || corner == 4) ? d : a));
        float cell = (2.0 * materialParams.extent) / (materialParams.grid - 1.0);
        float flux = materialParams.lux * cell * cell * (a.z + c.z + b.z + d.z) * 0.25;
        float illum = min(flux * 0.5 / area, 50000.0) / 50000.0;
        material.worldPosition.xyz += ok ? vec3(hit.x, illum, hit.y) : vec3(0.0, -80.0, 0.0);
    }
}

fragment {
    vec3 wave(float nm) {
        float r = 0.0;
        float g = 0.0;
        float b = 0.0;
        if (nm < 490.0) {
            g = (nm - 440.0) / 50.0;
            b = 1.0;
        } else if (nm < 510.0) {
            g = 1.0;
            b = (510.0 - nm) / 20.0;
        } else if (nm < 580.0) {
            r = (nm - 510.0) / 70.0;
            g = 1.0;
        } else if (nm < 645.0) {
            r = 1.0;
            g = (645.0 - nm) / 65.0;
        } else {
            r = 1.0;
        }
        return max(vec3(r, g, b), vec3(0.0));
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        int band = int(getUV0().x + 0.5);
        float nb = materialParams.bands;
        float nm = 450.0 + 220.0 * ((float(band) + 0.5) / nb);
        vec3 sum = vec3(0.0);
        for (int i = 0; i < 21; i++) {
            if (float(i) < nb) sum += wave(450.0 + 220.0 * ((float(i) + 0.5) / nb));
        }
        vec3 rgb = wave(nm) / max(sum, vec3(1e-6));
        float illum = clamp(getWorldPosition().y + 4.0, 0.0, 1.0) * 50000.0;
        material.baseColor = vec4(rgb * illum, 1.0);
    }
}
