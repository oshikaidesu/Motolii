// Single-channel caustic reconstruction, reimplemented from the published
// À-trous kernel (MPL-2.0), not the water-depth mip selector:
// https://github.com/AshenOneArt/HPWater
//   HPWaterCausticCompute.compute  AtrousDenoiseFirst_Single
//   HPWaterCommon.hlsl             ComputeEdgeWeight
//   HPWater.shader                 FragAtrousSingle_ColorToIrradiance
// HPWater skips this filter in RGB mode. This pass runs on one illuminance.
material {
    name : caustic_atrous,
    shadingModel : unlit,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    parameters : [
        { type : sampler2d, name : src, format : float },
        { type : float2, name : texel },
        { type : float, name : stride },
        { type : float, name : lumWeight },
        { type : float, name : mip },
        { type : float, name : second }
    ],
    requires : [ uv0 ]
}

fragment {
    float edgeWeight(float centerLum, float sampleLum, float w) {
        float lumDiff = abs(log2(1.0 + centerLum) - log2(1.0 + sampleLum));
        float strictness = smoothstep(0.0, 0.25, min(centerLum, sampleLum));
        return exp2(-lumDiff * w * strictness);
    }

    float spatial(int x, int y) {
        int a = abs(x) + abs(y);
        if (a == 0) return 4.0 / 16.0;
        if (a == 1) return 2.0 / 16.0;
        return 1.0 / 16.0;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = getUV0();
        float mip = materialParams.mip;
        vec2 step = materialParams.texel * materialParams.stride;
        vec3 center = textureLod(materialParams_src, uv, mip).rgb;
        float centerLum = max(center.r, max(center.g, center.b));
        vec3 acc = vec3(0.0);
        float wsum = 0.0;
        for (int y = -1; y <= 1; y++) {
            for (int x = -1; x <= 1; x++) {
                vec2 suv = uv + vec2(float(x), float(y)) * step;
                vec3 s = textureLod(materialParams_src, suv, mip).rgb;
                float sampleLum = max(s.r, max(s.g, s.b));
                float ew = edgeWeight(centerLum, sampleLum, materialParams.lumWeight);
                float w;
                if (materialParams.second > 0.5) {
                    if (mip < 4.0) ew = mix(ew, 1.0, mip / 4.0);
                    else ew = 1.0;
                    w = spatial(x, y) * ew;
                } else {
                    w = spatial(x, y) * mix(ew, 1.0, 0.25);
                }
                acc += s * w;
                wsum += w;
            }
        }
        material.baseColor = vec4(acc / max(wsum, 1e-6), 1.0);
    }
}
