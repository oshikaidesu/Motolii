// flat.mat: a sheet that shows a picture drawn for the screen (ThorVG's, drawn.h) as it was drawn: its colours are
// the screen's own numbers, so they are taken back to light before Filament's output step turns light into screen
// numbers again. Unlit: no lamp and no shadow touches it. flat_lit (kit_wgpu.sh: -TSHADE=lit -DLIT) is the same sheet in
// the lamps' light, as an After Effects 3D layer once its composition has a light: its colour the surface's.
material {
    name : flat,
    shadingModel : ${SHADE},
    requires : [ uv0 ],
    instanced : true,   // (its copies drawn in one go tell which they are: kit.h add_parts, the copies' own colours below)
    variables : [ copyOf, deepAt, deepEye, deepUp ],
    culling : none,
    doubleSided : true,
    transparentShadow : true,   // (it throws the shadow of what is drawn of it: Filament's own, dithered by how clear it is)
    blending : ${BLENDING},   // (kit_wgpu.sh builds it once for each way a sheet lies on what is behind: transparent, add, multiply, screen)
    depthWrite : true,
    parameters : [
        { type : sampler2d, name : matte0 }, { type : sampler2d, name : matte1 }, { type : sampler2d, name : matte2 }, { type : sampler2d, name : matte3 },
        { type : mat4, name : matteEye0 }, { type : mat4, name : matteEye1 }, { type : mat4, name : matteEye2 }, { type : mat4, name : matteEye3 },
        { type : float4, name : matteUse }, { type : float4, name : matteSoft },   // (matte.glsl)
        { type : float, name : opacity },    // how much of it is there at all (ThorVG's word): 1 all, 0 none
        { type : float, name : glowing },    // how much brighter than itself it shines (0: as it is; past 1 the stage's bloom takes it up)
        { type : float4, name : wash },      // a colour laid over it where it is drawn, and how much (a copy's own, from a ramp along the copies; 0: none)
        { type : sampler2d, name : backdrop },   // what lies under it as drawn so far, when its way of lying reads it (kit.h pictures_of)
        { type : float, name : blendWay },       // that way (doc.h doc_blend_way: 1 darken ... 13 luminosity; 0: the GPU's own blending)
        { type : float, name : behind },         // 1: its fill is what is behind it, as it is (doc.h: fill behind, a copy of the background; then its blend as said)
        { type : mat4, name : behindEye },       // where the stage's eye sees a point of the world: where in that picture a point of it is, on the stage or on a sheet of its own (matte.glsl's matteEye)
        { type : float4[8], name : ramp },   // its copies' colours from the first to the last (copy_fill), when they are drawn in one go
        { type : float4, name : rampOf },    // which copy the first of this one draw is, how many copies there are, how many colours, 1: one each in turn (0 copies: none)
        { type : float4, name : copyFade },  // the last copy's clearness, how many copies, which copy the first of this one draw is, 1: on (After Effects' Repeater, End Opacity)
        { type : float4, name : window },    // the part of the picture across this copy shows, from x to y of its width, when z is 1 (a text's letter of its own)
        { type : float4, name : key },       // a colour of the picture that is to be clear (a green screen), and how near to it counts (0: none)
        { type : float2, name : keySoft },   // how wide the edge of that is, and how far from it the key's colour is taken out of what stays
        { type : float, name : filmed },       // 1: the picture is a film's as its decoder left it, light in `picture` and colour in `colours`
        { type : mat4, name : filmRule },      // from a film's own three numbers (and a one) to red, green, blue: the rule the file names (video.h)
        { type : sampler2d, name : colours },
        { type : sampler2d, name : picture },
        // a flat shape in triangles bent as it is drawn (drawn.h flat_mesh; all 0: not), in shares of its height:
        // [0] After Effects' wave warp: how high, how long a wave, how far along in waves, which way (radians);
        // [1] Cavalry's bend: how far round (radians), which way (0 across, 1 up); After Effects' twist (radians at its middle); Cavalry's pinch (-1 to 1: in, or out);
        // [2] Cavalry's skew (radians) and its axis (radians); squash and stretch (-1 to 1, its area kept); half its width;
        // [3] After Effects' wiggle paths: how far, how fine (waves to its height), how far on in time, its seed;
        // [4] Cavalry's motion stretch: which way it moves and how fast (its own units a second, as it is turned), how much it stretches for that;
        // [5] [6] After Effects' corner pin: how far its corners are moved (top left, top right; bottom left, bottom right)
        { type : float4[8], name : bends },
        // a film's own look, as ThorVG's effects give a picture theirs: [0] how far it is blurred (across, up: shares of
        // the picture), how much its darks and lights are made two colours, how much three; [1] [2] the two (tint);
        // [3] [4] [5] the three (tritone: shadow, middle, highlight). All 0: as it is.
        { type : float4[6], name : grade },
        // a thing with depth (deep.glsl): half its box across, up and through, in its own lengths (all 0: a sheet), and 1: its box open (0: Z 0, shut, a sheet);
        // how its box's corners turn into its picture's (a film on its side: video.h)
        { type : float4, name : deep },
        { type : float4, name : deepTurn }
    ]
}

vertex {
    float bendHash(vec3 p) { return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453); }
    float bendNoise(vec3 p) {   // (value noise, smooth: -1 to 1)
        vec3 i = floor(p), f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        float a = mix(mix(bendHash(i), bendHash(i + vec3(1, 0, 0)), f.x), mix(bendHash(i + vec3(0, 1, 0)), bendHash(i + vec3(1, 1, 0)), f.x), f.y);
        float b = mix(mix(bendHash(i + vec3(0, 0, 1)), bendHash(i + vec3(1, 0, 1)), f.x), mix(bendHash(i + vec3(0, 1, 1)), bendHash(i + vec3(1, 1, 1)), f.x), f.y);
        return 2.0 * mix(a, b, f.z) - 1.0;
    }
    vec2 turned(vec2 p, float a) { float c = cos(a), s = sin(a); return vec2(c * p.x - s * p.y, s * p.x + c * p.y); }
#include "deep_vertex.glsl"
    void materialVertex(inout MaterialVertexInputs material) {
        material.copyOf = vec4(float(getInstanceIndex()), 0.0, 0.0, 0.0);
        if (materialParams.deep.z > 0.0) deepVertex(material);
        vec4 wave = materialParams.bends[0], bend = materialParams.bends[1], skew = materialParams.bends[2], wig = materialParams.bends[3], move = materialParams.bends[4];
        vec4 pinTop = materialParams.bends[5], pinBottom = materialParams.bends[6];
        float stretch = move.z * length(move.xy);
        bool pinned = pinTop != vec4(0.0) || pinBottom != vec4(0.0);
        if (wave.x == 0.0 && bend.x == 0.0 && bend.z == 0.0 && bend.w == 0.0 && skew.x == 0.0 && skew.z == 0.0 && wig.x == 0.0 && stretch == 0.0 && !pinned) return;
        vec2 p0 = vec2(material.uv0.x, 1.0 - material.uv0.y), p = p0;   // (where its point is, in shares of its height from its middle: flat_mesh; Filament turns uv0 upside down, flipUV, and this turns it back)
        float halfWide = max(skew.w, 1e-3), reach = length(vec2(halfWide, 0.5));
        if (pinned) {   // (each corner moved so far, all within between them in proportion: across, then down)
            vec2 f = clamp(vec2(p.x / (2.0 * halfWide) + 0.5, 0.5 - p.y), 0.0, 1.0);
            p += mix(mix(pinTop.xy, pinTop.zw, f.x), mix(pinBottom.xy, pinBottom.zw, f.x), f.y);
        }
        if (skew.z != 0.0) p *= vec2(1.0 / (1.0 + skew.z), 1.0 + skew.z);   // (squashed or stretched up, as wide the other way: its area kept)
        if (skew.x != 0.0) { vec2 q = turned(p, -skew.y); q.x += q.y * tan(skew.x); p = turned(q, skew.y); }
        if (bend.x != 0.0) {   // (round a centre of its own, as far round as told across all of it)
            bool up = bend.y > 0.5;
            vec2 q = up ? vec2(p.y, -p.x) : p;
            float span = up ? 1.0 : 2.0 * halfWide, r = span / bend.x, a = q.x / r;
            q = vec2((r - q.y) * sin(a), r - (r - q.y) * cos(a));
            p = up ? vec2(-q.y, q.x) : q;
        }
        if (bend.z != 0.0) p = turned(p, bend.z * max(0.0, 1.0 - length(p) / reach));   // (twisted most at its middle)
        if (bend.w != 0.0) { float d = length(p); if (d > 1e-5) p *= pow(d / reach, bend.w * 1.5) ; }   // (pinched in towards its middle, or out)
        if (wave.x != 0.0) { vec2 dir = vec2(cos(wave.w), sin(wave.w)); p += vec2(-dir.y, dir.x) * wave.x * sin(6.2831853 * (dot(p, dir) / max(wave.y, 1e-4) + wave.z)); }
        if (stretch != 0.0) {   // (longer along the way it goes, as much narrower across: its area kept)
            vec2 way = normalize(move.xy), side = vec2(-way.y, way.x);
            float along = 1.0 + stretch;
            p = way * dot(p, way) * along + side * dot(p, side) / along;
        }
        if (wig.x != 0.0) p += wig.x * vec2(bendNoise(vec3(p0 * wig.y, wig.z + wig.w)), bendNoise(vec3(p0 * wig.y + 17.3, wig.z + wig.w + 5.1)));
        vec4 region = materialParams.bends[7];   // (where the bends work, a behaviour's falloff, Cavalry's, point by point: centre on the stage, radius, soft (below 0: the other way))
        float w = 1.0;
        if (region.z > 0.0) {
            w = 1.0 - smoothstep(region.z, region.z + abs(region.w) + 1e-5, distance(material.worldPosition.xy, region.xy));
            if (region.w < 0.0) w = 1.0 - w;
        }
        material.worldPosition.xyz += mulMat3x3Float3(getWorldFromModelMatrix(), vec3(p - p0, 0.0)) * w;
    }
}

fragment {
#include "matte.glsl"
#include "blend_way.glsl"
    // A green screen: how much of this point stays, by how far its colour is from the key's with brightness left
    // out (the two colour numbers of video, Cb and Cr). On the edge a point is part film, part screen: the screen's
    // part is taken out of its colour (its strongest of red, green, blue brought down to the next: the usual way), and
    // what is then left is already the film's share of the point, so it is not dimmed again by how much stays.
    vec2 hue(vec3 c) { return vec2(dot(c, vec3(-0.1146, -0.3854, 0.5)), dot(c, vec3(0.5, -0.4542, -0.0458))); }
    float keyLeft(inout vec3 c) {
        vec4 key = materialParams.key;
        if (key.a <= 0.0) return 1.0;
        float beyond = distance(hue(c), hue(key.rgb)) - key.a;
        float spilt = 1.0 - smoothstep(0.5, 1.0, beyond / max(materialParams.keySoft.y, 1e-4));   // (all of it out to half that far, then less)
        vec3 of = step(vec3(max(key.r, max(key.g, key.b)) - 1e-3), key.rgb);   // (which of the three is the key's)
        float next = max(max(c.r * (1.0 - of.r), c.g * (1.0 - of.g)), c.b * (1.0 - of.b));
        c = mix(c, min(c, mix(c, vec3(next), of)), spilt);
        return clamp(beyond / max(materialParams.keySoft.x, 1e-4), 0.0, 1.0);
    }
    vec3 filmAt(vec2 uv) {   // (a film's colour at a place: its light and its colour planes, by the film's own rule)
        return clamp((materialParams.filmRule * vec4(textureLod(materialParams_picture, uv, 0.0).r, textureLod(materialParams_colours, uv, 0.0).rg, 1.0)).rgb, 0.0, 1.0);
    }
    float deepThere(highp vec2 uv) {   // (how much of it is at a point of its picture: its own clearness, a film's where it is not keyed out, a letter's within its part)
        if (materialParams.window.z > 0.5 && (uv.x < materialParams.window.x || uv.x >= materialParams.window.y)) return 0.0;
        if (materialParams.filmed < 0.5) return textureLod(materialParams_picture, uv, 0.0).a;
        if (materialParams.key.a <= 0.0) return 1.0;
        vec3 c = filmAt(uv);
        return keyLeft(c);
    }
    highp vec2 deepCells() { return vec2(textureSize(materialParams_picture, 0)); }
#include "deep.glsl"
#if defined(LIT)
    // (a box's point is not where its sheet is: the sun's first shadow map is read at the point met, as Filament reads its others,
    // surface_getters.fs. Its shadow code comes after this, ShaderGenerator.cpp)
#define getCascadeLightSpacePosition(cascade) computeLightSpacePosition(getWorldPosition(), getWorldGeometricNormalVector(), frameUniforms.lightDirection, shadowUniforms.shadows[cascade].normalBias, shadowUniforms.shadows[cascade].lightFromWorldMatrix)
#endif
    void material(inout MaterialInputs material) {
        highp vec2 uv = getUV0();
        float deepShade = 1.0, deepShine = 0.0, deepEdge = -1.0;
        gl_FragDepth = gl_FragCoord.z;
        if (materialParams.deep.z > 0.0) deepMeet(uv, deepShade, deepShine, deepEdge);
#if defined(LIT)
        material.normal = deepEdge >= 0.0 ? transpose(shading_tangentToWorld) * shading_geometricNormal : vec3(0.0, 0.0, 1.0);
#endif
        prepareMaterial(material);
        if (materialParams.window.z > 0.5 && (uv.x < materialParams.window.x || uv.x >= materialParams.window.y)) discard;   // (a letter: its own part of the words only)
        vec4 drawn = textureLod(materialParams_picture, uv, 0.0);   // (a drawn picture says itself how clear each point is; a film's is all there)
        vec3 c = deepEdge >= 0.0 ? drawn.rgb / max(drawn.a, 1e-4) : drawn.rgb;   // (a ray takes its colour whole, as AbsentMotion's: its edge is told by `edge`)
        if (materialParams.filmed > 0.5) {
            // video keeps light and colour apart, in its own range: to red, green, blue by the film's own rule
            c = filmAt(uv);
            vec4 g = materialParams.grade[0];
            if (g.x > 0.0 || g.y > 0.0) {   // (blurred: read at twelve places round it, near and far, and itself)
                vec3 sum = c;
                for (int k = 0; k < 12; k++) {
                    float a = 6.2831853 * (float(k) + 0.5 * float(k / 6)) / 6.0, r = k < 6 ? 0.45 : 1.0;
                    sum += filmAt(uv + vec2(cos(a), sin(a)) * g.xy * r);
                }
                c = sum / 13.0;
            }
        }
        // (the screen's own rule, exactly: Filament's output step is its reverse, so a number comes out as it went in)
        float kept = keyLeft(c);
        vec4 g = materialParams.grade[0];   // (a film's colours made two or three, after its green is keyed out by its own: ThorVG's tint and tritone)
        float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
        if (g.z > 0.0) c = mix(c, mix(materialParams.grade[1].rgb, materialParams.grade[2].rgb, l), g.z);
        if (g.w > 0.0) c = mix(c, l < 0.5 ? mix(materialParams.grade[3].rgb, materialParams.grade[4].rgb, 2.0 * l) : mix(materialParams.grade[4].rgb, materialParams.grade[5].rgb, 2.0 * l - 1.0), g.w);   // (the colour is then the film's share of the point already: only its clearness is `kept`)
        float there = deepEdge >= 0.0 ? deepEdge : materialParams.filmed > 0.5 ? 1.0 : drawn.a;
        c = min(c * deepShade + deepShine, vec3(1.0));
        if (kept * there < 0.004) discard;   // (where nothing of it is left it is not there at all: it hides nothing behind it)
        float uncut = matteLeft() * materialParams.opacity;
        if (uncut < 0.004) discard;
        material.baseColor = vec4(mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c)), kept) * (there * uncut);
        vec4 wash = materialParams.wash;
        vec4 of = materialParams.rampOf;
        if (of.y > 0.0) {   // (a copy drawn with others in one go: its colour from its place along the ramp, as doc.h gives each its own)
            float k = of.x + variable_copyOf.x;
            int colours = int(of.z);
            if (of.w > 0.5) wash = vec4(materialParams.ramp[int(mod(k + 0.5, of.z))].rgb, 1.0);
            else {
                float along = of.y > 1.0 ? k / (of.y - 1.0) * (of.z - 1.0) : 0.0;
                int i = min(int(along), colours - 2);
                wash = vec4(mix(materialParams.ramp[i].rgb, materialParams.ramp[i + 1].rgb, along - float(i)), 1.0);
            }
        }
        material.baseColor.rgb = mix(material.baseColor.rgb, wash.rgb * material.baseColor.a, wash.a);   // (a copy's own colour, where it is drawn)
        vec4 fade = materialParams.copyFade;
        if (fade.w > 0.5) material.baseColor *= mix(1.0, fade.x, fade.y > 1.0 ? (fade.z + variable_copyOf.x) / (fade.y - 1.0) : 0.0);   // (each copy clearer along them, from the first, as itself, to the last)
#if defined(LIT)
        material.emissive = vec4(material.baseColor.rgb * materialParams.glowing, 0.0);   // (it lights itself, as floor_lit.mat)
#else
        material.baseColor.rgb *= 1.0 + materialParams.glowing;   // (a neon: its own colour, brighter than white)
#endif
        if (materialParams.behind > 0.5 && material.baseColor.a > 1e-4) {   // (its fill what is behind it, where it is: a copy of the background in its shape)
            highp vec4 seen = materialParams.behindEye * vec4(getUserWorldPosition(), 1.0);
            vec4 behind = textureLod(materialParams_backdrop, uvToRenderTargetUV(seen.xy / max(seen.w, 1e-6) * 0.5 + 0.5), 0.0);
            material.baseColor.rgb = (behind.a > 1e-4 ? behind.rgb / behind.a : vec3(0.0)) * material.baseColor.a;
        }
        if (materialParams.blendWay > 0.5 && material.baseColor.a > 1e-4) material.baseColor.rgb = wayLaid(material.baseColor);
#if defined(LAY_multiply)
        material.baseColor.rgb += 1.0 - material.baseColor.a;   // (where it is clear, what is behind is left as it is: times one)
#endif
    }
}
