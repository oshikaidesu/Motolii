// EXPERIMENT (VBODY=1 in glass_scene): the CHEAP LAYER of a flat-faced solid's four-sided faces, drawn a hair in front
// of the same solid drawn the old way (glass_solid.mat, every pixel following its own sight line), which so fills only
// what this layer leaves open (the depth test throws the rest of it away before it is worked out).
// A face is a net of cells whose corners know where the sight line through the glass ends up (glass_nodes.mat works
// that out at 17 x 17 points per face, once a frame, whatever the size of the picture); a pixel only reads the
// backdrop where its corners say, once, or several times along the line from the red to the blue end where those part.
//   level 0: 4 x 4 cells per face, drawn where corners, middles of sides and middle all went the same way and the
//            middles look within `tol` pixels (of 1920 x 1080) of what the corners would give;
//   level 1: the four quarters of a cell that failed, by the same test;
//   levels 2 to 6: a quarter that failed too is crossed by a boundary between ways. It is drawn once for the way
//            each of its corners and its middle went: the whole quarter MADE to go that way (`forced`), carrying how
//            far it is from not going it; the pixels keep the part that really does. So a boundary costs a line, not
//            a band of cells. Ways that none of the five points went (slivers) are left to the old way behind.
// Mesh: POSITION = (face, level, cell), UV0 = which corner of the cell (0 or 1 each way).
material {
    name : glass_vert,
    shadingModel : unlit,
    blending : opaque,
    culling : back,
    requires : [ uv0 ],
    variables : [ lookA, lookB, lookC, near ],
    parameters : [
        { type : sampler2d, name : backdrop, precision : medium },
        { type : samplerCubemap, name : env, precision : medium },
        { type : float, name : ior },
        { type : float, name : abbe },
        { type : float4[40], name : planes },
        { type : int, name : planeCount },
        { type : int, name : kind },
        { type : float4, name : dims },
        { type : sampler2d, name : scene, precision : high },
        { type : sampler2d, name : shapes, precision : high, format : float },   // beam::ex_shape_table (kind 4)
        { type : int, name : solidCount },
        { type : float4[64], name : spheres },
        { type : int, name : self },
        { type : sampler2d, name : nodes, precision : high, format : float },   // glass_nodes.mat
        { type : sampler2d, name : cells, precision : high, format : float },   // glass_cells.mat
        { type : sampler2d, name : faces, precision : high, format : float },   // as glass_nodes.mat
        { type : float4[4], name : pose, precision : high },                    // axis x + size; axis y; axis z; place (the user's world space)
        { type : float2, name : slop },                                           // a way is kept up to this far past its boundary (room, turn): closes the cracks that carrying the least of several distances leaves
        { type : float, name : levels },                                          // timing only: corners of a level above this are dropped before anything is read (6: all)
        { type : float, name : tol },                                            // see above
        { type : float, name : showCells },                                      // 1: paint the cells by how they are drawn (to count)
        { type : float, name : nearCone },   // see `near` in the vertex part (0: every solid is asked)
        { type : float, name : spread },
        { type : float3, name : sunTo },
        { type : float3, name : sunGlint },
        { type : float, name : sunCos },
        { type : float, name : floorY },
        { type : float, name : envGain },
        { type : float3, name : sky },
        { type : float3, name : absorption },
        { type : float4[6], name : room, precision : high },
        { type : float, name : roomCount },
        { type : float4[16], name : blocks, precision : high },
        { type : float, name : blockCount }
    ]
}

vertex {
    const int VMAXP = 40;
    vec4 nodeAt(int face, int i, int j, int part) {
        return texelFetch(materialParams_nodes, ivec2(i + j * 17, materialParams.self * 6 + face), 0);
    }
    float fresnelV(float ci, float n1, float n2) {
        float s2 = (n1 / n2) * (n1 / n2) * (1.0 - ci * ci);
        if (s2 >= 1.0) return 1.0;
        float ct = sqrt(1.0 - s2);
        float rs = (n1 * ci - n2 * ct) / (n1 * ci + n2 * ct);
        float rp = (n1 * ct - n2 * ci) / (n1 * ct + n2 * ci);
        return 0.5 * (rs * rs + rp * rp);
    }
    float iorAtV(float nm) {
        float B = (materialParams.ior - 1.0) / (materialParams.abbe * (1.0 / (486.13 * 486.13) - 1.0 / (656.27 * 656.27)));
        return materialParams.ior + B * (1.0 / (nm * nm) - 1.0 / (587.56 * 587.56));
    }
    // The sight line that enters at pl (the solid's own space; direction dl, the face's normal nl), MADE to go the way
    // `code` says: the faces to meet inside one after the other, mirrored at all but the last and let out at the last,
    // whether or not it really would. Comes back with where it leaves (o), the direction it has inside there (dIn),
    // that face's normal (nOut), how far it went, and two numbers that say how far from NOT going this way it is:
    // `room` (the least distance, at every face met, to the edge of that face; less than nothing: it lands off the
    // face, so it really meets another) and `turn` (how far past / short of total reflection it is where the way says
    // mirrored / let out; less than nothing: the glass does the other thing). Both run smoothly across a face, so the
    // net can carry them and a pixel is on this way exactly where both are above nothing.
    bool forced(float code, vec3 pl, vec3 dl, vec3 nl, out vec3 o, out vec3 dIn, out vec3 nOut, out float path, out float room, out float turn) {
        float n0 = materialParams.ior;
        vec3 d = refract(dl, nl, 1.0 / n0);
        o = pl;
        dIn = d;
        nOut = nl;
        path = 0.0;
        room = 1e9;
        turn = 1e9;
        float c = floor(code + 0.25);
        for (int leg = 0; leg < 4; leg++) {
            float rest = floor(c / 41.0);
            int f = int(c - rest * 41.0 + 0.5) - 1;
            if (f < 0) return false;
            c = rest;
            vec4 pf = materialParams.planes[f];
            float den = dot(pf.xyz, d);
            if (!(den > 1e-5)) {       // heading away from that face: not this way at all
                room = -1.0;
                return true;
            }
            float t = (pf.w - dot(pf.xyz, o)) / den;
            room = min(room, t);
            o += d * t;
            path += t;
            for (int j = 0; j < VMAXP; j++) {
                if (j >= materialParams.planeCount) break;
                if (j == f) continue;
                vec4 pj = materialParams.planes[j];
                room = min(room, pj.w - dot(pj.xyz, o));
            }
            float s2 = n0 * n0 * (1.0 - den * den);     // above 1: the glass cannot let it out here
            if (c < 0.5) {
                turn = min(turn, 1.0 - s2);
                dIn = d;
                nOut = pf.xyz;
                return true;
            }
            turn = min(turn, s2 - 1.0);
            d = d - pf.xyz * (2.0 * den);
        }
        return false;
    }
    // where a sight line that has left the glass at p (the user's world space) along d looks: its place in the picture
    bool looksAtV(vec3 p, vec3 d, vec3 shift, out vec2 uv) {
        uv = vec2(0.0);
        if (!(d.y < -1e-4)) return false;
        float t = (materialParams.floorY - p.y) / d.y;
        if (t < 0.0) return false;
        highp vec4 clip = getClipFromWorldMatrix() * vec4(p + d * t - shift, 1.0);
        if (!(clip.w > 1e-4)) return false;
        uv = clamp(clip.xy / clip.w * 0.5 + 0.5, vec2(0.001), vec2(0.999));
        return true;
    }
    void materialVertex(inout MaterialVertexInputs material) {
        vec3 ax = materialParams.pose[0].xyz, ay = materialParams.pose[1].xyz, az = materialParams.pose[2].xyz, at = materialParams.pose[3].xyz;
        float size = materialParams.pose[0].w;
        vec3 shift = getUserWorldFromWorldMatrix()[3].xyz;
        int face = int(mesh_position.x + 0.5), level = int(mesh_position.y + 0.5), cell = int(mesh_position.z + 0.5);
        if (float(level) > materialParams.levels) {
            material.lookA = vec4(0.0); material.lookB = vec4(0.0); material.lookC = vec4(0.0); material.near = vec4(0.0);
            material.worldPosition = vec4(0.0, 0.0, 0.0, 1.0);
            return;
        }
        int per = level == 0 ? 4 : 8, pts = 16 / per;          // cells per side of the face; points per side of a cell
        int cj = cell / per, ci = cell - cj * per;
        ivec2 corner = ivec2(mesh_uv0 + 0.5);
        int i = (ci + corner.x) * pts, j = (cj + corner.y) * pts;
        vec4 f0 = texelFetch(materialParams_faces, ivec2(face * 4, materialParams.self), 0);
        vec3 c1 = texelFetch(materialParams_faces, ivec2(face * 4 + 1, materialParams.self), 0).xyz;
        vec3 c2 = texelFetch(materialParams_faces, ivec2(face * 4 + 2, materialParams.self), 0).xyz;
        vec3 nf = texelFetch(materialParams_faces, ivec2(face * 4 + 3, materialParams.self), 0).xyz;
        vec3 pl = f0.xyz + (c1 - f0.xyz) * (float(i) / 16.0) + (c2 - f0.xyz) * (float(j) / 16.0);
        vec4 la = vec4(-1.0), lb = vec4(0.0, -1.0, 0.0, 0.0), lc = vec4(0.0, 0.0, 1.0, 1.0), ld = vec4(-1.0, -1.0, 0.0, 0.0);
        bool draw = false;
        float code = 0.0;        // the way this corner is drawn by
        // (a face turned away from the camera: nothing of it is drawn, and nothing is looked up for it)
        mat3 R = mat3(ax, ay, az);
        bool towards = dot(R * nf, (R * f0.xyz) * size + at - (getWorldCameraPosition() + shift)) < 0.0;
        if (f0.w > 0.5 && towards) {
            vec4 verdict = texelFetch(materialParams_cells, ivec2(level == 0 ? cell : 16 + cell, materialParams.self * 6 + face), 0);
            if (level == 0) {
                draw = verdict.x > 0.5;
                if (draw) code = nodeAt(face, i, j, 0).z;
            } else {
                bool whole = verdict.x > 0.5;       // the cell it is a quarter of
                bool mine = verdict.y > 0.5;
                if (level == 1) {
                    draw = mine;
                    code = nodeAt(face, i, j, 0).z;
                } else if (!whole && !mine) {
                    // A quarter that a boundary between two ways crosses: drawn once for the way each of its corners
                    // (levels 2 to 5) and its middle (level 6) went, the whole quarter MADE to go that way, and the
                    // pixels keep what really does (`room` and `turn` above nothing).
                    int which = level - 2;
                    ivec2 from = which == 4 ? ivec2(1, 1) : ivec2(which - (which / 2) * 2, which / 2) * 2;
                    vec4 n0 = nodeAt(face, ci * 2 + from.x, cj * 2 + from.y, 0);
                    code = n0.z;
                    draw = n0.w >= 0.0 && code > 0.5 && code < 3.9e6;
                    for (int e = 0; e < 4; e++) {          // (not twice the same way)
                        if (e >= which) break;
                        ivec2 fe = ivec2(e - (e / 2) * 2, e / 2) * 2;
                        if (nodeAt(face, ci * 2 + fe.x, cj * 2 + fe.y, 0).z == code) draw = false;
                    }
                }
            }
        }
        if (draw && code > 0.5 && code < 3.9e6) {
            // made to go the way `code`, from this corner itself (the table says WHICH way; where that way leads is worked out here)
            vec3 Pw = (R * pl) * size + at;
            vec3 view = normalize(Pw - (getWorldCameraPosition() + shift));
            vec3 o, dIn, nOut;
            float path, room, turn;
            if (forced(code, pl, view * R, nf, o, dIn, nOut, path, room, turn)) {
                float nMid = materialParams.ior;
                vec3 wo = (R * o) * size + at, lastIn = R * dIn, lastN = R * nOut;
                vec3 dMid = refract(lastIn, -lastN, nMid);
                if (dot(dMid, dMid) <= 0.0) dMid = lastIn;
                vec3 dRed = refract(lastIn, -lastN, nMid + (iorAtV(670.0) - nMid) * materialParams.spread);
                vec3 dBlue = refract(lastIn, -lastN, nMid + (iorAtV(430.0) - nMid) * materialParams.spread);
                if (dot(dRed, dRed) <= 0.0) dRed = dMid;
                if (dot(dBlue, dBlue) <= 0.0) dBlue = dMid;
                bool sky = fract(code) > 0.25;
                turn = min(turn, (sky ? dMid.y : -dMid.y) * 4.0 + 4e-4);   // (the way also says: comes down on the floor, or does not)
                vec2 uvM = vec2(0.5), uvR, uvB;
                if (!sky) {
                    if (!looksAtV(wo, dMid, shift, uvM)) room = min(room, -1e-3);
                    if (!looksAtV(wo, dRed, shift, uvR)) uvR = uvM;
                    if (!looksAtV(wo, dBlue, shift, uvB)) uvB = uvM;
                    la = vec4(uvR, uvB);
                }
                lb = vec4(sky ? dMid : vec3(uvM, dMid.y), level == 0 ? 1.0 : (level == 1 ? 2.0 : 3.0));
                ld = vec4(dRed.y, dBlue.y, 0.0, 0.0);     // (how steeply the two ends leave: a colour that does not come down looks at the sky)
                lc = vec4(1.0 - fresnelV(dot(lastIn, lastN), nMid, 1.0), path * size, room, turn);
                if (level < 2) lc.zw = vec2(1.0);     // (a cell that passed is all on this way: nothing to cut)
            } else draw = false;
        } else draw = false;     // (a way the table cannot spell out, e.g. more than four faces inside: left to the old way)
        // (what is not drawn: all its corners on one spot, covering nothing)
        if (!draw) pl = f0.xyz;
        vec3 P = (ax * pl.x + ay * pl.y + az * pl.z) * size + at;
        material.lookA = la;     // where the red and the blue end look (or -1: the sky)
        material.lookB = lb;     // where the middle of the spectrum looks (or, for the sky, the direction out of the glass); how it is drawn: 1 / 2 a large / small cell, 3 a way cut out of a quarter
        material.lookC = lc;     // how much of the light is left, how far it went through glass, room, turn
        material.near = ld;      // (in this layer: how steeply the red and the blue end leave the glass, y of their directions)
        // a hair nearer than the same face drawn the old way behind it, which so fills only what is left over
        vec3 Pf = P - shift;
        material.worldPosition = vec4(mix(Pf, getWorldCameraPosition(), 0.0015), 1.0);
    }
}

fragment {
    const int WAVES = 9;
    const int BOUNCES = 6;

    float iorAt(float nm) {
        // two-term Cauchy from the Abbe number, as beam::Glass::n
        float B = (materialParams.ior - 1.0) / (materialParams.abbe * (1.0 / (486.13 * 486.13) - 1.0 / (656.27 * 656.27)));
        return materialParams.ior + B * (1.0 / (nm * nm) - 1.0 / (587.56 * 587.56));
    }
    float lobe(float x, float mu, float s1, float s2) {
        float t = (x - mu) * (x < mu ? s1 : s2);
        return exp(-0.5 * t * t);
    }
    vec3 waveRgb(float nm) {
        float X = 1.056 * lobe(nm, 599.8, 0.0264, 0.0323) + 0.362 * lobe(nm, 442.0, 0.0624, 0.0374) - 0.065 * lobe(nm, 501.1, 0.0490, 0.0382);
        float Y = 0.821 * lobe(nm, 568.8, 0.0213, 0.0247) + 0.286 * lobe(nm, 530.9, 0.0613, 0.0322);
        float Z = 1.217 * lobe(nm, 437.0, 0.0845, 0.0278) + 0.681 * lobe(nm, 459.0, 0.0385, 0.0725);
        return vec3(3.2406 * X - 1.5372 * Y - 0.4986 * Z, -0.9689 * X + 1.8758 * Y + 0.0415 * Z, 0.0557 * X - 0.2040 * Y + 1.0570 * Z);
    }
    // unpolarised Fresnel reflectance, n1 -> n2, 1 on total reflection
    float fresnel(float ci, float n1, float n2) {
        float s2 = (n1 / n2) * (n1 / n2) * (1.0 - ci * ci);
        if (s2 >= 1.0) return 1.0;
        float ct = sqrt(1.0 - s2);
        float rs = (n1 * ci - n2 * ct) / (n1 * ci + n2 * ct);
        float rp = (n1 * ct - n2 * ci) / (n1 * ct + n2 * ci);
        return 0.5 * (rs * rs + rp * rp);
    }

    const int MAXP = 40;

    // Every place a line o + t d crosses a cone (c: middle of the base, a: axis towards the tip, r, h), side or
    // base: how far and the outward normal there, nearest first. Returns how many (0 to 2). As beam::cone_crossings.
    int coneCross(vec3 c, vec3 a, float r, float h, vec3 o, vec3 d, out float t0, out vec3 n0, out float t1, out vec3 n1) {
        t0 = 0.0; t1 = 0.0;
        n0 = a; n1 = a;
        vec3 w = o - c;
        float k = r / h, y0 = dot(w, a), da = dot(d, a);
        vec3 wp = w - a * y0, dp = d - a * da;
        float A = dot(dp, dp) - k * k * da * da, B = dot(wp, dp) + k * da * (r - k * y0), C = dot(wp, wp) - (r - k * y0) * (r - k * y0);
        float root0 = 0.0, root1 = 0.0;
        int roots = 0;
        if (abs(A) > 1e-7) {
            float disc = B * B - A * C;
            if (disc > 0.0) {
                float sq = sqrt(disc);
                root0 = (-B - sq) / A;
                root1 = (-B + sq) / A;
                roots = 2;
            }
        } else if (abs(B) > 1e-7) {
            root0 = -C / (2.0 * B);
            roots = 1;
        }
        float slope = inversesqrt(1.0 + k * k);
        int count = 0;
        for (int i = 0; i < 2; i++) {
            if (i >= roots) break;
            float tt = i == 0 ? root0 : root1;
            float y = y0 + tt * da;
            if (y < 0.0 || y > h) continue;
            vec3 q = wp + dp * tt;
            float ql = length(q);
            vec3 nn = ql > 1e-6 * r ? (q / ql + a * k) * slope : a;
            if (count == 0) { t0 = tt; n0 = nn; } else { t1 = tt; n1 = nn; }
            count++;
        }
        if (abs(da) > 1e-7 && count < 2) {
            float tb = -y0 / da;
            vec3 q = wp + dp * tb;
            if (dot(q, q) <= r * r) {
                if (count == 0) { t0 = tb; n0 = -a; } else { t1 = tb; n1 = -a; }
                count++;
            }
        }
        if (count == 2 && t1 < t0) {
            float ts = t0; t0 = t1; t1 = ts;
            vec3 ns = n0; n0 = n1; n1 = ns;
        }
        return count;
    }
    // from a point in or on the cone along d: distance to its surface and the outward normal there
    float coneExit(vec3 c, vec3 a, float r, float h, vec3 o, vec3 d, out vec3 n) {
        float t0, t1;
        vec3 n0, n1;
        int count = coneCross(c, a, r, h, o, d, t0, n0, t1, n1);
        n = a;
        if (count >= 1 && t0 > 1e-5 * r && dot(n0, d) > 0.0) { n = n0; return t0; }
        if (count >= 2 && t1 > 1e-5 * r && dot(n1, d) > 0.0) { n = n1; return t1; }
        // nothing found (a sight line along the surface): leave where it stands
        n = normalize(d);
        return 0.0;
    }

    // ---- kind 4: an outline with dents and holes (beam_extrude.h)
#define EX_WITH_SOLID
#include "extrude_common.glsl"
    vec3 exFlat = vec3(0.0, 0.0, 1.0);   // the normal of the mesh's triangle under the pixel (set in material())
    vec3 exSnap = vec3(0.0);             // the pixel put on the true wall (set by faceAt)
    ExShape exOwn() { return exShape(int(texelFetch(materialParams_scene, ivec2(4, materialParams.self), 0).w + 0.5)); }
    // solid k of the table: a ray of the world into the outline's own frame (d keeps its length, so t stays in world units / size)
    void exLocal(int k, vec3 o, vec3 d, out ExShape s, out vec3 lo, out vec3 ld, out mat3 R, out float size) {
        vec4 a = texelFetch(materialParams_scene, ivec2(3, k), 0), b = texelFetch(materialParams_scene, ivec2(4, k), 0);
        vec3 ez = texelFetch(materialParams_scene, ivec2(2, k), 0).xyz;
        R = mat3(b.xyz, cross(ez, b.xyz), ez);
        size = a.w;
        s = exShape(int(b.w + 0.5));
        lo = ((o - a.xyz) * R) / size;
        ld = d * R;
    }

    // the face a surface point lies on: the plane it is closest to
    vec3 faceAt(vec3 p) {
        if (materialParams.kind == 4) return exFace(exOwn(), p, exFlat, exSnap);
        if (materialParams.kind == 1) return normalize(p);
        if (materialParams.kind == 2) {
            float side = materialParams.dims.x - length(p.xz), end = materialParams.dims.y - abs(p.y);
            return side < end ? normalize(vec3(p.x, 0.0, p.z)) : vec3(0.0, p.y < 0.0 ? -1.0 : 1.0, 0.0);
        }
        if (materialParams.kind == 3) {
            float r = materialParams.dims.x, h = materialParams.dims.y, k = r / h;
            float up = p.y + 0.5 * h, across = length(p.xz);
            float side = (r - k * up - across) * inversesqrt(1.0 + k * k);
            if (up < side) return vec3(0.0, -1.0, 0.0);
            return across > 1e-6 * r ? normalize(vec3(p.x / across, k, p.z / across)) : vec3(0.0, 1.0, 0.0);
        }
        float best = 1e9;
        vec3 n = vec3(0.0, 1.0, 0.0);
        for (int i = 0; i < MAXP; i++) {
            if (i >= materialParams.planeCount) break;
            vec4 pl = materialParams.planes[i];
            float s = pl.w - dot(pl.xyz, p);
            if (s < best) { best = s; n = pl.xyz; }
        }
        return n;
    }
    // from a point in or on the solid along d: distance to the surface, and the outward normal there
    float exitAt(vec3 o, vec3 d, out vec3 n) {
        float t = 1e9;
        n = vec3(0.0, 1.0, 0.0);
        if (materialParams.kind == 1) {
            float r = materialParams.dims.x, b = dot(o, d);
            t = -b + sqrt(max(b * b - (dot(o, o) - r * r), 0.0));
            n = normalize(o + d * t);
            return max(t, 0.0);
        }
        if (materialParams.kind == 2) {
            float r = materialParams.dims.x, h = materialParams.dims.y;
            float tS = 1e9, tC = 1e9;
            if (d.y > 1e-6) tS = (h - o.y) / d.y;
            else if (d.y < -1e-6) tS = (-h - o.y) / d.y;
            float A = dot(d.xz, d.xz), B = dot(o.xz, d.xz), C = dot(o.xz, o.xz) - r * r;
            if (A > 1e-9) tC = (-B + sqrt(max(B * B - A * C, 0.0))) / A;
            if (tC <= tS) {
                vec3 q = o + d * tC;
                n = normalize(vec3(q.x, 0.0, q.z));
                return max(tC, 0.0);
            }
            n = vec3(0.0, d.y > 0.0 ? 1.0 : -1.0, 0.0);
            return max(tS, 0.0);
        }
        if (materialParams.kind == 3)
            return coneExit(vec3(0.0, -0.5 * materialParams.dims.y, 0.0), vec3(0.0, 1.0, 0.0), materialParams.dims.x, materialParams.dims.y, o, d, n);
        if (materialParams.kind == 4) return exLeave(exOwn(), o, d, n);
        for (int i = 0; i < MAXP; i++) {
            if (i >= materialParams.planeCount) break;
            vec4 pl = materialParams.planes[i];
            float den = dot(pl.xyz, d);
            if (den > 1e-6) {
                float ti = (pl.w - dot(pl.xyz, o)) / den;
                if (ti < t) { t = ti; n = pl.xyz; }
            }
        }
        return max(t, 0.0);
    }

    const int SEGS = 3;
    const int MAXS = 64;
    vec4 sceneAt(int x, int row) { return texelFetch(materialParams_scene, ivec2(x, row), 0); }
    // does a sight line in the air meet solid k? how far, and the face normal there
    bool meets(int k, vec3 o, vec3 d, out float t, out vec3 n) {
        vec4 info = sceneAt(1, k);
        int kind = int(info.y + 0.5);
        n = vec3(0.0, 1.0, 0.0);
        t = 0.0;
        if (kind == 1) {
            vec3 w = o - sceneAt(0, k).xyz;
            float b = dot(w, d), disc = b * b - (dot(w, w) - info.z * info.z);
            if (disc <= 0.0) return false;
            t = -b - sqrt(disc);
            if (t < -1e-5) return false;
            n = normalize(w + d * t);
            return true;
        }
        if (kind == 2) {
            vec3 a = sceneAt(2, k).xyz, w = o - sceneAt(0, k).xyz;
            float wa = dot(w, a), da = dot(d, a);
            vec3 wp = w - a * wa, dp = d - a * da;
            float tinS = -1e9, toutS = 1e9, tinC = -1e9, toutC = 1e9;
            if (abs(da) > 1e-6) {
                float t1 = (-info.w - wa) / da, t2 = (info.w - wa) / da;
                tinS = min(t1, t2);
                toutS = max(t1, t2);
            } else if (abs(wa) > info.w) return false;
            float A = dot(dp, dp), B = dot(wp, dp), C = dot(wp, wp) - info.z * info.z;
            if (A > 1e-9) {
                float disc = B * B - A * C;
                if (disc <= 0.0) return false;
                float sq = sqrt(disc);
                tinC = (-B - sq) / A;
                toutC = (-B + sq) / A;
            } else if (C > 0.0) return false;
            float tin = max(tinS, tinC), tout = min(toutS, toutC);
            if (tin >= tout || tin < -1e-5) return false;
            t = tin;
            if (tinC >= tinS) {
                vec3 q = w + d * t;
                n = normalize(q - a * dot(q, a));
            } else {
                n = da < 0.0 ? a : -a;
            }
            return true;
        }
        if (kind == 3) {
            float t1;
            vec3 n1;
            int count = coneCross(sceneAt(3, k).xyz, sceneAt(2, k).xyz, info.z, info.w, o, d, t, n, t1, n1);
            return count == 2 && t >= -1e-5 && dot(n, d) < 0.0;
        }
        if (kind == 4) {
            ExShape s;
            vec3 lo, ld, ln;
            mat3 R;
            float size;
            exLocal(k, o, d, s, lo, ld, R, size);
            if (!exMeet(s, lo, ld, t, ln)) return false;
            t *= size;
            n = R * ln;
            return true;
        }
        int cnt = int(info.x + 0.5);
        float tin = -1e9, tout = 1e9;
        for (int j = 0; j < MAXP; j++) {
            if (j >= cnt) break;
            vec4 pl = sceneAt(3 + j, k);
            float dj = dot(pl.xyz, d), off = pl.w - dot(pl.xyz, o);
            if (dj < -1e-6) { float tt = off / dj; if (tt > tin) { tin = tt; n = pl.xyz; } }
            else if (dj > 1e-6) tout = min(tout, off / dj);
            else if (off < 0.0) return false;
        }
        t = tin;
        return tin < tout && tin >= -1e-5;
    }
    // the next solid a sight line in the air meets (not `from`): which one, how far, and the face normal there
    ivec4 gNear;   // one bit per solid that can be seen through this one (the vertex part's `near`)
    bool nextSolid(vec3 o, vec3 d, int from, out int S, out float t, out vec3 n) {
        t = 1e9;
        S = -1;
        n = vec3(0.0, 1.0, 0.0);
        for (int k = 0; k < MAXS; k++) {
            if (k >= materialParams.solidCount) break;
            if (((gNear[k >> 4] >> (k & 15)) & 1) == 0) continue;
            if (k == from && sceneAt(1, k).y < 3.5) continue;   // (a solid with dents may be met again across a dent)
            vec4 sp = materialParams.spheres[k];   // (the same numbers as texel 0 of the table, without a lookup per solid per pixel)
            vec3 rel = sp.xyz - o;
            float along = dot(rel, d);
            if (along < -sp.w || dot(rel, rel) - along * along > sp.w * sp.w) continue;
            float tk;
            vec3 nk;
            if (meets(k, o, d, tk, nk) && tk < t) { t = tk; S = k; n = nk; }
        }
        return S >= 0;
    }
    // from a point in or on solid k (world space) along d: distance to its surface and the outward normal there
    float exitWorld(int k, vec3 o, vec3 d, out vec3 n) {
        float t = 1e9;
        n = vec3(0.0, 1.0, 0.0);
        vec4 info = sceneAt(1, k);
        int kind = int(info.y + 0.5);
        if (kind == 1) {
            vec3 w = o - sceneAt(0, k).xyz;
            float b = dot(w, d);
            t = -b + sqrt(max(b * b - (dot(w, w) - info.z * info.z), 0.0));
            n = normalize(w + d * t);
            return max(t, 0.0);
        }
        if (kind == 2) {
            vec3 a = sceneAt(2, k).xyz, w = o - sceneAt(0, k).xyz;
            float wa = dot(w, a), da = dot(d, a);
            vec3 wp = w - a * wa, dp = d - a * da;
            float tS = 1e9, tC = 1e9;
            if (da > 1e-6) tS = (info.w - wa) / da;
            else if (da < -1e-6) tS = (-info.w - wa) / da;
            float A = dot(dp, dp), B = dot(wp, dp), C = dot(wp, wp) - info.z * info.z;
            if (A > 1e-9) tC = (-B + sqrt(max(B * B - A * C, 0.0))) / A;
            if (tC <= tS) {
                vec3 q = w + d * tC;
                n = normalize(q - a * dot(q, a));
                return max(tC, 0.0);
            }
            n = da > 0.0 ? a : -a;
            return max(tS, 0.0);
        }
        if (kind == 3) return coneExit(sceneAt(3, k).xyz, sceneAt(2, k).xyz, info.z, info.w, o, d, n);
        if (kind == 4) {
            ExShape s;
            vec3 lo, ld, ln;
            mat3 R;
            float size;
            exLocal(k, o, d, s, lo, ld, R, size);
            t = exLeave(s, lo, ld, ln) * size;
            n = R * ln;
            return t;
        }
        int cnt = int(info.x + 0.5);
        for (int j = 0; j < MAXP; j++) {
            if (j >= cnt) break;
            vec4 pl = sceneAt(3 + j, k);
            float den = dot(pl.xyz, d);
            if (den > 1e-6) {
                float ti = (pl.w - dot(pl.xyz, o)) / den;
                if (ti < t) { t = ti; n = pl.xyz; }
            }
        }
        return max(t, 0.0);
    }

    highp vec3 gShift;   // the user's world space is Filament's, moved by this
    // The first matte thing a sight line from o along d meets (user's world space): how far, or -1.0 for none.
    float recvFirst(highp vec3 o, highp vec3 d) {
        highp float best = 1e9;
        int rc = int(materialParams.roomCount + 0.5), bc = int(materialParams.blockCount + 0.5), met = -1;
        // the room is convex and seen from inside: the nearest of its planes that the line runs into
        for (int j = 0; j < 6; j++) {
            if (j >= rc) break;
            highp vec4 pl = materialParams.room[j];
            highp float den = dot(pl.xyz, d);
            if (den > -1e-5) continue;
            highp float t = max(0.0, -(dot(pl.xyz, o) + pl.w) / den);
            if (t < best) { best = t; met = j; }
        }
        if (met == rc - 1) best = 1e9;   // (the last plane is where the walls end: nothing matte there)
        for (int i = 0; i < 4; i++) {
            if (i >= bc) break;
            highp vec3 c = materialParams.blocks[4 * i].xyz;
            highp float t0 = 0.0, t1 = best;
            bool miss = false;
            for (int k = 1; k <= 3; k++) {
                highp vec4 ax = materialParams.blocks[4 * i + k];
                highp float off = dot(ax.xyz, o - c), dd = dot(ax.xyz, d);
                if (abs(dd) < 1e-7) {
                    if (abs(off) > ax.w) miss = true;
                    continue;
                }
                highp float ta = (-ax.w - off) / dd, tb = (ax.w - off) / dd;
                t0 = max(t0, min(ta, tb));
                t1 = min(t1, max(ta, tb));
            }
            if (!miss && t0 < t1) best = t0;
        }
        return best < 1e8 ? best : -1.0;
    }

    // What a sight line that has left the glass at p (Filament world space) along d sees.
    vec3 lookup(vec3 p, vec3 d, float floorY) {
        if (materialParams.roomCount > 0.5) {
            float t = recvFirst(p + gShift, d);
            if (t >= 0.0) {
                highp vec4 clip = getClipFromWorldMatrix() * vec4(p + d * t, 1.0);
                if (clip.w > 1e-4) {
                    vec2 uv = clamp(clip.xy / clip.w * 0.5 + 0.5, vec2(0.001), vec2(0.999));
                    return textureLod(materialParams_backdrop, uvToRenderTargetUV(uv), 0.0).rgb;
                }
            }
        } else if (d.y < -1e-4) {
            float t = (floorY - p.y) / d.y;
            if (t >= 0.0) {
                highp vec4 clip = getClipFromWorldMatrix() * vec4(p + d * t, 1.0);
                if (clip.w > 1e-4) {
                    vec2 uv = clamp(clip.xy / clip.w * 0.5 + 0.5, vec2(0.001), vec2(0.999));
                    return textureLod(materialParams_backdrop, uvToRenderTargetUV(uv), 0.0).rgb;
                }
            }
        }
        // the sun itself, when the sight line ends up pointing at it: the flash of a face that catches the sun
        // (sunCos is the cosine of how wide the sun is taken to be; a little wider than the real one reads better)
        float sun = smoothstep(materialParams.sunCos, mix(materialParams.sunCos, 1.0, 0.5), dot(d, materialParams.sunTo));
        return (textureLod(materialParams_env, d, 0.0).rgb * materialParams.envGain + materialParams.sky + materialParams.sunGlint * sun) * getExposure();
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 P = getWorldPosition();
        vec3 shift = getUserWorldPosition() - P;                                     // Filament's world space is the user's, moved
        gShift = shift;
        float floorY = materialParams.floorY - shift.y;                              // the floor in Filament's world space
        vec3 view = normalize(P - getWorldCameraPosition());
        vec3 c = materialParams.pose[3].xyz - shift;
        float e = materialParams.pose[0].w;
        vec3 ax = materialParams.pose[0].xyz;
        vec3 ay = materialParams.pose[1].xyz;
        mat3 R = mat3(ax, ay, cross(ax, ay));                 // solid -> world (turn only)

        if (variable_lookB.w > 0.5) {
            // ---- drawn from the corners of its cell: read the backdrop where they say
            if (variable_lookC.z < -materialParams.slop.x || variable_lookC.w < -materialParams.slop.y) discard;     // (not on this way here)
            if (materialParams.showCells > 0.5) {
                material.baseColor = variable_lookB.w < 1.5 ? vec4(0.0, 1.0, 0.0, 1.0) : (variable_lookB.w < 2.5 ? vec4(0.0, 0.0, 1.0, 1.0) : vec4(1.0, 1.0, 0.0, 1.0));
                return;
            }
            vec3 nW = normalize(cross(dFdx(P), dFdy(P)));
            if (dot(nW, view) > 0.0) nW = -nW;
            float F0 = fresnel(clamp(-dot(view, nW), 0.0, 1.0), 1.0, materialParams.ior);
            vec3 mirrored0 = lookup(P, reflect(view, nW), floorY);
            vec3 seen;
            if (variable_lookA.x < -0.5) {
                vec3 d = normalize(variable_lookB.xyz);
                float sun = smoothstep(materialParams.sunCos, mix(materialParams.sunCos, 1.0, 0.5), dot(d, materialParams.sunTo));
                seen = (textureLod(materialParams_env, d, 0.0).rgb * materialParams.envGain + materialParams.sky + materialParams.sunGlint * sun) * getExposure();
            } else {
                vec2 red = variable_lookA.xy, blue = variable_lookA.zw, mid = variable_lookB.xy;
                float apart = length((blue - red) * getResolution().xy);   // how far the two ends of the spectrum are apart here, in pixels
                float yRed = variable_near.x, yBlue = variable_near.y, yMid = variable_lookB.z;
                if (apart < 1.0 && max(yRed, yBlue) < -1e-4) {
                    seen = textureLod(materialParams_backdrop, uvToRenderTargetUV(mid), 0.0).rgb;
                } else {
                    // the rainbow only where there is one: the colours along the curve through where red, the middle and
                    // blue look (the middle is the glass's own index, 587.56 nm: 0.2104 of the way from red to blue)
                    vec3 acc = vec3(0.0), wsum = vec3(0.0);
                    for (int i = 0; i < WAVES; i++) {
                        float nm = mix(430.0, 670.0, (float(i) + 0.5) / float(WAVES));
                        vec3 w = max(waveRgb(nm), vec3(0.0));
                        wsum += w;
                        // (a colour is bent by so much more than red as 1 / wavelength^2 says)
                        float f = (1.0 / (nm * nm) - 1.0 / (670.0 * 670.0)) / (1.0 / (430.0 * 430.0) - 1.0 / (670.0 * 670.0));
                        const float m = 0.2104;
                        float kr = (f - m) * (f - 1.0) / m, km = f * (f - 1.0) / (m * (m - 1.0)), kb = f * (f - m) / (1.0 - m);
                        // (a colour that leaves the glass without coming down looks at the sky, as it does the old way)
                        if (yRed * kr + yMid * km + yBlue * kb > -1e-4) acc += w * materialParams.sky * getExposure();
                        else acc += w * textureLod(materialParams_backdrop, uvToRenderTargetUV(red * kr + mid * km + blue * kb), 0.0).rgb;
                    }
                    seen = acc / max(wsum, vec3(1e-5));
                }
            }
            seen *= exp(-materialParams.absorption * variable_lookC.y) * variable_lookC.x;
            material.baseColor = vec4(seen * (1.0 - F0) + mirrored0 * F0, 1.0);
            return;
        }
        if (materialParams.showCells > 0.5) {
            material.baseColor = vec4(1.0, 0.0, 0.0, 1.0);
            return;
        }
        // ---- the old way: every pixel follows its own sight line (glass_solid.mat from here on)
        vec3 pl = ((P - c) * R) / e;
        vec3 dl = view * R;
        exFlat = normalize(cross(dFdx(pl), dFdy(pl)));
        if (dot(exFlat, dl) > 0.0) exFlat = -exFlat;
        vec3 nl = faceAt(pl);
        // A round solid is drawn as a many-sided mesh; the pixel is a hair inside the true surface. Put it on the
        // surface, or the flat sides of the mesh show in what is seen through the glass.
        if (materialParams.kind == 1) {
            pl = normalize(pl) * materialParams.dims.x;
        } else if (materialParams.kind == 2 && abs(nl.y) < 0.5) {
            pl.xz *= materialParams.dims.x / max(length(pl.xz), 1e-6);
        } else if (materialParams.kind == 3 && nl.y > -0.5) {
            float up = clamp(pl.y + 0.5 * materialParams.dims.y, 0.0, materialParams.dims.y);
            pl.xz *= materialParams.dims.x * (1.0 - up / materialParams.dims.y) / max(length(pl.xz), 1e-6);
        } else if (materialParams.kind == 4) {
            pl = exSnap;
        }
        float ci = clamp(-dot(dl, nl), 0.0, 1.0);

        float F = fresnel(ci, 1.0, materialParams.ior);
        vec3 mirrored = lookup(P, R * reflect(dl, nl), floorY);

        // One sight line, followed once with the middle of the spectrum: through this solid, then on through
        // whatever other glass it meets. The colours are only told apart where it finally leaves the glass
        // (the last bend is done once per colour). Plausible, not exact: following every colour all the way
        // costs nine times as much and looks the same.
        float n0 = materialParams.ior;
        vec3 rd = refract(dl, nl, 1.0 / n0), ro = pl;
        float path = 0.0, through = 1.0;
        vec3 lastIn = vec3(0.0), lastN = vec3(0.0, 1.0, 0.0), wo = vec3(0.0);
        bool outOk = false;
        for (int b = 0; b < BOUNCES; b++) {
            vec3 fn;
            float t = exitAt(ro, rd, fn);
            ro += rd * t;
            path += t * e;
            vec3 o1 = refract(rd, -fn, n0);
            if (dot(o1, o1) > 0.0) {
                lastIn = R * rd;
                lastN = R * fn;
                wo = c + R * (ro * e);
                outOk = true;
                break;
            }
            rd = reflect(rd, fn);
        }
        if (outOk && materialParams.solidCount > 1) {
            gNear = ivec4(variable_near + 0.5);
            // the scene table is in the user's world space
            int cur = materialParams.self;
            for (int seg = 1; seg < SEGS; seg++) {
                vec3 wd = refract(lastIn, -lastN, n0);
                int nx;
                float tn;
                vec3 nn;
                if (!nextSolid(wo + shift, wd, cur, nx, tn, nn)) break;
                through *= 1.0 - fresnel(dot(lastIn, lastN), n0, 1.0);
                vec3 q = wo + shift + wd * tn;
                through *= 1.0 - fresnel(clamp(-dot(wd, nn), 0.0, 1.0), 1.0, n0);
                wd = refract(wd, nn, 1.0 / n0);
                cur = nx;
                bool left = false;
                for (int b = 0; b < BOUNCES; b++) {
                    vec3 fn;
                    float t = exitWorld(cur, q, wd, fn);
                    q += wd * t;
                    path += t;
                    vec3 o2 = refract(wd, -fn, n0);
                    if (dot(o2, o2) > 0.0) {
                        lastIn = wd;
                        lastN = fn;
                        wo = q - shift;
                        left = true;
                        break;
                    }
                    wd = reflect(wd, fn);
                }
                if (!left) { outOk = false; break; }
            }
        }
        vec3 acc = vec3(0.0), wsum = vec3(0.0);
        // a sight line still caught inside after the allowed mirrors would get out a little later anyway:
        // let it look where it is heading, instead of leaving a black sliver
        vec3 caught = outOk ? vec3(0.0) : lookup(c + R * (ro * e), R * rd, floorY) * exp(-materialParams.absorption * path);
        for (int i = 0; i < WAVES; i++) {
            float nm = mix(430.0, 670.0, (float(i) + 0.5) / float(WAVES));
            vec3 w = max(waveRgb(nm), vec3(0.0));
            wsum += w;
            if (!outOk) { acc += w * caught; continue; }
            float n = n0 + (iorAt(nm) - n0) * materialParams.spread;
            vec3 outDir = refract(lastIn, -lastN, n);
            // a colour the glass would not let out here leaves with the middle of the spectrum instead: every
            // colour must come out somewhere, or the glass turns yellow
            if (dot(outDir, outDir) <= 0.0) outDir = refract(lastIn, -lastN, n0);
            acc += w * lookup(wo, outDir, floorY);
        }
        if (outOk) acc *= exp(-materialParams.absorption * path) * through * (1.0 - fresnel(dot(lastIn, lastN), n0, 1.0));
        vec3 transmitted = acc / max(wsum, vec3(1e-5));
        material.baseColor = vec4(transmitted * (1.0 - F) + mirrored * F, 1.0);
    }
}
