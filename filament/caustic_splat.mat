material {
    name : caustic_splat,
    shadingModel : unlit,
    blending : add,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    specularAntiAliasing : false,
    parameters : [
        { type : sampler2d, name : frontFace, format : float, filter : nearest },
        { type : sampler2d, name : backFace, format : float, filter : nearest },
        { type : float3, name : origin },
        { type : float3, name : dir },
        { type : float3, name : tangent },
        { type : float3, name : bitangent },
        { type : float, name : captureSize },
        { type : float, name : extent },
        { type : float, name : ior },
        { type : float, name : dispersion },
        { type : float, name : splat },
        { type : float, name : lux }
    ],
    requires : [ uv0 ]
}

vertex {
    vec3 octDecode(vec2 e) {
        vec2 f = e * 2.0 - 1.0;
        vec3 n = vec3(f.xy, 1.0 - abs(f.x) - abs(f.y));
        if (n.z < 0.0) n.xy = (vec2(1.0) - abs(n.yx)) * sign(n.xy);
        return normalize(n);
    }
    float n_of(float nm) {
        float offset = 0.70795215 + (nm - 486.1) / (656.3 - 486.1) * (-0.29204785 - 0.70795215);
        float P = materialParams.dispersion / 20.0;
        return max(1.05, materialParams.ior + P * (materialParams.ior - 1.0) * offset);
    }
    bool bend(vec3 I, vec3 N, float eta, out vec3 T) {
        float cosi = clamp(-dot(I, N), -1.0, 1.0);
        float k = 1.0 - eta * eta * (1.0 - cosi * cosi);
        if (k < 0.0) return false;
        T = normalize(I * eta + N * (eta * cosi - sqrt(k)));
        return true;
    }
    void materialVertex(inout MaterialVertexInputs material) {
        int v = getVertexIndex();
        int corner = v - (v / 6) * 6;
        int rest = v / 6;
        int band = rest - (rest / 6) * 6;
        int id = rest / 6;
        int n = int(materialParams.captureSize + 0.5);
        int x = id - (id / n) * n;
        int y = id / n;
        vec2 uv = (vec2(float(x), float(y)) + 0.5) / materialParams.captureSize;
        vec4 front = textureLod(materialParams_frontFace, uv, 0.0);
        vec4 back = textureLod(materialParams_backFace, uv, 0.0);
        float su = (uv.x * 2.0 - 1.0) * materialParams.extent;
        float sv = (uv.y * 2.0 - 1.0) * materialParams.extent;
        vec3 o = materialParams.origin + materialParams.tangent * su + materialParams.bitangent * sv;
        vec3 pf = o + materialParams.dir * front.b;
        vec3 pb = o + materialParams.dir * back.b;
        vec3 nf = octDecode(front.rg);
        vec3 nb = octDecode(back.rg);
        if (dot(materialParams.dir, nf) > 0.0) nf = -nf;
        float nm = 450.0 + float(band) * (220.0 / 5.0);
        float eta = n_of(nm);
        vec3 inside = materialParams.dir;
        vec3 outd = materialParams.dir;
        bool ok = front.b > 0.05 && back.b > front.b + 0.001;
        if (ok) ok = bend(materialParams.dir, nf, 1.0 / eta, inside);
        if (ok && dot(inside, nb) > 0.0) nb = -nb;
        if (ok) ok = bend(inside, nb, eta, outd);
        if (ok && outd.y >= -0.001) ok = false;
        float t = ok ? -pb.y / outd.y : 0.0;
        if (ok && t < 0.0) ok = false;
        vec3 hit = pb + outd * t;
        float ox = (corner == 1 || corner == 2 || corner == 4) ? 1.0 : -1.0;
        float oz = (corner == 2 || corner == 4 || corner == 5) ? 1.0 : -1.0;
        vec3 placed = hit + vec3(ox, 0.0, oz) * materialParams.splat + vec3(0.0, 0.02, 0.0);
        material.worldPosition.xyz += ok ? placed : vec3(0.0, -80.0, 0.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        int band = int(getUV0().x + 0.5);
        vec3 rgb = vec3(0.0);
        if (band == 0) rgb = vec3(0.0000, 0.0578, 0.5556);
        else if (band == 1) rgb = vec3(0.0000, 0.2889, 0.4444);
        else if (band == 2) rgb = vec3(0.1176, 0.2889, 0.0000);
        else if (band == 3) rgb = vec3(0.2941, 0.2800, 0.0000);
        else if (band == 4) rgb = vec3(0.2941, 0.0844, 0.0000);
        else rgb = vec3(0.2941, 0.0000, 0.0000);
        float cell = (2.0 * materialParams.extent) / materialParams.captureSize;
        float area = (2.0 * materialParams.splat) * (2.0 * materialParams.splat);
        float illum = materialParams.lux * cell * cell / area;
        material.baseColor = vec4(rgb * illum, 1.0);
    }
}
