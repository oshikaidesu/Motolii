material {
    name : gpu_tube,
    shadingModel : lit,
    blending : fade,
    refractionMode : screenspace,
    refractionType : solid,
    doubleSided : false,
    specularAntiAliasing : true,
    requires : [
        tangents,
        uv0
    ],
    parameters : [
        { type : sampler2d, name : controls, precision : high, format : float, filter : nearest },
        { type : float, name : tubeRadius },
        { type : float, name : spanCount },
        { type : float, name : ior },
        { type : float, name : transmission },
        { type : float, name : thickness },
        { type : float, name : dispersion }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        float packed = material.uv0.x;
        float span = floor(packed + 0.0001);
        float t = clamp(packed - span, 0.0, 0.999);
        mat4 userFromWorld = getUserWorldFromWorldMatrix();
        float ang = (userFromWorld * material.worldPosition).y;
        float width = materialParams.spanCount > 0.0 ? materialParams.spanCount * 4.0 : 16.0;
        float base = span * 4.0;
        vec2 p0 = textureLod(materialParams_controls, vec2((base + 0.5) / width, 0.5), 0.0).xy;
        vec2 p1 = textureLod(materialParams_controls, vec2((base + 1.5) / width, 0.5), 0.0).xy;
        vec2 p2 = textureLod(materialParams_controls, vec2((base + 2.5) / width, 0.5), 0.0).xy;
        vec2 p3 = textureLod(materialParams_controls, vec2((base + 3.5) / width, 0.5), 0.0).xy;
        if (span < 0.5) { p0 = vec2(-0.85, -0.40); p1 = p0; p2 = vec2(0.85, -0.40); p3 = p2; }
        else if (span < 1.5) { p0 = vec2(0.85, -0.40); p1 = p0; p2 = vec2(0.85, 0.40); p3 = p2; }
        else if (span < 2.5) { p0 = vec2(0.85, 0.40); p1 = p0; p2 = vec2(-0.85, 0.40); p3 = p2; }
        else { p0 = vec2(-0.85, 0.40); p1 = p0; p2 = vec2(-0.85, -0.40); p3 = p2; }
        float u = 1.0 - t;
        vec2 center = ((u * u * u) * p0) + ((3.0 * u * u * t) * p1) + ((3.0 * u * t * t) * p2) + ((t * t * t) * p3);
        vec2 deriv = (3.0 * u * u) * (p1 - p0) + (6.0 * u * t) * (p2 - p1) + (3.0 * t * t) * (p3 - p2);
        float len = length(deriv);
        vec3 T = len > 1e-4 ? vec3(deriv / len, 0.0) : vec3(1.0, 0.0, 0.0);
        vec3 side = normalize(cross(T, vec3(0.0, 0.0, 1.0)));
        vec3 lift = normalize(cross(side, T));
        vec3 radial = cos(ang) * lift + sin(ang) * side;
        float radius = materialParams.tubeRadius > 0.0 ? materialParams.tubeRadius : 0.052;
        material.worldPosition = inverse(userFromWorld) * vec4(vec3(center, 0.0) + radius * radial, 1.0);
        material.worldNormal = radial;
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = vec4(0.92, 0.96, 1.0, 1.0);
        material.roughness = 0.0;
        material.metallic = 0.0;
        material.reflectance = 0.72;
        material.clearCoat = 1.0;
        material.clearCoatRoughness = 0.0;
        material.absorption = vec3(0.02, 0.16, 0.55);
        material.transmission = materialParams.transmission;
        material.ior = materialParams.ior;
        material.thickness = materialParams.thickness;
        material.dispersion = materialParams.dispersion;
    }
}
