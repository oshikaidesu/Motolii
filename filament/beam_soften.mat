// Softens the floor light and the block's shadow the way a sun with some width does: sharp where the light
// lands right beside the glass, softer the further it flew. One full-screen pass, no noise, no history:
// the same picture every time.
//
// Inputs (both drawn by beam_light.mat with the picture's own camera, both with a full mip chain):
//   light  rgb = light on the floor,           a = light * distance flown
//   shade  r   = how much of the sun is cut off (1 inside the block's outline), a = that * distance flown
// a / brightness is therefore the average distance the light (or the missing light) at a pixel travelled from
// the glass, at any mip level. Light that flew `travel` is spread over a disc of radius travel * sunTan.
// Each pixel looks at a few mip levels to find the widest spread that reaches it, then averages a small fixed
// ring of taps at the matching level.
//
// Output: rgb = softened light - softened shade * sunDown, in units of the sun's irradiance (may be negative:
// that is the shadow, which the floor adds to its own sunlight).
//
// Receivers other than the floor (walls, blocks; see recv_light.mat, recv_beam.mat). Three switches, all 0 if not set:
//   unit > 0 : the inputs' alpha is not light * distance but light * (the spread in pixels) / unit: whoever drew the
//              light knew how far from the camera it lies, so nothing here needs to know what it lies on.
//   split    : output rgb = softened light, a = softened shade (0 to 1). What the missing sun takes away depends on
//              how the surface faces the sun; the surface works that out itself (recv_beam.mat). The shade picture
//              then carries the sun cut off in RED alone.
//   marks    : (with split) the shade picture's GREEN says what a pixel shows: 0 the room, (i + 1) / 8 block i
//              (recv_mask.mat). A pixel is then softened only with what lies on the same thing: without this, light
//              on top of a block would run into the floor seen behind it. Green is averaged down the mip chain with
//              everything else, so a tap whose patch of picture is partly something else has another green and
//              counts for less, smoothly.
material {
    name : beam_soften,
    shadingModel : unlit,
    vertexDomain : device,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    flipUV : false,
    parameters : [
        { type : sampler2d, name : light, precision : medium },
        { type : sampler2d, name : shade, precision : medium },
        { type : mat4, name : worldFromClip, precision : high },
        { type : float3, name : eye },
        { type : float, name : floorY },
        { type : float, name : sunTan },
        { type : float, name : sunDown },
        { type : float, name : focal },
        { type : float2, name : texel },
        { type : float, name : least },      // spread at least this many pixels (of the light's picture): when that picture is smaller than the final one, its
                                             // pixel steps along a sharp edge would show as stairs
        { type : float, name : unit },
        { type : float, name : split },
        { type : float, name : marks }
    ],
    requires : [ uv0 ]
}

fragment {
    const int RING = 12;

    // The widest spread (in pixels) of anything near this pixel that reaches it.
    float spread(sampler2D tex, vec2 uv, float pxPerUnit) {
        float r = 0.0;
        for (int i = 0; i < 6; i++) {
            float lod = float(i) * 1.25;
            vec4 s = textureLod(tex, uv, lod);
            float lum = (s.r + s.g + s.b) / 3.0;
            if (lum <= 1e-6) continue;
            float rr = s.a / lum * materialParams.sunTan * pxPerUnit;
            // level `lod` sees about 2^lod pixels around: accept what is wide enough to reach from there
            if (i == 0 || rr >= 0.35 * exp2(lod)) r = max(r, rr);
        }
        return r;
    }
    vec3 soften(sampler2D tex, vec2 uv, float r) {
        if (r < 0.75) return textureLod(tex, uv, 0.0).rgb;
        // a ring of taps at half the radius plus the centre, read at the mip whose texel is about the tap spacing
        float lod = max(log2(r * 0.5), 0.0);
        vec3 acc = textureLod(tex, uv, lod).rgb;
        for (int i = 0; i < RING; i++) {
            float ang = (float(i) + 0.5) * (6.2831853 / float(RING));
            float rad = (i - (i / 2) * 2 == 0) ? 0.45 : 0.85;
            acc += textureLod(tex, uv + vec2(cos(ang), sin(ang)) * (r * rad) * materialParams.texel, lod).rgb;
        }
        return acc / float(RING + 1);
    }

    // The same two for a stage (`split`): the shade is in red alone, and with `marks` a tap counts by how much of it
    // lies on the same thing as the pixel (green of the shade picture, see above).
    float spreadRed(sampler2D tex, vec2 uv, float pxPerUnit) {
        float r = 0.0;
        for (int i = 0; i < 6; i++) {
            float lod = float(i) * 1.25;
            vec4 s = textureLod(tex, uv, lod);
            if (s.r <= 1e-6) continue;
            float rr = s.a / s.r * materialParams.sunTan * pxPerUnit;
            if (i == 0 || rr >= 0.35 * exp2(lod)) r = max(r, rr);
        }
        return r;
    }
    vec3 softenSame(sampler2D tex, vec2 uv, float r) {
        vec3 sharp = textureLod(tex, uv, 0.0).rgb;
        if (r < 0.75) return sharp;
        float lod = max(log2(r * 0.5), 0.0);
        if (materialParams.marks < 0.5) {
            vec3 sum = textureLod(tex, uv, lod).rgb;
            for (int i = 0; i < RING; i++) {
                float ang = (float(i) + 0.5) * (6.2831853 / float(RING));
                float rad = (i - (i / 2) * 2 == 0) ? 0.45 : 0.85;
                sum += textureLod(tex, uv + vec2(cos(ang), sin(ang)) * (r * rad) * materialParams.texel, lod).rgb;
            }
            return sum / float(RING + 1);
        }
        float mine = textureLod(materialParams_shade, uv, 0.0).g;
        float w = clamp(1.0 - abs(textureLod(materialParams_shade, uv, lod).g - mine) * 12.0, 0.0, 1.0);
        vec3 acc = textureLod(tex, uv, lod).rgb * w;
        float total = w;
        for (int i = 0; i < RING; i++) {
            float ang = (float(i) + 0.5) * (6.2831853 / float(RING));
            float rad = (i - (i / 2) * 2 == 0) ? 0.45 : 0.85;
            vec2 at = uv + vec2(cos(ang), sin(ang)) * (r * rad) * materialParams.texel;
            w = clamp(1.0 - abs(textureLod(materialParams_shade, at, lod).g - mine) * 12.0, 0.0, 1.0);
            acc += textureLod(tex, at, lod).rgb * w;
            total += w;
        }
        // (with next to nothing of its own kind around, the pixel keeps what it has)
        float own = clamp(total * 0.5, 0.0, 1.0);
        return mix(sharp, acc / max(total, 1e-3), own);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = uvToRenderTargetUV(getUV0());
        float pxPerUnit = 0.0;
        if (materialParams.sunTan > 0.0) {
            highp vec4 far = materialParams.worldFromClip * vec4(getUV0() * 2.0 - 1.0, 0.5, 1.0);
            highp vec3 d = far.xyz / far.w - materialParams.eye;
            if (d.y < -1e-6) {
                highp float t = (materialParams.floorY - materialParams.eye.y) / d.y;
                pxPerUnit = materialParams.focal / (length(d) * t);       // pixels per world unit at the floor under this pixel
            }
        }
        if (materialParams.unit > 0.0) pxPerUnit = materialParams.unit / max(materialParams.sunTan, 1e-9);
        if (materialParams.split > 0.5) {
            vec3 lit = softenSame(materialParams_light, uv, max(spread(materialParams_light, uv, pxPerUnit), materialParams.least));
            float cut = min(softenSame(materialParams_shade, uv, max(spreadRed(materialParams_shade, uv, pxPerUnit), materialParams.least)).r, 1.0);
            material.baseColor = vec4(lit, cut);
            return;
        }
        vec3 light = soften(materialParams_light, uv, max(spread(materialParams_light, uv, pxPerUnit), materialParams.least));
        // several blocks may shade the same spot: the sun cannot be cut off more than once
        float shade = min(soften(materialParams_shade, uv, max(spread(materialParams_shade, uv, pxPerUnit), materialParams.least)).r, 1.0);
        material.baseColor = vec4(light - vec3(shade * materialParams.sunDown), 1.0);
    }
}
