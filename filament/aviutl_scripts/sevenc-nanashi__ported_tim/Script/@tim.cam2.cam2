@位置補正
--label:tim\カメラ制御
--track@track_offset_x:補正X,-5000,5000,0,0.1
--track@track_offset_y:補正Y,-5000,5000,0,0.1
--track@track_offset_z:補正Z,-5000,5000,0,0.1
--select@select_adjust_method:補正方法=1,カメラ位置=1,ターゲット位置=2,両方=3
local dx = track_offset_x
local dy = track_offset_y
local dz = track_offset_z
local adjust_method = math.floor(select_adjust_method)
local camera = obj.getoption("camera_param")

if adjust_method == 1 or adjust_method == 3 then
    camera.x = camera.x + dx
    camera.y = camera.y + dy
    camera.z = camera.z + dz
end
if adjust_method == 2 or adjust_method == 3 then
    camera.tx = camera.tx + dx
    camera.ty = camera.ty + dy
    camera.tz = camera.tz + dz
end
obj.setoption("camera_param", camera)

@位置補正R
--label:tim\カメラ制御
--track@track_rotation_z_offset:補正RZ,-5000,5000,0,0.1
local rotation_z_offset = track_rotation_z_offset
local camera = obj.getoption("camera_param")

camera.rz = camera.rz + rotation_z_offset

obj.setoption("camera_param", camera)

@MMDカメラデータ読込VMD
--label:tim\カメラ制御
--track@track_size_correction:サイズ補正,1,10000,100,0.01
--track@track_frame_offset:フレームオフセット,0,10000,0,1
--check@check_auto_view_angle:自動視野角,true
--file@file_path:ファイル
local tim2 = obj.module("tim2")
local loaded_camera_count = tim2.mmdcam_read_data(file_path)

if loaded_camera_count ~= 0 then
    local x, y, z, target_x, target_y, target_z, roll, view_angle, vertical_sign = tim2.mmdcam_get_camera_data(
        obj.frame + track_frame_offset,
        obj.totalframe + track_frame_offset,
        3000 / track_size_correction
    )

    local camera = obj.getoption("camera_param")

    camera.x = x
    camera.y = y
    camera.z = z
    camera.target_x = target_x
    camera.target_y = target_y
    camera.target_z = target_z
    camera.roll = camera.roll + roll

    if vertical_sign < 0 then
        camera.ux = -camera.ux
        camera.uy = -camera.uy
        camera.uz = -camera.uz
    end

    if check_auto_view_angle then
        camera.d = obj.screen_h / math.tan(view_angle * math.pi / 360) / 2
    end

    obj.setoption("camera_param", camera)
end

