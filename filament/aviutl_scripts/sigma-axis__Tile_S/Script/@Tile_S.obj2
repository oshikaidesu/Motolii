local obj, tonumber, type, math, bit = obj, tonumber, type, math, require("bit");

-- set anchors.
obj.setanchor("X,Y", 0, "line");

--#region PI / normalize parameters.

-- take parameters.
local function field_as_num(src, tgt, fld)
	local t = src[fld];
	if type(t) == "table" then
