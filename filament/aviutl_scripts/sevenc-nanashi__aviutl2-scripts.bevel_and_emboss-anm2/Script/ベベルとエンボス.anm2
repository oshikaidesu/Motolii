--[[pixelshader@bevel_shade:
Texture2D<float4> tex0 : register(t0);
Texture2D<float4> tex1 : register(t1);
Texture2D<float4> tex2 : register(t2);

cbuffer Params : register(b0) {
  float threshold;
  float bevelWidth;
  float jumpStep;
  float shape;
  float lightX;
  float lightY;
  float strength;
  float outputMode;
  float red;
  float green;
  float blue;
  float shadow;
  float opacity;
};

