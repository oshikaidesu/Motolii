float signedDistance(int2 p) {
  float4 seed = tex0.Load(int3(p, 0));
  float distance = validSeed(seed) ? length(unpackOffset(seed)) : bevelWidth + 2.0;
  return tex1.Load(int3(p, 0)).a > threshold ? -distance : distance;
