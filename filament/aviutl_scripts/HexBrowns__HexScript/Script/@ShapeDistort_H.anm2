--[[pixelshader@ps_pp_grid:
cbuffer P : register(b0) {
    float2 src_size;     // 0-1  元の絵の大きさ（px）
    float2 cell;         // 2-3  1 マスの大きさ（px）
};

Texture2D src : register(t0);

// 1 マス（出力の 1 画素）の中の 8x8 点のアルファの最大を R に書く。
// A = 1 で書くので、読み戻し（ストレートの RGBA8）でも R はそのまま（0〜255）
float4 ps_pp_grid(float4 pos : SV_Position) : SV_Target {
    float2 base = floor(pos.xy) * cell;
    int2 lim = max(int2(src_size) - int2(1, 1), int2(0, 0));
    float m = 0.0;
    [loop]
    for (int j = 0; j < 8; j++) {
        [loop]
        for (int i = 0; i < 8; i++) {
            float2 p = base + (float2((float)i, (float)j) + 0.5) * (cell / 8.0);
            int2 q = clamp(int2(p), int2(0, 0), lim);
            m = max(m, src.Load(int3(q, 0)).a);
        }
    }
    return float4(m, 0.0, 0.0, 1.0);
}
]]

local obj, math = obj, math

-- パペット: 絵のアルファから三角網を作り、ピンに引かれて自然に曲がるよう変形して、三角形ごとに obj.drawpoly で描く。
-- 変形の計算（三角網・As-Rigid-As-Possible・描く順）は puppet.mod2（AI/plugins/Puppet_H/。Script/Puppet_H/ に置く）。
-- 仕様: AI/specifications/20261012_ShapeDistort_H_パペット_spec.md / 検証器: AI/scripts/ShapeDistort_H/verify_puppet.py
--
-- 座標はすべて「オブジェクトの中心を原点とする、元の絵の画素」（y は下向き）。obj.setanchor の既定（オブジェクト座標）と同じ。
-- ピンの今の位置 = 元の位置（ピンの元の位置）＋ ずれ（ピンNX / ピンNY）＋ 付いていくレイヤーの動き ＋ 揺れ
-- 「元の位置を打つ」の間は変形せず、元の位置・硬さピン・重なりピンのアンカーを出す（変形していない絵の上で打つため）。
-- それ以外は、ピンごとに「ずれ」のアンカーを元の位置からのオフセットで出す（ドラッグでずれのトラックに値が入る）

local W0, H0 = obj.w, obj.h
if W0 < 1 or H0 < 1 then return end
local G = _PUPPET_H or { warned = {}, list = {}, wire = {} }
_PUPPET_H = G

-- 配列の i 番目の数（無い・数でないなら d）
local function num(t, i, d)
  local v = (type(t) == "table") and tonumber(t[i]) or nil
  if v == nil or v ~= v or v == math.huge or v == -math.huge then return d end
  return v
end
local np = math.max(1, math.min(8, math.floor(pin_n + 0.5)))
local ns = math.max(0, math.min(4, math.floor(starch_n + 0.5)))
local no = math.max(0, math.min(4, math.floor(ovl_n + 0.5)))
local is_place = (place_mode == 1)

-- 配列が足りないときの既定の位置（絵の大きさに対する割合を画素に丸める）
local DEF_PIN = { {0, -0.35}, {0, 0.35}, {-0.35, 0}, {0.35, 0}, {-0.3, -0.3}, {0.3, -0.3}, {-0.3, 0.3}, {0.3, 0.3} }
local DEF_SUB = { {0, 0}, {0, -0.2}, {0, 0.2}, {-0.2, 0} }
local function points(arr, count, def)
  local out = {}
  for k = 1, count do
    out[2 * k - 1] = num(arr, 2 * k - 1, math.floor(def[k][1] * W0 + 0.5))
    out[2 * k] = num(arr, 2 * k, math.floor(def[k][2] * H0 + 0.5))
  end
  return out
end
local base = points(pin_base, np, DEF_PIN)
local spos = points(starch_pos, ns, DEF_SUB)
local opos = points(ovl_pos, no, DEF_SUB)

-- 硬さピン {x, y, 半径, 強さ(0〜1)}・重なりピン {x, y, 前後, 半径}。値の配列は 1 本につき 2 つ（既定 半径 100・強さ 100 / 前後 50・半径 100）
local starch, ovl = {}, {}
for k = 1, ns do
  starch[#starch + 1] = spos[2 * k - 1]
  starch[#starch + 1] = spos[2 * k]
  starch[#starch + 1] = math.max(0, num(starch_v, 2 * k - 1, 100))
  starch[#starch + 1] = math.max(0, math.min(100, num(starch_v, 2 * k, 100))) / 100
end
for k = 1, no do
  ovl[#ovl + 1] = opos[2 * k - 1]
  ovl[#ovl + 1] = opos[2 * k]
  ovl[#ovl + 1] = math.max(-100, math.min(100, num(ovl_v, 2 * k - 1, 50)))
  ovl[#ovl + 1] = math.max(0, num(ovl_v, 2 * k, 100))
end

-- アンカー（呼ぶ順と回数は、ピンの数・モードが同じ間は変わらない）
local PX = { p1x, p2x, p3x, p4x, p5x, p6x, p7x, p8x }
local PY = { p1y, p2y, p3y, p4y, p5y, p6y, p7y, p8y }
if is_place then
  local function circle(cx, cy, r, col)
    if not (r > 0) then return end
    local t = {}
    for i = 0, 23 do
      local a = i * math.pi / 12
      t[2 * i + 1] = cx + r * math.cos(a)
      t[2 * i + 2] = cy + r * math.sin(a)
    end
    obj.setanchor(t, 24, "loop", "color", col)
  end
  obj.setanchor("pin_base", np, base)
  if ns > 0 then
    obj.setanchor("starch_pos", ns, "color", 0x40c0ff, spos)
    for k = 1, ns do circle(starch[4 * k - 3], starch[4 * k - 2], starch[4 * k - 1], 0x40c0ff) end
  end
  if no > 0 then
    obj.setanchor("ovl_pos", no, "color", 0xff9040, opos)
    for k = 1, no do circle(ovl[4 * k - 3], ovl[4 * k - 2], ovl[4 * k], 0xff9040) end
  end
else
  for k = 1, np do
    obj.setanchor("p" .. k .. "x,p" .. k .. "y", 0, "line", "offset", base[2 * k - 1], base[2 * k])
  end
end

-- ピンの今の位置
local cur = {}
if is_place then
  for i = 1, 2 * np do cur[i] = base[i] end
else
  -- 付いていく: 指定したレイヤーのオブジェクトの基準座標の、そのオブジェクトの最初の位置からの動き。
  -- 画面の上の動きなので、このオブジェクトの回転と拡大率を戻して画素に直す（画面で 100px 動けばピンも画面で 100px）
  local rz = math.rad((tonumber((obj.getvalue("rz"))) or 0) + (obj.rz or 0))
  local sx = (tonumber((obj.getvalue("sx"))) or 1) * (obj.sx or 1)
  local sy = (tonumber((obj.getvalue("sy"))) or 1) * (obj.sy or 1)
  if math.abs(sx) < 1e-6 then sx = (sx < 0) and -1e-6 or 1e-6 end
  if math.abs(sy) < 1e-6 then sy = (sy < 0) and -1e-6 or 1e-6 end
  local cr, sr = math.cos(rz), math.sin(rz)
  local function follow_of(L)
    L = math.floor(L + 0.5)
    if L < 1 or L == obj.layer then return 0, 0 end
    local key = "layer" .. L
    if not (obj.getvalue(key)) then return 0, 0 end
    local x = tonumber((obj.getvalue(key .. ".x")))
    local y = tonumber((obj.getvalue(key .. ".y")))
    if x == nil or y == nil then return 0, 0 end
    -- 最初の位置: 相手の開始点（区間 0）の時刻 0 の値。区間の番号は相手の区間を指す（"layerN.time" で検証 IDL-02）ので、
    -- 開始フレームの差から時刻を組まない（時刻の基準がどちらのオブジェクトかは lua.txt に無い。実機で確かめる V-4）
    local x0 = tonumber((obj.getvalue(key .. ".x", 0, 0))) or x
    local y0 = tonumber((obj.getvalue(key .. ".y", 0, 0))) or y
    local dx, dy = x - x0, y - y0
    return (cr * dx + sr * dy) / sx, (-sr * dx + cr * dy) / sy
  end
  -- 揺れ: 滑らかな 1 次元のノイズ（勾配ノイズ、-1〜1）。ピンと軸ごとに種と位相を変える
  local function hash1(v)
    local s = math.sin(v) * 43758.5453123
    return s - math.floor(s)
  end
  local function gnoise(t, s)
    local i = math.floor(t)
    local f = t - i
    local g0 = hash1(i * 127.1 + s * 311.7) * 2 - 1
    local g1 = hash1((i + 1) * 127.1 + s * 311.7) * 2 - 1
    local u = f * f * f * (f * (f * 6 - 15) + 10)
    local a, b = g0 * f, g1 * (f - 1)
    return 2 * (a + (b - a) * u)
  end
  local function wiggle(k)
    local amp = wig_amp * num(wig_w, k, 100) / 100
    if amp == 0 then return 0, 0 end
    local s = wig_seed * 13 + k * 7
    local t = obj.time * wig_freq
    return amp * gnoise(t + hash1(s * 1.7) * 100, s), amp * gnoise(t + hash1(s * 2.3 + 5) * 100, s + 3)
  end
  for k = 1, np do
    local fx, fy = follow_of(num(follow, k, 0))
    local wx, wy = wiggle(k)
    cur[2 * k - 1] = base[2 * k - 1] + PX[k] + fx + wx
    cur[2 * k] = base[2 * k] + PY[k] + fy + wy
  end
end

-- 「元の位置を打つ」の間は、三角網を表示するときだけ（変形しない三角網に線を重ねて）描く
if is_place and show_mesh ~= 1 then return end

local mod = obj.module("puppet")
if not mod then
  if not G.warned.mod then
    G.warned.mod = true
    print("@warn", "[パペット@ShapeDistort_H] puppet.mod2 が見つかりません（Script/Puppet_H/）")
  end
  return
end

-- 三角網の格子: 長い辺を「細かさ」マスに分ける（マスの 1 辺は 1 画素以上。小さな絵を画素より細かく割らない）。
-- マスの大きさは端が細くならないよう W0 / gw x H0 / gh
local dt = math.max(4, math.min(100, math.floor(detail + 0.5)))
local cell = math.max(1, math.max(W0, H0) / dt)
local gw = math.max(1, math.floor(W0 / cell + 0.5))
local gh = math.max(1, math.floor(H0 / cell + 0.5))
obj.clearbuffer("cache:puppet_h/grid", gw, gh)
obj.pixelshader("ps_pp_grid", "cache:puppet_h/grid", {"object"}, { W0, H0, W0 / gw, H0 / gh }, "copy")
local data, dw, dh = obj.getpixeldata("cache:puppet_h/grid")
if data == nil or dw ~= gw or dh ~= gh then return end

-- 前計算（三角網と行列の分解）はモジュールの中でオブジェクトごとに使い回す
local id = string.format("%s/%s/%s/%s", tostring(obj.id), tostring(obj.effect_id), tostring(obj.index), tostring(obj.scene_id))
local verts, ntri = mod.deform(id, data, gw, gh, W0, H0, base, cur, starch, ovl, math.floor(iters + 0.5))
if type(verts) ~= "table" or type(ntri) ~= "number" or ntri <= 0 then return end

-- 頂点の表（描く順。奥から前）。表は使い回す
local list = G.list
local m = 0
local ex, ey = W0 / 2, H0 / 2
for i = 0, ntri * 3 - 1 do
  local b = i * 4
  local x, y = verts[b + 1], verts[b + 2]
  if x == nil or y == nil then break end
  m = m + 1
  local v = list[m]
  if v == nil then
    v = {}
    list[m] = v
  end
  v[1], v[2], v[3], v[4], v[5] = x, y, 0, verts[b + 3], verts[b + 4]
  if math.abs(x) > ex then ex = math.abs(x) end
  if math.abs(y) > ey then ey = math.abs(y) end
end
m = m - m % 3
if m <= 0 then return end
for i = #list, m + 1, -1 do list[i] = nil end

-- 描く先: 中心をそろえたまま、変形した絵が収まるまで上下・左右を同じだけ広げる（元の絵と画素の位置がそろう）。
-- image_max に収め、総ドット数を SIZE_BUDGET 以下に抑える（重さの上限。はみ出した所は切れる）。
-- tempbuffer は cache と 1600 万ドットの枠を共有する（au2-filter-object）ので、半分の 800 万までにする
local SIZE_BUDGET = 8000000
local max_w, max_h = obj.getinfo("image_max")
max_w, max_h = max_w or 16384, max_h or 16384
local pad_x = math.min(math.max(0, math.ceil(ex - W0 / 2)) + 2, math.max(0, math.floor((max_w - W0) / 2)))
local pad_y = math.min(math.max(0, math.ceil(ey - H0 / 2)) + 2, math.max(0, math.floor((max_h - H0) / 2)))
local px, py = 0, 0
for k = 64, 0, -1 do
  px, py = math.floor(pad_x * k / 64), math.floor(pad_y * k / 64)
  if (W0 + 2 * px) * (H0 + 2 * py) <= SIZE_BUDGET then break end
end
local TW, TH = W0 + 2 * px, H0 + 2 * py

obj.setoption("drawtarget", "tempbuffer", TW, TH)
obj.drawpoly(list, 3)
if show_mesh == 1 then
  -- 三角網の線（辺ごとに幅 1.5px の四角。色はストレートで渡す: au2-shader-lua）
  local wire = G.wire
  local q = 0
  local HW = 0.75
  local function put(x, y)
    q = q + 1
    local v = wire[q]
    if v == nil then
      v = {}
      wire[q] = v
    end
    v[1], v[2], v[3], v[4], v[5], v[6], v[7] = x, y, 0, 1, 0.82, 0.25, 0.9
  end
  for t = 0, m / 3 - 1 do
    for e = 0, 2 do
      local a = list[t * 3 + e + 1]
      local c = list[t * 3 + (e + 1) % 3 + 1]
      local dx, dy = c[1] - a[1], c[2] - a[2]
      local len = math.sqrt(dx * dx + dy * dy)
      if len > 1e-6 then
        local nx, ny = -dy / len * HW, dx / len * HW
        put(a[1] - nx, a[2] - ny)
        put(c[1] - nx, c[2] - ny)
        put(c[1] + nx, c[2] + ny)
        put(a[1] + nx, a[2] + ny)
      end
    end
  end
  for i = #wire, q + 1, -1 do wire[i] = nil end
  if q > 0 then obj.drawpoly(wire, 4) end
end
obj.setoption("drawtarget", "framebuffer")
obj.copybuffer("object", "tempbuffer")
