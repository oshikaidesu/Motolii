--[[pixelshader@ps_sd_zigzag:
cbuffer P : register(b0) {
    float2 center;       // 0-1  未使用（レイアウトを 4 セクションで揃えている）
    float2 resolution;   // 2-3
    float amount;        // 4
    float ridges;        // 5
    float wave_shape;    // 6
    float randomness;    // 7
    float random_seed;   // 8
    float wrap_mode;     // 9
    float compose_bg;    // 10
    float extra;         // 11  重ねる順（0 = 横→縦 / 1 = 縦→横）
    float2 pad;          // 12-13
    float2 buf_size;     // 14-15
    float clip_out;      // 16
    float read_mode;     // 17
};

Texture2D tex : register(t0);
SamplerState smp : register(s0);

// 正本: @回転 の ps_sd_swirl
float sd_hash(float2 p) {
    p = frac(p * float2(443.897, 441.423));
    p += dot(p, p.yx + 19.19);
    return frac((p.x + p.y) * p.x);
}

float sd_wave(float x, float shape) {
    float s = sin(x * 6.28318530718);
    float t = abs(frac(x) * 2.0 - 1.0) * 2.0 - 1.0;
    return lerp(s, t, saturate(shape));
}

float sd_jitter(float x, float rnd, float seed) {
    float r = sd_hash(float2(floor(x), seed));
    return lerp(1.0, r * 2.0, saturate(rnd));
}

// 正本: @回転 の sd_read（説明もそこ。直すときは 5 つとも直す）
float4 sd_row(float x0, float y, float dx, float4 wx) {
    return tex.SampleLevel(smp, float2(x0 - dx, y), 0) * wx.x
         + tex.SampleLevel(smp, float2(x0, y), 0) * wx.y
         + tex.SampleLevel(smp, float2(x0 + dx, y), 0) * wx.z
         + tex.SampleLevel(smp, float2(x0 + dx * 2.0, y), 0) * wx.w;
}

float4 sd_read(float2 tuv, float mode, float2 tsize) {
    float2 ts = max(tsize, float2(1.0, 1.0));
    float2 inv = 1.0 / ts;
    float4 res = float4(0.0, 0.0, 0.0, 0.0);
    if (mode > 1.5) {
        float2 tp = tuv * ts - 0.5;
        float2 base = floor(tp);
        float2 f = tp - base;
        float2 c0 = (base + 0.5) * inv;
        float2 f2 = f * f;
        float2 f3 = f2 * f;
        float2 w0 = -0.5 * f3 + f2 - 0.5 * f;
        float2 w1 = 1.5 * f3 - 2.5 * f2 + 1.0;
        float2 w2 = -1.5 * f3 + 2.0 * f2 + 0.5 * f;
        float2 w3 = 0.5 * f3 - 0.5 * f2;
        float4 wx = float4(w0.x, w1.x, w2.x, w3.x);
        res = sd_row(c0.x, c0.y - inv.y, inv.x, wx) * w0.y
            + sd_row(c0.x, c0.y, inv.x, wx) * w1.y
            + sd_row(c0.x, c0.y + inv.y, inv.x, wx) * w2.y
            + sd_row(c0.x, c0.y + inv.y * 2.0, inv.x, wx) * w3.y;
        res.a = saturate(res.a);
        res.rgb = clamp(res.rgb, float3(0.0, 0.0, 0.0), float3(res.a, res.a, res.a));
    } else {
        res = tex.SampleLevel(smp, (floor(tuv * ts) + 0.5) * inv, 0);
    }
    return res;
}

float4 ps_sd_zigzag(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    // 広げた画像の扱いは正本 @回転 の ps_sd_swirl の説明
    float2 buf_uv = uv;
    bool expanded = (pad.x + pad.y) > 0.0;
    if (expanded) {
        uv = (buf_uv * buf_size - pad) / resolution;
    }

    // 縦横比: 横の uv に 幅/高さ を掛けて等方な空間へ直す（正本 @回転 の ps_sd_swirl の説明）
    float aspect = resolution.x / max(resolution.y, 1.0);

    // 横のずれ（行ごと。y で決まる）と縦のずれ（列ごと。x で決まる）を順に重ねる（v1.04）。
    // 描く画素 p から読む位置へは、後に掛けるずれから戻る: 横→縦 なら先に縦（p.x で決まる）、
    // その位置の y で横を決める。どちらも行・列を滑らせるだけの写しなので、重ねても画像は裂けない。
    // v1.03 までは両方を p から同時に決めていて、ずれが大きいと画像が折り返して破片になった
    float kx = amount / 500.0 / max(aspect, 1e-5);
    float ky = amount / 500.0;
    float2 suv = uv;
    if (extra < 0.5) {
        float phase_y = suv.x * ridges;
        suv.y += sd_wave(phase_y, wave_shape) * sd_jitter(phase_y, randomness, random_seed + 37.0) * ky;
        float phase_x = suv.y * ridges;
        suv.x += sd_wave(phase_x, wave_shape) * sd_jitter(phase_x, randomness, random_seed) * kx;
    } else {
        float phase_x = suv.y * ridges;
        suv.x += sd_wave(phase_x, wave_shape) * sd_jitter(phase_x, randomness, random_seed) * kx;
        float phase_y = suv.x * ridges;
        suv.y += sd_wave(phase_y, wave_shape) * sd_jitter(phase_y, randomness, random_seed + 37.0) * ky;
    }
    if (wrap_mode > 0.5) {
        suv = frac(suv);
    } else if (clip_out < 0.5) {
        suv = saturate(suv);
    }
    float2 tuv = expanded ? (suv * resolution + pad) / buf_size : suv;

    float4 fg = tex.Sample(smp, tuv);
    if (read_mode > 0.5) {
        fg = sd_read(tuv, read_mode, buf_size);
    }
    if (compose_bg > 0.5) {
        float4 bg = tex.Sample(smp, buf_uv);
        return fg + bg * (1.0 - fg.a);
    }
    return fg;
}
]]

-- 正本: @回転 の expand（同じ複製。変更時は 4 つとも直す）
local PAD_MARGIN = 2
local SIZE_BUDGET = 15000000
local is_filter = obj.getinfo("filter")
is_filter = (is_filter == true or is_filter == 1)
-- 広げる量を決めて領域拡張まで行い、広げた量を返す（広げなければ 0, 0）
local function expand(want_x, want_y, w, h)
  if is_filter or wrap == 1 then return 0, 0 end
  want_x = (want_x > 0) and (math.ceil(want_x) + PAD_MARGIN) or 0
  want_y = (want_y > 0) and (math.ceil(want_y) + PAD_MARGIN) or 0
  local max_w, max_h = obj.getinfo("image_max")
  local cap_x = math.max(0, math.floor(((max_w or w) - w) / 2))
  local cap_y = math.max(0, math.floor(((max_h or h) - h) / 2))
  local px, py = math.min(want_x, cap_x), math.min(want_y, cap_y)
  local sx, sy = 0, 0
  for k = 64, 0, -1 do
    sx, sy = math.floor(px * k / 64), math.floor(py * k / 64)
    if (w + 2 * sx) * (h + 2 * sy) <= SIZE_BUDGET then break end
    sx, sy = 0, 0
  end
  if sx > 0 or sy > 0 then
    obj.effect("領域拡張", "上", sy, "下", sy, "左", sx, "右", sx, "塗りつぶし", 0)
  end
  return sx, sy
end

local W0, H0 = obj.w, obj.h
-- 変位は横・縦とも 波 x 量/500 x 高さ px（波の絶対値は 1 + ランダム割合 未満）。順に重ねても、
-- 読む位置は横と縦がそれぞれ 1 回ずつずれるだけなので、広げる量は同じ
local reach = (1 + randomness / 100) * math.abs(amount) / 500 * H0
local pad_x, pad_y = expand(reach, reach, W0, H0)

-- 通常のオブジェクトでラップ OFF なら、広げていなくても元の画像の外は透明として読む（v1.03）
if not is_filter and wrap ~= 1 then
  obj.pixelshader("ps_sd_zigzag", "object", "object", {
    0.5, 0.5,
    W0, H0,
    amount, ridges, wave, randomness / 100,
    random_seed, (wrap == 1) and 1 or 0, (compose_bg == 1) and 1 or 0, order,
    pad_x, pad_y, obj.w, obj.h, 1,
    read_mode,
  }, "copy", "clip")
else
  -- 端を読む経路は sampler を明示する（v1.03）。省くと範囲外を透明として補間し、
  -- ちょうど端（uv 0 / 1）を読んだ画素が半透明になる（ラップ ON の継ぎ目・フィルタオブジェクトの画面の端）
  obj.pixelshader("ps_sd_zigzag", "object", "object", {
    0.5, 0.5,
    W0, H0,
    amount, ridges, wave, randomness / 100,
    random_seed, (wrap == 1) and 1 or 0, (compose_bg == 1) and 1 or 0, order,
    0, 0, obj.w, obj.h, 0,
    read_mode,
  }, "copy", (wrap == 1) and "loop" or "clamp")
end

@無限ズーム
--information:無限ズーム@ShapeDistort_H v1.10 by HexBrowns
--label:HexScript
--filter

--group:変形
--track@zoom:ズーム,-1000,1000,0,0.01
--select@zoom_dir:向き=0,寄る=0,引く=1
--track@ratio:縮小率,10,90,50,0.1
--track@step_rot:回転,-360,360,0,0.1
--group

--group:中心
--track@center_x:中心X,-4000,4000,0,0.1
--track@center_y:中心Y,-4000,4000,0,0.1
--trackgroup@center_x,center_y:中心
--group

--group:継ぎ目,0
--track@feather:継ぎ目のなじませ,0,500,0,0.1
--track@frame_w:枠の幅,0,500,0,0.1
--color@frame_col:枠の色,ffffff
--group

--group:品質,0
--track@levels:段の数,1,32,8,1
--select@aa:アンチエイリアス=1,なし=0,2x2=1,4x4=2
--select@read_mode:画像の読み方=0,バイリニア=0,最近傍=1,バイキュービック=2
--group

--[[pixelshader@ps_sd_droste:
cbuffer P : register(b0) {
    float2 center;       // 0-1  不動点（元の画像の uv）
    float2 resolution;   // 2-3  画像の大きさ（px）
    float3 frame_color;  // 4-6  枠の色（0-1。不透明で塗るので乗算済みと同じ）
    float frame_width;   // 7    枠の幅（高さ = 1 の単位）
    float zoom_t;        // 8    ズームの進行の小数部 [0, 1)。Lua で折り返して渡す
    float log_s;         // 9    ln(縮小率)。負
    float step_rot;      // 10   1 段ごとの回転（ラジアン）
    float max_levels;    // 11   1 画素で重ねる段（覆う段だけを数える）の数の上限
    float feather;       // 12   継ぎ目のなじませの幅（高さ = 1 の単位）
    float aa_n;          // 13   1 軸あたりの副標本の数（1 / 2 / 4）
    float read_mode;     // 14   画像の読み方（0 = バイリニア / 1 = 最近傍 / 2 = バイキュービック）
};

Texture2D tex : register(t0);
SamplerState smp : register(s0);

// 入れ子の平面 P: 段 n（整数）の複製は、不動点を中心に s^n 倍・n x 回転 した元の画像。
// 内側の段（n が大きい＝小さい複製）ほど上に重なる。P(s R(回転) y) = P(y)（1 段ずらしても同じ平面）。
// 出力の画素 x（不動点から、高さ = 1 の等方な空間）は y = s^t R(t x 回転) x を読む。t = 1 で t = 0 と同じ絵に戻る。
// 段 n の複製の上での位置は u = s^-n R(-n x 回転) y。u が元の画像の中なら、その段がこの画素を覆う。
// 透明な所は下（外側）の段が透ける。手前から奥へ（n の大きい方から）乗算済みのまま重ねる。
// 覆わない段（画像の外）は「段の数」に数えない。縮小率が大きく中心が辺に近いと覆わない段が続くので、
// 調べる段は別に 64 段で打ち切る（縮小率 90% でも r_in / r_out が 0.9^64 = 0.001 までの中心なら届く）
// 正本: @回転 の sd_read（説明もそこ。直すときは 5 つとも直す）
float4 sd_row(float x0, float y, float dx, float4 wx) {
    return tex.SampleLevel(smp, float2(x0 - dx, y), 0) * wx.x
         + tex.SampleLevel(smp, float2(x0, y), 0) * wx.y
         + tex.SampleLevel(smp, float2(x0 + dx, y), 0) * wx.z
         + tex.SampleLevel(smp, float2(x0 + dx * 2.0, y), 0) * wx.w;
}

float4 sd_read(float2 tuv, float mode, float2 tsize) {
    float2 ts = max(tsize, float2(1.0, 1.0));
    float2 inv = 1.0 / ts;
    float4 res = float4(0.0, 0.0, 0.0, 0.0);
    if (mode > 1.5) {
        float2 tp = tuv * ts - 0.5;
        float2 base = floor(tp);
        float2 f = tp - base;
        float2 c0 = (base + 0.5) * inv;
        float2 f2 = f * f;
        float2 f3 = f2 * f;
        float2 w0 = -0.5 * f3 + f2 - 0.5 * f;
        float2 w1 = 1.5 * f3 - 2.5 * f2 + 1.0;
        float2 w2 = -1.5 * f3 + 2.0 * f2 + 0.5 * f;
        float2 w3 = 0.5 * f3 - 0.5 * f2;
        float4 wx = float4(w0.x, w1.x, w2.x, w3.x);
        res = sd_row(c0.x, c0.y - inv.y, inv.x, wx) * w0.y
            + sd_row(c0.x, c0.y, inv.x, wx) * w1.y
            + sd_row(c0.x, c0.y + inv.y, inv.x, wx) * w2.y
            + sd_row(c0.x, c0.y + inv.y * 2.0, inv.x, wx) * w3.y;
        res.a = saturate(res.a);
        res.rgb = clamp(res.rgb, float3(0.0, 0.0, 0.0), float3(res.a, res.a, res.a));
    } else {
        res = tex.SampleLevel(smp, (floor(tuv * ts) + 0.5) * inv, 0);
    }
    return res;
}

float4 ps_sd_droste(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    float aspect = resolution.x / max(resolution.y, 1.0);
    // 不動点から最も遠い角までの距離。|u| がこれより大きい段は画像の外（覆わない）
    float ext_x = max(abs(center.x), abs(1.0 - center.x)) * aspect;
    float ext_y = max(abs(center.y), abs(1.0 - center.y));
    float r_out = max(sqrt(ext_x * ext_x + ext_y * ext_y), 1e-4);
    float inv_log_s = 1.0 / min(log_s, -1e-4);

    float zs = exp(zoom_t * log_s);
    float za = zoom_t * step_rot;
    float zc = cos(za);
    float zn = sin(za);

    int n_aa = (int)clamp(aa_n, 1.0, 4.0);
    int n_lev = (int)clamp(max_levels, 1.0, 32.0);
    float fa = (float)n_aa;

    float4 sum = float4(0.0, 0.0, 0.0, 0.0);
    [loop]
    for (int sy = 0; sy < 4; sy++) {
        if (sy >= n_aa) break;
        [loop]
        for (int sx = 0; sx < 4; sx++) {
            if (sx >= n_aa) break;
            float2 sub = (float2((float)sx, (float)sy) + 0.5) / fa - 0.5;
            float2 xq = (uv + sub / resolution - center) * float2(aspect, 1.0);
            float2 yq = float2(xq.x * zc - xq.y * zn, xq.x * zn + xq.y * zc) * zs;
            float ry = max(length(yq), 1e-6);
            // 覆いうる最も内側の段: s^-n |y| <= r_out となる最大の n
            float n_top = floor(log(ry / r_out) * inv_log_s);
            float4 acc = float4(0.0, 0.0, 0.0, 0.0);
            int hit = 0;
            [loop]
            for (int k = 0; k < 64; k++) {
                if (hit >= n_lev || acc.a >= 0.999) break;
                float n = n_top - (float)k;
                float ang = -n * step_rot;
                float ca = cos(ang);
                float sa = sin(ang);
                float2 u = float2(yq.x * ca - yq.y * sa, yq.x * sa + yq.y * ca) * exp(-n * log_s);
                float2 iuv = center + u / float2(aspect, 1.0);
                // 辺までの距離（高さ = 1 の単位）。負なら元の画像の外
                float edge = min(min(iuv.x * aspect, (1.0 - iuv.x) * aspect), min(iuv.y, 1.0 - iuv.y));
                if (edge >= 0.0) {
                    hit += 1;
                    // ループの中なので勾配を使わない SampleLevel で読む（Sample は X3570 になりうる）
                    float4 col = tex.SampleLevel(smp, iuv, 0);
                    if (read_mode > 0.5) {
                        col = sd_read(iuv, read_mode, resolution);
                    }
                    if (edge < frame_width) {
                        col = float4(frame_color, 1.0);
                    }
                    float wgt = (feather > 0.0) ? saturate(edge / feather) : 1.0;
                    acc += (1.0 - acc.a) * col * wgt;
                }
            }
            sum += acc;
        }
    }
    return sum / (fa * fa);
}
]]

-- 1 パスで描く。大きさを変えず、cache と tempbuffer も使わない（フィルタオブジェクトでも同じ）。
-- 絵は進行 t の小数部だけで決まる（P は 1 段ずらしても同じ平面）ので、ここで折り返して渡す。
-- 大きな t のまま渡すと、シェーダーの s^t が float32 で潰れる
local W0, H0 = obj.w, obj.h
local t = zoom * ((zoom_dir == 1) and -1 or 1)
t = t - math.floor(t)
if t >= 1 then t = 0 end
local s = math.min(math.max(ratio / 100, 0.01), 0.99)
local aa_n = ({ [0] = 1, [1] = 2, [2] = 4 })[aa] or 2
local col = math.floor(tonumber(frame_col) or 0xffffff)
local fr = math.floor(col / 65536) % 256 / 255
local fg = math.floor(col / 256) % 256 / 255
local fb = col % 256 / 255
obj.pixelshader("ps_sd_droste", "object", "object", {
  0.5 + center_x / math.max(W0, 1), 0.5 + center_y / math.max(H0, 1),
  W0, H0,
  fr, fg, fb,
  frame_w / math.max(H0, 1),
  t, math.log(s), math.rad(step_rot), levels,
  feather / math.max(H0, 1), aa_n,
  read_mode,
}, "copy", "clamp")

@パペット
--information:パペット@ShapeDistort_H v1.00 by HexBrowns
