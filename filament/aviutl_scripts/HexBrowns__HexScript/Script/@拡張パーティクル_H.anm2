@本体
--information:本体@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--group:出力
--track@speed:出力速度,0,10000,200,0.01
--track@rate:出力頻度,0,5000,10,0.01
--track@sync:同時発生数,1,100,1,1
--track@dir:出力方向,-3600,3600,0,0.01
--track@spread:拡散角度,0,180,60,0.01
--track@zdir:Z出力方向,-3600,3600,0,0.01
--track@zspread:Z拡散角度,0,180,0,0.01
--track@life:生存時間,0.001,600,3,0.001
--track@tsub:開始時間,0,600,0,0.001
--group
--group:運動
--track@accel:加速度,-10000,10000,0,0.01
--track@gx:重力X,-10000,10000,0,0.01
--track@gy:重力Y,-10000,10000,0,0.01
--track@gz:重力Z,-10000,10000,0,0.01
--group
--group:回転
--select@rot_random:初期の回転=1,指定どおり=0,Z軸だけランダム=1,XYZランダム=2
--track@rx0:X軸回転,-3600,3600,0,0.01
--track@ry0:Y軸回転,-3600,3600,0,0.01
--track@rz0:Z軸回転,-3600,3600,0,0.01
--track@vrx:X軸回転速度,-36000,36000,0,0.01
--track@vry:Y軸回転速度,-36000,36000,0,0.01
--track@vrz:Z軸回転速度,-36000,36000,60,0.01
--check@revrot:逆回転,0
--group
--group:拡大率と透過率
--track@zoom0:始拡大率,0,5000,100,0.01
--track@zoom1:終拡大率,0,5000,100,0.01
--track@alpha0:始透過率,0,100,0,0.01
--track@alpha1:終透過率,0,100,50,0.01
--group
--group:描画
--select@draw_order:描画順=0,新しい粒子が手前=0,古い粒子が手前=1
--select@face:表示する面=0,両面=0,表だけ=1,裏だけ=2,裏だけ(画像も裏)=3
--select@rot_order:回転の順番=0,標準=0,X→Y→Z=1,X→Z→Y=2,Y→X→Z=3,Y→Z→X=4,Z→X→Y=5,Z→Y→X=6
--select@facing:向き=0,回転どおり=0,進行方向を向く=1,カメラを見る=2
--select@blend:合成モード=0,通常=0,加算=1,減算=2,乗算=3,スクリーン=4,オーバーレイ=5,比較(明)=6,比較(暗)=7,差分=8
--check@reverse:逆再生,0
--check@vanish:終了時に消える,0
--check@plane:平面描写,0
--track@plane_w:平面の幅,1,8192,1920,1
--track@plane_h:平面の高さ,1,8192,1080,1
--hide@plane_w:plane==0
--hide@plane_h:plane==0
--check@screen_fix:画面に貼り付ける,0
--group
--group:その他
--check@birth:放出時の値を使う,1
--track@seed:シード,-100000,100000,0,1
--track@precision:描写精度,1,10,2,1
--select@integ:積分法=0,半陰的オイラー=0,陽的オイラー=1,RK4=2
--track@hmul:刻みの倍率,1,20,1,0.01
--check@diag:診断ログ,0
--select@guide:ガイドの表示=0,なし=0,編集中だけ=1,出力にも=2
--select@hud:状態の表示=0,なし=0,編集中だけ=1,出力にも=2
--check@hud_no:粒子の番号も表示,0
--track@preview:編集中の粒子の割合,1,100,100,0.01
--string@share:渡す名前,
--check@share_only:渡すだけ（自分では描かない）,0
--track@share_n:渡す数,100,10000,500,1
--group
--[[pixelshader@prh_glass:
// ガラス化: t0 = 粒子を描いた画像（アルファだけ使う）、t1 = フレームバッファ（下のレイヤーまでの絵）。
// 粒子のアルファをぼかした勾配の向きへ背景をずらして読み、縁を明るくする。出力は乗算済み
cbuffer P : register(b0) {
    float4 aff0;        // この画像の画素 (px, py) → 画面の画素 x = aff0.x*px + aff0.y*py + aff0.z
    float4 aff1;        //                                  y = aff1.x*px + aff1.y*py + aff1.z
    float4 tint;        // 色（rgb）と色の強さ（a）
    float2 inv_screen;  // 1 / 画面の大きさ
    float2 texel;       // 1 / この画像の大きさ
    float refraction;   // 屈折（px）
    float width;        // 縁の幅（px）
    float edge;         // 縁の明るさ（0..1）
    float blur;         // 背景のぼかし（px）
};
Texture2D mask : register(t0);
Texture2D bg : register(t1);
SamplerState smp : register(s0);

float4 prh_glass(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    float a = mask.SampleLevel(smp, uv, 0).a;
    if (a <= 0.0) return float4(0, 0, 0, 0);
    float2 g = float2(0, 0);
    [loop] for (int i = 0; i < 12; i++) {
        float ang = 6.2831853 * i / 12.0;
        float2 d = float2(cos(ang), sin(ang));
        g += d * mask.SampleLevel(smp, uv + d * width * texel, 0).a;
    }
    g = g / 6.0;
    float2 px = pos.xy + g * refraction;
    float2 sp = float2(dot(aff0.xy, px) + aff0.z, dot(aff1.xy, px) + aff1.z);
    float2 suv = sp * inv_screen;
    float4 col = bg.SampleLevel(smp, suv, 0);
    if (blur > 0.0) {
        float4 acc = col;
        [loop] for (int k = 0; k < 8; k++) {
            float ang2 = 6.2831853 * k / 8.0;
            acc += bg.SampleLevel(smp, suv + float2(cos(ang2), sin(ang2)) * blur * inv_screen, 0);
        }
        col = acc / 9.0;
    }
    col.rgb = lerp(col.rgb, col.rgb * tint.rgb, tint.a);
    float e = saturate(length(g) * 1.5) * edge;
    col.rgb = col.rgb + e * (1.0 - col.rgb);
    col.a = max(col.a, e);
    return col * a;
}
]]
-- 付けたオブジェクトの画像を粒子として放出する。拡張（出力位置・回転・風など）は本体より上に付ける。
-- 計算は Script/Particle_H.lua。計画: AI/specifications/20261002_拡張パーティクル_H_spec.md
local P = require("Particle_H")
local t_start = P.clock()
local SUFFIX = "@拡張パーティクル_H"
local function on(v) return v == true or v == 1 end
local fps = obj.framerate
local total = obj.totaltime
local reverse = on(reverse)
local birth_mode = on(birth)
local start = tsub

-- 時刻: シミュレーション時刻 s とオブジェクトの時刻 t の対応（開始時間・逆再生）
local now = (reverse and (total - obj.time) or obj.time) + start
local function obj_time(s)
  local t = s - start
  if reverse then t = total - t end
  if t < 0 then return 0 elseif t > total then return total end
  return t
end
local function obj_time_raw(s)
  local t = s - start
  if reverse then t = total - t end
  return t
end

-- 拡張: 本体より上にあり（無効なものは除く）、今のフレームに書かれた値だけを使う
local above, seen = {}, {}
for i = 1, 64 do
  local ok, name = pcall(obj.getoption, "script_name", -i, true)
  if not ok or name == nil then break end
  if name ~= "" then
    seen[#seen + 1] = name
    local kind = name:match("^(.-)" .. SUFFIX .. "$")
    if kind then above[kind] = true end
  end
end
-- 本体のメインの関数のローカル変数は、UI の変数（本体が先頭に local で足す）と合わせて 200 個まで。
-- ほかで使わない変数は do … end の中に閉じる（v0.17.0。超えると「main function has more than 200 local variables」で全部止まる）
local ext
do
  local box = _G.Particle_H_ext and _G.Particle_H_ext[obj.id]
  ext = function(kind, key)
    local e = box and box[key]
    if e and above[kind] and e.origin == obj.originframe then return e end
    return nil
  end
end
local e_emit = ext("出力位置", "emit")
local e_rot = ext("回転", "rot")
local e_zoal = ext("拡大率と透過率", "zoal")
local e_indiv = ext("個別微調整", "indiv")
if e_zoal then e_zoal.total = total end
-- カーブエディタ_H のスロット（補間 = カーブエディタ_H）。スロットの式を 0..1 → 割合の関数にする
local ce2_hash, ce2_err = "", nil
local function ce2(slot)
  local fn, err, hash = P.ce2_slot(slot)
  ce2_hash = ce2_hash .. "|" .. slot .. ":" .. (hash or "")
  if err then ce2_err = ce2_err or err end
  return fn
end
if e_zoal then
  if e_zoal.zmode == 9 then e_zoal.zfn = ce2(e_zoal.zslot) end
  if e_zoal.amode == 9 then e_zoal.afn = ce2(e_zoal.aslot) end
  if e_zoal.vmode == 9 then e_zoal.vfn = ce2(e_zoal.vslot) end
end
local X = {
  wind = ext("風", "wind"), noise = ext("ノイズ場", "noise"), att = ext("集結点", "att"), bnc = ext("跳ね返り", "bnc"),
  beh = ext("挙動", "beh"), disp = ext("分散と停止", "disp"), orbit = ext("円運動", "orbit"), time = ext("時間の付け替え", "time"),
  field = ext("力場", "field"), path = ext("パス", "path"), gather = ext("形へ集まる", "gather"), inter = ext("粒子どうし", "inter"),
}
local gather_fn = (X.gather and X.gather.curve == 9) and ce2(X.gather.slot) or nil
local e_look = ext("見た目の調整", "look")
local e_child = ext("子粒子", "child")
local e_shadow = ext("影", "shadow")
local e_light = ext("光源", "light")
local e_bake = ext("焼き付け", "bake")
local e_mat, e_filt, e_color = ext("素材", "mat"), ext("フィルター", "filt"), ext("色の変化", "color")
local e_trail, e_fan, e_mesh = ext("軌跡", "trail"), ext("ファンネル", "fan"), ext("メッシュ", "mesh")
if e_color and e_color.ckind == 9 then e_color.cfn = ce2(e_color.cslot) end
local e_grid, e_solid, e_glass = ext("格子", "grid"), ext("立体物", "solid"), ext("ガラス化", "glass")
local e_audio, e_custom = ext("音", "audio"), ext("カスタム描画", "custom")
-- 時間の付け替え: 進行時間を使うなら、粒子の時刻をその値にする
if X.time and X.time.tp_on then now = X.time.tp + start end

-- トラックバー: 動いていて「放出時の値を使う」なら、その時刻の値を読む（フレームごとに標本を取り、間は直線で補う）
local NOW_VALUES = {
  speed = speed, dir = dir, spread = spread, zdir = zdir, zspread = zspread, life = life, accel = accel,
  gx = gx, gy = gy, gz = gz, rx0 = rx0, ry0 = ry0, rz0 = rz0, vrx = vrx, vry = vry, vrz = vrz,
  zoom0 = zoom0, zoom1 = zoom1, alpha0 = alpha0, alpha1 = alpha1, rate = rate,
}
local moving = {}
for name in pairs(NOW_VALUES) do
  local m = obj.getoption("track_mode", name)
  moving[name] = (m ~= nil and m ~= 0 and m ~= "")
end
local gets = 0
local sample
do
  local samples = {}
  sample = function(name, f)
    local tab = samples[name]
    if not tab then tab = {}; samples[name] = tab end
    local v = tab[f]
    if v == nil then
      v = obj.getvalue("track." .. name, f / fps)
      if v == nil then v = NOW_VALUES[name] end
      tab[f] = v
      gets = gets + 1
    end
    return v
  end
end
local function value_at_obj(name, t)
  local x = t * fps
  local f0 = math.floor(x)
  local v0 = sample(name, f0)
  local fr = x - f0
  if fr <= 0 then return v0 end
  return v0 + (sample(name, f0 + 1) - v0) * fr
end
local function track(name, s)
  if birth_mode and moving[name] then return value_at_obj(name, obj_time(s)) end
  return NOW_VALUES[name]
end
-- 動かないトラックバーの値（計算の側で直接読む）
local track_const = {}
for name, v in pairs(NOW_VALUES) do
  if not (birth_mode and moving[name]) then track_const[name] = v end
end

-- 拡張のトラックバー（風力・ノイズの強さ）: 動いていれば、その時刻の値を読む
local ext_val
do
local ext_samples = {}
local EXT_EFFECT = { wind = "風" .. SUFFIX, noise = "ノイズ場" .. SUFFIX }
ext_val = function(kind, var, s)
  local e = X[kind]
  local item = e.mv and e.mv[var]
  if not item then return e[var] end
  local key = kind .. "." .. var
  local tab = ext_samples[key]
  if not tab then tab = {}; ext_samples[key] = tab end
  local function get(f)
    local v = tab[f]
    if v == nil then
      v = obj.getvalue(EXT_EFFECT[kind], item, f / fps)
      if v == nil then v = e[var] end
      tab[f] = v
      gets = gets + 1
    end
    return v
  end
  local x = obj_time(s) * fps
  local f0 = math.floor(x)
  local v0 = get(f0)
  local fr = x - f0
  if fr <= 0 then return v0 end
  return v0 + (get(f0 + 1) - v0) * fr
end
end

-- 他レイヤー: 位置・Z軸回転・拡大率・中心を、フレームごとに読んで間を直線で補う。
-- 本体の位置（標準描画の値。同じ時刻）を引いて、本体から見た座標にする。対象が無い時刻は nil
local function num(v, d) return tonumber(v) or d end
local layer_frame
do
local layer_tabs = {}
layer_frame = function(n, f)
  local tab = layer_tabs[n]
  if not tab then tab = {}; layer_tabs[n] = tab end
  local v = tab[f]
  if v == nil then
    local t = f / fps
    local L = "layer" .. n .. "."
    local x = obj.getvalue(L .. "x", t)
    if x == nil then
      v = false
    else
      v = { x - num(obj.getvalue("x", t), 0), num(obj.getvalue(L .. "y", t), 0) - num(obj.getvalue("y", t), 0),
            num(obj.getvalue(L .. "z", t), 0) - num(obj.getvalue("z", t), 0), num(obj.getvalue(L .. "rz", t), 0),
            num(obj.getvalue(L .. "sx", t), 1), num(obj.getvalue(L .. "sy", t), 1),
            num(obj.getvalue(L .. "cx", t), 0), num(obj.getvalue(L .. "cy", t), 0) }
    end
    tab[f] = v
    gets = gets + 1
  end
  return v
end
end
local function layer_obj(n)
  return function(t)
    local x = t * fps
    local f0 = math.floor(x)
    local a = layer_frame(n, f0)
    if not a then return nil end
    local fr = x - f0
    local b = fr > 0 and layer_frame(n, f0 + 1) or nil
    if not b then return a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8] end
    return a[1] + (b[1] - a[1]) * fr, a[2] + (b[2] - a[2]) * fr, a[3] + (b[3] - a[3]) * fr, a[4] + (b[4] - a[4]) * fr,
           a[5] + (b[5] - a[5]) * fr, a[6] + (b[6] - a[6]) * fr, a[7] + (b[7] - a[7]) * fr, a[8] + (b[8] - a[8]) * fr
  end
end
local function layer_at(n)
  local f = layer_obj(n)
  return function(s) return f(obj_time(s)) end
end

-- 他レイヤーの形: 今のフレームの画像（そのオブジェクトの効果の後）のアルファを読む。自分の画像と obj の値は後で戻す
local saved
local function save_self()
  if saved then return end
  saved = { cx = obj.cx, cy = obj.cy, cz = obj.cz, ox = obj.ox, oy = obj.oy, oz = obj.oz, rx = obj.rx, ry = obj.ry, rz = obj.rz,
            zoom = obj.zoom, alpha = obj.alpha, aspect = obj.aspect, sx = obj.sx, sy = obj.sy, sz = obj.sz }
  obj.copybuffer("cache:prh_self", "object")
end
local layer_mask
do
local masks = {}
layer_mask = function(n, thr)
  local key = n .. "/" .. thr
  if masks[key] ~= nil then return masks[key] or nil end
  save_self()
  local Mk = false
  if n >= 1 and n ~= obj.layer and obj.load("layer", n, true) then
    local data, w, h = obj.getpixeldata("object")
    if data and w and h and w > 0 and h > 0 then Mk = P.build_mask(data, w, h, thr) end
  end
  masks[key] = Mk
  return Mk or nil
end
end

-- 時刻と画像に依る値（積分の目印には入れない）。関数ファイルは中身の目印を目印に入れる
local errs, RT, fhash = {}, {}, ""
if ce2_err then errs.ce2 = ce2_err end
-- 自分の画像を並べる: 自分の画像（素材の元）のアルファを、並べる間隔のマスにする。他レイヤーを読む前に読む（毎フレーム読む）
if e_emit and e_emit.shape == 8 then
  local data, w, h = obj.getpixeldata("object")
  if data and w and h and w > 0 and h > 0 then
    if e_emit.gsplit == 1 then
      -- 破片: ボロノイの領域（形はシードと画像の大きさで決まる）
      RT.cells = P.image_shards(data, w, h, e_emit.gshards, e_emit.grand / 100, P.seed_key(seed, obj.layer))
    else
      RT.cells = P.image_cells(data, w, h, e_emit.gcell)
    end
  end
end
-- 文字の並び: 素材のテキストを 1 文字ずつ測って並べる（測った幅はフォントと文字ごとに取っておく）
_G.Particle_H_textw = _G.Particle_H_textw or {}
local function text_layout()
  if RT.tlayout ~= nil then return RT.tlayout or nil end
  RT.tlayout = false
  if e_mat and e_mat.kind == 4 and (e_mat.count or 0) > 0 then
    save_self()
    local TW_ = _G.Particle_H_textw
    local fk = table.concat({ tostring(e_mat.font), e_mat.tsize, e_mat.tdeco }, "|") .. "|"
    local set = false
    local function measure(str)
      local v = TW_[fk .. str]
      if not v then
        if not set then obj.setfont(e_mat.font, e_mat.tsize, e_mat.tdeco, e_mat.tcol1, e_mat.tcol2); set = true end
        obj.load("text", str)
        v = { obj.w or 0, obj.h or 0 }
        TW_[fk .. str] = v
      end
      return v[1], v[2]
    end
    RT.tlayout = P.text_layout(e_mat.rawtext, e_mat.by_line, measure,
      { size = e_mat.tsize, space = e_mat.tspace or 0, lspace = e_mat.tlspace or 0, align = e_mat.talign or 1 })
    RT.tmat = e_mat
  end
  return RT.tlayout or nil
end
if e_emit and e_emit.shape == 9 then text_layout() end
if e_emit and e_emit.shape >= 5 and e_emit.shape <= 7 then
  if e_emit.shape <= 6 then
    RT.lay = layer_at(e_emit.layer)
    if e_emit.shape == 6 then RT.emask = layer_mask(e_emit.layer, e_emit.thr / 100) end
  else
    local env, err, hash = P.load_func(e_emit.func)
    if env and (env.xyz or env.xyzd) then RT.efn = { xyz = env.xyz, xyzd = env.xyzd }
    elseif e_emit.func ~= "" then errs.emit = err or "xyz も xyzd も無い" end
    fhash = fhash .. "|e" .. hash
  end
end
-- 出力位置「渡された粒子」: 誕生時刻のシーンのフレームの履歴を引く（同じフレームは 1 回だけ）
local shared_found
if e_emit and e_emit.shape == 10 and e_emit.sname ~= "" then
  local skey = (obj.scene_id ~= nil and (tostring(obj.scene_id) .. ":") or "") .. e_emit.sname
  local f0 = (obj.originframe or (obj.frame_s + obj.frame)) - obj.frame
  local memo = {}
  RT.shared = function(b)
    local fb = f0 + math.floor(obj_time_raw(b) * fps + 0.5)
    local A = memo[fb]
    if A == nil then A = P.share_hist(skey, fb) or false; memo[fb] = A end
    if A then shared_found = true end
    return A or nil
  end
  RT.shared_b = { num(obj.getvalue("x"), 0) + (obj.ox or 0), num(obj.getvalue("y"), 0) + (obj.oy or 0), num(obj.getvalue("z"), 0) + (obj.oz or 0) }
end
-- 粒子どうしの「当たる相手」（v0.13.0）: 相手が渡した粒子の履歴を、シミュレーション時刻 t のシーンのフレームで引く
local other_found
if X.inter and (X.inter.other or "") ~= "" then
  local okey = (obj.scene_id ~= nil and (tostring(obj.scene_id) .. ":") or "") .. X.inter.other
  local f0 = (obj.originframe or (obj.frame_s + obj.frame)) - obj.frame
  local bx, by, bz = num(obj.getvalue("x"), 0) + (obj.ox or 0), num(obj.getvalue("y"), 0) + (obj.oy or 0), num(obj.getvalue("z"), 0) + (obj.oz or 0)
  local memo = {}
  RT.inter_other = function(t)
    -- 刻みの時刻のシーンのフレーム（端数あり）。はさむ 2 つのフレームから、同じ番号の粒子の位置を直線で補う（v0.16.0）
    local fb = f0 + obj_time_raw(t) * fps
    local L = memo[fb]
    if L == nil then
      local A = P.share_at(okey, fb)
      if A then
        L = { n = A.n, x = {}, y = {}, z = {}, vx = A.vx, vy = A.vy }
        for i = 1, A.n do L.x[i], L.y[i], L.z[i] = A.x[i] - bx, A.y[i] - by, A.z[i] - bz end
        other_found = true
      else
        L = false
      end
      memo[fb] = L
    end
    return L or nil
  end
end
if X.beh and (X.beh.vfile or "") ~= "" then
  local env, err, hash = P.load_func(X.beh.vfile)
  if env and env.vector then RT.vfn = env.vector else errs.vector = err or "vector が無い" end
  fhash = fhash .. "|v" .. hash
end
if X.bnc and (X.bnc.blayer or 0) > 0 then
  local Mk = layer_mask(X.bnc.blayer, X.bnc.bthr / 100)
  if Mk then RT.bshape = { at = layer_at(X.bnc.blayer), mask = Mk, e = X.bnc.be2, inv = X.bnc.binv } end
end
-- 力場「画像の明るさ」: 対象の明るさの格子と、オブジェクトの時刻での位置
if X.field then
  for i, F in ipairs(X.field.list) do
    if F.type == 5 then
      RT.fimg = RT.fimg or {}
      local Mk = layer_mask(F.layer or 1, 0.5)
      if Mk then RT.fimg[i] = { mask = Mk, lay = layer_obj(F.layer or 1) } end
    end
  end
end
-- 形へ集まる（計算した位置を行き先へ寄せる）
local gather
if X.gather then
  local G = X.gather
  gather = { src = G.src, pick = G.pick, pts = G.pts, np = G.np, radius = G.radius, start = G.start, dur = G.dur, base = G.base,
             spread = G.spread, order = G.order, curve = G.curve, rep = G.rep, fn = gather_fn, align = G.align,
             after = G.after, leave = G.leave, jitter = G.jitter }
  if G.src == 0 then
    gather.mask = layer_mask(G.layer, G.thr / 100)
    local la = layer_at(G.layer)
    gather.lay = function() return la(now) end
  elseif G.src == 2 then
    gather.tlay = text_layout()
    gather.tmat = RT.tmat
  end
end
-- メッシュ「三角形で塗る」の他レイヤーの画像の色
if e_mesh and e_mesh.rule == 2 and e_mesh.fill == 1 then
  local Mk = layer_mask(e_mesh.flayer, 0.5)
  if Mk then
    local la = layer_at(e_mesh.flayer)
    e_mesh.cimg = { mask = Mk, lay = function() return la(now) end }
  end
end
local grid
if e_grid then
  grid = { mode = e_grid.mode, a = e_grid.a, b = e_grid.b, c = e_grid.c, inv = e_grid.inv }
  if e_grid.layer > 0 then grid.mask = layer_mask(e_grid.layer, e_grid.thr / 100) end
end
if saved then
  obj.copybuffer("object", "cache:prh_self")
  for k2, v in pairs(saved) do obj[k2] = v end
  saved = nil
end

-- 音: 今の音の大きさ（周波数を低い方から 10 に分けた帯の値）。基準（P.AUDIO_REF）で 0..1 にする
local audio
if e_audio then
  local src = e_audio.src == 1 and e_audio.file or "audiobuffer"
  local lv, raw = 0, -1
  if src and src ~= "" then
    local buf = {}
    local ok, nb = pcall(obj.getaudio, buf, src, "spectrum", 10)
    if ok and (tonumber(nb) or 0) > 0 then
      raw = buf[e_audio.band] or 0
      if e_audio.band2 > 0 then raw = math.max(raw, buf[e_audio.band2] or 0) end
      lv = math.min(math.max(raw * e_audio.gain / 100 / P.AUDIO_REF, 0), 1)
    end
  end
  audio = { level = lv, raw = raw, zoom = e_audio.zoom, alpha = e_audio.alpha, spread = e_audio.spread }
end

-- 積分の状態を引き継げるかの目印（位置に効く設定。時刻で読む値は入れない）
local function ser(v, skip)
  local t = type(v)
  if t == "table" then
    local keys = {}
    for k2 in pairs(v) do
      if k2 ~= "origin" and k2 ~= "mv" and not (skip and skip[k2]) then keys[#keys + 1] = tostring(k2) end
    end
    table.sort(keys)
    local parts = {}
    for _, k2 in ipairs(keys) do
      local val = v[k2]
      if val == nil then val = v[tonumber(k2)] end
      parts[#parts + 1] = k2 .. "=" .. ser(val)
    end
    return "{" .. table.concat(parts, ",") .. "}"
  elseif t == "number" then
    return string.format("%.10g", v)
  end
  return tostring(v)
end
-- 音の拍で出す（v0.11.0）: 拍の時刻（オブジェクトの時刻）と数。拍が変われば粒子の生まれる時刻が変わるので、シグネチャに入れる
local beat_ts, beat_cs, beat_err
if e_audio and (e_audio.beat or 0) ~= 0 then
  local ts, ss
  if e_audio.beat == 1 then
    if e_audio.src ~= 1 or e_audio.file == "" then
      beat_err = "拍で出す「音声ファイルの拍」は、音を「音声ファイル」にしてファイルを選ぶ"
    else
      local err
      ts, ss, err = P.file_beats(e_audio.file, e_audio.bband, e_audio.bth)
      if not ts then beat_err = "音声ファイルの拍: " .. tostring(err) end
    end
  else
    -- BPM のグリッド（シーンの秒）→ オブジェクトの時刻
    local ok, list = pcall(obj.getinfo, "bpm_list")
    local t0 = ((obj.originframe or (obj.frame_s + obj.frame)) - obj.frame) / fps
    ts, ss = P.bpm_beats(ok and list or nil, t0, t0 + total, e_audio.bdiv)
    for i = 1, #ts do ts[i] = ts[i] - t0 end
    if #ts == 0 then beat_err = "BPM のグリッドが無い" end
  end
  if ts then
    beat_ts, beat_cs = {}, {}
    for i, t in ipairs(ts) do
      if t >= 0 and t <= total then
        beat_ts[#beat_ts + 1] = t
        beat_cs[#beat_cs + 1] = e_audio.bacc and math.max(math.floor(e_audio.bn * ss[i] + 0.5), 1) or e_audio.bn
      end
    end
  end
  fhash = fhash .. "|ab" .. (beat_ts and (table.concat(beat_ts, ",") .. "/" .. table.concat(beat_cs, ",")) or "-")
end
-- 音の大きさで出す数（v0.15.0）: 音声ファイルの音の大きさの表。数が変わるので、ファイルと設定をシグネチャに入れる
local loud_tab, loud_err
if e_audio and (e_audio.arate or 0) > 0 then
  if e_audio.src ~= 1 or e_audio.file == "" then
    loud_err = "音の大きさで出す数は、音を「音声ファイル」にしてファイルを選ぶ（編集中の音は、過去の音を読めないので使えない）"
  else
    local err
    loud_tab, err = P.file_loudness(e_audio.file, e_audio.arband)
    if not loud_tab then loud_err = "音の大きさで出す数: " .. tostring(err) end
  end
  fhash = fhash .. "|al" .. (loud_tab and (e_audio.arate .. "/" .. e_audio.arband .. "/" .. e_audio.file .. "/" .. loud_tab.n) or "-")
end
local sig, bake_keep_look, sig_motion
do
local sig_parts = {}
for name, v in pairs(NOW_VALUES) do
  if not (birth_mode and moving[name]) then sig_parts[#sig_parts + 1] = name .. "=" .. string.format("%.10g", v) end
end
table.sort(sig_parts)
local sig_ext = {}
for _, kind in ipairs({ "wind", "noise", "att", "bnc", "beh", "disp", "orbit", "time", "field", "inter" }) do
  if X[kind] then sig_ext[#sig_ext + 1] = kind .. ser(X[kind], X[kind].mv) end
end
local sig_rest = "|" .. table.concat(sig_ext, "|") .. "|" .. ser(e_emit) .. ser(e_indiv) ..
  (e_zoal and ser({ e_zoal.vm0, e_zoal.vm1, e_zoal.vmode, e_zoal.vrep, e_zoal.vslot }) or "") .. ce2_hash ..
  string.format("|%s|%s|%s|%s|%s|%s", tostring(birth_mode), tostring(reverse), start, precision, seed, sync) .. fhash ..
  ((integ ~= 0 or hmul ~= 1) and string.format("|im%s/%.6g", tostring(integ), hmul) or "")
sig = table.concat(sig_parts, ",") .. sig_rest
-- 焼き付けのシグネチャ（v0.16.0）: 動き（位置と回転が決まる値）だけ。拡大率・透過率のトラックバーは入れない（読んだ後に今の値で計算し直す）。
-- 計算の後に位置を動かすもの（回転・子粒子・軌跡・形へ集まる・格子・音の広がり）も入れる。
-- 形へ集まるの「回転と大きさをそろえる」は拡大率も変えるので、そのときは見た目の値も入れる（計算し直さない）
local LOOK_NAMES = { zoom0 = true, zoom1 = true, alpha0 = true, alpha1 = true }
bake_keep_look = X.gather and X.gather.align
local motion_parts = {}
for _, p_ in ipairs(sig_parts) do
  if bake_keep_look or not LOOK_NAMES[p_:match("^([^=]+)")] then motion_parts[#motion_parts + 1] = p_ end
end
sig_motion = table.concat(motion_parts, ",") .. sig_rest .. (on(vanish) and "|va1" or "") .. "|" .. ser(e_rot) .. ser(X.child) .. ser(X.gather) .. ser(e_grid) ..
  (e_trail and ser({ e_trail.mode, e_trail.n, e_trail.dt }) or "") .. (e_audio and ser({ e_audio.spread }) or "")
end
_G.Particle_H_cache = _G.Particle_H_cache or {}
-- v0.19.2: シーンチェンジ・モーションブラーの参照フレームの描画（本体 2.1.14〜）は別のキャッシュにする。
-- 参照フレームは今より前のフレームを描き直すので、同じキャッシュだと通常の描画と行き来するたびに粒子を誕生から計算し直していた
local cache_key = obj.id
local ok_ref, is_ref = pcall(obj.getinfo, "reference_frame")
if ok_ref and is_ref == true then
  cache_key = tostring(obj.id) .. "/ref"
end
local cache = _G.Particle_H_cache[cache_key] or {}
_G.Particle_H_cache[cache_key] = cache

-- 放出の数: 頻度が動いていれば、シミュレーション時刻 0 から今までを 1 フレームずつ積む
local rate_obj
if moving.rate then
  local dt = 1 / fps
  local nS = math.floor(now * fps) + 2
  local smp = {}
  for i = 1, nS do smp[i] = value_at_obj("rate", obj_time((i - 1) * dt)) end
  rate_obj = P.rate_table(smp, dt)
else
  rate_obj = P.rate_const(rate)
end
-- 時間の付け替え: 数を保つ（頻度 = 保つ数 ÷ 生存時間）・一斉に出す（オブジェクトの時刻 → シミュレーション時刻）
if X.time and X.time.keep_on then rate_obj = P.rate_const(X.time.keep_n / math.max(life, 1e-3)) end
-- 音の大きさで出す数: フレームごとの数に 1 ＋ % × 音の大きさ を掛ける（ファイルの時刻 = オブジェクトの時刻）
if loud_tab then rate_obj = P.rate_loud(rate_obj, loud_tab, e_audio.arate, 1 / fps, now, obj_time) end
-- 時間の付け替え: 出し方（まばら・まとめ撃ち）。一斉に出す分は足す前に変える
if X.time and (X.time.pace or 0) ~= 0 and not X.time.loop_on then
  rate_obj = P.rate_paced(rate_obj, X.time.pace, X.time.pace_n, X.time.pace_var, P.seed_key(seed, obj.layer), 1 / fps, now)
end
if X.time and #(X.time.burst_t or {}) > 0 and (X.time.burst_n or 0) > 0 then
  local ts = {}
  for i, t in ipairs(X.time.burst_t) do ts[i] = (reverse and (total - t) or t) + start end
  rate_obj = P.add_bursts(rate_obj, ts, X.time.burst_n)
end
-- 音の拍で出す: 拍の時刻に、拍ごとの数を一斉に出す
if beat_ts and #beat_ts > 0 then
  local ts = {}
  for i, t in ipairs(beat_ts) do ts[i] = (reverse and (total - t) or t) + start end
  rate_obj = P.add_bursts_var(rate_obj, ts, beat_cs)
end
-- 自分の画像を並べる: 出す時刻にマスの数だけ一斉に出す（出力頻度・同時発生数は使わない）
local sync_v, cells_n = sync, 0
if e_emit and e_emit.shape == 8 then
  cells_n = RT.cells and RT.cells.n or 0
  rate_obj = P.add_bursts(P.rate_const(0), { (reverse and (total - e_emit.gtime) or e_emit.gtime) + start }, cells_n)
  sync_v = 1
end

-- 生存時間の上限（窓の計算用）
local life_max = life
if birth_mode and moving.life then
  local F = math.floor(total * fps)
  for f = 0, F do life_max = math.max(life_max, sample("life", f)) end
end
if e_indiv and e_indiv.life ~= 0 then
  local p = e_indiv.life
  life_max = p > 0 and life_max * (1 + p / 100) or life_max - p
end

-- 子粒子
local child
if e_child then
  child = { event = e_child.event, n = math.max(math.floor(e_child.n), 1), interval = math.max(e_child.interval, 0.01),
            speed = e_child.speed, spread = e_child.spread, inherit = e_child.inherit, life = math.max(e_child.life, 0.001),
            zoom = e_child.zoom, gy = e_child.gy, drag = e_child.drag, alpha1 = e_child.alpha1, ext = e_child.ext }
end
-- 時間の付け替え: ループ。時刻を「満ちた後の周期の中の時刻」にし、1 周期に出る数（整数に丸める）で粒子の番号を巻く
local loop_e
if X.time and X.time.loop_on then
  local T = math.max(X.time.loop_t, 0.1)
  local pe = math.max(math.floor(rate * T + 0.5), 1)
  rate_obj = P.rate_const(pe / T)
  -- 進行時間を使うなら、その値を周期で巻く
  local t = X.time.tp_on and X.time.tp or (reverse and (total - obj.time) or obj.time)
  local m = math.ceil((life_max + (child and child.life or 0)) / T) + 1
  now = m * T + (t % T)
  loop_e = pe
end
local keep_n = 0
if X.bnc and X.bnc.keep_stop then keep_n = X.bnc.keep_max end
if X.disp and X.disp.keep_stop then keep_n = math.max(keep_n, X.disp.keep_max) end
-- 焼き付け（v0.13.0）: フレーム（オブジェクトの頭から）ごとに、計算した粒子をファイルに置く / 読む。設定（シグネチャ）が変われば使わない
local bake_path, bake_sig, bake_n, bake_err, BR
if e_bake and e_bake.mode ~= 0 then
  if e_bake.dir == "" then
    bake_err = "焼き付けの置くフォルダが選ばれていない"
  else
    local BS = string.char(92)
    local dir = e_bake.dir
    if dir:sub(-1) ~= BS and dir:sub(-1) ~= "/" then dir = dir .. BS end
    bake_path = dir .. (e_bake.name ~= "" and e_bake.name or "particles") .. ".prh"
    bake_sig = P.BAKE_VERSION .. "|" .. P.text_hash(sig_motion)
    bake_n = math.floor(total * fps + 0.5) + 1
    if e_bake.mode == 2 then
      local why
      BR, why = P.bake_read(bake_path, bake_sig, bake_n, obj.frame)
      if BR then
        BR.cells = RT.cells
      elseif why == "無い" then
        bake_err = "焼き付けのファイルが無い: " .. bake_path
      elseif why == "違う" then
        bake_err = "焼き付けが今の設定と違うので使わない（書き出し直す）"
      else
        bake_err = e_bake.sim and "焼き付けに無いフレームがある（そのフレームは計算した）" or "焼き付けに無いフレームがある（そのフレームは描かない）"
      end
    end
  end
end
local bake_nosim = e_bake and e_bake.mode == 2 and not BR and not e_bake.sim
local scfg = {
  now = now, t_end = total + start, sk = P.seed_key(seed, obj.layer), sync = sync_v,
  rate = rate_obj, life_max = life_max, track = track, track_const = track_const, obj_time = obj_time,
  rot_random = tonumber(rot_random) or 1, revrot = on(revrot), vanish_at_end = on(vanish),
  emit = e_emit, rot = e_rot, zoal = e_zoal, indiv = e_indiv,
  ext = X, ext_val = ext_val, cache = cache, sig = sig, fps = fps, precision = precision, integ = integ, hmul = hmul,
  alive_hint = math.max(math.max(rate_obj.rate(now), 0) * (life_max + (child and child.life or 0)) * math.max(sync_v, 1), cells_n) + keep_n,
  trail = (e_trail and e_trail.mode ~= 2) and { n = e_trail.n, dt = e_trail.dt } or nil,
  rt = RT, errs = errs, audio = audio, grid = grid, obj_time_raw = obj_time_raw, look = e_look, gather = gather,
  child = child, loop_e = loop_e, t_start = start,
  need_tb = (e_filt and (e_filt.base == 3 or e_filt.base == 4)) or (e_color and (e_color.mode == 6 or e_color.mode == 7)) or nil,
  need_fb = (e_filt and e_filt.base == 4) or (e_color and e_color.mode == 7) or nil, colsrc = (e_color and e_color.mode == 5) and e_color.levels or nil,
}
-- 終了時に消える（v0.19.1）: 最後のフレーム（総時間の 1 フレーム手前）で粒子が残らないよう、そこまでに消え終わる粒子だけを生む。
-- ループでは時刻を周期で巻くので、終わりは今の時刻からオブジェクトの残りの時間だけ先
scfg.t_vanish = total + start - 1 / fps
if loop_e and not X.time.tp_on and not reverse then scfg.t_vanish = now + (total - 1 / fps - obj.time) end
-- 焼き付けを書くときは、跳ね返った年齢・分散した年齢も書く（読んだ後に拡大率・透過率・色を計算し直すため）
if bake_path and e_bake.mode == 1 then scfg.need_tb, scfg.need_td = true, true end
if BR and not bake_keep_look then P.relook(BR, scfg) end
local res = BR or (bake_nosim and { n = 0, overflow = 0, steps = 0, resets = 0 }) or P.simulate(scfg)
local t_sim = P.clock()
if bake_path and e_bake.mode == 1 then
  local ok, err = P.bake_write(bake_path, bake_sig, bake_n, obj.frame, res)
  if not ok then bake_err = err end
  if e_bake.csv then
    local ok2, err2 = P.csv_write(e_bake.dir, e_bake.name ~= "" and e_bake.name or "particles", obj.frame, res)
    if not ok2 then bake_err = err2 end
  end
end
-- 粒子を外へ渡す（受け取って描く・出力位置「渡された粒子」が読む）。座標は本体の位置を足して置く
local share_name = tostring(share or "")
local share_dup = false
if share_name ~= "" then
  local sx0, sy0, sz0 = num(obj.getvalue("x"), 0) + (obj.ox or 0), num(obj.getvalue("y"), 0) + (obj.oy or 0), num(obj.getvalue("z"), 0) + (obj.oz or 0)
  local scene_part = obj.scene_id ~= nil and (tostring(obj.scene_id) .. ":") or ""
  share_dup = P.share_put(scene_part .. share_name, res, sx0, sy0, sz0, obj.originframe or (obj.frame_s + obj.frame), obj.id,
                          tonumber(share_n) or 500)
end
local draw_off = share_name ~= "" and on(share_only)
-- 編集中の粒子の割合（編集中だけ。出力は全部描く）
local editing = obj.getoption("gui") == true
if editing and (tonumber(preview) or 100) < 100 then P.thin(res, preview, P.seed_key(seed, obj.layer)) end

-- 描く
local facing = tonumber(facing) or 0
local cam_mode = num(obj.getoption("camera_mode"), 0)
-- 画面に貼り付ける: カメラ制御の下で、既定のカメラで見た絵を今のカメラでも同じに写す（描く直前に頂点を移す）
local scr_on = on(screen_fix) and cam_mode ~= 0
local CAM0 = { x = 0, y = 0, z = -P.SCREEN_D0, tx = 0, ty = 0, tz = 0, rz = 0, ux = 0, uy = -1, uz = 0, d = P.SCREEN_D0 }
local cam_basis
if facing == 2 then
  local c = scr_on and CAM0 or obj.getoption("camera_param")
  local fx, fy, fz = c.tx - c.x, c.ty - c.y, c.tz - c.z
  local fl = math.sqrt(fx * fx + fy * fy + fz * fz)
  if fl > 0 then fx, fy, fz = fx / fl, fy / fl, fz / fl end
  local ux, uy, uz = c.ux, c.uy, c.uz
  local rx, ry, rz = fy * uz - fz * uy, fz * ux - fx * uz, fx * uy - fy * ux     -- 右 = 前 × 上
  local rl = math.sqrt(rx * rx + ry * ry + rz * rz)
  if rl > 0 then rx, ry, rz = rx / rl, ry / rl, rz / rl end
  local dx, dy, dz = fy * rz - fz * ry, fz * rx - fx * rz, fx * ry - fy * rx     -- 下 = 前 × 右
  cam_basis = { rx = rx, ry = ry, rz = rz, ux = dx, uy = dy, uz = dz }
end
local ro = tonumber(rot_order) or 0
local mat = e_mat or { kind = 0 }
-- カスタム描画: 関数ファイルの particle_obj で描いた絵を素材にする（読めなければ素材のまま）
local custom_fn
if e_custom then
  local env, err = P.load_func(e_custom.file)
  if env and env.particle_obj then
    custom_fn = env.particle_obj
    mat = { kind = 6, cvar = e_custom.cvar, clv = e_custom.clv }
  elseif e_custom.file ~= "" then
    errs.custom = err or "particle_obj が無い"
  end
end
-- 目の位置（本体から見た座標）。曲面・厚みの三角形を奥から並べるのに使う
local bx0, by0, bz0 = num(obj.getvalue("x"), 0) + (obj.ox or 0), num(obj.getvalue("y"), 0) + (obj.oy or 0), num(obj.getvalue("z"), 0) + (obj.oz or 0)
local eye = { -bx0, -by0, -1024 - bz0 }
if cam_mode ~= 0 and not scr_on then
  local c = obj.getoption("camera_param")
  if c and c.x then eye = { c.x - bx0, c.y - by0, c.z - bz0 } end
end
local solid, model, model_err
if e_solid then
  solid = { type = e_solid.type, div = e_solid.div, size = e_solid.size, bh = e_solid.bh, bv = e_solid.bv, depth = e_solid.depth,
            mscale = e_solid.mscale, my = e_solid.my }
  -- モデル（v0.17.0）: 読めなければ六面体で描く（注意を出す）
  if solid.type == 6 then
    model, model_err = P.pmd_load(e_solid.model)
    if not model then solid.type = 0 end
  end
end
local opt = {
  order = ro == 0 and P.STANDARD_ORDER or ro, facing = facing, cam = cam_basis, face = tonumber(face) or 0,
  sk = P.seed_key(seed, obj.layer), cut_size = mat.csize or 60, cut_center = mat.ccenter, solid = solid, eye = eye,
}
-- 光源（v0.11.0）: 向きを長さ 1 にし、% を割合にする
local LT
if e_light then
  local dx, dy, dz = e_light.lx, e_light.ly, e_light.lz
  local l = math.sqrt(dx * dx + dy * dy + dz * dz)
  if l < 1e-9 then dx, dy, dz, l = 0, 0, 1, 1 end
  LT = {
    kind = e_light.kind, dx = dx / l, dy = dy / l, dz = dz / l, px = e_light.pos[1], py = e_light.pos[2], pz = e_light.pos[3],
    amb = e_light.amb / 100, pow = e_light.pow / 100, spec = e_light.spec / 100, levels = math.max(math.floor(e_light.levels), 2),
    back = e_light.back, col = e_light.col,
  }
end
local R = P.build_draw(res, {
  mat = mat, color = e_color, filt = e_filt, trail = e_trail, fan = e_fan, mesh = e_mesh, solid = solid, shadow = e_shadow,
  old_front = (tonumber(draw_order) or 0) == 1, sk = opt.sk, obj_now = obj.time, total = total, light = LT, lopt = opt,
})
local runs = R.runs

-- カスタム描画: 要る鍵（種類 × 時間の段）ごとに 1 回だけ関数を呼び、キャッシュに置く
if custom_fn then
  local done = {}
  for _, r in ipairs(runs) do
    local mk = r.key:match("^(u%d+_%d+)/")
    if mk and not done[mk] then
      done[mk] = true
      local var, lv = mk:match("^u(%d+)_(%d+)$")
      var, lv = tonumber(var), tonumber(lv)
      local t = e_custom.clv > 1 and lv / (e_custom.clv - 1) * life or 0
      local vals = e_custom.vals
      local seed_v = math.floor(P.rnd(var, P.CH.cust + 1, opt.sk) * 100000)
      local ok, err = pcall(custom_fn, t, 0, life, var, 0, seed_v, e_custom.v1, e_custom.v2, e_custom.v3,
        vals[1], vals[2], vals[3], vals[4], vals[5], vals[6], vals[7], vals[8],
        e_custom.col1, e_custom.col2, e_custom.fig1, e_custom.fig2, e_custom.chk1, e_custom.chk2)
      if not ok then errs.custom = errs.custom or tostring(err) end
      obj.setoption("drawtarget", "framebuffer")
      obj.copybuffer("cache:prh_" .. mk, "object")
    end
  end
end

local tex_fail
-- 素材を読み込み、色とフィルターを掛ける（鍵が変わったときだけ）。
-- base: モデルの材質（v0.17.0）。テクスチャがあればそれを、無ければ拡散色の四角を素材の代わりに読む
local function prepare(key, base)
  local mk, look = key:match("^([^/]*)/(.*)$")
  local c, num_ = mk:sub(1, 1), tonumber(mk:sub(2))
  if base then
    -- テクスチャが読めなければ（obj.load が false）、拡散色の四角にする（注意を出す）
    if not (base.tex and obj.load("image", base.tex)) then
      if base.tex then tex_fail = base.tex end
      local function ch(v) return math.floor(math.min(math.max(v, 0), 1) * 255 + 0.5) end
      obj.load("figure", "四角形", ch(base.r) * 65536 + ch(base.g) * 256 + ch(base.b), 8)
    end
  elseif c == "o" then
    obj.copybuffer("object", "cache:prh_orig")
  elseif c == "f" then
    obj.load("figure", mat.figs[num_] or "円", mat.fcol, mat.fsize, mat.fline)
  elseif c == "i" then
    obj.load("image", mat.files[num_])
  elseif c == "t" then
    obj.setfont(mat.font, mat.tsize, mat.tdeco, mat.tcol1, mat.tcol2)
    obj.load("text", mat.units[num_])
  elseif c == "m" then
    obj.load("movie", mat.mfile, num_ / mat.fps)
  elseif c == "u" then
    obj.copybuffer("object", "cache:prh_" .. mk)
  elseif c == "s" then
    obj.load("figure", e_fan.fig, e_fan.col, e_fan.size, 4000)
  elseif c == "r" then
    obj.load("figure", "円", e_fan.ring_col, e_fan.ring_size, e_fan.ring_width)
  end
  local cl, fl = look:match("c(%d+)"), look:match("x(%d+)")
  if cl and e_color then
    obj.effect("単色化", "色", P.level_color(e_color, tonumber(cl)), "強さ", e_color.str, "輝度を保持する", e_color.keep and 1 or 0)
  end
  if fl and e_filt then
    local args = { e_filt.name, e_filt.item, P.level_value(e_filt, tonumber(fl)) }
    for _, kv in ipairs(e_filt.fixed) do args[#args + 1] = kv[1]; args[#args + 1] = kv[2] end
    obj.effect(unpack(args))
  end
  -- 光源（鍵の l<段>）: 段 / (段数 − 1) が 1 未満なら黒へ、1 を超えれば光の色へ単色化で寄せる
  local ll = look:match("l(%d+)")
  if ll and LT then
    local v = tonumber(ll) / (LT.levels - 1)
    if v < 1 - 1e-9 then
      obj.effect("単色化", "色", 0x000000, "強さ", (1 - v) * 100, "輝度を保持する", 0)
    elseif v > 1 + 1e-9 then
      obj.effect("単色化", "色", LT.col, "強さ", math.min(v - 1, 1) * 100, "輝度を保持する", 0)
    end
  end
  -- 影（鍵の終わりの h）: 影の色に塗りつぶし、ぼかす（大きさは変えない）
  if e_shadow and look:find("h", 1, true) then
    obj.effect("単色化", "色", e_shadow.col, "強さ", 100, "輝度を保持する", 0)
    if e_shadow.blur > 0 then obj.effect("ぼかし", "範囲", e_shadow.blur, "サイズ固定", 1) end
  end
end

local need_orig = false
for _, r in ipairs(runs) do if r.key:sub(1, 1) == "o" then need_orig = true; break end end
if need_orig then obj.copybuffer("cache:prh_orig", "object") end
local plane_on = on(plane)
-- ガラス化: 粒子を仮想バッファに描き、その形でフレームバッファ（下のレイヤーまでの絵）をずらして読む。カメラ制御の下では使わない
local glass = e_glass and cam_mode == 0
local use_tb = plane_on or glass
-- 画面に貼り付ける変換（仮想バッファに描くときは使わない）
local scr
if scr_on and not use_tb then scr = P.screen_basis(obj.getoption("camera_param"), bx0, by0, bz0) end
local BLENDS = { "add", "sub", "mul", "screen", "overlay", "light", "dark", "diff" }
local BL = BLENDS[tonumber(blend) or 0]
-- 合成モード: 直接描くときは粒子に、仮想バッファに描くときは最後の絵に掛ける
if BL and not use_tb then obj.setoption("blend", BL) end
if use_tb then
  if plane_on then obj.setoption("drawtarget", "tempbuffer", plane_w, plane_h)
  else obj.setoption("drawtarget", "tempbuffer", obj.screen_w, obj.screen_h) end
end
-- 頂点色で描くもの（帯・メッシュ）は粒子の後ろ
if scr then P.screen_apply(scr, R.cq4, false); P.screen_apply(scr, R.cq3, false) end
if not draw_off and #R.cq4 > 0 then obj.drawpoly(R.cq4, 4) end
if not draw_off and #R.cq3 > 0 then obj.drawpoly(R.cq3, 3) end
local cur, drawn = nil, 0
for _, run in ipairs(draw_off and {} or runs) do
  if run.key ~= cur then
    prepare(run.key)
    cur = run.key
  end
  if run.vn == 5 and model then
    -- モデル（v0.17.0）: 材質ごとにテクスチャ（無ければ拡散色の四角）を読んで、その材質の三角形を描く。裏を向いた面は描かない
    for mi, Mt in ipairs(model.mats) do
      local mv = P.model_verts(R, run, model, mi, opt)
      if #mv > 0 then
        local mkey = run.key .. "|m" .. mi
        local groups = LT and P.light_split(LT, mv, false) or { { nil, mv } }
        for _, B in ipairs(groups) do
          local k2 = B[1] and (run.key .. "l" .. B[1]) or run.key
          if mkey .. k2 ~= cur then prepare(k2, Mt); cur = mkey .. k2 end
          if scr then P.screen_apply(scr, B[2], false) end
          obj.setoption("culling", 1)
          obj.drawpoly(B[2], 3, run.alpha * math.min(math.max(Mt.a, 0), 1))
          obj.setoption("culling", 0)
        end
      end
    end
    drawn = drawn + #run.items
    goto next_run
  end
  local verts = P.run_verts(R, run, obj.w, obj.h, opt)
  if #verts > 0 and run.vn == 5 and LT then
    -- 光源の立体物: 三角形ごとに面の向きが違うので、光の段ごとに素材を変えて描く（画面に貼り付けるなら段を決めてから移す）
    for _, B in ipairs(P.light_split(LT, verts, solid.type <= 3)) do
      local k2 = run.key .. "l" .. B[1]
      if k2 ~= cur then prepare(k2); cur = k2 end
      if scr then P.screen_apply(scr, B[2], false) end
      if solid.type <= 3 then obj.setoption("culling", 1) end
      obj.drawpoly(B[2], 3, run.alpha)
      if solid.type <= 3 then obj.setoption("culling", 0) end
    end
    drawn = drawn + #run.items
    verts = {}
  end
  if scr then P.screen_apply(scr, verts, run.vn == 4) end
  if #verts > 0 then
    if run.vn == 4 then
      obj.drawpoly(verts, run.alpha)
    elseif run.vn == 5 and solid.type <= 3 then
      -- 閉じた凸の立体は、裏を向いた面を描かない
      obj.setoption("culling", 1)
      obj.drawpoly(verts, 3, run.alpha)
      obj.setoption("culling", 0)
    else
      obj.drawpoly(verts, 3, run.alpha)
    end
    drawn = drawn + #run.items
  end
  ::next_run::
end
if use_tb then
  -- 仮想バッファの絵をオブジェクトにして、本体より下の効果を掛けてから描く。
  -- drawpoly を使うとスクリプト以降の効果は自動では走らない（lua.txt の obj.drawpoly。実機 EPR-20 で確認）ので、自分で呼ぶ
  obj.load("tempbuffer")
  obj.setoption("drawtarget", "framebuffer")
  if glass then
    -- この画像の画素 → 画面の画素（標準描画の位置・中心・拡大率・Z軸回転と、ここまでの効果の値。au2-shader-lua）
    local ccx, ccy = num(obj.getvalue("cx"), 0) + (obj.cx or 0), num(obj.getvalue("cy"), 0) + (obj.cy or 0)
    local ssx, ssy = num(obj.getvalue("sx"), 1) * (obj.sx or 1), num(obj.getvalue("sy"), 1) * (obj.sy or 1)
    local rot = (num(obj.getvalue("rz"), 0) + (obj.rz or 0)) * math.pi / 180
    local c, s = math.cos(rot), math.sin(rot)
    local a11, a12, a21, a22 = c * ssx, -s * ssy, s * ssx, c * ssy
    local px0, py0 = obj.w / 2 + ccx, obj.h / 2 + ccy
    local t1 = obj.screen_w / 2 + bx0 - (a11 * px0 + a12 * py0)
    local t2 = obj.screen_h / 2 + by0 - (a21 * px0 + a22 * py0)
    local col = e_glass.col
    local cr, cg, cb = math.floor(col / 65536) % 256 / 255, math.floor(col / 256) % 256 / 255, col % 256 / 255
    obj.pixelshader("prh_glass", "object", { "object", "framebuffer" }, {
      a11, a12, t1, 0, a21, a22, t2, 0, cr, cg, cb, e_glass.tint / 100,
      1 / obj.screen_w, 1 / obj.screen_h, 1 / obj.w, 1 / obj.h,
      e_glass.ref, e_glass.width, e_glass.edge / 100, e_glass.blur,
    }, "copy", "clamp")
  end
  if plane_on then obj.effect() end
  if BL then obj.setoption("blend", BL) end
  obj.draw()
else
  obj.setoption("draw_state", true)
end

-- 警告（変わったときだけログへ。状態の表示にも出す）
local warns = {}
for i = 1, 64 do
  local ok, name = pcall(obj.getoption, "script_name", i, true)
  if not ok or name == nil then break end
  local kind = name ~= "" and name:match("^(.-)" .. SUFFIX .. "$")
  if kind and kind ~= "本体" then warns[#warns + 1] = "本体より下の「" .. kind .. "」は使われない（本体より上へ）" end
end
if X.orbit and (X.wind or X.noise or X.att or X.bnc or X.disp or X.field or (X.beh and X.beh.sp > 0)) then
  warns[#warns + 1] = "円運動を付けているので、風・ノイズ場・集結点・跳ね返り・分散と停止・力場・挙動不審は効かない"
end
if X.path and X.orbit then warns[#warns + 1] = "パスと円運動を両方付けているので、パスを使う" end
if X.time and X.time.loop_on then
  if (X.time.pace or 0) ~= 0 or X.time.keep_on or #(X.time.burst_t or {}) > 0 or moving.rate then
    warns[#warns + 1] = "ループでは一定の出力頻度だけを使う（出し方・一斉に出す・数を保つ・出力頻度の移動は使わない）"
  end
  if X.noise and X.noise.speed ~= 0 then warns[#warns + 1] = "ノイズ場の変化の速さが 0 でないと、ループの継ぎ目で流れがずれる" end
end
if e_child and e_child.event == 1 and not X.bnc then warns[#warns + 1] = "子粒子の「最初に跳ね返ったとき」は、跳ね返りを付けたときだけ出る" end
if e_child and e_child.event == 2 and not (X.disp and (X.disp.dt > 0 or X.disp.dbounce)) then
  warns[#warns + 1] = "子粒子の「分散したとき」は、分散と停止で分散するときだけ出る"
end
if X.path and (X.wind or X.noise or X.att or X.bnc or X.disp or X.field or (X.beh and X.beh.sp > 0)) then
  warns[#warns + 1] = "パスを付けているので、風・ノイズ場・集結点・跳ね返り・分散と停止・力場・挙動不審は効かない"
end
if e_emit and e_emit.shape == 8 and cells_n > P.MAX_PARTICLES then
  warns[#warns + 1] = "並べるマスが " .. cells_n .. " 個あり、" .. P.MAX_PARTICLES .. " 個を超える分は描かない（並べる間隔を広げる）"
end
if ((e_emit and e_emit.shape == 9) or (X.gather and X.gather.src == 2)) and not RT.tlayout then
  warns[#warns + 1] = "文字の並びは、素材をテキストにしたときだけ使える"
end
if e_mat and e_mat.kind == 1 and e_mat.cwhere == 1 and not (e_emit and e_emit.shape == 8) then
  warns[#warns + 1] = "切り抜く所「出た所」は、出力位置「自分の画像を並べる」と一緒に使う"
end
if gather and gather.src == 0 and not (gather.mask and gather.mask.nc > 0) then
  warns[#warns + 1] = "形へ集まるの対象レイヤー " .. X.gather.layer .. " に形が無い"
end
if e_color and e_color.mode == 5 and not (e_emit and (e_emit.shape == 6 or e_emit.shape == 8)) then
  warns[#warns + 1] = "色の決め方「出た所の色」は、出力位置が「他レイヤーの形」か「自分の画像を並べる」のときだけ使える"
end
if e_mesh and e_mesh.rule == 2 and e_mesh.fill == 1 and not e_mesh.cimg then
  warns[#warns + 1] = "三角形で塗るの色を取るレイヤー " .. e_mesh.flayer .. " に画像が無い"
end
if e_glass and cam_mode ~= 0 then warns[#warns + 1] = "カメラ制御の下ではガラス化は効かない" end
if beat_err then warns[#warns + 1] = beat_err end
if model_err then warns[#warns + 1] = "立体物のモデル: " .. tostring(model_err) .. "（六面体で描いた）" end
if tex_fail then warns[#warns + 1] = "立体物のモデルのテクスチャを読めない: " .. tex_fail .. "（拡散色で描いた）" end
if loud_err then warns[#warns + 1] = loud_err end
if e_child and e_child.ext and (X.orbit or X.path) then
  warns[#warns + 1] = "子粒子の「動きの拡張も掛ける」は、円運動・パスの粒子では使えない（子は閉じた式で動く）"
end
if ((e_filt and (e_filt.base == 3 or e_filt.base == 4)) or (e_color and (e_color.mode == 6 or e_color.mode == 7))) and not X.bnc then
  warns[#warns + 1] = "「跳ね返ってから・跳ね返るまで」は跳ね返りを付けたときだけ変わる（今は始の値のまま）"
end
if X.disp and (X.disp.link or 0) == 2 and X.disp.dbounce then
  warns[#warns + 1] = "分散と停止の「止まってから分散する」は、反射で分散するときは使えない"
end
if bake_err then warns[#warns + 1] = bake_err end
if X.inter and (X.inter.other or "") ~= "" and not other_found and res.inter_n then
  warns[#warns + 1] = "当たる相手「" .. X.inter.other .. "」の粒子が渡されていない（相手の本体の渡す名前と、相手を上のレイヤーに置く）"
end
if X.inter and (X.orbit or X.path) then warns[#warns + 1] = "粒子どうしは、円運動・パスと一緒には効かない" end
if res.inter_over and res.inter_over > 0 then
  warns[#warns + 1] = "粒子どうしで一緒に進めるのは " .. math.floor(X.inter.imax or P.INTER_MAX) .. " 個まで（超えた " .. res.inter_over ..
    " 個は力を受けない。一緒に進める数を上げる）"
end
if e_light and e_glass then warns[#warns + 1] = "ガラス化には光源は効かない" end
if scr_on and use_tb then warns[#warns + 1] = "平面描写では、画面に貼り付けるは効かない" end
if e_emit and e_emit.shape == 10 then
  if e_emit.sname == "" then warns[#warns + 1] = "出力位置「渡された粒子」の受け取る名前が空"
  elseif not shared_found and res.n == 0 then warns[#warns + 1] = "「" .. e_emit.sname .. "」の粒子が渡されていない" end
end
if share_dup then warns[#warns + 1] = "渡す名前「" .. share_name .. "」が、ほかのオブジェクトと重なっている（後から書いた方が使われる）" end
if e_solid and e_mat and e_mat.kind == 1 and (e_mat.shape or 0) ~= 0 then warns[#warns + 1] = "立体物では、切り抜きの形は四角として貼る" end
do
  local parts = {}
  for k2, v in pairs(errs) do parts[#parts + 1] = "自作関数 " .. k2 .. ": " .. tostring(v) end
  table.sort(parts)
  for _, v in ipairs(parts) do warns[#warns + 1] = v end
end
local wmsg = table.concat(warns, " / ")
_G.Particle_H_err = _G.Particle_H_err or {}
if _G.Particle_H_err[obj.id] ~= wmsg then
  _G.Particle_H_err[obj.id] = wmsg
  if wmsg ~= "" then print("@warn", "[拡張パーティクル_H] 注意: " .. wmsg) end
end

-- ガイドと状態の表示（編集中だけ = obj.getoption("gui") が真のとき。lua.txt「動画の出力中は非表示状態になります」）
local gmode, hmode = tonumber(guide) or 0, tonumber(hud) or 0
if BL then obj.setoption("blend", "none") end
if gmode == 2 or (gmode == 1 and editing) then
  local fl = {}
  if X.field then for i, F in ipairs(X.field.list) do fl[i] = P.prepare_field(F) end end
  local gl = P.guide(X, fl, 2)
  if #gl > 0 then obj.drawpoly(gl, 4) end
end
if hmode == 2 or (hmode == 1 and editing) then
  local t_end = P.clock()
  local lines = {
    string.format("粒子 %d / 描いた %d / 上限で落ちた %d", res.n, drawn, res.overflow),
    string.format("計算 %.1f ms / 描画 %.1f ms", (t_sim - t_start) * 1000, (t_end - t_sim) * 1000),
  }
  for _, w in ipairs(warns) do lines[#lines + 1] = "注意: " .. w end
  obj.setfont("MS UI Gothic", 24, 3, 0xffffff, 0x000000)
  obj.load("text", table.concat(lines, "\n"))
  -- 画面の左上へ（本体の位置から逆に戻す）
  obj.draw(-bx0 - obj.screen_w / 2 + obj.w / 2 + 16, -by0 - obj.screen_h / 2 + obj.h / 2 + 16, 0)
  if on(hud_no) then
    -- 粒子の番号（新しい粒子から 100 個まで）。個別微調整の「乱数を変える番号」に使う
    obj.setfont("MS UI Gothic", 18, 3, 0xffff80, 0x000000)
    local c = 0
    for i = 0, res.n - 1 do
      if c >= 100 then break end
      if res.alpha[i] > 0 then
        obj.load("text", tostring(res.k[i]))
        obj.draw(res.x[i] + 14, res.y[i] - 14, res.z[i])
        c = c + 1
      end
    end
  end
end

-- 診断ログ（変わったときだけ。毎フレーム変わる値は入れない）
if on(diag) then
  local kinds = {}
  for k in pairs(above) do kinds[#kinds + 1] = k end
  table.sort(kinds)
  local used = {}
  if e_emit then used[#used + 1] = "出力位置" end
  if e_rot then used[#used + 1] = "回転" end
  if e_zoal then used[#used + 1] = "拡大率と透過率" end
  if e_indiv then used[#used + 1] = "個別微調整" end
  for _, kind in ipairs({ "wind", "noise", "att", "bnc", "beh", "disp", "orbit", "time", "field", "inter" }) do
    if X[kind] then used[#used + 1] = kind end
  end
  if e_mat then used[#used + 1] = "mat" .. e_mat.kind end
  if e_filt then used[#used + 1] = "filt" end
  if e_color then used[#used + 1] = "color" end
  if e_trail then used[#used + 1] = "trail" .. e_trail.mode end
  if e_fan then used[#used + 1] = "fan" end
  if e_mesh then used[#used + 1] = "mesh" end
  if e_grid then used[#used + 1] = "grid" .. e_grid.mode end
  if e_solid then used[#used + 1] = "solid" .. e_solid.type end
  if e_glass then used[#used + 1] = glass and "glass" or "glass(camera)" end
  if e_audio then used[#used + 1] = "audio" end
  if custom_fn then used[#used + 1] = "custom" end
  if RT.lay then used[#used + 1] = "lay" end
  if RT.emask then used[#used + 1] = "emask" .. RT.emask.nc end
  if RT.bshape then used[#used + 1] = "bshape" end
  if RT.efn then used[#used + 1] = "efn" end
  if RT.vfn then used[#used + 1] = "vfn" end
  if X.field then used[#used + 1] = "field" .. #X.field.list end
  if X.path then used[#used + 1] = "path" end
  if X.time and (X.time.pace or 0) ~= 0 then used[#used + 1] = "pace" .. X.time.pace end
  if loop_e then used[#used + 1] = "loop" .. loop_e end
  if keep_n > 0 then used[#used + 1] = "keep" .. keep_n end
  if child then used[#used + 1] = "child" .. child.event end
  if gather then used[#used + 1] = "gather" .. gather.src end
  if RT.cells then used[#used + 1] = (RT.cells.shards and "shards" or "cells") .. RT.cells.n end
  if res.qpal then used[#used + 1] = "qpal" .. #res.qpal end
  if e_mesh and e_mesh.rule == 2 then used[#used + 1] = "delaunay" end
  if e_shadow then used[#used + 1] = "shadow" .. e_shadow.mode end
  if LT then used[#used + 1] = "light" .. LT.kind end
  if beat_ts then used[#used + 1] = "beats" .. #beat_ts end
  if res.inter_n then used[#used + 1] = "inter" .. res.inter_n end
  if BR then used[#used + 1] = "baked" end
  if bake_path and e_bake.mode == 1 then used[#used + 1] = "baking" end
  if RT.tlayout then used[#used + 1] = "text" .. RT.tlayout.n end
  if e_look then used[#used + 1] = "look" end
  if BL then used[#used + 1] = "blend=" .. BL end
  local msg = string.format("[拡張パーティクル_H] layer=%d above=%s used=%s seen=%s runs=%d merged=%s",
    obj.layer, table.concat(kinds, ","), table.concat(used, ","), table.concat(seen, "|"), #runs, tostring(runs.merged == true))
  _G.Particle_H_diag = _G.Particle_H_diag or {}
  if _G.Particle_H_diag[obj.id] ~= msg then
    _G.Particle_H_diag[obj.id] = msg
    print("@warn", msg)
  end
  -- 数の要約も、変わったときだけ出す（フレーム番号・計算の刻みの数・音の大きさのように毎フレーム変わる値は入れない）
  local stat = string.format("[拡張パーティクル_H] alive=%d drawn=%d overflow=%d over=%d cq=%d getvalue=%d resets=%d",
    res.n, drawn, res.overflow, R.over, #R.cq4 + #R.cq3, gets, res.resets)
  _G.Particle_H_diag2 = _G.Particle_H_diag2 or {}
  if _G.Particle_H_diag2[obj.id] ~= stat then
    _G.Particle_H_diag2[obj.id] = stat
    print("@warn", stat)
  end
end

@出力位置
--information:出力位置@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--select@shape:出力の形=1,点=0,線=1,線を走る=2,箱=3,球=4,他レイヤーを追う=5,他レイヤーの形=6,関数=7,自分の画像を並べる=8,文字の並び=9,渡された粒子=10
--track@npts:アンカー数,2,16,2,1
--value@pos:座標,{-300,0,0,300,0,0}
--check@from_points:各点から出す,0
--track@run_time:走る時間,0.001,600,2,0.001
--check@loop:一周する,1
--track@hollow:内側の空間,0,99,0,0.01
--check@same_pos:同時発生分を同じ位置,0
--track@layer:対象レイヤー,1,1000,1,1
--track@thr:しきい値,0,100,50,0.01
--select@oarea:出す所=0,形の中=0,形の縁=1
--select@oweight:出す数の重み=0,なし=0,明るい所ほど多く=1,暗い所ほど多く=2
--check@use_dir:動く向きに出す,0
--select@ltrace:追う位置=0,生まれた時刻=0,通った所からランダム=1,通る所全体からランダム=2
--track@add_vel:動きの速さを足す,0,1000,0,0.01
--file@func:関数ファイル
--check@chain:上の出力位置につなぐ,0
--track@gcell:並べる間隔,2,1000,20,1
--track@gtime:出す時刻,0,600,0,0.001
--select@gsplit:並べ方=0,格子=0,破片=1
--track@gshards:破片の数,2,2000,80,1
--track@grand:破片の不ぞろい,0,100,70,0.01
--string@sname:受け取る名前,
--hide@npts:shape==0
--hide@npts:shape>2
--hide@from_points:shape~=1
--hide@run_time:shape~=2
--hide@loop:shape~=2
--hide@hollow:shape<3
--hide@hollow:shape>4
--hide@layer:shape<5
--hide@layer:shape>6
--hide@thr:shape~=6
--hide@oarea:shape~=6
--hide@oweight:shape~=6
--hide@use_dir:shape<5
--hide@use_dir:shape==7
--hide@use_dir:shape==8
--hide@use_dir:shape==9
--hide@add_vel:shape<5
--hide@add_vel:shape==7
--hide@add_vel:shape==8
--hide@add_vel:shape==9
--hide@sname:shape~=10
--hide@ltrace:shape~=5
--hide@func:shape~=7
--hide@chain:shape==0
--hide@chain:shape>2
--hide@gcell:shape~=8
--hide@gcell:gsplit==1
--hide@gtime:shape~=8
--hide@gsplit:shape~=8
--hide@gshards:shape~=8
--hide@gshards:gsplit==0
--hide@grand:shape~=8
--hide@grand:gsplit==0
-- 本体より上に付ける。粒子の出る位置を点・線・線を走る・箱・球にする（座標はオブジェクトの中心から）。
-- 他レイヤーを追う: 対象レイヤーのオブジェクトの位置から出す（その時刻の位置。本体から見た座標）。
--   追う位置: 通った所からランダム = 0〜生まれた時刻の、通る所全体からランダム = オブジェクト全体の、でたらめな時刻の位置から出す。
-- 他レイヤーの形: 対象レイヤーのオブジェクトの形（アルファがしきい値 % 以上の所）から出す（位置・Z軸回転・拡大率に付いていく）。
-- 動く向きに出す: 対象の動く向きを出力方向にする（本体の拡散角度は効く）。動きの速さを足す: 対象の速さの % を粒子の速さに足す。
-- 関数: 関数ファイル（.lua）の xyz(t) か xyzd(t) が返す位置から出す（t はオブジェクトの時刻・秒。xyzd は出力方向と Z出力方向もラジアンで返す）。
-- 自分の画像を並べる: 自分の画像を並べる間隔（px）のマスに分け、透明でないマスの中心から、出す時刻（秒）に一斉に出す（出力頻度は使わない）。
-- 並べ方「破片」: 格子の代わりに、およそ破片の数のボロノイの領域（割れたガラスのような多角形）に割る。不ぞろいは種の点のずれ（%）。
-- 文字の並び: 素材のテキストを、テキストオブジェクトのように並べた位置から 1 文字ずつ出す（出力頻度が 1 秒に出す文字の数）
-- 渡された粒子: 本体の「渡す名前」で渡された粒子の、生まれた時刻の位置から出す（受け取る名前で選ぶ。渡す側を上のレイヤーに置く）。
--   動く向きに出す・動きの速さを足すは、その粒子の動きを使う
local function on(v) return v == true or v == 1 end
local shape = tonumber(shape) or 1
local n = (shape == 3 or shape == 4) and 2 or math.max(math.floor(npts), 2)
local pts = {}
if shape >= 1 and shape <= 4 then
  local def = {}
  for i = 0, n - 1 do
    def[#def + 1] = -300 + 600 * i / (n - 1); def[#def + 1] = 0; def[#def + 1] = 0
  end
  obj.setanchor("pos", n, "xyz", "line", def)
  for i = 1, n * 3 do pts[i] = (pos and pos[i]) or def[i] end
end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
-- 上の出力位置につなぐ: このフレームに上の出力位置（線・線を走る）が書いた点の後ろに、この点を足す
local prev = box.emit
if on(chain) and (shape == 1 or shape == 2) and prev and prev.origin == obj.originframe and (prev.shape == 1 or prev.shape == 2) then
  local all = {}
  for i = 1, prev.n * 3 do all[i] = prev.pts[i] end
  for i = 1, n * 3 do all[#all + 1] = pts[i] end
  pts, n = all, prev.n + n
end
box.emit = {
  origin = obj.originframe, shape = shape, pts = pts, n = n, from_points = on(from_points),
  run_time = run_time, loop = on(loop), hollow = hollow, same_pos = on(same_pos),
  layer = math.floor(layer), thr = thr, use_dir = on(use_dir), add_vel = add_vel, func = func or "",
  oarea = tonumber(oarea) or 0, oweight = tonumber(oweight) or 0,
  gcell = math.max(math.floor(gcell), 2), gtime = gtime,
  gsplit = tonumber(gsplit) or 0, gshards = math.floor(gshards), grand = grand,
  sname = tostring(sname or ""), trace = tonumber(ltrace) or 0,
}

@回転
--information:回転@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--group:揺れ
