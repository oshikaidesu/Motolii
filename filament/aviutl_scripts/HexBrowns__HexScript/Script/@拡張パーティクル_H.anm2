--track@i_speed:個別揺れ速度,-10000,10000,0,0.01
--track@i_amp:個別揺れ回転,-10000,10000,0,0.01
--track@i_acc:個別回転加速度,-10000,10000,0,0.01
--track@i_time:個別加速タイミング,-10000,10000,0,0.01
--group
-- 本体より上に付ける。回転を揺らす・放射した時刻で角度を変える・回転を加速する
local function on(v) return v == true or v == 1 end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.rot = {
  origin = obj.originframe,
  swing_speed = swing_speed, swing = { swing_x, swing_y, swing_z },
  phase_random = on(phase_random), sync = on(swing_sync),
  inc = { inc_x, inc_y, inc_z },
  acc = { acc_x, acc_y, acc_z }, limit = { lim_x, lim_y, lim_z },
  acc_time = acc_time, relative = on(acc_rel), no_reverse = on(no_rev),
  indiv_speed = i_speed, indiv_amp = i_amp, indiv_acc = i_acc, indiv_time = i_time,
}

@拡大率と透過率
--information:拡大率と透過率@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--track@zoom0:始拡大率,0,5000,100,0.01
--track@zoom1:終拡大率,0,5000,100,0.01
--track@alpha0:始透過率,0,100,0,0.01
--track@alpha1:終透過率,0,100,50,0.01
--select@base:時間の基準=0,粒子ごと=0,オブジェクト=1
--group:拡大率の中間点
--value@zmid_t:中間点の時刻(拡大率),{}
--value@zmid_v:中間点の値(拡大率),{}
--select@zmode:補間(拡大率)=0,直線=0,瞬間=1,反復=2,加速=3,減速=4,加減速=5,バウンス=6,弾性=7,バック=8,カーブエディタ_H=9
--track@zrep:反復の回数(拡大率),1,100,2,1
--track@zslot:スロット(拡大率),1,1000,1,1
--group
--group:透過率の中間点
--value@amid_t:中間点の時刻(透過率),{}
--value@amid_v:中間点の値(透過率),{}
--select@amode:補間(透過率)=0,直線=0,瞬間=1,反復=2,加速=3,減速=4,加減速=5,バウンス=6,弾性=7,バック=8,カーブエディタ_H=9
--track@arep:反復の回数(透過率),1,100,2,1
--track@aslot:スロット(透過率),1,1000,1,1
--group
--group:反射と分散
--track@zb:反射中間点(拡大率),0,10,0,1,なし
--track@zd:分散中間点(拡大率),0,10,0,1,なし
--track@ab:反射中間点(透過率),0,10,0,1,なし
--track@ad:分散中間点(透過率),0,10,0,1,なし
--group
--group:速度倍率
--track@vm0:始速度倍率,0,10000,100,0.01
--track@vm1:終速度倍率,0,10000,100,0.01
--select@vmode:補間(速度倍率)=0,直線=0,瞬間=1,反復=2,加速=3,減速=4,加減速=5,バウンス=6,弾性=7,バック=8,カーブエディタ_H=9
--track@vrep:反復の回数(速度倍率),1,100,2,1
--track@vslot:スロット(速度倍率),1,1000,1,1
--group
--hide@zrep:zmode~=2
--hide@zslot:zmode~=9
--hide@arep:amode~=2
--hide@aslot:amode~=9
--hide@vrep:vmode~=2
--hide@vslot:vmode~=9
-- 本体より上に付ける。本体の拡大率と透過率を置き換え、中間点（時刻は秒）を足す。
-- 時間の基準: 粒子ごと = 生まれてからの時刻（終わりは寿命）/ オブジェクト = オブジェクトの時刻（終わりはオブジェクトの終わり）。
-- 補間: 点と点の間の変わり方（区間ごとに掛かる）。反復: 反復の回数だけ往復する（奇数は次の値、偶数は前の値で終わる）。
-- カーブエディタ_H: スロットの式で変わる（CurveEditor_H の Live スロット）。
-- 速度倍率: 粒子の自分の速さ（出力速度・加速度）に、寿命に沿って掛ける %（風などの外から受けた速さには掛けない）
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
local function arr(t)
  local o = {}
  if type(t) == "table" then for i = 1, #t do o[i] = tonumber(t[i]) or 0 end end
  return o
end
box.zoal = {
  origin = obj.originframe,
  zoom0 = zoom0, zoom1 = zoom1, alpha0 = alpha0, alpha1 = alpha1,
  zmid_t = arr(zmid_t), zmid_v = arr(zmid_v), amid_t = arr(amid_t), amid_v = arr(amid_v),
  zmode = tonumber(zmode) or 0, amode = tonumber(amode) or 0, by_object = (tonumber(base) or 0) == 1,
  zb = math.floor(zb), zd = math.floor(zd), ab = math.floor(ab), ad = math.floor(ad),
  zrep = math.floor(zrep), zslot = math.floor(zslot), arep = math.floor(arep), aslot = math.floor(aslot),
  vm0 = vm0, vm1 = vm1, vmode = tonumber(vmode) or 0, vrep = math.floor(vrep), vslot = math.floor(vslot),
}

@個別微調整
--information:個別微調整@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--group:ばらつき(正の値は元の値の%・負の値は幅)
--track@i_speed:速度,-10000,10000,0,0.01
--track@i_accel:加速度,-10000,10000,0,0.01
--track@i_vrx:X軸回転速度,-10000,10000,0,0.01
--track@i_vry:Y軸回転速度,-10000,10000,0,0.01
--track@i_vrz:Z軸回転速度,-10000,10000,0,0.01
--track@i_alpha:透過率,-10000,10000,0,0.01
--track@i_zoom:拡大率,-10000,10000,0,0.01
--track@i_gx:重力X,-10000,10000,0,0.01
--track@i_gy:重力Y,-10000,10000,0,0.01
--track@i_gz:重力Z,-10000,10000,0,0.01
--track@i_rate:出力頻度,-10000,10000,0,0.01
--track@i_life:生存時間,-10000,10000,0,0.01
--group
--check@same_group:同時発生の組で揃える,0
--value@reseed:乱数を変える番号,{}
--track@reseed_salt:変え方,1,1000,1,1
-- 本体より上に付ける。粒子ごとに値をばらつかせる。正の値は元の値の %、負の値は絶対値の幅（原作の説明書 09 の式）。
-- 乱数を変える番号: {番号,番号,…} の粒子だけ、乱数を変える（変え方を変えると別の乱数）。番号は本体の「粒子の番号も表示」で見る
local function on(v) return v == true or v == 1 end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.indiv = {
  origin = obj.originframe,
  speed = i_speed, accel = i_accel, vrx = i_vrx, vry = i_vry, vrz = i_vrz, alpha = i_alpha, zoom = i_zoom,
  gx = i_gx, gy = i_gy, gz = i_gz, rate = i_rate, life = i_life, same_group = on(same_group),
  reseed = (function() local o = {} if type(reseed) == "table" then for i = 1, #reseed do o[i] = tonumber(reseed[i]) or -1 end end return o end)(),
  salt = math.floor(reseed_salt),
}

@風
--information:風@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--track@wx:風力X,-10000,10000,100,0.01
--track@wy:風力Y,-10000,10000,0,0.01
--track@wz:風力Z,-10000,10000,0,0.01
--track@drag:空気抵抗,0,100,0,0.01
--check@use_point:発生場所を使う,0
--value@wpos:発生場所,{0,0,0}
--track@wrange:届く距離,1,100000,500,0.01
--track@i_wind:個別風力,-10000,10000,0,0.01
--hide@wpos:use_point==0
--hide@wrange:use_point==0
-- 本体より上に付ける。粒子を風で流す。風力は 1 秒あたりの速度の変化（px/秒²）。空気抵抗は速度に比例して遅らせる強さ（1/秒）。
-- 風力はトラックバーを動かすと、その時刻の値で吹く（粒子の過去の動きも、その時刻の風で計算する）
local function on(v) return v == true or v == 1 end
local mv = {}
for var, item in pairs({ wx = "風力X", wy = "風力Y", wz = "風力Z" }) do
  local m = obj.getoption("track_mode", var)
  if m ~= nil and m ~= 0 and m ~= "" then mv[var] = item end
end
local up = on(use_point)
if up then obj.setanchor("wpos", 1, "xyz") end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.wind = {
  origin = obj.originframe, wx = wx, wy = wy, wz = wz, drag = drag, use_point = up,
  pt = { (wpos and wpos[1]) or 0, (wpos and wpos[2]) or 0, (wpos and wpos[3]) or 0 }, range = wrange, i_wind = i_wind, mv = mv,
}

@ノイズ場
--information:ノイズ場@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--track@nstr:強さ,0,100000,300,0.01
--track@nscale:大きさ,1,10000,200,0.01
--track@nspeed:変化の速さ,0,100,0.5,0.001
--track@nseed:シード,-100000,100000,0,1
--check@nz:Z方向にも,0
--track@nstart:効き始め,0,600,0,0.001
--track@nfade:ゆるやかに効かせる,0,600,0,0.001
--track@i_noise:個別の強さ,-10000,10000,0,0.01
--select@ntype:元のノイズ=0,値ノイズ=0,勾配ノイズ=1,ブロック=2
-- 本体より上に付ける。見えない流れ（カールノイズ）で粒子を渦のように流す。原作の「空間場」の代わり（式は別物）。
-- 強さ: 力の大きさ（px/秒²）。大きさ: 渦の大きさ（px）。変化の速さ: 流れが時間で変わる速さ（1/秒）。効き始め・ゆるやかに効かせる: 粒子が生まれてからの秒
-- 元のノイズ（v0.19.0）: 値ノイズ（今まで）/ 勾配ノイズ（渦の大きさがそろう）/ ブロック（升ごとに縦か横の一定の流れ。格子に沿って折れ曲がる）
local function on(v) return v == true or v == 1 end
local mv = {}
local m = obj.getoption("track_mode", "nstr")
if m ~= nil and m ~= 0 and m ~= "" then mv.str = "強さ" end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.noise = {
  origin = obj.originframe, str = nstr, scale = nscale, speed = nspeed, seed = nseed, z = on(nz),
  -- 元のノイズは値ノイズ（0）なら入れない。焼き付けのシグネチャ（ser(X.noise)）を v0.18.0 と同じに保つ
  start = nstart, fade = nfade, i_noise = i_noise, mv = mv, ntype = ((tonumber(ntype) or 0) ~= 0) and tonumber(ntype) or nil,
}

@集結点
--information:集結点@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--select@cmode:選び方=0,ランダム=0,一番近い点=1,順に巡る=2
--track@cnum:点の数,1,5,1,1
--value@cpos:座標,{0,-300,0}
--track@cstart:集結開始時間,0,600,0.5,0.001
--check@crel:相対時間,1
--track@cstrength:追従の強さ,0,1000,4,0.01
--track@cspeed:集結速度,0,10000,0,0.01,そのまま
--track@cxy:XY方向角度,-180,180,0,0.01
--track@cexy:XY拡散度,0,180,0,0.01
--track@cz:Z方向角度,-90,90,0,0.01
--track@cez:Z拡散度,0,90,0,0.01
--select@carrive:着いたら=0,そのまま=0,消える=1,止まる=2
--track@cradius:着いたとみなす半径,0,10000,20,0.01
--track@cinterval:巡る間隔,0.001,600,1,0.001
--track@i_cstart:個別集結開始時間,-10000,10000,0,0.01
--check@cchain:上の集結点につなぐ,0
--hide@cinterval:cmode~=2
--hide@cradius:carrive==0
-- 本体より上に付ける。集結開始時間を過ぎた粒子が、点へ向かって進む。
-- 追従の強さ: 1 秒あたりに向きを点へ寄せる強さ。集結速度: 0 なら今の速さのまま向きだけ変える。
-- 相対時間: オン = 粒子が生まれてからの秒 / オフ = オブジェクトの始まりからの秒。
-- 上の集結点につなぐ: 集結点を 2 つ重ねると、点を 5 つより多く置ける（設定は下の集結点のものを使う）
local function on(v) return v == true or v == 1 end
local n = math.max(math.min(math.floor(cnum), 5), 1)
local def = {}
for i = 0, n - 1 do def[#def + 1] = (i - (n - 1) / 2) * 200; def[#def + 1] = -300; def[#def + 1] = 0 end
obj.setanchor("cpos", n, "xyz", "line", def)
local pts = {}
for i = 1, n * 3 do pts[i] = (cpos and cpos[i]) or def[i] end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
-- 上の集結点につなぐ: このフレームに上の集結点が書いた点の後ろに、この点を足す（5 つより多く置ける）
local prev = box.att
if on(cchain) and prev and prev.origin == obj.originframe then
  local all = {}
  for i = 1, prev.n * 3 do all[i] = prev.pts[i] end
  for i = 1, n * 3 do all[#all + 1] = pts[i] end
  pts, n = all, prev.n + n
end
box.att = {
  origin = obj.originframe, mode = tonumber(cmode) or 0, n = n, pts = pts, start = cstart, rel = on(crel),
  strength = cstrength, speed = cspeed, xy = cxy, exy = cexy, z = cz, ez = cez, arrive = tonumber(carrive) or 0,
  radius = cradius, interval = cinterval, i_start = i_cstart,
}

@跳ね返り
--information:跳ね返り@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--group:面
--select@bx:X方向の面=0,両面=0,小さい側だけ=1,大きい側だけ=2,なし=3
--track@xmin:X最小,-100000,100000,-960,0.01
--track@xmax:X最大,-100000,100000,960,0.01
--track@ex:X反発係数,0,10,0.9,0.001
--select@by:Y方向の面=0,両面=0,小さい側だけ=1,大きい側だけ=2,なし=3
--track@ymin:Y最小,-100000,100000,-540,0.01
--track@ymax:Y最大,-100000,100000,540,0.01
--track@ey:Y反発係数,0,10,0.9,0.001
--select@bz:Z方向の面=3,両面=0,小さい側だけ=1,大きい側だけ=2,なし=3
--track@zmin:Z最小,-100000,100000,-500,0.01
--track@zmax:Z最大,-100000,100000,500,0.01
--track@ez:Z反発係数,0,10,0.9,0.001
--group
--group:球
--select@sph:球の面=0,なし=0,外側で跳ね返る=1,内側に閉じ込める=2,半球（上側）=3
--value@spos:球の中心,{0,0,0}
--track@srad:球の半径,1,100000,200,0.01
--track@se:球の反発係数,0,10,0.9,0.001
--group
--group:他レイヤーの形
--track@blayer:当たるレイヤー,0,1000,0,1,なし
--track@bthr:形のしきい値,0,100,50,0.01
--track@be2:形の反発係数,0,10,0.9,0.001
--check@binv:形の中に閉じ込める,0
--group
--track@bfric:摩擦,0,100,0,0.01
--check@irr:イレギュラー,0
--track@irrp:確率,0,100,30,0.01
--track@irra:ずれの角度,0,180,45,0.01
--check@keep_stop:止まったら残す,0
--track@keep_max:残す数,1,10000,500,1
--track@keep_speed:止まったとみなす速さ,0,1000,20,0.01
--select@bfinite:面の広さ=0,無限=0,範囲の中だけ=1
--check@broll:転がる,0
--track@brrad:粒子の半径,0.1,10000,10,0.01
--hide@brrad:broll==0
--group:面を変える
--track@btime:面を変える時刻,0,600,0,0.001,変えない
--check@brel:面を変える時刻は粒子ごと,0
--select@bx2:変えた後のX方向の面=0,そのまま=0,両面=1,小さい側だけ=2,大きい側だけ=3,なし=4
--select@by2:変えた後のY方向の面=0,そのまま=0,両面=1,小さい側だけ=2,大きい側だけ=3,なし=4
--select@bz2:変えた後のZ方向の面=0,そのまま=0,両面=1,小さい側だけ=2,大きい側だけ=3,なし=4
--select@bs2:変えた後の球の面=0,そのまま=0,なし=1,外側で跳ね返る=2,内側に閉じ込める=3,半球（上側）=4
--group
--hide@keep_max:keep_stop==0
--hide@keep_speed:keep_stop==0
--hide@xmin:bx==3
--hide@xmax:bx==3
--hide@ex:bx==3
--hide@ymin:by==3
--hide@ymax:by==3
--hide@ey:by==3
--hide@zmin:bz==3
--hide@zmax:bz==3
--hide@ez:bz==3
--hide@spos:sph==0
--hide@srad:sph==0
--hide@se:sph==0
--hide@irrp:irr==0
--hide@irra:irr==0
-- 本体より上に付ける。座標はオブジェクトの中心から。反発係数: 1 で同じ速さ、0.5 で半分の速さで跳ね返る。
-- 面の広さ: 無限 = 面は無限に広い。範囲の中だけ = 面はほかの 2 軸の最小〜最大の中だけにあり、外を通る粒子はすり抜ける（原作の領域内反射のオフ）。
-- 面を変える時刻: その時刻（秒。オブジェクトの時刻、粒子ごとなら生まれてから）より後は、変えた後の面にする（そのまま = 変えない）。
-- 動く面には対応しない（今の値を全時刻に使う）。
-- 転がる: 面に当たった後の、面に沿う速さ ÷ 粒子の半径 で Z 軸に回る（宙では同じ速さで回り続ける）。回転の拡張の回転に足す。
-- 他レイヤーの形: 当たるレイヤーのオブジェクトの形（アルファがしきい値 % 以上の所）で跳ね返る。XY だけで見る（Z は見ない）。
-- 位置・Z軸回転・拡大率の動きには付いていく。形そのものの変化は今のフレームの形を全時刻に使う。
-- 摩擦: 当たるたびに、面に沿う速さを (100 − 摩擦) % にする（床で滑って止まる）
-- 止まったら残す: 跳ね返った後に速さが 止まったとみなす速さ（px/秒）を下回ったら、その場に止め、寿命の後も残す（新しい方から 残す数 まで）
local function on(v) return v == true or v == 1 end
local s = tonumber(sph) or 0
if s ~= 0 then obj.setanchor("spos", 1, "xyz") end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.bnc = {
  origin = obj.originframe, bx = tonumber(bx) or 0, by = tonumber(by) or 0, bz = tonumber(bz) or 3,
  xmin = math.min(xmin, xmax), xmax = math.max(xmin, xmax), ymin = math.min(ymin, ymax), ymax = math.max(ymin, ymax),
  zmin = math.min(zmin, zmax), zmax = math.max(zmin, zmax), ex = ex, ey = ey, ez = ez,
  sph = s, spos = { (spos and spos[1]) or 0, (spos and spos[2]) or 0, (spos and spos[3]) or 0 }, srad = srad, se = se,
  irr = on(irr), irrp = irrp, irra = irra,
  blayer = math.floor(blayer), bthr = bthr, be2 = be2, binv = on(binv), fric = bfric,
  keep_stop = on(keep_stop), keep_max = math.floor(keep_max), keep_speed = keep_speed,
  finite = tonumber(bfinite) or 0, ctime = btime, crel = on(brel),
  cbx = tonumber(bx2) or 0, cby = tonumber(by2) or 0, cbz = tonumber(bz2) or 0, csph = tonumber(bs2) or 0,
  roll = on(broll), rrad = brrad,
}

@挙動
--information:挙動@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--group:位置のずれ
--track@jx:X方向,0,10000,0,0.01
--track@jy:Y方向,0,10000,0,0.01
--track@jz:Z方向,0,10000,0,0.01
--track@jn:間隔,1,10000,10,1
--select@jpat:つなぎ方=1,折れ線=0,曲線=1
--track@jsmooth:滑らかさ,0,100,100,0.01
--hide@jsmooth:jpat==0
--group
--group:ゆらぎ
--track@ys:ゆらぎ速度,0,36000,180,0.01
--track@yx:ゆらぎ幅X,0,10000,0,0.01
--track@yy:ゆらぎ幅Y,0,10000,0,0.01
--track@yz:ゆらぎ幅Z,0,10000,0,0.01
--check@yrel:進行方向基準,0
--track@i_ys:個別ゆらぎ速度,-10000,10000,0,0.01
--track@i_ya:個別ゆらぎ幅,-10000,10000,0,0.01
--group
--group:挙動不審
--track@sp:不審確率,0,100,0,0.01
--track@si:不審間隔,0.001,600,0.5,0.001
--track@ssp:不審速度,0,100000,200,0.01
--select@sdir:不審方向=0,指定=0,ランダム=1
--track@sdx:不審方向X,-10000,10000,0,0.01
--track@sdy:不審方向Y,-10000,10000,-100,0.01
--track@sdz:不審方向Z,-10000,10000,0,0.01
--check@sz3:ランダムにZも含める,0
--hide@sdx:sdir==1
--hide@sdy:sdir==1
--hide@sdz:sdir==1
--hide@sz3:sdir==0
--group
--file@vfile:速度の関数
-- 本体より上に付ける。
-- 位置のずれ: 出る位置を、粒子の並び（間隔の数ごと）に沿ってなめらかにずらす（px）。
-- ゆらぎ: 粒子を左右・上下に揺らす（速度は度/秒、360 で 1 秒に 1 往復。幅は px）。進行方向基準: X が進む向きと直角、Y が進む向き。
-- 挙動不審: 不審間隔（秒）ごとに、不審確率（%）で、その向きへ不審速度（px/秒）ではじかれる。
-- 速度の関数: 関数ファイル（.lua）の vector(t) が返す速度（px/秒。t は粒子が生まれてからの秒）を足して動かす
local function on(v) return v == true or v == 1 end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.beh = {
  origin = obj.originframe, jx = jx, jy = jy, jz = jz, jn = jn, jpat = tonumber(jpat) or 1, jsmooth = jsmooth,
  ys = ys, yx = yx, yy = yy, yz = yz, yrel = on(yrel), i_ys = i_ys, i_ya = i_ya,
  sp = sp, si = si, ssp = ssp, sdir = tonumber(sdir) or 0, sdx = sdx, sdy = sdy, sdz = sdz, sz3 = on(sz3),
  vfile = vfile or "",
}

@分散と停止
--information:分散と停止@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--group:分散
--track@dt:分散タイム,0,600,1,0.001,なし
--check@dbounce:反射で分散,0
--track@dxy:XY拡散度,0,180,60,0.01
--track@dz:Z拡散度,0,90,0,0.01
--select@dspd:分散後の速さ=0,そのまま=0,指定=1
--track@dv:分散後の速度,0,10000,200,0.01
--check@dacc_on:分散後の加速度を変える,0
--track@dac:分散後の加速度,-10000,10000,0,0.01
--track@i_dt:個別分散タイム,-10000,10000,0,0.01
--hide@dv:dspd==0
--hide@dac:dacc_on==0
--group
--group:停止
--track@stop:急停止,0,600,0,0.001,なし
--track@i_stop:個別急停止,-10000,10000,0,0.01
--select@dlink:つなぐ=0,つながない=0,分散してから止める=1,止まってから分散する=2
--track@dlt:つなぐ時間,0.001,600,1,0.001
--track@dlti:個別つなぐ時間,-10000,10000,0,0.01
--hide@dlt:dlink==0
--hide@dlti:dlink==0
--check@keep_stop:止まったら残す,0
--track@keep_max:残す数,1,10000,500,1
--track@keep_speed:止まったとみなす速さ,0,1000,20,0.01
--hide@keep_max:keep_stop==0
--hide@keep_speed:keep_stop==0
--group
-- 本体より上に付ける。
-- 分散: 粒子が生まれてから分散タイム（秒）で、進む向きを拡散度（度）の範囲でばらばらに変える（花火）。反射で分散: 最初に跳ね返ったときに分散する。
-- 急停止: 生まれてからこの秒数で速さを 0 にする（重力・風などは効き続ける）。
-- つなぐ（原作の分散停止リンク）: 分散してから止める = 分散した時刻 ＋ つなぐ時間 で急停止。止まってから分散する = 急停止の時刻 ＋ つなぐ時間 で分散（分散の速さを決めていなければ生まれたときの速さ。反射で分散のときは使えない）
local function on(v) return v == true or v == 1 end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.disp = {
  origin = obj.originframe, dt = dt, dbounce = on(dbounce), dxy = dxy, dz = dz, dspd = tonumber(dspd) or 0, dv = dv,
  dacc_on = on(dacc_on), dac = dac, i_dt = i_dt, stop = stop, i_stop = i_stop,
  link = tonumber(dlink) or 0, link_t = dlt, i_link = dlti,
  keep_stop = on(keep_stop), keep_max = math.floor(keep_max), keep_speed = keep_speed,
}

@円運動
--information:円運動@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--select@ocenter:中心=0,出力位置=0,指定=1,範囲からランダム=2
--value@opos:中心の座標,{0,0,0}
--track@orx:範囲X,0,100000,640,0.01
--track@ory:範囲Y,0,100000,360,0.01
--track@orz:範囲Z,0,100000,0,0.01
--track@ow:角速度,-36000,36000,90,0.01
--track@oacc:角速度の加速,-36000,36000,0,0.01
--check@ononeg:減速で止める,1
--track@ovr:半径速度,-10000,10000,50,0.01
--track@olim:半径上限,0,100000,0,0.01,なし
--track@oax:回転平面X角,-360,360,0,0.01
--track@oay:回転平面Y角,-360,360,0,0.01
--track@i_ow:個別角速度,-10000,10000,0,0.01
--track@i_ovr:個別半径速度,-10000,10000,0,0.01
--hide@opos:ocenter~=1
--hide@orx:ocenter~=2
--hide@ory:ocenter~=2
--hide@orz:ocenter~=2
-- 本体より上に付ける。粒子を中心のまわりで回す。円運動があるときは、本体の出力速度・加速度・重力と、
-- 風・ノイズ場・集結点・跳ね返り・分散と停止・挙動不審は使わない。
-- 中心=出力位置: 粒子の出た位置が中心（半径 0 から半径速度で広がる）。角速度は度/秒、半径速度は px/秒
local function on(v) return v == true or v == 1 end
local c = tonumber(ocenter) or 0
if c == 1 then obj.setanchor("opos", 1, "xyz") end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.orbit = {
  origin = obj.originframe, center = c, pos = { (opos and opos[1]) or 0, (opos and opos[2]) or 0, (opos and opos[3]) or 0 },
  rx = orx, ry = ory, rz = orz, w = ow, acc = oacc, nonneg = on(ononeg), vr = ovr, lim = olim, ax = oax, ay = oay,
  i_w = i_ow, i_vr = i_ovr,
}

@時間の付け替え
--information:時間の付け替え@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--check@tp_on:進行時間を使う,0
--track@tp:進行時間,-9999,9999,0,0.001
--value@emit_win:放射時間,{}
--value@act_win:活動時間,{}
--check@act_rel:相対時間,0
--value@burst_t:一斉に出す時刻,{}
--track@burst_n:一斉に出す数,0,10000,100,1
--check@keep_on:数を保つ,0
--track@keep_n:保つ数,1,10000,300,1
--select@pace:出し方=0,一定=0,まばら=1,まとめ撃ち=2
--track@pace_n:まとめる数,1,1000,10,1
--track@pace_var:ばらつき,0,100,50,0.01
--check@loop_on:ループ,0
--track@loop_t:周期,0.1,600,5,0.001
--hide@tp:tp_on==0
--hide@keep_n:keep_on==0
--hide@pace_n:pace~=2
--hide@pace_var:pace~=2
--hide@loop_t:loop_on==0
-- 本体より上に付ける。
-- 進行時間: オンにすると、粒子の時刻をこのトラックバーの値（秒）にする（動かすと早送り・巻き戻し・停止ができる）。
-- 放射時間: 粒子を出す時間帯。{始,終,始,終,…}（秒。オブジェクトの始まりから。終に -1 で最後まで）。空なら常に出す。
-- 活動時間: 粒子が動く時間帯（同じ書き方）。外では止まる（拡大率・透過率は変わり続ける）。相対時間: オン = 粒子が生まれてからの秒。
-- 一斉に出す時刻: {秒,秒,…}（オブジェクトの始まりから）に、一斉に出す数 だけまとめて出す（出力頻度の分とは別に）。
-- 数を保つ: 出力頻度の代わりに、保つ数 ÷ 生存時間 の頻度で出す（生きている粒子がおよそ保つ数になる）
-- 出し方: まばら = 間隔がでたらめ（平均は出力頻度）/ まとめ撃ち = まとめる数（± ばらつき %）ずつ、でたらめな時刻にまとめて出す。
-- ループ: 周期（秒）で同じ絵に戻る（周期の始まりと終わりがつながる）。1 周期に出る数が整数になるよう出力頻度を少し丸め、開始時間は使わない（進行時間は使う）
local function on(v) return v == true or v == 1 end
local function arr(t)
  local o = {}
  if type(t) == "table" then for i = 1, #t do o[i] = tonumber(t[i]) or 0 end end
  return o
end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.time = {
  origin = obj.originframe, tp_on = on(tp_on), tp = tp, emit_win = arr(emit_win), act_win = arr(act_win), act_rel = on(act_rel),
  burst_t = arr(burst_t), burst_n = math.floor(burst_n), keep_on = on(keep_on), keep_n = keep_n,
  pace = tonumber(pace) or 0, pace_n = math.floor(pace_n), pace_var = pace_var, loop_on = on(loop_on), loop_t = loop_t,
}

@素材
--information:素材@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--select@kind:素材=0,元の画像=0,切り抜き=1,図形=2,画像フォルダ=3,テキスト=4,動画=5
--group:切り抜きの設定
--select@cshape:切り抜く形=0,四角=0,円=1,三角=2,五角=3,六角=4,星=5,ランダム=6,不定の四角形=7
--select@cwhere:切り抜く所=0,ランダム=0,出た所=1
--track@csize:切り抜く大きさ,1,4000,60,0.01
--check@ccenter:中央だけ,0
--group
--group:図形の設定
--track@fignum:使う図形の数,1,3,1,1
--figure@fig1:図形1,円
--figure@fig2:図形2,四角形
--figure@fig3:図形3,三角形
--track@fsize:図形の大きさ,1,4000,20,0.01
--color@fcol:図形の色,0xffffff
--track@fline:図形のライン幅,0,4000,4000,1
--group
--group:画像フォルダの設定
--folder@idir:画像フォルダ
--select@iorder:選び方=0,名前順=0,ランダム=1,連番として再生=2
--track@ifps:連番の速さ,0.01,240,30,0.01
--group
--group:テキストの設定
--text@txt:テキスト,拡張パーティクル
--file@tfile:テキストファイル
--font@tfont:フォント,MS UI Gothic
--track@tsize:文字の大きさ,1,1000,40,0.01
--select@tdeco:装飾=0,標準文字=0,影付き文字=1,影付き文字(薄)=2,縁取り文字=3,縁取り文字(細)=4,縁取り文字(太)=5,縁取り文字(角)=6
--color@tcol1:文字色,0xffffff
--color@tcol2:影・縁色,0x000000
--select@tunit:分け方=0,一文字=0,一行=1
--select@torder:並び=0,入力順=0,逆順=1,ランダム=2
--track@tswitch:切替間隔,0,600,0,0.001,切り替えない
--select@talign:文字揃え=1,左=0,中央=1,右=2
--track@tspace:文字の間隔,-1000,1000,0,0.01
--track@tlspace:行の間隔,-1000,1000,0,0.01
--group
--group:動画の設定
--file@mfile:動画ファイル
--track@mpos:再生位置,0,100,0,0.01
--track@mspeed:再生速度,-5000,5000,100,0.01
--check@mrandpos:再生位置をランダム,0
--track@mispeed:再生速度のばらつき,-10000,10000,0,0.01
--check@msync:全部の粒子をそろえる,0
--track@mlevels:動画の段数,1,64,16,1
--group
--hide@cshape:kind~=1
--hide@csize:kind~=1
--hide@ccenter:kind~=1
--hide@cwhere:kind~=1
--hide@fignum:kind~=2
--hide@fig1:kind~=2
--hide@fig2:kind~=2
--hide@fig3:kind~=2
--hide@fsize:kind~=2
--hide@fcol:kind~=2
--hide@fline:kind~=2
--hide@idir:kind~=3
--hide@iorder:kind~=3
--hide@ifps:kind~=3
--hide@txt:kind~=4
--hide@tfile:kind~=4
--hide@tfont:kind~=4
--hide@tsize:kind~=4
--hide@tdeco:kind~=4
--hide@tcol1:kind~=4
--hide@tcol2:kind~=4
--hide@tunit:kind~=4
--hide@torder:kind~=4
--hide@tswitch:kind~=4
--hide@talign:kind~=4
--hide@tspace:kind~=4
--hide@tlspace:kind~=4
--hide@mfile:kind~=5
--hide@mpos:kind~=5
--hide@mspeed:kind~=5
--hide@mrandpos:kind~=5
--hide@mispeed:kind~=5
--hide@msync:kind~=5
--hide@mlevels:kind~=5
-- 本体より上に付ける。粒子の見た目（素材）を変える。
-- 切り抜き: 元の画像のでたらめな場所を、形で切り抜いて粒子にする（大きさは px）。切り抜く所「出た所」: 出力位置「自分の画像を並べる」のマスを切り抜く（並べ直すと元の画像）。
-- 画像フォルダ: フォルダの中の画像（png / jpg / jpeg / bmp / gif / webp / tga）を使う。連番として再生: 粒子が生まれてから連番の速さ（枚/秒）で次の画像へ。
-- テキスト: 文字（または行）を粒子にする。テキストファイルを選ぶとそちらを使う（UTF-8）。切替間隔（秒）ごとに次の文字へ変わる。
-- 文字揃え・文字の間隔・行の間隔: 出力位置・形へ集まるの「文字の並び」で文字を並べるときに使う（px）。
-- 動画: 粒子ごとに動画を再生する。動画の段数: 1 フレームに読む動画の絵の数の上限（多いほど滑らかで重い）
local function on(v) return v == true or v == 1 end
local P = require("Particle_H")
local kind = tonumber(kind) or 0
_G.Particle_H_matcache = _G.Particle_H_matcache or {}
local MC = _G.Particle_H_matcache
local m = {
  origin = obj.originframe, kind = kind, shape = tonumber(cshape) or 0, csize = csize, ccenter = on(ccenter), cwhere = tonumber(cwhere) or 0,
  figs = { fig1, fig2, fig3 }, fignum = math.max(math.min(math.floor(fignum), 3), 1), fsize = fsize, fcol = fcol, fline = fline,
  order = 0, fps = 30, count = 0, switch = 0,
}
if kind == 3 then
  local key = "dir|" .. tostring(idir)
  local files = MC[key]
  if not files then
    files = P.list_dir(idir, { png = true, jpg = true, jpeg = true, bmp = true, gif = true, webp = true, tga = true })
    MC[key] = files
  end
  m.files, m.count, m.order, m.fps = files, #files, tonumber(iorder) or 0, ifps
elseif kind == 4 then
  local key = "txt|" .. tostring(tfile) .. "|" .. tostring(txt) .. "|" .. tostring(tunit)
  local ent = MC[key]
  if not ent or not ent.units then
    local text = txt
    if tfile and tfile ~= "" then text = P.read_text(tfile) or "" end
    ent = { units = P.split_units(text, (tonumber(tunit) or 0) == 1), text = text }
    MC[key] = ent
  end
  local units = ent.units
  m.units, m.count, m.order, m.switch = units, #units, tonumber(torder) or 0, tswitch
  m.rawtext, m.by_line = ent.text, (tonumber(tunit) or 0) == 1
  m.talign, m.tspace, m.tlspace = tonumber(talign) or 1, tspace, tlspace
  m.font, m.tsize, m.tdeco, m.tcol1, m.tcol2 = tfont, tsize, tonumber(tdeco) or 0, tcol1, tcol2
elseif kind == 5 then
  local key = "mov|" .. tostring(mfile)
  local info = MC[key]
  if not info then
    local frames, rate, scale = 0, 0, 0
    if mfile and mfile ~= "" then frames, rate, scale = obj.load("movie.info", mfile) end
    local fps = (scale and scale > 0) and rate / scale or 30
    info = { fps = fps > 0 and fps or 30, duration = (frames or 0) / (fps > 0 and fps or 30) }
    MC[key] = info
  end
  m.mfile, m.fps, m.duration = mfile, info.fps, info.duration
  m.pos, m.speed, m.randpos, m.i_speed, m.sync, m.levels = mpos, mspeed, on(mrandpos), mispeed, on(msync), math.floor(mlevels)
  m.obj_now = obj.time
  if not mfile or mfile == "" or info.duration <= 0 then m.kind = 0 end
end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.mat = m

@フィルター
--information:フィルター@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--string@fname:効果名,ぼかし
--string@fitem:変化させる項目,範囲
--track@fv0:始の値,-100000,100000,0,0.01
--track@fv1:終の値,-100000,100000,20,0.01
--select@fbase:変化の基準=0,寿命=0,オブジェクト=1,ランダム=2,跳ね返ってから=3,跳ね返るまで=4
--track@flevels:段数,1,64,16,1
--track@fiv:個別,0,100,0,0.01
--string@ffixed:固定の項目,
--check@fparticle:粒子に掛ける,1
--check@ftrail:軌跡に掛ける,0
--check@ffan:ファンネルに掛ける,0
-- 本体より上に付ける。粒子ごとに、値を変えながら標準のフィルタ効果を掛ける（例: 効果名 ぼかし・変化させる項目 範囲）。
-- 値は段数に分けて、段ごとに 1 回だけ掛ける（多いほど滑らかで重い）。変化の基準: 寿命 = 生まれてから消えるまで / オブジェクト = オブジェクトの始まりから終わりまで / ランダム = 粒子ごとにでたらめ。
-- 個別: 粒子ごとに値の位置を ±この % ずらす。固定の項目: 「項目=値」をカンマで区切って並べる（例: 縦横比=-50,光の強さ=20）。
-- スクリプトの効果は掛からない（標準の効果だけ）
local function on(v) return v == true or v == 1 end
local fixed = {}
local spec = tostring(ffixed or ""):gsub("＝", "="):gsub("，", ","):gsub("、", ",")
for pair in spec:gmatch("[^,]+") do
  local k, v = pair:match("^%s*(.-)%s*=%s*(.-)%s*$")
  if k and k ~= "" then fixed[#fixed + 1] = { k, tonumber(v) or v } end
end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.filt = {
  origin = obj.originframe, name = fname, item = fitem, v0 = fv0, v1 = fv1, base = tonumber(fbase) or 0,
  levels = math.max(math.floor(flevels), 1), i_v = fiv, fixed = fixed,
  particle = on(fparticle), trail = on(ftrail), fan = on(ffan),
}

@色の変化
--information:色の変化@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--select@cmode:色の決め方=0,寿命で変える=0,ランダム=1,同時発生の組でランダム=2,速さで変える=3,奥行きで変える=4,出た所の色=5,跳ね返ってから=6,跳ね返るまで=7
--track@cnum:色の数,1,4,2,1
--color@c1:色1,0xff5050
--color@c2:色2,0xffd040
--color@c3:色3,0x40c0ff
--color@c4:色4,0xffffff
--file@cpal:パレット
--track@cref:基準の速さ,1,100000,300,0.01
--track@cz0:奥行きの始め,-100000,100000,0,0.01
--track@cz1:奥行きの終わり,-100000,100000,1000,0.01
--track@cstr:強さ,0,100,100,0.01
--check@ckeep:輝度を保持する,0
--track@clevels:段数,1,64,16,1
--select@ccurve:補間=0,直線=0,瞬間=1,反復=2,加速=3,減速=4,加減速=5,バウンス=6,弾性=7,バック=8,カーブエディタ_H=9
--track@crep:反復の回数,1,100,2,1
--track@cslot:スロット,1,1000,1,1
--select@ccs:色空間=0,sRGB=0,リニア=1,Oklab=2,HSV=3,HSL=4,Lab=5,LCh=6,Oklch=7,HWB=9
--select@chue:色相経路=0,短経路=0,長経路=1
--select@cdiff:色差=0,RGB=0,YCbCr=1,Oklab=2,CIEDE2000=3
--check@ctrail:軌跡にも,1
--check@cfan:ファンネルにも,0
--hide@clevels:cmode==1
--hide@clevels:cmode==2
--hide@ccurve:cmode==1
--hide@ccurve:cmode==2
--hide@crep:cmode==1
--hide@crep:cmode==2
--hide@crep:ccurve~=2
--hide@cslot:cmode==1
--hide@cslot:cmode==2
--hide@cslot:ccurve~=9
--hide@ccurve:cmode==5
--hide@crep:cmode==5
--hide@cslot:cmode==5
--hide@cref:cmode~=3
--hide@cz0:cmode~=4
--hide@cz1:cmode~=4
--hide@ccs:cmode==1
--hide@ccs:cmode==2
--hide@ccs:cmode==5
--hide@chue:cmode==1
--hide@chue:cmode==2
--hide@chue:cmode==5
--hide@chue:ccs<3
--hide@chue:ccs==5
--hide@cdiff:cmode~=5
-- 本体より上に付ける。粒子を単色化で色付けする。
-- 寿命で変える: 生まれてから消えるまでに 色1 → 色2 → …（色の数まで）と変わる（段数に分けて描く。補間で変わり方を選ぶ）。ランダム: 粒子ごとに色をでたらめに選ぶ。
-- 速さで変える: 速さ 0 で色1、基準の速さ（px/秒）以上で最後の色。奥行きで変える: Z が始め→終わりで色1→最後の色。
-- パレット: 選ぶと、色1〜4 の代わりにパレット（Default の .palette）の色を順に使う（64 色まで。色の数は使わない）。
-- 出た所の色: 出力位置が「他レイヤーの形」「自分の画像を並べる」のとき、出た所の画像の色にする（画像の色から 段数 色を選んで近い色で塗る）。
-- 白い素材（図形など）は「輝度を保持する」をオフにする（オンだと白のまま）
-- 色空間（v0.18.0）: 色1 → 色2 → …（パレットも）の間をどの色空間で混ぜるか。sRGB は今までと同じ。Oklab / Oklch は中間がくすみにくく、明るさがそろう。
-- 色相経路: 色相のある色空間（HSV・HSL・LCh・Oklch・HWB）で、色相を短い方と長い方のどちらへ回るか。
-- 色差（v0.18.0）: 出た所の色を、選んだ色の中のどれに寄せるかを決める色の差。RGB は今までと同じ（選ぶ色そのものは RGB で選ぶ）。
-- CIEDE2000 は、出た所の画像が毎フレーム変わる（動画など）と重い（色 3000 で 1 フレーム約 70ms）。止まった画像なら最初のフレームだけ
local function on(v) return v == true or v == 1 end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
local mode = tonumber(cmode) or 0
local n = math.max(math.min(math.floor(cnum), 4), 1)
local cols = { c1, c2, c3, c4 }
if cpal and cpal ~= "" then
  -- パレット（番号=rrggbb の行）。読めなければ色1〜4 のまま
  local text = require("Particle_H").read_text(cpal)
  if text then
    local pal = {}
    for idx, hex in text:gmatch("(%d+)%s*=%s*(%x%x%x%x%x%x)") do pal[#pal + 1] = { tonumber(idx), tonumber(hex, 16) } end
    table.sort(pal, function(a, b) return a[1] < b[1] end)
    if #pal > 0 then
      cols = {}
      for i = 1, math.min(#pal, 64) do cols[i] = pal[i][2] end
      n = #cols
    end
  end
end
local by_level = mode == 0 or mode == 3 or mode == 4 or mode == 5 or mode == 6 or mode == 7
box.color = {
  origin = obj.originframe, mode = mode, cols = cols, n = n, ref = cref, z0 = cz0, z1 = cz1,
  levels = by_level and math.max(math.floor(clevels), 1) or n, str = cstr, keep = on(ckeep),
  ckind = tonumber(ccurve) or 0, crep = math.floor(crep), cslot = math.floor(cslot),
  trail = on(ctrail), fan = on(cfan),
  space = tonumber(ccs) or 0, hue = tonumber(chue) or 0, metric = tonumber(cdiff) or 0,
}

@軌跡
--information:軌跡@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--select@tmode:軌跡の形=0,粒子を並べる=0,帯=1,速度で伸ばす=2
--track@tnum:尻尾の数,1,32,8,1
--track@tint:間隔,0.001,10,0.05,0.001
--track@talpha:尻尾の透過率,0,100,80,0.01
--track@tzoom:尻尾の拡大率,0,1000,50,0.01
--color@tcol:帯の色,0xffffff
--color@tcol2:帯の色2,0xffffff
--select@tgrad:帯の色の変わり方=0,同じ色=0,頭から尻尾へ=1
--select@tcs:色空間=0,sRGB=0,リニア=1,Oklab=2,HSV=3,HSL=4,Lab=5,LCh=6,Oklch=7,HWB=9
--select@thue:色相経路=0,短経路=0,長経路=1
--track@twidth:帯の幅,0.1,1000,8,0.01
--track@tstretch:伸ばす時間,0,10,0.05,0.001
--hide@tnum:tmode==2
--hide@tint:tmode==2
--hide@talpha:tmode==2
--hide@tzoom:tmode==2
--hide@tcol:tmode~=1
--hide@tcol2:tmode~=1
--hide@tgrad:tmode~=1
--hide@twidth:tmode~=1
--hide@tstretch:tmode~=2
--hide@tcs:tmode~=1
--hide@tcs:tgrad==0
--hide@thue:tmode~=1
--hide@thue:tgrad==0
--hide@thue:tcs<3
--hide@thue:tcs==5
-- 本体より上に付ける。
-- 粒子を並べる: 少し前の位置（間隔は秒）に、粒子を薄く小さくして並べる（尻尾の透過率・拡大率はいちばん後ろの値）。
-- 帯: 少し前の位置を結んだ帯を描く（幅は px。頭から尻尾へ で、帯の色 → 帯の色2 と変わる）。速度で伸ばす: 粒子を進む向きの後ろへ、速さ × 伸ばす時間 だけ伸ばす
-- 色空間・色相経路（v0.18.0）: 帯の色 → 帯の色2 をどの色空間で混ぜるか。sRGB は今までと同じ
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.trail = {
  origin = obj.originframe, mode = tonumber(tmode) or 0, n = math.max(math.min(math.floor(tnum), 32), 1), dt = tint,
  alpha_end = talpha, zoom_end = tzoom, col = tcol, width = twidth, stretch = tstretch,
  col2 = tcol2, grad = tonumber(tgrad) or 0, space = tonumber(tcs) or 0, hue = tonumber(thue) or 0,
}

@ファンネル
--information:ファンネル@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--track@fnum:数,0,50,3,1
--track@frad:半径,0,10000,60,0.01
--select@fsame:見た目=0,図形=0,粒子と同じ=1
--figure@ffig:図形,円
--track@fsize:大きさ,1,4000,12,0.01
--color@fcol:色,0xffffff
--track@frev:公転速度,-36000,36000,180,0.01
--track@frot:自転速度,-36000,36000,0,0.01
--check@feven:等間隔,1
--check@f3d:立体的に回す,0
--track@rnum:円環の数,0,10,0,1
--track@rsize:円環の大きさ,1,10000,120,0.01
--track@rwidth:円環の幅,1,1000,3,0.01
--color@rcol:円環の色,0xffffff
--hide@ffig:fsame==1
--hide@fcol:fsame==1
-- 本体より上に付ける。粒子のまわりに小さな図形（ファンネル）を回し、輪（円環）を付ける。
-- 半径・大きさは px（粒子の拡大率に合わせて変わる）。見た目=粒子と同じ のとき、大きさは粒子に対する %。公転・自転速度は度/秒。
-- 立体的に回す: 粒子ごとに回る面を傾ける（円環も傾く）
local function on(v) return v == true or v == 1 end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.fan = {
  origin = obj.originframe, n = math.floor(fnum), rad = frad, same = (tonumber(fsame) or 0) == 1, fig = ffig, size = fsize,
  col = fcol, rev = frev, rot = frot, even = on(feven), d3 = on(f3d),
  rings = math.floor(rnum), ring_size = rsize, ring_width = rwidth, ring_col = rcol,
}

@メッシュ
--information:メッシュ@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--select@mrule:結び方=0,生まれた順の隣=0,近い粒子=1,三角形で塗る=2
--track@mdist:結ぶ距離,1,10000,150,0.01
--track@mmax:最大の線の数,1,16,3,1
--color@mcol:色,0xffffff
--track@mwidth:線の幅,0.1,100,2,0.01
--track@malpha:透過率,0,100,30,0.01
--check@mfade:遠いほど薄く,1
--check@mgroup:同時発生で分ける,0
--check@mface:面にする,0
--check@mmul:粒子の透過率を掛ける,1
--select@mfillc:面の色=0,粒子の色=0,他レイヤーの画像の色=1,指定の色=2
--track@mflayer:色を取るレイヤー,1,1000,1,1
--track@mmaxedge:長い辺を除く,0,10000,0,0.01,除かない
--check@medge:線も描く,0
--hide@mdist:mrule==0
--hide@mdist:mrule==2
--hide@mmax:mrule==0
--hide@mmax:mrule==2
--hide@mfade:mrule==0
--hide@mfade:mrule==2
--hide@mface:mrule==1
--hide@mface:mrule==2
--hide@mgroup:mrule==2
--hide@mfillc:mrule~=2
--hide@mflayer:mrule~=2
--hide@mflayer:mfillc~=1
--hide@mmaxedge:mrule~=2
--hide@medge:mrule~=2
-- 本体より上に付ける。粒子どうしを線で結ぶ（粒子の後ろに描く）。
-- 生まれた順の隣: 生まれた順に次の粒子と結ぶ（面にする: 続く 3 つを三角形にする）。近い粒子: 結ぶ距離（px）以内の粒子と、1 粒子あたり最大の線の数まで結ぶ
local function on(v) return v == true or v == 1 end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.mesh = {
  origin = obj.originframe, rule = tonumber(mrule) or 0, dist = mdist, max = math.floor(mmax), col = mcol, width = mwidth,
  alpha = malpha, fade = on(mfade), group = on(mgroup), face = on(mface), mul = on(mmul),
  fill = tonumber(mfillc) or 0, flayer = math.floor(mflayer), maxedge = mmaxedge, edge = on(medge),
}

@格子
--information:格子@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--select@gmode:格子の形=0,直交=0,極座標=1
--track@gsx:間隔X,0,10000,20,0.01,なし
--track@gsy:間隔Y,0,10000,20,0.01,なし
--track@gsz:間隔Z,0,10000,0,0.01,なし
--track@gr:間隔(半径),0,10000,20,0.01,なし
--track@gth:間隔(角度),0,360,10,0.01,なし
--track@gph:間隔(仰角),0,180,0,0.01,なし
--group:マスク
--track@glayer:マスクのレイヤー,0,1000,0,1,なし
--track@gthr:マスクのしきい値,0,100,50,0.01
--check@ginv:マスクを反転,0
--group
--hide@gsx:gmode==1
--hide@gsy:gmode==1
--hide@gsz:gmode==1
--hide@gr:gmode==0
--hide@gth:gmode==0
--hide@gph:gmode==0
-- 本体より上に付ける。粒子の位置を格子の点にそろえる（間隔は px。極座標は本体の中心から、角度と仰角は度）。
-- マスクのレイヤー: そのレイヤーのオブジェクトの形（アルファ）を本体の中心に重ね、形の外の粒子を描かない（反転で形の中を描かない）
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
local mode = tonumber(gmode) or 0
box.grid = {
  origin = obj.originframe, mode = mode,
  a = mode == 0 and gsx or gr, b = mode == 0 and gsy or gth, c = mode == 0 and gsz or gph,
  layer = math.floor(glayer), thr = gthr, inv = ginv == true or ginv == 1,
}

@立体物
--information:立体物@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--select@stype:立体の形=0,六面体=0,球=1,錐体=2,双錐体=3,曲面=4,厚み=5,モデル=6
--track@ssize:大きさ,0,4000,0,0.01,素材の大きさ
--track@sdiv:分割数,3,64,8,1
--track@sbh:横の曲がり,-100,100,50,0.01
--track@sbv:縦の曲がり,-100,100,0,0.01
--track@sdepth:奥行き,0,4000,20,0.01
--file@smodel:モデルファイル
--track@smscale:モデルの拡大率,0,10000,100,0.01
--track@smy:モデルの中心の高さ,-10000,10000,0,0.01
--hide@smodel:stype~=6
--hide@smscale:stype~=6
--hide@smy:stype~=6
--hide@ssize:stype>3
--hide@sdiv:stype==0
--hide@sdiv:stype==6
--hide@sbh:stype~=4
--hide@sbv:stype~=4
--hide@sdepth:stype~=5
-- 本体より上に付ける。粒子を立体にする（素材を各面に貼る）。大きさ: px（0 は素材の大きさ）。
-- 分割数: 球・錐体の面の細かさ、曲面の細かさ、厚みの重ねる枚数。曲がり: 100 で幅（高さ）を円周とする筒に巻き付く。奥行き: 厚みの px。
-- 粒子が多いと重い（球は 1 粒あたり 分割数 × 分割数 枚の三角形）。
-- モデル: pmd（MikuMikuDance）の静止した形を粒子ごとに置く（ボーン・表情は読まない）。テクスチャはモデルと同じフォルダから読む。
--   モデルの 1 単位 = 10px × モデルの拡大率 %。モデルの中心の高さ: モデルの (0, この値, 0) を粒子の位置に置く（モデルの単位）。
--   重い（三角形の数 × 粒子の数）。素材の画像は使わない
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.solid = {
  origin = obj.originframe, type = tonumber(stype) or 0, size = ssize, div = math.floor(sdiv), bh = sbh, bv = sbv, depth = sdepth,
  model = tostring(smodel or ""), mscale = smscale, my = smy,
}

@ガラス化
--information:ガラス化@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--track@gref:屈折,-1000,1000,40,0.01
--track@gwid:縁の幅,1,500,16,0.01
--track@gedge:縁の明るさ,0,100,30,0.01
--track@gblur:背景のぼかし,0,100,0,0.01
--color@gcol:色,0xffffff
--track@gtint:色の強さ,0,100,0,0.01
-- 本体より上に付ける。粒子をガラスにする（粒子の形の向こうの絵を、縁ほどずらして見せる）。屈折・縁の幅・ぼかしは px。
-- 粒子の形（アルファ）だけを使い、色は使わない。カメラ制御の下では効かない（粒子をそのまま描く）
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.glass = {
  origin = obj.originframe, ref = gref, width = gwid, edge = gedge, blur = gblur, col = gcol, tint = gtint,
}

@音
--information:音@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--select@asrc:音=0,編集中の音=0,音声ファイル=1
--file@afile:音声ファイル
--track@aband:周波数帯,1,10,1,1
--track@aband2:もう一つの周波数帯,0,10,0,1,なし
--track@again:感度,0,10000,100,0.01
--track@azoom:拡大率,-1000,1000,100,0.01
--track@aalpha:透過率,-100,100,0,0.01
--track@aspread:広がり,-1000,1000,0,0.01
--select@abeat:拍で出す=0,出さない=0,音声ファイルの拍=1,BPMのグリッド=2
--track@abn:拍ごとの数,1,10000,30,1
--track@abth:拍の感度,0,100,50,0.01
--select@abband:拍を見る音=0,全体=0,低い音=1,高い音=2
--track@abdiv:グリッドの細かさ,1,16,1,1
--check@abacc:強い拍ほど多く,1
--track@arate:音の大きさで出す数,0,1000,0,0.01,変えない
--select@arband:音の大きさを見る音=0,全体=0,低い音=1,高い音=2
--hide@arate:asrc==0
--hide@arband:asrc==0
--hide@afile:asrc==0
--hide@abn:abeat==0
--hide@abth:abeat~=1
--hide@abband:abeat~=1
--hide@abdiv:abeat~=2
--hide@abacc:abeat==0
-- 本体より上に付ける。今の音の大きさで、今いる粒子の拡大率・透過率・広がり（出た所からの距離）を変える（値は音がいちばん大きいときの変化 %）。
-- 周波数帯: 音を低い方から 10 に分けた番号。もう一つの周波数帯を選ぶと、大きい方を使う。
-- 過去の音は読めないので、出る数や速さは変えない（拍で出すは別。下）。
-- 拍で出す: 拍の時刻に 拍ごとの数 だけ一斉に出す。音声ファイルの拍は、音を「音声ファイル」にしてファイルを選ぶ（ファイルの先頭 = オブジェクトの始まり）。
--   WAV のほか、mp3・m4a など Windows（Media Foundation）が読める形式も使える。
--   拍の感度が大きいほど小さな立ち上がりも拾う。BPMのグリッドは、編集画面のグリッド（BPM）の拍。細かさ 2 で 8 分、4 で 16 分。
--   強い拍ほど多く: 音の拍は立ち上がりの大きさ、グリッドは小節の頭 1 / 拍 0.7 / 拍の間 0.4 を数に掛ける
-- 音の大きさで出す数: 音声ファイルの音の大きさ（一番大きい所が 1）に合わせて、出力頻度に 1 ＋ この % × 音の大きさ を掛ける（0 で変えない）
local function on(v) return v == true or v == 1 end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.audio = {
  origin = obj.originframe, src = tonumber(asrc) or 0, file = afile or "", band = math.floor(aband), band2 = math.floor(aband2),
  gain = again, zoom = azoom, alpha = aalpha, spread = aspread,
  beat = tonumber(abeat) or 0, bn = math.floor(abn), bth = abth, bband = tonumber(abband) or 0, bdiv = math.floor(abdiv), bacc = on(abacc),
  arate = arate, arband = tonumber(arband) or 0,
}

@カスタム描画
--information:カスタム描画@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--file@cfile:関数ファイル
--track@cvar:種類の数,1,64,4,1
--track@clv:時間の段数,1,64,8,1
--track@cv1:値1,-9999,9999,0,0.01
--track@cv2:値2,-9999,9999,0,0.01
--track@cv3:値3,-9999,9999,0,1
--value@cvals:設定値,{}
--color@ccol1:色1,0xffffff
--color@ccol2:色2,0x000000
--figure@cfig1:図形1,円
--figure@cfig2:図形2,四角形
--check@cchk1:チェック1,0
--check@cchk2:チェック2,0
-- 本体より上に付ける。関数ファイル（.lua）の particle_obj で描いた絵を粒子にする（素材の代わり）。
-- particle_obj(t, t0, life, pi, pj, seed, 値1, 値2, 値3, 設定値1〜8, 色1, 色2, 図形1, 図形2, チェック1, チェック2) を、
-- 種類（pi = 0〜種類の数-1）× 時間の段（t = 0〜生存時間）ごとに 1 回だけ呼ぶ。関数は仮想バッファに描いて obj.load("tempbuffer") で終える。
-- 種類の数 × 時間の段数は 64 まで（超える分は段数を減らす）
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
local nvar = math.max(math.floor(cvar), 1)
local nlv = math.max(math.min(math.floor(clv), math.floor(64 / nvar)), 1)
box.custom = {
  origin = obj.originframe, file = cfile or "", cvar = nvar, clv = nlv, v1 = cv1, v2 = cv2, v3 = cv3, vals = cvals or {},
  col1 = ccol1, col2 = ccol2, fig1 = cfig1, fig2 = cfig2, chk1 = (cchk1 == true or cchk1 == 1) and 1 or 0,
  chk2 = (cchk2 == true or cchk2 == 1) and 1 or 0,
}

@力場
--information:力場@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--select@ftype:力の種類=0,渦=0,引力・斥力=1,衝撃波=2,双極=3,浮力=4,画像の明るさ=5
--value@fpos:中心,{0,0,0,300,0,0}
--track@fstr:強さ,-100000,100000,300,0.01
--track@frange:届く距離,0,100000,500,0.01,どこまでも
--track@i_fstr:個別の強さ,-10000,10000,0,0.01
--check@fchain:上の力場に足す,0
--group:渦
--track@fspin:回す強さ,-100000,100000,600,0.01
--track@fup:軸に沿う強さ,-100000,100000,0,0.01
--track@fax:軸の傾きX,-180,180,0,0.01
--track@fay:軸の傾きY,-180,180,0,0.01
--group
--group:衝撃波
--track@ft0:起きる時刻,0,600,1,0.001
--track@fwave:広がる速さ,0,100000,600,0.01
--track@fwidth:波の幅,1,10000,60,0.01
--group
--group:双極
--track@ffollow:沿わせる強さ,0,1000,4,0.01
--group
--group:浮力
--track@fcool:冷める時間,0,600,1,0.001,冷めない
--track@fheavy:冷めた後の重さ,-100000,100000,300,0.01
--track@fbase:基準の高さ,-100000,100000,0,0.01
--group
--group:画像の明るさ
--track@flayer:対象レイヤー,1,1000,1,1
--select@fgrad:向き=0,明るい方へ=0,暗い方へ=1,明るさの等高線に沿う=2
--group
--hide@fpos:ftype==5
--hide@frange:ftype==5
--hide@flayer:ftype~=5
--hide@fgrad:ftype~=5
--hide@fspin:ftype~=0
--hide@fup:ftype~=0
--hide@fax:ftype~=0
--hide@fay:ftype~=0
--hide@ft0:ftype~=2
--hide@fwave:ftype~=2
--hide@fwidth:ftype~=2
--hide@ffollow:ftype~=3
--hide@fcool:ftype~=4
--hide@fheavy:ftype~=4
--hide@fbase:ftype~=4
-- 本体より上に付ける。粒子に力を掛ける（積分で動かす。座標はオブジェクトの中心から、力は px/秒²）。
-- 渦: 軸の周りを回す（回す強さ）・軸へ寄せる（強さ。負なら外へ）・軸に沿って押す。軸は画面の奥向きを傾きで回す。
-- 引力・斥力: 中心へ引く（負なら押す）。届く距離: その距離で力が半分になる（どこまでも = 弱めない）。
-- 衝撃波: 起きる時刻（秒）から広がる輪で外へ押す。波が通り過ぎる間に、粒子の速さが 強さ（px/秒）だけ増える。
-- 双極: 中心の 1 点目（N 極）から出て 2 点目（S 極）へ入る線に沿って、向きを寄せる。強さが正なら、沿って進む速さ（px/秒）。
-- 浮力: 上へ押す。冷める時間で 0 になり、その分 冷めた後の重さ で下へ引く。届く距離があれば、基準の高さより上で弱める。
-- 画像の明るさ: 対象レイヤーのオブジェクトの明るさの勾配に沿って押す（明るい方へ / 暗い方へ / 等高線に沿う）。強さ × 勾配の大きさ（64px で明るさが 0→1 なら強さいっぱい）。
-- 上の力場に足す: すぐ上に置いた力場と一緒に使う（力場を重ねる）
local function on(v) return v == true or v == 1 end
local ty = tonumber(ftype) or 0
local def = { 0, 0, 0, 300, 0, 0 }
if ty == 3 then obj.setanchor("fpos", 2, "xyz", "line", def) elseif ty ~= 5 then obj.setanchor("fpos", 1, "xyz", def) end
local pos = {}
for i = 1, 6 do pos[i] = (fpos and fpos[i]) or def[i] end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
local F = {
  type = ty, pos = pos, str = fstr, range = frange, i_str = i_fstr, spin = fspin, up = fup, ax = fax, ay = fay,
  t0 = ft0, wave = fwave, width = fwidth, follow = ffollow, cool = fcool, heavy = fheavy, base = fbase,
  layer = math.floor(flayer), grad = tonumber(fgrad) or 0,
}
local list = { F }
local prev = box.field
if on(fchain) and prev and prev.origin == obj.originframe then
  list = {}
  for i, v in ipairs(prev.list) do list[i] = v end
  list[#list + 1] = F
end
box.field = { origin = obj.originframe, list = list }

@見た目の調整
--information:見た目の調整@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--group:速さ
--track@sref:基準の速さ,1,100000,300,0.01
--track@szoom:速さで大きさ,-1000,1000,0,0.01
--track@salpha:速さで透過率,-100,100,0,0.01
--group
--group:奥行き
--track@dz0:奥行きの始め,-100000,100000,0,0.01
--track@dz1:奥行きの終わり,-100000,100000,1000,0.01
--track@dzoom:奥ほど大きさ,-100,1000,0,0.01
--track@dalpha:奥ほど透過率,-100,100,0,0.01
--group
--group:点滅
--track@blink_hz:点滅の速さ,0,100,2,0.01
--track@blink_depth:点滅の深さ,0,100,0,0.01
--select@blink_shape:点滅の形=0,なめらか=0,きらめき=1
--check@blink_rand:位相をランダム,1
--group
--group:形
--track@aspect:縦横比,-99,99,0,0.01
--track@i_aspect:個別縦横比,0,99,0,0.01
--track@shear:ゆがみ,-200,200,0,0.01
--track@i_shear:個別ゆがみ,0,200,0,0.01
--group
-- 本体より上に付ける。
-- 速さ: 基準の速さ（px/秒）で、大きさ・透過率をこの % だけ変える（速さに比例。基準の 10 倍まで）。
-- 奥行き: Z が始め→終わりの間で、大きさ・透過率を 0 → この % だけ変える（奥が大きい Z）。
-- 点滅: なめらか = 1 秒に 点滅の速さ 回、深さ % だけ暗くなる / きらめき = 1 / 点滅の速さ 秒ごとに、ときどき強く光る（ふだんは深さ % 暗い）。
-- 形: 縦横比（プラス = 横が縮む / マイナス = 縦が縮む）とゆがみ（%。横へ傾ける）。個別は粒子ごとのばらつきの幅
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.look = {
  origin = obj.originframe, sref = sref, szoom = szoom, salpha = salpha, dz0 = dz0, dz1 = dz1, dzoom = dzoom, dalpha = dalpha,
  blink_hz = blink_hz, blink_depth = blink_depth, blink_shape = tonumber(blink_shape) or 0,
  blink_rand = blink_rand == true or blink_rand == 1,
  aspect = aspect, i_aspect = i_aspect, shear = shear, i_shear = i_shear,
}

@パス
--information:パス@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--track@pnum:アンカー数,2,16,3,1
--value@ppos:道,{-600,0,0,0,-200,0,600,0,0}
--select@pcurve:つなぎ方=1,折れ線=0,曲線=1
--track@pspeed:流れる速さ,-10000,10000,300,0.01
--track@paccel:流れる加速度,-10000,10000,0,0.01
--track@pwidth:道の幅,0,10000,40,0.01
--select@pend:端に着いたら=0,消える=0,止まる=1,最初へ戻る=2,折り返す=3
--select@pstart:出る所=0,道の始め=0,道のどこでも=1,出力位置から一番近い所=2
--track@i_pspeed:個別の速さ,-10000,10000,0,0.01
--check@pchain:上のパスにつなぐ,0
-- 本体より上に付ける。粒子をアンカーで引いた道に沿って流す（円運動と同じく、本体の速さ・重力と動きの拡張は使わない）。
-- 曲線: アンカーを通る曲線。流れる速さ（px/秒。負なら逆向き）と加速度で、道のりを進む。道の幅: 道と直角の向きに散らす幅（px）。
-- 出る所: 道の始め（速さが負なら終わり）/ 道のどこでも / 出力位置から一番近い所（道からのずれを保つ。幅は使わない）。
-- 上のパスにつなぐ: すぐ上に置いたパスの点の後ろに、この点を足す（アンカーを 16 より多く置ける）
local function on(v) return v == true or v == 1 end
local n = math.max(math.floor(pnum), 2)
local def = {}
for i = 0, n - 1 do
  def[#def + 1] = -600 + 1200 * i / (n - 1); def[#def + 1] = (i % 2 == 1) and -200 or 0; def[#def + 1] = 0
end
obj.setanchor("ppos", n, "xyz", "line", def)
local pts = {}
for i = 1, n * 3 do pts[i] = (ppos and ppos[i]) or def[i] end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
local prev = box.path
if on(pchain) and prev and prev.origin == obj.originframe then
  local all = {}
  for i = 1, prev.n * 3 do all[i] = prev.pts[i] end
  for i = 1, n * 3 do all[#all + 1] = pts[i] end
  pts, n = all, prev.n + n
end
box.path = {
  origin = obj.originframe, pts = pts, n = n, curve = tonumber(pcurve) or 1, speed = pspeed, accel = paccel, width = pwidth,
  pend = tonumber(pend) or 0, start = tonumber(pstart) or 0, i_speed = i_pspeed,
}

@形へ集まる
--information:形へ集まる@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--select@gsrc:行き先=0,他レイヤーの形=0,出た所=1,文字の並び=2,アンカー=3
--track@glayer:対象レイヤー,1,1000,1,1
--track@gthr:しきい値,0,100,50,0.01
--select@gpick:行き先の選び方=0,ランダム=0,近い所=1,均等に=2
--track@gnpts:アンカー数,1,16,1,1
--value@gpos:点,{0,0,0}
--track@grad:行き先の広がり,0,10000,0,0.01
--track@gstart:集まり始める時刻,0,600,1,0.001
--track@gdur:かかる時間,0.001,600,1,0.001
--select@gbase:時間の基準=0,粒子ごと=0,オブジェクト=1
--track@gspread:ずらす幅,0,600,0,0.001
--select@gorder:ずらす順=0,番号順=0,ランダム=1,行き先の左から=2,行き先の中心から=3
--select@gcurve:補間=4,直線=0,瞬間=1,反復=2,加速=3,減速=4,加減速=5,バウンス=6,弾性=7,バック=8,カーブエディタ_H=9
--track@grep:反復の回数,1,100,2,1
--track@gslot:スロット,1,1000,1,1
--check@galign:回転と大きさをそろえる,1
--select@gafter:着いたら=0,とどまる=0,離れる=1
--track@gleave:離れ始める時刻,0,600,3,0.001
--track@gjitter:着いた後のゆらぎ,0,1000,0,0.01
--hide@glayer:gsrc~=0
--hide@gthr:gsrc~=0
--hide@gpick:gsrc~=0
--hide@gnpts:gsrc~=3
--hide@gpos:gsrc<2
--hide@grep:gcurve~=2
--hide@gslot:gcurve~=9
--hide@gleave:gafter~=1
-- 本体より上に付ける。集まり始める時刻から、かかる時間で、粒子を行き先へ寄せる（動きの計算の後に掛ける。どの動きとも組める）。
-- 行き先: 他レイヤーの形（ランダム / 近い所 = いまの位置から一番近い形の中 / 均等に）・出た所（生まれた位置へ戻る）・
--         文字の並び（素材のテキストの位置。点の 1 点目が中心）・アンカー（粒子ごとに順に割り当てる）。行き先の広がり: 行き先の周りに散らす半径（px）。
-- 時間の基準: 粒子ごと = 生まれてからの秒 / オブジェクト = オブジェクトの時刻。ずらす幅: 粒子ごとに始める時刻を 0〜この秒数ずらす（ずらす順で並べる）。
-- 回転と大きさをそろえる: 回転を 0、拡大率を 100% へ同じ進みで寄せる。離れる: 離れ始める時刻から、かかる時間で元の動きへ戻る
local function on(v) return v == true or v == 1 end
local src = tonumber(gsrc) or 0
local np = 1
local pts = { 0, 0, 0 }
if src == 2 then
  obj.setanchor("gpos", 1, "xyz", { 0, 0, 0 })
  for i = 1, 3 do pts[i] = (gpos and gpos[i]) or 0 end
elseif src == 3 then
  np = math.max(math.floor(gnpts), 1)
  local def = {}
  for i = 0, np - 1 do
    local a = i / np * 2 * math.pi
    def[#def + 1] = np > 1 and 300 * math.cos(a) or 0; def[#def + 1] = np > 1 and 300 * math.sin(a) or 0; def[#def + 1] = 0
  end
  obj.setanchor("gpos", np, "xyz", def)
  pts = {}
  for i = 1, np * 3 do pts[i] = (gpos and gpos[i]) or def[i] end
end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.gather = {
  origin = obj.originframe, src = src, layer = math.floor(glayer), thr = gthr, pick = tonumber(gpick) or 0, np = np, pts = pts,
  radius = grad, start = gstart, dur = gdur, base = tonumber(gbase) or 0, spread = gspread, order = tonumber(gorder) or 0,
  curve = tonumber(gcurve) or 4, rep = math.floor(grep), slot = math.floor(gslot), align = on(galign),
  after = tonumber(gafter) or 0, leave = gleave, jitter = gjitter,
}

@子粒子
--information:子粒子@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--select@cevent:出す時=0,消えるとき=0,最初に跳ね返ったとき=1,分散したとき=2,動いている間=3
--track@cnum:出す数,1,100,8,1
--track@cint:間隔,0.01,10,0.1,0.001
--track@cspeed:速さ,0,10000,150,0.01
--track@cspread:拡散角度,0,180,180,0.01
--track@cinherit:親の速さを受け継ぐ,0,100,0,0.01
--track@clife:生存時間,0.001,600,1,0.001
--track@czoom:大きさ,0,1000,50,0.01
--track@cgy:重力Y,-10000,10000,0,0.01
--track@cdrag:空気抵抗,0,100,0,0.01
--track@calpha1:終透過率,0,100,100,0.01
--check@cext:動きの拡張も掛ける,0
--hide@cint:cevent~=3
-- 本体より上に付ける。親の粒子の出来事から、子の粒子を出す（子は親と同じ素材で描く）。
-- 出す時: 消えるとき（寿命の終わり）/ 最初に跳ね返ったとき（跳ね返りが要る）/ 分散したとき（分散と停止が要る）/ 動いている間（間隔ごとに、その時の位置から）。
-- 子は 1 回に 出す数 だけ出て、速さ（の 60〜100%）で、親の進む向きから ± 拡散角度 の向きへ飛ぶ（親の速さを受け継ぐ % を足す）。
-- 子は 速さ・重力Y・空気抵抗 だけで動く。大きさは素材の大きさに対する %。透過率は 0 から 終透過率 へ。
-- 動きの拡張も掛ける: 親と同じ風・ノイズ場・力場・跳ね返りを子にも掛ける（集結点・分散と停止などは掛けない。子の数だけ重くなる）
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.child = {
  origin = obj.originframe, event = tonumber(cevent) or 0, n = math.floor(cnum), interval = cint, speed = cspeed, spread = cspread,
  inherit = cinherit, life = clife, zoom = czoom, gy = cgy, drag = cdrag, alpha1 = calpha1, ext = cext == true or cext == 1,
}

@影
--information:影@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--select@smode:落とし方=0,ずらす=0,床に写す=1
--track@sdx:ずらすX,-10000,10000,20,0.01
--track@sdy:ずらすY,-10000,10000,20,0.01
--track@sfloor:床の高さ,-100000,100000,400,0.01
--track@slx:光の向きX,-10,10,0.5,0.01
--track@slz:光の向きZ,-10,10,0,0.01
--track@sdark:影の濃さ,0,100,60,0.01
--track@sblur:影のぼかし,0,200,6,0.01
--color@scol:影の色,0x000000
--track@sfade:高さで薄く,0,100000,0,0.01,薄くしない
--hide@sdx:smode~=0
--hide@sdy:smode~=0
--hide@sfloor:smode~=1
--hide@slx:smode~=1
--hide@slz:smode~=1
--hide@sfade:smode~=1
-- 本体より上に付ける。粒子の影を、粒子より先に（後ろに）同じ素材で描く。
-- ずらす: 画面の上でずらす（ドロップシャドウ）。床に写す: 床の高さ（Y）の面へ、光の向き（下へ 1 進むごとに X・Z へ進む量）で写し、床に寝かせて描く。
-- 影の濃さ: 粒子の不透明度に掛ける %。高さで薄く: 床からこの距離（px）で影が消える
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.shadow = {
  origin = obj.originframe, mode = tonumber(smode) or 0, dx = sdx, dy = sdy, floor = sfloor, lx = slx, lz = slz,
  dark = sdark, blur = sblur, col = scol, fade = sfade,
}

@受け取って描く
--information:受け取って描く@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--string@rname:受け取る名前,
--track@rzoom:拡大率,0,5000,100,0.01
--check@ralpha:粒子の透過率を使う,1
--check@rrot:粒子の回転を使う,1
--check@rdiag:診断ログ,0
-- 本体の「渡す名前」で渡された粒子の位置に、このオブジェクトの画像を描く（本体とは別のオブジェクトに付ける）。
-- 位置は渡した側の座標（本体の位置を足した値）からこのオブジェクトの位置を引いて置く。拡大率は粒子の拡大率に掛ける %。
-- 渡す側が同じフレームで先に計算されていないと、前のフレームの粒子になる（ログに注意が出る）
local P = require("Particle_H")
local function on(v) return v == true or v == 1 end
local function num(v, d) return tonumber(v) or d end
local name = tostring(rname or "")
local frame = obj.originframe or (obj.frame_s + obj.frame)
local scene_part = obj.scene_id ~= nil and (tostring(obj.scene_id) .. ":") or ""
local S, lag
if name ~= "" then S, lag = P.share_get(scene_part .. name, frame) end
local warn = ""
if name == "" then
  warn = "受け取る名前が空"
elseif not S then
  warn = "「" .. name .. "」の粒子が渡されていない"
elseif lag > 0 then
  warn = "「" .. name .. "」の粒子は " .. lag .. " フレーム前のもの（渡す側を、受け取る側より上のレイヤーへ）"
elseif lag < 0 then
  warn = "「" .. name .. "」の粒子は " .. -lag .. " フレーム先のもの（使わない）"
end
-- 上のレイヤーが先に計算される（実機 EPR-204〜207）。渡す側が下だと 1 つ前のフレームの粒子になる。
-- 使うのは今のフレームと 1 つ前だけ（それより古いのは渡す側がもう無い、先のものは戻って描いている）
if S and lag ~= 0 and lag ~= 1 then S = nil end
_G.Particle_H_err = _G.Particle_H_err or {}
if _G.Particle_H_err[obj.id] ~= warn then
  _G.Particle_H_err[obj.id] = warn
  if warn ~= "" then print("@warn", "[拡張パーティクル_H] 注意: " .. warn) end
end
if on(rdiag) then
  local msg = string.format("受け取って描く %s: 粒子 %d / フレームの差 %s", name, S and S.n or 0, tostring(lag))
  _G.Particle_H_rdiag = _G.Particle_H_rdiag or {}
  if _G.Particle_H_rdiag[obj.id] ~= msg then
    _G.Particle_H_rdiag[obj.id] = msg
    print("@warn", "[拡張パーティクル_H] " .. msg)
  end
end
if S then
  local bx, by, bz = num(obj.getvalue("x"), 0) + (obj.ox or 0), num(obj.getvalue("y"), 0) + (obj.oy or 0), num(obj.getvalue("z"), 0) + (obj.oz or 0)
  local groups = P.receive_quads(S, obj.w, obj.h, bx, by, bz, rzoom / 100, on(ralpha), on(rrot))
  for lv = 1, 64 do
    local list = groups[lv]
    if list then obj.drawpoly(list, lv / 64) end
  end
end
obj.setoption("draw_state", true)

@光源
--information:光源@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--select@lkind:光の種類=0,平行光=0,点光源=1
--track@lx:光の向きX,-10,10,0.5,0.01
--track@ly:光の向きY,-10,10,1,0.01
--track@lz:光の向きZ,-10,10,1,0.01
--value@lpos:光の位置,{-400,-400,-300}
--track@lamb:環境光,0,100,30,0.01
--track@lpow:光の強さ,0,200,100,0.01
--track@lspec:ハイライト,0,100,0,0.01
--track@llev:段数,2,32,8,1
--check@lback:裏も照らす,1
--color@lcol:光の色,0xffffff
--hide@lx:lkind==1
--hide@ly:lkind==1
--hide@lz:lkind==1
--hide@lpos:lkind==0
-- 本体より上に付ける。粒子の面の向きと光から明るさを求め、段数の段に分けて暗く（ハイライトは光の色へ明るく）描く。
-- 光の向き: 光が進む向き（初期値は左上の手前から右下の奥へ）。点光源: 光の位置（アンカー）から粒子へ向かう光。
-- 明るさ = 環境光 + 光の強さ × 面が光の方を向いている度合い（%）。裏も照らす: 裏を向いた面も、裏から当たる光で照らす。
-- 立体物は面ごとに明るさが変わる（閉じた立体 = 六面体・球・錐体・双錐体では、裏も照らすを使わない）。段数 × 素材 × 色の段の数だけ素材を読み直すので、段数を上げるほど重い
local function on(v) return v == true or v == 1 end
local kind = tonumber(lkind) or 0
if kind == 1 then obj.setanchor("lpos", 1, "xyz") end
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
box.light = {
  origin = obj.originframe, kind = kind, lx = lx, ly = ly, lz = lz,
  pos = { (lpos and lpos[1]) or -400, (lpos and lpos[2]) or -400, (lpos and lpos[3]) or -300 },
  amb = lamb, pow = lpow, spec = lspec, levels = llev, back = on(lback), col = lcol,
}

@粒子どうし
--information:粒子どうし@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--track@ir:届く距離,1,2000,40,0.01
--track@irep:反発,0,100000,500,0.01
--track@isize:粒子の大きさ,0,2000,0,0.01,重なってよい
--track@iatt:引き合い,-100000,100000,0,0.01
--track@ifric:粒子どうしの摩擦,0,100,0,0.01
--group:群れ
--track@bsep:離れる,0,100,0,0.01
--track@bali:向きをそろえる,0,100,0,0.01
--track@bcoh:群れの中心へ寄る,0,100,0,0.01
--track@bview:見える角度,0,180,135,0.01
--track@bvmin:最低の速さ,0,10000,0,0.01
--track@bvmax:最高の速さ,0,10000,0,0.01,制限しない
--group
--check@i3d:奥行きも使う,0
--string@iother:当たる相手（受け取る名前）,
--track@iorad:相手の大きさ,0,2000,20,0.01
--track@iorep:相手から押される強さ,0,100000,500,0.01
--track@imax:一緒に進める数,100,10000,3000,1
-- 本体より上に付ける。粒子どうしを押し合わせ・引き合わせ、群れにする。全部の粒子を同じ時刻の刻みで一緒に進める（3,000 個まで）。
-- 反発: 届く距離（px）の中で、近いほど強く押し合う（px/秒²）。粒子の大きさ: これより近づかない（位置を押し戻し、近づく速さを消す。積み上がる）。
-- 粒子どうしの摩擦: 触れている粒子どうしがずれる速さを弱め、押し合う量 × 摩擦 までのずれを止める（%。粒子の大きさと一緒に使うと砂が山になる）。引き合い: 届く距離の中で寄る（負なら離れる）。群れ: 見える角度（進む向きから ± 度）の中の仲間から、離れる・向きをそろえる・中心へ寄る（%）。
-- 最低の速さ・最高の速さ: 速さをこの範囲に収める。奥行きも使う: オフなら XY の距離だけで考える（軽い）。
-- 粒子どうしを使うと、最初のフレームと後ろへ飛んだときに頭から計算し直すので重い（途中の状態を取っておき、そこから進め直す）。
-- 当たる相手: 別のオブジェクトの本体が「渡す名前」で渡した粒子に当たって押される（相手は押し返さない）。相手の大きさ: 中心どうしがこれより近づかない（px）。
--   相手を上のレイヤーに置く。相手の位置は 1 フレームに 500 個まで（多ければ間引く）
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
local function on(v) return v == true or v == 1 end
box.inter = {
  origin = obj.originframe, r = ir, rep = irep, size = isize, att = iatt, fric = ifric,
  sep = bsep, ali = bali, coh = bcoh, view = bview, vmin = bvmin, vmax = bvmax, d3 = on(i3d),
  other = tostring(iother or ""), orad = iorad, orep = iorep, imax = imax,
}

@焼き付け
--information:焼き付け@拡張パーティクル_H v0.19.2 by HexBrowns
--label:HexScript
--select@bmode:焼き付け=0,使わない=0,書き出す=1,読み込む=2
--folder@bdir:置くフォルダ
--string@bname:名前,particles
--check@bsim:無いフレームは計算する,1
--check@bcsv:CSV も書く,0
--hide@bcsv:bmode~=1
--hide@bdir:bmode==0
--hide@bname:bmode==0
--hide@bsim:bmode~=2
-- 本体より上に付ける。計算した粒子をフレームごとにファイル（置くフォルダの 名前.prh）に書き、読み込むときは計算を飛ばす。
-- 書き出す: 描いたフレームを書く（出力すると全部のフレームが埋まる。どの順で描いても上書きできる）。
-- 読み込む: そのフレームの記録があれば計算せずに描く。無いフレームは、無いフレームは計算する がオンなら計算し、オフなら描かない。
-- 本体・拡張の動きの設定が変わった焼き付けは使わない（ログに注意が出る。書き出し直す）。重い粒子どうしを一度だけ計算して、後は軽く見るのに使う。
-- 拡大率・透過率・色・素材などの見た目だけを変えたときは、焼き付けを使い続ける（位置は焼き付けのまま、見た目は今の設定で計算し直す）。
-- CSV も書く: 置くフォルダの 名前_csv に、フレームごとの 00012.csv（1 行 1 粒: k,x,y,z,rx,ry,rz,zoom,alpha,age,life）も書く
_G.Particle_H_ext = _G.Particle_H_ext or {}
local box = _G.Particle_H_ext[obj.id] or {}
_G.Particle_H_ext[obj.id] = box
local function on(v) return v == true or v == 1 end
box.bake = { origin = obj.originframe, mode = tonumber(bmode) or 0, dir = tostring(bdir or ""), name = tostring(bname or ""), sim = on(bsim),
             csv = on(bcsv) }
