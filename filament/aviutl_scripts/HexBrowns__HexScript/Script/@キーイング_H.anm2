--hide@ref_mode:src_mode==0
--track@interval:比較フレーム間隔,1,30,1,1
--track@ref_time:基準の時刻,0,36000,0,0.01
--hide@ref_time:ref_mode==0
--track@movie_offset:動画のずれ,-36000,36000,0,0.01
--hide@movie_offset:src_mode==0
--select@no_prev:比較元が無いとき=0,何も残さない=0,すべて残す=1
--group:検出
--track@threshold:しきい値,0,100,10,0.1
--track@softness:境界の幅,0,50,5,0.1
--track@pre_blur:ぼかし,0,50,2,0.1
--track@smooth:マスクの滑らかさ,0,100,4,0.1
--check@gradient:強度グラデーション,0
--check@use_color:色の差,0
--select@color_metric:色差=4,今まで=4,RGB=0,YCbCr=1,Oklab=2,CIEDE2000=3
--hide@color_metric:use_color==0
--check@invert:反転,0
--group:対象
--track@noise:ノイズ除去,0,100000,0,1
--select@target:ターゲット選択=0,すべて=0,面積が大きい順=1,最も近い順=2
--track@count:個数,1,32,1,1
--hide@count:target==0
