float4 to_gamma(float4 col, int mode) {
    switch (mode) {
        case 0:
            return saturate(col);
        case 1:
            float3 t = step(col.rgb, 0.0031308);
            float3 low = 12.92 * col.rgb;
            float3 high = 1.055 * pow(abs(col.rgb), rcp(2.4)) - 0.055;
            return saturate(float4(lerp(high, low, t), col.a));
        default:
            return saturate(col);
    }
}

