--information:RZoom.anm2
--label:変形
--track@power:拡大率,0,100,0
--track@curve:調整,0.5,4,1.5

local b = 30

local t = power * 0.01
local w,h = obj.getpixel()

local cx = w*0.5
local cy = h*0.5
local D = math.sqrt(w*w+h*h)*0.5

local N = curve

local wb = w/b
local hb = h/b


local zoom = 1 + t*0.6

local pos={}
local n=0

for i=0,b do
 for j=0,b do
  local u=j*wb
  local v=i*hb

  local x=u-cx
  local y=v-cy

  local r = math.sqrt(x*x+y*y)/D


  local suck = (r^N) * t * (2.5 + t*2)

  local L = 1 + suck

  n=n+1
  pos[n]={x*L*zoom,y*L*zoom,u,v}
 end
end

obj.setoption("drawtarget","tempbuffer",w,h)

for i=1,b*b do
 local p1=math.ceil(i/b)-1+i
 local p2=p1+1
 local p3=p2+b+1
 local p4=p3-1

 obj.drawpoly(
  pos[p1][1],pos[p1][2],0,
  pos[p2][1],pos[p2][2],0,
  pos[p3][1],pos[p3][2],0,
  pos[p4][1],pos[p4][2],0,
  pos[p1][3],pos[p1][4],
  pos[p2][3],pos[p2][4],
  pos[p3][3],pos[p3][4],
  pos[p4][3],pos[p4][4]
 )
end

obj.setoption("drawtarget","framebuffer")
obj.load("tempbuffer")
