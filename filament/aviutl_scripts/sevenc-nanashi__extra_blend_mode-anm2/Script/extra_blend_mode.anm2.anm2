--information:extra_blend_mode.anm2 / https://github.com/sevenc-nanashi/extra_blend_mode.anm2
--label:色調整
--select@mode:合成モード=1,加算=1,減算=2,乗算=3,除算=4,スクリーン=5,オーバーレイ=6,オーバーレイ(gimp)=7,比較(明)=8,比較(暗)=9,色差=10,陰影(焼き込み(リニア))=11,明暗(リニアライト)=12,明暗(逆)=13,差分=14,除外=15,ネガ=16,反転=17,カラー比較(明)=18,カラー比較(暗)=19,覆い焼き(カラー)=20,覆い焼き(逆カラー)=21,覆い焼き(ソフト)=22,焼き込み(カラー)=23,焼き込み(逆カラー)=24,焼き込み(ソフト)=25,ハードライト=26,ソフトライト=27,ソフトライト(gimp)=28,ソフトライト(photoshop)=29,ビビッドライト=30,ビビッドライト(photoshop)=31,ピンライト=32,ピンライト(逆)=33,ピンライト(強)=34,ハードミックス=35,色相=36,色相(HSVL)=37,色相(δ)=38,カラー(明度)=39,カラー(輝度)=40,カラー(HSVL)=41,彩度(明度)=42,彩度(輝度)=43,彩度(HSVL)=44,明度=45,輝度=46,輝度(HSVL)=47,RED=48,GREEN=49,BLUE=50,YELLOW=51,AQUA=52,MAGENTA=53,相加平均=54,相乗平均=55,調和平均=56,反射=57,グロー=58,寒色=59,暖色=60,微粒取り出し=61,微粒結合=62,フェニックス=63,AND=64,OR=65,XOR=66,SHIFT=67,加算(unsigned)=68,減算(unsigned)=69,加算(RED)=70,加算(GREEN)=71,加算(BLUE)=72,加算(RED-GREEN)=73,加算(GREEN-BLUE)=74,加算(BLUE-RED)=75,二値化=76

--[[pixelshader@add:
#define ENTRY add
// label: 加算
float3 Blend(float3 s, float3 b) { return min(s + b, 255.0); }

Texture2D<float4> Source : register(t0);
Texture2D<float4> Background : register(t1);

float4 ENTRY(float4 pos : SV_Position) : SV_Target {
  int3 pixel = int3(pos.xy, 0);
  float4 source = Source.Load(pixel);
  float4 background = Background.Load(pixel);
  if (source.a <= 0.0)
    return background;
  if (background.a <= 0.0)
    return source;

  float3 s = saturate(source.rgb / source.a);
  float3 b = saturate(background.rgb / background.a);
  float overlap = source.a * background.a;
  float sourceOnly = source.a * (1.0 - background.a);
  float backgroundOnly = background.a * (1.0 - source.a);
  float3 mixed = saturate(Blend(s * 255.0, b * 255.0) / 255.0);
  // 非乗算の合成結果を、出力アルファで割らずに返す。
  return float4(s * sourceOnly + b * backgroundOnly + mixed * overlap,
                source.a + backgroundOnly);
}

]]

--[[pixelshader@subtract:
#define ENTRY subtract
// label: 減算
float3 Blend(float3 s, float3 b) { return max(b - s, 0.0); }

Texture2D<float4> Source : register(t0);
Texture2D<float4> Background : register(t1);

float4 ENTRY(float4 pos : SV_Position) : SV_Target {
  int3 pixel = int3(pos.xy, 0);
  float4 source = Source.Load(pixel);
  float4 background = Background.Load(pixel);
  if (source.a <= 0.0)
    return background;
  if (background.a <= 0.0)
    return source;

  float3 s = saturate(source.rgb / source.a);
  float3 b = saturate(background.rgb / background.a);
  float overlap = source.a * background.a;
  float sourceOnly = source.a * (1.0 - background.a);
  float backgroundOnly = background.a * (1.0 - source.a);
  float3 mixed = saturate(Blend(s * 255.0, b * 255.0) / 255.0);
  // 非乗算の合成結果を、出力アルファで割らずに返す。
  return float4(s * sourceOnly + b * backgroundOnly + mixed * overlap,
                source.a + backgroundOnly);
}

]]

--[[pixelshader@multiply:
#define ENTRY multiply
// label: 乗算
float3 Blend(float3 s, float3 b) { return s * b / 255.0; }

Texture2D<float4> Source : register(t0);
Texture2D<float4> Background : register(t1);

float4 ENTRY(float4 pos : SV_Position) : SV_Target {
  int3 pixel = int3(pos.xy, 0);
  float4 source = Source.Load(pixel);
  float4 background = Background.Load(pixel);
  if (source.a <= 0.0)
    return background;
  if (background.a <= 0.0)
    return source;

  float3 s = saturate(source.rgb / source.a);
  float3 b = saturate(background.rgb / background.a);
  float overlap = source.a * background.a;
  float sourceOnly = source.a * (1.0 - background.a);
  float backgroundOnly = background.a * (1.0 - source.a);
  float3 mixed = saturate(Blend(s * 255.0, b * 255.0) / 255.0);
  // 非乗算の合成結果を、出力アルファで割らずに返す。
  return float4(s * sourceOnly + b * backgroundOnly + mixed * overlap,
                source.a + backgroundOnly);
}

]]

--[[pixelshader@divide:
#define ENTRY divide
// label: 除算
float3 Blend(float3 s, float3 b) { return min(b * 256.0 / (s + 1.0), 255.0); }

Texture2D<float4> Source : register(t0);
Texture2D<float4> Background : register(t1);

float4 ENTRY(float4 pos : SV_Position) : SV_Target {
  int3 pixel = int3(pos.xy, 0);
  float4 source = Source.Load(pixel);
  float4 background = Background.Load(pixel);
  if (source.a <= 0.0)
    return background;
  if (background.a <= 0.0)
    return source;

  float3 s = saturate(source.rgb / source.a);
  float3 b = saturate(background.rgb / background.a);
  float overlap = source.a * background.a;
  float sourceOnly = source.a * (1.0 - background.a);
  float backgroundOnly = background.a * (1.0 - source.a);
  float3 mixed = saturate(Blend(s * 255.0, b * 255.0) / 255.0);
  // 非乗算の合成結果を、出力アルファで割らずに返す。
  return float4(s * sourceOnly + b * backgroundOnly + mixed * overlap,
                source.a + backgroundOnly);
}

]]

--[[pixelshader@screen:
#define ENTRY screen
// label: スクリーン
float3 Blend(float3 s, float3 b) {
  return 255.0 - (255.0 - s) * (255.0 - b) / 255.0;
}

Texture2D<float4> Source : register(t0);
Texture2D<float4> Background : register(t1);

float4 ENTRY(float4 pos : SV_Position) : SV_Target {
  int3 pixel = int3(pos.xy, 0);
  float4 source = Source.Load(pixel);
  float4 background = Background.Load(pixel);
  if (source.a <= 0.0)
    return background;
  if (background.a <= 0.0)
    return source;

  float3 s = saturate(source.rgb / source.a);
  float3 b = saturate(background.rgb / background.a);
  float overlap = source.a * background.a;
  float sourceOnly = source.a * (1.0 - background.a);
  float backgroundOnly = background.a * (1.0 - source.a);
  float3 mixed = saturate(Blend(s * 255.0, b * 255.0) / 255.0);
  // 非乗算の合成結果を、出力アルファで割らずに返す。
  return float4(s * sourceOnly + b * backgroundOnly + mixed * overlap,
                source.a + backgroundOnly);
}

]]

--[[pixelshader@overlay:
#define ENTRY overlay
// label: オーバーレイ
float BlendChannel(float s, float b) {
  return b < 128.0 ? 2.0 * s * b / 255.0
                   : 2.0 * (b + s - b * s / 255.0) - 255.0;
}

float3 Blend(float3 s, float3 b) {
  return float3(BlendChannel(s.r, b.r), BlendChannel(s.g, b.g),
                BlendChannel(s.b, b.b));
}

Texture2D<float4> Source : register(t0);
Texture2D<float4> Background : register(t1);

float4 ENTRY(float4 pos : SV_Position) : SV_Target {
  int3 pixel = int3(pos.xy, 0);
  float4 source = Source.Load(pixel);
  float4 background = Background.Load(pixel);
  if (source.a <= 0.0)
    return background;
  if (background.a <= 0.0)
    return source;

  float3 s = saturate(source.rgb / source.a);
  float3 b = saturate(background.rgb / background.a);
  float overlap = source.a * background.a;
  float sourceOnly = source.a * (1.0 - background.a);
  float backgroundOnly = background.a * (1.0 - source.a);
  float3 mixed = saturate(Blend(s * 255.0, b * 255.0) / 255.0);
  // 非乗算の合成結果を、出力アルファで割らずに返す。
  return float4(s * sourceOnly + b * backgroundOnly + mixed * overlap,
                source.a + backgroundOnly);
}

]]

--[[pixelshader@overlay_gimp:
#define ENTRY overlay_gimp
// label: オーバーレイ(gimp)
float3 Blend(float3 s, float3 b) {
  return b / 255.0 * (b + (255.0 - b) * (2.0 * s / 255.0));
}

Texture2D<float4> Source : register(t0);
Texture2D<float4> Background : register(t1);

float4 ENTRY(float4 pos : SV_Position) : SV_Target {
  int3 pixel = int3(pos.xy, 0);
  float4 source = Source.Load(pixel);
  float4 background = Background.Load(pixel);
  if (source.a <= 0.0)
    return background;
  if (background.a <= 0.0)
    return source;

  float3 s = saturate(source.rgb / source.a);
  float3 b = saturate(background.rgb / background.a);
  float overlap = source.a * background.a;
  float sourceOnly = source.a * (1.0 - background.a);
  float backgroundOnly = background.a * (1.0 - source.a);
  float3 mixed = saturate(Blend(s * 255.0, b * 255.0) / 255.0);
  // 非乗算の合成結果を、出力アルファで割らずに返す。
  return float4(s * sourceOnly + b * backgroundOnly + mixed * overlap,
                source.a + backgroundOnly);
}

]]

