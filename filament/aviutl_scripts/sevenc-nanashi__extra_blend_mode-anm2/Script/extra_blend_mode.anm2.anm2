  float overlap = source.a * background.a;
  float sourceOnly = source.a * (1.0 - background.a);
  float backgroundOnly = background.a * (1.0 - source.a);
  float3 mixed = saturate(Blend(s * 255.0, b * 255.0) / 255.0);
