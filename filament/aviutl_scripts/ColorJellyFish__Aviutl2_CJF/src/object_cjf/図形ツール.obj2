--information:図形ツール（幅/高さ指定・線幅固定） ver1.6
--label:CJF

--select@shape:図形,円=0,四角形=1,三角形=2,五角形=3,六角形=4
--track@w:幅(px),1,16384,200,1
--track@h:高さ(px),1,16384,200,1
--track@line:線幅(px),0,2000,10,1
--check@fill:塗りつぶし,true
--color@col:色,0xffffff

obj.load("figure", "四角形", 0xffffff, 1)
obj.setoption("culling", 0)

local function clamp(v,lo,hi) if v<lo then return lo elseif v>hi then return hi else return v end end
local r=(math.floor(col/0x10000)%0x100)/255.0
local g=(math.floor(col/0x100)%0x100)/255.0
local b=(col%0x100)/255.0
local bw=w
local bh=h
local rx=math.max(0.5,w/2.0-0.5)
local ry=math.max(0.5,h/2.0-0.5)
local t=clamp(line,0,math.floor(math.min(w,h)/2))

local function V(x,y) return {x,y,0,r,g,b,1.0} end
local function tri(a,x0,y0,x1,y1,x2,y2) table.insert(a,V(x0,y0));table.insert(a,V(x1,y1));table.insert(a,V(x2,y2)) end
local function quad(a,x0,y0,x1,y1,x2,y2,x3,y3) table.insert(a,V(x0,y0));table.insert(a,V(x1,y1));table.insert(a,V(x2,y2));table.insert(a,V(x3,y3)) end
local function poly(n,px,py,ang) local p={};local d=math.pi*2/n;for i=0,n-1 do local a=ang+i*d;p[i+1]={math.cos(a)*px,math.sin(a)*py} end;return p end
local function intersection(a,b,c,d) local dx1,dy1=b[1]-a[1],b[2]-a[2];local dx2,dy2=d[1]-c[1],d[2]-c[2];local det=dx1*dy2-dy1*dx2;if math.abs(det)<1e-8 then return {b[1],b[2]} end;local q=((c[1]-a[1])*dy2-(c[2]-a[2])*dx2)/det;return {a[1]+dx1*q,a[2]+dy1*q} end
local function inset(p,d) if d<=0 then return nil end;local cx,cy=0,0;for i=1,#p do cx=cx+p[i][1];cy=cy+p[i][2] end;cx,cy=cx/#p,cy/#p;local l={};for i=1,#p do local a=p[i];local z=p[i%#p+1];local dx,dy=z[1]-a[1],z[2]-a[2];local len=math.sqrt(dx*dx+dy*dy);if len<1e-8 then return nil end;local n1x,n1y=-dy/len,dx/len;local n2x,n2y=dy/len,-dx/len;local mx,my=(a[1]+z[1])/2,(a[2]+z[2])/2;local tx,ty=cx-mx,cy-my;local nx,ny;if n1x*tx+n1y*ty>n2x*tx+n2y*ty then nx,ny=n1x,n1y else nx,ny=n2x,n2y end;l[i]={a[1]+nx*d,a[2]+ny*d,z[1]+nx*d,z[2]+ny*d} end;local q={};for i=1,#p do local a=l[(i-2+#p)%#p+1];local z=l[i];q[i]=intersection({a[1],a[2]},{a[3],a[4]},{z[1],z[2]},{z[3],z[4]}) end;return q end
local function draw_fill(a,p) local cx,cy=0,0;for i=1,#p do cx=cx+p[i][1];cy=cy+p[i][2] end;cx,cy=cx/#p,cy/#p;for i=1,#p do local z=p[i%#p+1];local q=p[i];tri(a,cx,cy,q[1],q[2],z[1],z[2]) end end
local function stroke(a,p,d) if d<=0 then return end;local q=inset(p,d);if not q then return end;for i=1,#p do local j=i%#p+1;quad(a,p[i][1],p[i][2],p[j][1],p[j][2],q[j][1],q[j][2],q[i][1],q[i][2]) end end

obj.setoption("drawtarget","tempbuffer",bw,bh)
local fv,sv={},{}
if shape==0 then
 local n=clamp(math.floor(math.max(w,h)/4),24,512);local d=math.pi*2/n;local p={};for i=0,n-1 do local a=i*d;p[i+1]={math.cos(a)*rx,math.sin(a)*ry} end
 if fill then for i=1,n do local z=p[i%n+1];local q=p[i];tri(fv,0,0,q[1],q[2],z[1],z[2]) end end
 if t>0 then for i=1,n do local q,z=p[i],p[i%n+1];local nx0,ny0=q[1]/(rx*rx),q[2]/(ry*ry);local nx1,ny1=z[1]/(rx*rx),z[2]/(ry*ry);local l0=math.sqrt(nx0*nx0+ny0*ny0);local l1=math.sqrt(nx1*nx1+ny1*ny1);nx0,ny0=nx0/l0,ny0/l0;nx1,ny1=nx1/l1,ny1/l1;quad(sv,q[1],q[2],z[1],z[2],z[1]-nx1*t,z[2]-ny1*t,q[1]-nx0*t,q[2]-ny0*t) end end
elseif shape==1 then local p={{-rx,-ry},{rx,-ry},{rx,ry},{-rx,ry}};if fill then draw_fill(fv,p) end;stroke(sv,p,t)
elseif shape==2 then local p=poly(3,rx,ry,-math.pi/2);if fill then draw_fill(fv,p) end;stroke(sv,p,t)
elseif shape==3 then local p=poly(5,rx,ry,-math.pi/2);if fill then draw_fill(fv,p) end;stroke(sv,p,t)
elseif shape==4 then local p=poly(6,rx,ry,math.pi/6);if fill then draw_fill(fv,p) end;stroke(sv,p,t) end

if #fv>0 then obj.drawpoly(fv,3) end
if #sv>0 then obj.drawpoly(sv) end
obj.setoption("drawtarget","framebuffer")
obj.copybuffer("object","tempbuffer")
