--
-- v2.93
--

-- https://github.com/sigma-axis/aviutl2_script_Basic_S

@全体で時間制御
--information:全体で時間制御@Basic_S v2.93 by σ軸
--label:Basic_S
--require:2011200
--timecontrol
local i, t = require("Basic_S").track.curve.entire();
local v0, v1 = obj.getpoint(i), obj.getpoint(i + 1)
return v0 + (v1 - v0) * t;

@区間ごとに時間制御
--information:区間ごとに時間制御@Basic_S v2.93 by σ軸
--label:Basic_S
--require:2011200
--timecontrol
local i, t = require("Basic_S").track.curve.section();
local v0, v1 = obj.getpoint(i), obj.getpoint(i + 1)
return v0 + (v1 - v0) * t;

@全体で時間制御(回転)
--information:全体で時間制御(回転)@Basic_S v2.93 by σ軸
--label:Basic_S
--require:2011200
--param:1周角度,360
--timecontrol
local track = require("Basic_S").track;
local i, t = track.curve.entire();
return track.linear_rotation(i, t, obj.getpoint("param"));

@区間ごとに時間制御(回転)
--information:区間ごとに時間制御(回転)@Basic_S v2.93 by σ軸
--label:Basic_S
--require:2011200
--param:1周角度,360
--timecontrol
local track = require("Basic_S").track;
local i, t = track.curve.section();
return track.linear_rotation(i, t, obj.getpoint("param"));

@正弦波
--information:正弦波@Basic_S v2.93 by σ軸
--label:Basic_S\基本緩急
--require:2011200
--speed:0,1
local t, v0, v1 = require("Basic_S").track.ease_inout_core();
local rho = 1 - math.cos(math.pi / 2 * t);
return v0 + (v1 - v0) * rho;

@2次式
--information:2次式@Basic_S v2.93 by σ軸
--label:Basic_S\基本緩急
--require:2011200
--speed:0,1
local t, v0, v1 = require("Basic_S").track.ease_inout_core();
local rho = t ^ 2;
return v0 + (v1 - v0) * rho;

@3次式
--information:3次式@Basic_S v2.93 by σ軸
--label:Basic_S\基本緩急
--require:2011200
--speed:0,1
local t, v0, v1 = require("Basic_S").track.ease_inout_core();
local rho = t ^ 3;
return v0 + (v1 - v0) * rho;

@4次式
--information:4次式@Basic_S v2.93 by σ軸
--label:Basic_S\基本緩急
--require:2011200
--speed:0,1
local t, v0, v1 = require("Basic_S").track.ease_inout_core();
local rho = t ^ 4;
return v0 + (v1 - v0) * rho;

@N次式
--information:N次式@Basic_S v2.93 by σ軸
--label:Basic_S\基本緩急
--require:2011200
--speed:0,1
--param:次数N,5
local t, v0, v1 = require("Basic_S").track.ease_inout_core();

local N = math.max(obj.getpoint("param"), 0);
local rho = (N > 0 or t > 0) and t ^ N or 0;

return v0 + (v1 - v0) * rho;

@指数関数
--information:指数関数@Basic_S v2.93 by σ軸
--label:Basic_S\基本緩急
--require:2011200
--speed:0,1
--param:減衰率,2
local t, v0, v1 = require("Basic_S").track.ease_inout_core();

local a = math.max(obj.getpoint("param"), 0);
local rho = a > 0 and (math.exp(a * t) - 1) / (math.exp(a) - 1) or t;

return v0 + (v1 - v0) * rho;

@円形
--information:円形@Basic_S v2.93 by σ軸
--label:Basic_S\基本緩急
--require:2011200
--speed:0,1
local t, v0, v1 = require("Basic_S").track.ease_inout_core();
local rho = 1 - (1 - t ^ 2) ^ 0.5;
return v0 + (v1 - v0) * rho;

@等速移動
--information:等速移動@Basic_S v2.93 by σ軸
--label:Basic_S
--require:2011200
--twopoint
--param:単位/select/秒=0/フレーム=1,0
--param:単位時間,1
--param:起点/select/始点=0/終点=1,0
local fr, mode, T, origin = obj.getpoint("framerate"), obj.getpoint("param");
local t, v0, v1 = obj.getpoint("time"), obj.getpoint(0), obj.getpoint(1);
T = math.abs(T); if T == 0 then T = 1 end
if origin == 1 then t, v0, v1 = obj.getpoint("time", 1) - t, v1, v0 end
if mode == 1 then t = fr * t end
return v0 + (v1 - v0) * t / T;

@等速移動(秒)
-- 非推奨化に伴い，このスクリプトは更新凍結 / information も固定．
--hidemenu
--information:等速移動(秒)@Basic_S v2.71 by σ軸
--label:Basic_S\非推奨
--require:2005400
--twopoint
--param:単位時間(秒),1
local t, T, v0, v1 = obj.getpoint("time"), obj.getpoint("param"), obj.getpoint(0), obj.getpoint(1);
if 1 / T < 0 then t, T, v0, v1 = obj.getpoint("time", 1) - t, -T, v1, v0 end
if T == 0 then T = 1 end
return v0 + (v1 - v0) * t / T;

@等速移動(フレーム)
-- 非推奨化に伴い，このスクリプトは更新凍結 / information も固定．
--hidemenu
--information:等速移動(フレーム)@Basic_S v2.71 by σ軸
--label:Basic_S\非推奨
--require:2005400
--twopoint
--param:単位時間(フレーム),60
local fr = obj.getpoint("framerate");
local f, F, v0, v1 = fr * obj.getpoint("time"), obj.getpoint("param"), obj.getpoint(0), obj.getpoint(1);
if 1 / F < 0 then f, F, v0, v1 = fr * obj.getpoint("time", 1) - f, -F, v1, v0 end
if F == 0 then F = 1 end
return v0 + (v1 - v0) * f / F;

@コマ落ち反復
--information:コマ落ち反復@Basic_S v2.93 by σ軸
--label:Basic_S\コマ落ち
--require:2011200
--twopoint
--param:周期の単位/select/秒=0/フレーム=1/Hz=2/回数=3/BPM=4/BPMグリッド(拍数線)=5/BPMグリッド(小節線)=6,0
--param:周期,0.5
--param:周期(倍率),1
--param:周期(分母),1
--param:周期ずれ%,0
--param:周期の起点/select/始点=0/終点=1/始点近くのグリッド(BPMグリッド)=2/終点近くのグリッド(BPMグリッド)=3,0
--param:デューティ比%,50
local track = require("Basic_S").track;
return track.discrete_repeat(track.period.select(obj.getpoint("param")));

@コマ落ち反復(秒)
-- 非推奨化に伴い，このスクリプトは更新凍結 / information も固定．
