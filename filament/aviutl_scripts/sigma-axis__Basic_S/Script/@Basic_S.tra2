--param:周期(BPM),120
--param:周期ずれ%,0
--timecontrol
local track = require("Basic_S").track;
return track.curve_backforth(track.period.bpm(obj.getpoint("param")));

@時間制御繰り返し往復(BPMグリッド)
-- 非推奨化に伴い，このスクリプトは更新凍結 / information も固定．
--hidemenu
--information:時間制御繰り返し往復(BPMグリッド)@Basic_S v2.71 by σ軸
--label:Basic_S\非推奨
--require:2005400
--twopoint
--param:周期(音符数),1
--param:基準のN分音符(0:小節),4
--param:グリッド1拍のN分音符,4
--param:周期ずれ%,0
--timecontrol
local track = require("Basic_S").track;
return track.curve_backforth(track.period.bpmgrid(obj.getpoint("param")));

@時間制御繰り返し往復(回数)
-- 非推奨化に伴い，このスクリプトは更新凍結 / information も固定．
--hidemenu
--information:時間制御繰り返し往復(回数)@Basic_S v2.71 by σ軸
--label:Basic_S\非推奨
--require:2005400
--twopoint
--param:周期(回数),8
--param:周期ずれ%,0
--timecontrol
local track = require("Basic_S").track;
return track.curve_backforth(track.period.count(obj.getpoint("param")));

@対数補間
--information:対数補間@Basic_S v2.93 by σ軸
--label:Basic_S\特殊補間
--require:2011200
--param:原点,0
--timecontrol
local track = require("Basic_S").track;
local i, t = track.curve.section();
return track.logarithmic(t, obj.getpoint(i), obj.getpoint(i + 1), obj.getpoint("param"));

@対数補間(全体時間制御)
--information:対数補間(全体時間制御)@Basic_S v2.93 by σ軸
--label:Basic_S\特殊補間
--require:2011200
--param:原点,0
--timecontrol
local track = require("Basic_S").track;
local i, t = track.curve.entire();
return track.logarithmic(t, obj.getpoint(i), obj.getpoint(i + 1), obj.getpoint("param"));

