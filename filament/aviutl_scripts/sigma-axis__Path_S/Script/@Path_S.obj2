--select@join_shape:線結合の形状=0,ラウンド=0,ベベル=1,マイター=2,ブランク=3,ブランク+ラウンド=4,ブランク+ベベル=5
--track@miter_limit:マイター限界,100,3200,400,0.001,,0.25
