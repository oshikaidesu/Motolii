@絶対時間指定（フレーム指定）
--label:@time_control_assistant.tra2
--timecontrol
--param:開始位置[f],0
--param:終了位置[f],60

local obj_getpoint = obj.getpoint
local core = require("time_control_assistant")
local start_frame, end_frame = obj_getpoint("param")

return core.do_absolute(obj_getpoint, start_frame - 1, end_frame - 1)

@絶対時間指定（秒数指定）
--label:@time_control_assistant.tra2
--timecontrol
--param:開始位置[秒],0
--param:終了位置[秒],1

local obj_getpoint = obj.getpoint
local core = require("time_control_assistant")
local start_time, end_time = obj_getpoint("param")

return core.do_absolute(obj_getpoint, start_time * obj_getpoint("framerate"), end_time * obj_getpoint("framerate"))

@相対時間指定（フレーム指定）
--label:@time_control_assistant.tra2
--timecontrol
--param:開始位置シフト[f],0
--param:終了位置シフト[f],0

local obj_getpoint = obj.getpoint
local core = require("time_control_assistant")
local start_frame_shift, end_frame_shift = obj_getpoint("param")
local obj_start_frame = obj_getpoint("frame_s")
local obj_end_frame = obj_getpoint("frame_e")

return core.do_absolute(obj_getpoint, obj_start_frame + start_frame_shift, obj_end_frame + end_frame_shift)

@相対時間指定（秒数指定）
--label:@time_control_assistant.tra2
--timecontrol
--param:開始位置シフト[秒],0
--param:終了位置シフト[秒],1

local obj_getpoint = obj.getpoint
local core = require("time_control_assistant")
local start_time_shift, end_time_shift = obj_getpoint("param")
local obj_start_frame = obj_getpoint("frame_s")
local obj_end_frame = obj_getpoint("frame_e")
local framerate = obj_getpoint("framerate")

return core.do_absolute(obj_getpoint, obj_start_frame + start_time_shift * framerate,
  obj_end_frame + end_time_shift * framerate)

