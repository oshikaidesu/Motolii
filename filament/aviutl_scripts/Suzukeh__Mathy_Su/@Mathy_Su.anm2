@対数螺旋
--infomation:Mathy_Su v1.0.0 by Suzuke
--label:配置\Mathy_Su
--track@a:初期半径,0,10000,100,0.01
--track@b:拡大係数,-10000,10000,0.1,0.01
--track@rev:回転数,0,10000,5,0.01,,0.1
--track@off:開始角度,-36000,36000,0,0.01
--select@mode:モード,位置置換=0,線上に配置=1
--track@pos:配置位置,0,10000,10000,0.01,,0.1
--track@shift:シフト,0,10000,0,0.01,,0.1
--track@zs:Z始点,-10000,10000,0,0.01
--track@ze:Z終点,-10000,10000,0,0.01
--track@alpha:元画像透明度,0,100,100,0.01
--track@l_alpha:線透明度,0,100,0,0.01
--track@l_len:線描画比率,0,100,100,0.01
--track@l_ref:描画基準点,0,10000,100,0.01,,0.1
--color@col:線色,0xffffff
--track@width:線幅,0,1000,2,0.01
--track@res:分割数,1,10000,200,1
--track@rot:回転合わせ,0,100,100,0.01
--track@rep_num:個数,0,1000,0,1
--track@rep_dist:間隔,0,10000,10,0.01,,0.1
--track@rep_alpha:透明度変化,-100,100,0,0.01
--color@rep_col:終了色,0xffffff
--check@help:Help,0
--value@PI:PI,{}

if help == 1 then
    local text = [[
[対数螺旋 / Logarithmic Spiral (配置)]
式: r = a * exp(b * theta)
一定の角度で広がる螺旋です。
PI: {a, b, rev, off, mode, pos, shift, zs, ze, alpha, l_alpha, l_len, l_ref, col, width, res, rot, rep_num, rep_dist, rep_alpha, rep_col}
]]
    obj.load("text", text)
    obj.draw()
    return
end

local a, b, rev, off, mode = (PI and tonumber(PI.a)) or a, (PI and tonumber(PI.b)) or b, (PI and tonumber(PI.rev)) or rev, (PI and tonumber(PI.off)) or off, (PI and tonumber(PI.mode)) or mode
local p, ps = ((PI and tonumber(PI.pos)) or pos) / 100, ((PI and tonumber(PI.shift)) or shift) / 100
local zs, ze, alpha, l_alpha = (PI and tonumber(PI.zs)) or zs, (PI and tonumber(PI.ze)) or ze, (PI and tonumber(PI.alpha)) or alpha, (PI and tonumber(PI.l_alpha)) or l_alpha
local l_len, l_ref, col, width = (PI and tonumber(PI.l_len)) or l_len, (PI and tonumber(PI.l_ref)) or l_ref, (PI and tonumber(PI.col)) or col, (PI and tonumber(PI.width)) or width
local res, rot, rep_num, rep_dist, rep_alpha, rep_col = (PI and tonumber(PI.res)) or res, (PI and tonumber(PI.rot)) or rot, (PI and tonumber(PI.rep_num)) or rep_num, (PI and tonumber(PI.rep_dist)) or rep_dist, (PI and tonumber(PI.rep_alpha)) or rep_alpha, (PI and tonumber(PI.rep_col)) or rep_col

local mw, mh = obj.screen_w, obj.screen_h
obj.setoption("drawtarget", "tempbuffer", mw, mh)
local max_theta = rev * 2 * math.pi; local offset = off * math.pi / 180

local function get_p(p_val)
    local t = p_val * max_theta; local r = a * math.exp(b * t)
    local x, y = r * math.cos(t + offset), r * math.sin(t + offset)
    local angle = (t + math.atan2(1, b) + offset) * 180 / math.pi
    return x, y, zs + (ze - zs) * p_val, angle
end

local x0, y0, z0 = get_p(ps)

if l_alpha > 0 then
    local r_c, g_c, b_c = math.floor(col/0x10000)%0x100/255, math.floor(col/0x100)%0x100/255, col%0x100/255
    local vertices = {}
    local t_end, t_start = p * (l_ref / 100), p * (l_ref / 100) * (1 - l_len / 100)
    for i = 0, res - 1 do
        local p1, p2 = t_start + (t_end - t_start) * (i / res), t_start + (t_end - t_start) * ((i + 1) / res)
        local vx1, vy1, vz1 = get_p(p1 + ps); local vx2, vy2, vz2 = get_p(p2 + ps)
        if mode == 1 then vx1, vy1, vz1 = vx1 - x0, vy1 - y0, vz1 - z0; vx2, vy2, vz2 = vx2 - x0, vy2 - y0, vz2 - z0 end
        local dx, dy = vx2 - vx1, vy2 - vy1; local len = math.sqrt(dx*dx + dy*dy)
        if len > 0 then
            local nx, ny = -dy/len*width/2, dx/len*width/2
            table.insert(vertices, {vx1-nx, vy1-ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx1+nx, vy1+ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2+nx, vy2+ny, vz2, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2-nx, vy2-ny, vz2, r_c, g_c, b_c, l_alpha/100})
        end
    end
    obj.drawpoly(vertices)
end

local function draw_inst(p_val, a_mul, col_mul)
    local vx, vy, vz, angle = get_p(p_val + ps)
    local dx, dy, dz = (mode == 1) and (vx - x0) or vx, (mode == 1) and (vy - y0) or vy, (mode == 1) and (vz - z0) or vz
    local sox, soy, soz, srz, sal = obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha
    obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox + dx, soy + dy, soz + dz, srz + angle * (rot / 100), sal * (alpha / 100) * a_mul
    if col_mul > 0 then
        local r1, g1, b1 = 255, 255, 255; local r2, g2, b2 = math.floor(rep_col/0x10000)%0x100, math.floor(rep_col/0x100)%0x100, rep_col%0x100
        obj.color(r1 + (r2-r1)*col_mul, g1 + (g2-g1)*col_mul, b1 + (b2-b1)*col_mul)
    end
    obj.draw(); obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox, soy, soz, srz, sal
end

if alpha > 0 then
    draw_inst(p, 1.0, 0)
    for i = 1, rep_num do draw_inst(p - i * (rep_dist / 100), math.max(0, 1 + i * (rep_alpha / 100)), math.min(1, i / rep_num)) end
end
obj.copybuffer("obj", "tempbuffer")

@アルキメデスの螺旋
--infomation:Mathy_Su v1.0.0 by Suzuke
--label:配置\Mathy_Su
--track@a:拡大率,0,10000,10,0.01
--track@rev:回転数,0,10000,5,0.01,,0.1
--track@off:開始角度,-36000,36000,0,0.01
--select@mode:モード,位置置換=0,線上に配置=1
--track@pos:配置位置,0,10000,10000,0.01,,0.1
--track@shift:シフト,0,10000,0,0.01,,0.1
--track@zs:Z始点,-10000,10000,0,0.01
--track@ze:Z終点,-10000,10000,0,0.01
--track@alpha:元画像透明度,0,100,100,0.01
--track@l_alpha:線透明度,0,100,0,0.01
--track@l_len:線描画比率,0,100,100,0.01
--track@l_ref:描画基準点,0,10000,100,0.01,,0.1
--color@col:線色,0xffffff
--track@width:線幅,0,1000,2,0.01
--track@res:分割数,1,10000,200,1
--track@rot:回転合わせ,0,100,100,0.01
--track@rep_num:個数,0,1000,0,1
--track@rep_dist:間隔,0,10000,10,0.01,,0.1
--track@rep_alpha:透明度変化,-100,100,0,0.01
--color@rep_col:終了色,0xffffff
--check@help:Help,0
--value@PI:PI,{}

if help == 1 then
    local text = [[
[アルキメデスの螺旋 / Archimedean Spiral (配置)]
式: r = a * theta
等間隔に広がる螺旋です。
PI: {a, rev, off, mode, pos, shift, zs, ze, alpha, l_alpha, l_len, l_ref, col, width, res, rot, rep_num, rep_dist, rep_alpha, rep_col}
]]
    obj.load("text", text)
    obj.draw()
    return
end

local a, rev, off, mode = (PI and tonumber(PI.a)) or a, (PI and tonumber(PI.rev)) or rev, (PI and tonumber(PI.off)) or off, (PI and tonumber(PI.mode)) or mode
local p, ps = ((PI and tonumber(PI.pos)) or pos) / 100, ((PI and tonumber(PI.shift)) or shift) / 100
local zs, ze, alpha, l_alpha = (PI and tonumber(PI.zs)) or zs, (PI and tonumber(PI.ze)) or ze, (PI and tonumber(PI.alpha)) or alpha, (PI and tonumber(PI.l_alpha)) or l_alpha
local l_len, l_ref, col, width = (PI and tonumber(PI.l_len)) or l_len, (PI and tonumber(PI.l_ref)) or l_ref, (PI and tonumber(PI.col)) or col, (PI and tonumber(PI.width)) or width
local res, rot, rep_num, rep_dist, rep_alpha, rep_col = (PI and tonumber(PI.res)) or res, (PI and tonumber(PI.rot)) or rot, (PI and tonumber(PI.rep_num)) or rep_num, (PI and tonumber(PI.rep_dist)) or rep_dist, (PI and tonumber(PI.rep_alpha)) or rep_alpha, (PI and tonumber(PI.rep_col)) or rep_col

local mw, mh = obj.screen_w, obj.screen_h
obj.setoption("drawtarget", "tempbuffer", mw, mh)
local max_theta = rev * 2 * math.pi; local offset = off * math.pi / 180

local function get_p(p_val)
    local t = p_val * max_theta; local r = a * t
    local x, y = r * math.cos(t + offset), r * math.sin(t + offset)
    local z = zs + (ze - zs) * p_val
    local dx, dy = a * (math.cos(t + offset) - t * math.sin(t + offset)), a * (math.sin(t + offset) + t * math.cos(t + offset))
    return x, y, z, math.atan2(dy, dx) * 180 / math.pi
end

local x0, y0, z0 = get_p(ps)

if l_alpha > 0 then
    local r_c, g_c, b_c = math.floor(col/0x10000)%0x100/255, math.floor(col/0x100)%0x100/255, col%0x100/255
    local vertices = {}
    local t_end, t_start = p * (l_ref / 100), p * (l_ref / 100) * (1 - l_len / 100)
    for i = 0, res - 1 do
        local p1, p2 = t_start + (t_end - t_start) * (i / res), t_start + (t_end - t_start) * ((i + 1) / res)
        local vx1, vy1, vz1 = get_p(p1 + ps); local vx2, vy2, vz2 = get_p(p2 + ps)
        if mode == 1 then vx1, vy1, vz1 = vx1 - x0, vy1 - y0, vz1 - z0; vx2, vy2, vz2 = vx2 - x0, vy2 - y0, vz2 - z0 end
        local dx, dy = vx2 - vx1, vy2 - vy1; local len = math.sqrt(dx*dx + dy*dy)
        if len > 0 then
            local nx, ny = -dy/len*width/2, dx/len*width/2
            table.insert(vertices, {vx1-nx, vy1-ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx1+nx, vy1+ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2+nx, vy2+ny, vz2, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2-nx, vy2-ny, vz2, r_c, g_c, b_c, l_alpha/100})
        end
    end
    obj.drawpoly(vertices)
end

local function draw_inst(p_val, a_mul, col_mul)
    local vx, vy, vz, angle = get_p(p_val + ps)
    local dx, dy, dz = (mode == 1) and (vx - x0) or vx, (mode == 1) and (vy - y0) or vy, (mode == 1) and (vz - z0) or vz
    local sox, soy, soz, srz, sal = obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha
    obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox + dx, soy + dy, soz + dz, srz + angle * (rot / 100), sal * (alpha / 100) * a_mul
    if col_mul > 0 then
        local r1, g1, b1 = 255, 255, 255; local r2, g2, b2 = math.floor(rep_col/0x10000)%0x100, math.floor(rep_col/0x100)%0x100, rep_col%0x100
        obj.color(r1 + (r2-r1)*col_mul, g1 + (g2-g1)*col_mul, b1 + (b2-b1)*col_mul)
    end
    obj.draw(); obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox, soy, soz, srz, sal
end

if alpha > 0 then
    draw_inst(p, 1.0, 0)
    for i = 1, rep_num do draw_inst(p - i * (rep_dist / 100), math.max(0, 1 + i * (rep_alpha / 100)), math.min(1, i / rep_num)) end
end
obj.copybuffer("obj", "tempbuffer")

@フェルマーの螺旋
--infomation:Mathy_Su v1.0.0 by Suzuke
--label:配置\Mathy_Su
--track@a:拡大率,0,10000,100,0.01
--track@rev:回転数,0,10000,3,0.01,,0.1
--select@mode:モード,位置置換=0,線上に配置=1
--track@pos:配置位置,0,10000,10000,0.01,,0.1
--track@shift:シフト,0,10000,0,0.01,,0.1
--track@zs:Z始点,-10000,10000,0,0.01
--track@ze:Z終点,-10000,10000,0,0.01
--track@alpha:元画像透明度,0,100,100,0.01
--track@l_alpha:線透明度,0,100,0,0.01
--track@l_len:線描画比率,0,100,100,0.01
--track@l_ref:描画基準点,0,10000,100,0.01,,0.1
--color@col:線色,0xffffff
--track@width:線幅,0,1000,2,0.01
--track@res:分割数,1,10000,200,1
--track@rot:回転合わせ,0,100,100,0.01
--track@rep_num:個数,0,1000,0,1
--track@rep_dist:間隔,0,10000,10,0.01,,0.1
--track@rep_alpha:透明度変化,-100,100,0,0.01
--color@rep_col:終了色,0xffffff
--check@help:Help,0
--value@PI:PI,{}

if help == 1 then
    local text = [[
[フェルマーの螺旋 / Fermat's Spiral (配置)]
式: r = a * sqrt(theta)
放物螺旋とも呼ばれます。
a: 拡大率, rev: 回転数

[共通パラメータ]
(Helpを参照)

PI: {a, rev, mode, pos, shift, zs, ze, alpha, l_alpha, l_len, l_ref, col, width, res, rot, rep_num, rep_dist, rep_alpha, rep_col}
]]
    obj.load("text", text)
    obj.draw()
    return
end

local a, rev, mode = (PI and tonumber(PI.a)) or a, (PI and tonumber(PI.rev)) or rev, (PI and tonumber(PI.mode)) or mode
local p, ps = ((PI and tonumber(PI.pos)) or pos) / 100, ((PI and tonumber(PI.shift)) or shift) / 100
local zs, ze, alpha, l_alpha = (PI and tonumber(PI.zs)) or zs, (PI and tonumber(PI.ze)) or ze, (PI and tonumber(PI.alpha)) or alpha, (PI and tonumber(PI.l_alpha)) or l_alpha
local l_len, l_ref, col, width = (PI and tonumber(PI.l_len)) or l_len, (PI and tonumber(PI.l_ref)) or l_ref, (PI and tonumber(PI.col)) or col, (PI and tonumber(PI.width)) or width
local res, rot, rep_num, rep_dist, rep_alpha, rep_col = (PI and tonumber(PI.res)) or res, (PI and tonumber(PI.rot)) or rot, (PI and tonumber(PI.rep_num)) or rep_num, (PI and tonumber(PI.rep_dist)) or rep_dist, (PI and tonumber(PI.rep_alpha)) or rep_alpha, (PI and tonumber(PI.rep_col)) or rep_col

local mw, mh = obj.screen_w, obj.screen_h
obj.setoption("drawtarget", "tempbuffer", mw, mh)
local max_t = rev * 2 * math.pi

local function get_p(p_val)
    local t = p_val * max_t
    local r = a * math.sqrt(t)
    local x, y = r * math.cos(t), r * math.sin(t)
    local z = zs + (ze - zs) * p_val
    local dx, dy = (a/(2*math.sqrt(t)))*math.cos(t) - r*math.sin(t), (a/(2*math.sqrt(t)))*math.sin(t) + r*math.cos(t)
    if t == 0 then dx, dy = 1, 0 end
    return x, y, z, math.atan2(dy, dx) * 180 / math.pi
end

local x0, y0, z0 = get_p(ps)

if l_alpha > 0 then
    local r_c, g_c, b_c = math.floor(col/0x10000)%0x100/255, math.floor(col/0x100)%0x100/255, col%0x100/255
    local vertices = {}
    local t_end, t_start = p * (l_ref / 100), p * (l_ref / 100) * (1 - l_len / 100)
    for i = 0, res - 1 do
        local p1, p2 = t_start + (t_end - t_start) * (i / res), t_start + (t_end - t_start) * ((i + 1) / res)
        local vx1, vy1, vz1 = get_p(p1 + ps); local vx2, vy2, vz2 = get_p(p2 + ps)
        if mode == 1 then vx1, vy1, vz1 = vx1-x0, vy1-y0, vz1-z0; vx2, vy2, vz2 = vx2-x0, vy2-y0, vz2-z0 end
        local dx, dy = vx2-vx1, vy2-vy1; local len = math.sqrt(dx*dx+dy*dy)
        if len > 0 then
            local nx, ny = -dy/len*width/2, dx/len*width/2
            table.insert(vertices, {vx1-nx, vy1-ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx1+nx, vy1+ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2+nx, vy2+ny, vz2, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2-nx, vy2-ny, vz2, r_c, g_c, b_c, l_alpha/100})
        end
    end
    obj.drawpoly(vertices)
end

local function draw_inst(p_val, a_mul, col_mul)
    local vx, vy, vz, angle = get_p(p_val + ps)
    local dx, dy, dz = (mode == 1) and (vx - x0) or vx, (mode == 1) and (vy - y0) or vy, (mode == 1) and (vz - z0) or vz
    local sox, soy, soz, srz, sal = obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha
    obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox + dx, soy + dy, soz + dz, srz + angle * (rot / 100), sal * (alpha / 100) * a_mul
    if col_mul > 0 then
        local r1, g1, b1 = 255, 255, 255; local r2, g2, b2 = math.floor(rep_col/0x10000)%0x100, math.floor(rep_col/0x100)%0x100, rep_col%0x100
        obj.color(r1 + (r2-r1)*col_mul, g1 + (g2-g1)*col_mul, b1 + (b2-b1)*col_mul)
    end
    obj.draw(); obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox, soy, soz, srz, sal
end
if alpha > 0 then
    draw_inst(p, 1.0, 0)
    for i = 1, rep_num do draw_inst(p - i * (rep_dist / 100), math.max(0, 1 + i * (rep_alpha / 100)), math.min(1, i / rep_num)) end
end
obj.copybuffer("obj", "tempbuffer")

@双曲螺旋
--infomation:Mathy_Su v1.0.0 by Suzuke
--label:配置\Mathy_Su
--track@a:係数,0,10000,1000,0.01
--track@rev:回転数,0,10000,3,0.01,,0.1
--select@mode:モード,位置置換=0,線上に配置=1
--track@pos:配置位置,0,10000,10000,0.01,,0.1
--track@shift:シフト,0,10000,0,0.01,,0.1
--track@zs:Z始点,-10000,10000,0,0.01
--track@ze:Z終点,-10000,10000,0,0.01
--track@alpha:元画像透明度,0,100,100,0.01
--track@l_alpha:線透明度,0,100,0,0.01
--track@l_len:線描画比率,0,100,100,0.01
--track@l_ref:描画基準点,0,10000,100,0.01,,0.1
--color@col:線色,0xffffff
--track@width:線幅,0,1000,2,0.01
--track@res:分割数,1,10000,200,1
--track@rot:回転合わせ,0,100,100,0.01
--track@rep_num:個数,0,1000,0,1
--track@rep_dist:間隔,0,10000,10,0.01,,0.1
--track@rep_alpha:透明度変化,-100,100,0,0.01
--color@rep_col:終了色,0xffffff
--check@help:Help,0
--value@PI:PI,{}

if help == 1 then
    local text = [[
[双曲螺旋 / Hyperbolic Spiral (配置)]
式: r = a / theta
中心に向かって無限に巻き付く螺旋です。
a: 係数, rev: 回転数

[共通パラメータ]
(Helpを参照)

PI: {a, rev, mode, pos, shift, zs, ze, alpha, l_alpha, l_len, l_ref, col, width, res, rot, rep_num, rep_dist, rep_alpha, rep_col}
]]
    obj.load("text", text)
    obj.draw()
    return
end

local a, rev, mode = (PI and tonumber(PI.a)) or a, (PI and tonumber(PI.rev)) or rev, (PI and tonumber(PI.mode)) or mode
local p, ps = ((PI and tonumber(PI.pos)) or pos) / 100, ((PI and tonumber(PI.shift)) or shift) / 100
local zs, ze, alpha, l_alpha = (PI and tonumber(PI.zs)) or zs, (PI and tonumber(PI.ze)) or ze, (PI and tonumber(PI.alpha)) or alpha, (PI and tonumber(PI.l_alpha)) or l_alpha
local l_len, l_ref, col, width = (PI and tonumber(PI.l_len)) or l_len, (PI and tonumber(PI.l_ref)) or l_ref, (PI and tonumber(PI.col)) or col, (PI and tonumber(PI.width)) or width
local res, rot, rep_num, rep_dist, rep_alpha, rep_col = (PI and tonumber(PI.res)) or res, (PI and tonumber(PI.rot)) or rot, (PI and tonumber(PI.rep_num)) or rep_num, (PI and tonumber(PI.rep_dist)) or rep_dist, (PI and tonumber(PI.rep_alpha)) or rep_alpha, (PI and tonumber(PI.rep_col)) or rep_col

local mw, mh = obj.screen_w, obj.screen_h
obj.setoption("drawtarget", "tempbuffer", mw, mh)
local max_t = rev * 2 * math.pi

local function get_p(p_val)
    local t = p_val * max_t; if t < 0.001 then t = 0.001 end
    local r = a / t
    local x, y = r * math.cos(t), r * math.sin(t)
    local z = zs + (ze - zs) * p_val
    local dr = -a / (t * t)
    local dx, dy = dr*math.cos(t) - r*math.sin(t), dr*math.sin(t) + r*math.cos(t)
    return x, y, z, math.atan2(dy, dx) * 180 / math.pi
end

local x0, y0, z0 = get_p(ps)

if l_alpha > 0 then
    local r_c, g_c, b_c = math.floor(col/0x10000)%0x100/255, math.floor(col/0x100)%0x100/255, col%0x100/255
    local vertices = {}
    local t_end, t_start = p * (l_ref / 100), p * (l_ref / 100) * (1 - l_len / 100)
    for i = 0, res - 1 do
        local p1, p2 = t_start + (t_end - t_start) * (i / res), t_start + (t_end - t_start) * ((i + 1) / res)
        local vx1, vy1, vz1 = get_p(p1 + ps); local vx2, vy2, vz2 = get_p(p2 + ps)
        if mode == 1 then vx1, vy1, vz1 = vx1-x0, vy1-y0, vz1-z0; vx2, vy2, vz2 = vx2-x0, vy2-y0, vz2-z0 end
        local dx, dy = vx2-vx1, vy2-vy1; local len = math.sqrt(dx*dx+dy*dy)
        if len > 0 then
            local nx, ny = -dy/len*width/2, dx/len*width/2
            table.insert(vertices, {vx1-nx, vy1-ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx1+nx, vy1+ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2+nx, vy2+ny, vz2, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2-nx, vy2-ny, vz2, r_c, g_c, b_c, l_alpha/100})
        end
    end
    obj.drawpoly(vertices)
end

local function draw_inst(p_val, a_mul, col_mul)
    local vx, vy, vz, angle = get_p(p_val + ps)
    local dx, dy, dz = (mode == 1) and (vx - x0) or vx, (mode == 1) and (vy - y0) or vy, (mode == 1) and (vz - z0) or vz
    local sox, soy, soz, srz, sal = obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha
    obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox + dx, soy + dy, soz + dz, srz + angle * (rot / 100), sal * (alpha / 100) * a_mul
    if col_mul > 0 then
        local r1, g1, b1 = 255, 255, 255; local r2, g2, b2 = math.floor(rep_col/0x10000)%0x100, math.floor(rep_col/0x100)%0x100, rep_col%0x100
        obj.color(r1 + (r2-r1)*col_mul, g1 + (g2-g1)*col_mul, b1 + (b2-b1)*col_mul)
    end
    obj.draw(); obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox, soy, soz, srz, sal
end
if alpha > 0 then
    draw_inst(p, 1.0, 0)
    for i = 1, rep_num do draw_inst(p - i * (rep_dist / 100), math.max(0, 1 + i * (rep_alpha / 100)), math.min(1, i / rep_num)) end
end
obj.copybuffer("obj", "tempbuffer")

@クロソイド曲線
--infomation:Mathy_Su v1.0.0 by Suzuke
--label:配置\Mathy_Su
--track@a:係数,0,10000,100,0.01
--track@len:長さ,0,10000,500,0.01
--select@mode:モード,位置置換=0,線上に配置=1
--track@pos:配置位置,0,10000,10000,0.01,,0.1
--track@shift:シフト,0,10000,0,0.01,,0.1
--track@zs:Z始点,-10000,10000,0,0.01
--track@ze:Z終点,-10000,10000,0,0.01
--track@alpha:元画像透明度,0,100,100,0.01
--track@l_alpha:線透明度,0,100,0,0.01
--track@l_len:線描画比率,0,100,100,0.01
--track@l_ref:描画基準点,0,10000,100,0.01,,0.1
--color@col:線色,0xffffff
--track@width:線幅,0,1000,2,0.01
--track@res:分割数,1,10000,200,1
--track@rot:回転合わせ,0,100,100,0.01
--track@rep_num:個数,0,1000,0,1
--track@rep_dist:間隔,0,10000,10,0.01,,0.1
--track@rep_alpha:透明度変化,-100,100,0,0.01
--color@rep_col:終了色,0xffffff
--check@help:Help,0
--value@PI:PI,{}

if help == 1 then
    local text = [[
[クロソイド曲線 / Clothoid (配置)]
曲率が長さに比例する曲線です。
a: 係数, len: 全体の長さ
[共通パラメータ]
(Helpを参照)
PI: {a, len, mode, pos, shift, zs, ze, alpha, l_alpha, l_len, l_ref, col, width, res, rot, rep_num, rep_dist, rep_alpha, rep_col}
]]
    obj.load("text", text)
    obj.draw()
    return
end

local a, L, mode = (PI and tonumber(PI.a)) or a, (PI and tonumber(PI.len)) or len, (PI and tonumber(PI.mode)) or mode
local p, ps = ((PI and tonumber(PI.pos)) or pos) / 100, ((PI and tonumber(PI.shift)) or shift) / 100
local zs, ze, alpha, l_alpha = (PI and tonumber(PI.zs)) or zs, (PI and tonumber(PI.ze)) or ze, (PI and tonumber(PI.alpha)) or alpha, (PI and tonumber(PI.l_alpha)) or l_alpha
local l_len, l_ref, col, width = (PI and tonumber(PI.l_len)) or l_len, (PI and tonumber(PI.l_ref)) or l_ref, (PI and tonumber(PI.col)) or col, (PI and tonumber(PI.width)) or width
local res, rot, rep_num, rep_dist, rep_alpha, rep_col = (PI and tonumber(PI.res)) or res, (PI and tonumber(PI.rot)) or rot, (PI and tonumber(PI.rep_num)) or rep_num, (PI and tonumber(PI.rep_dist)) or rep_dist, (PI and tonumber(PI.rep_alpha)) or rep_alpha, (PI and tonumber(PI.rep_col)) or rep_col

local mw, mh = obj.screen_w, obj.screen_h
obj.setoption("drawtarget", "tempbuffer", mw, mh)

local function get_p(p_val)
    local s_max = p_val * L
    local rx, ry = 0, 0; local steps = 100
    for i = 0, steps-1 do
        local s = s_max * (i + 0.5) / steps
        rx = rx + math.cos(s*s / (2*a*a)) * (s_max/steps)
        ry = ry + math.sin(s*s / (2*a*a)) * (s_max/steps)
    end
    local angle = (s_max*s_max / (2*a*a)) * 180 / math.pi
    return rx, ry, zs + (ze-zs)*p_val, angle
end

local x0, y0, z0 = get_p(ps)

if l_alpha > 0 then
    local r_c, g_c, b_c = math.floor(col/0x10000)%0x100/255, math.floor(col/0x100)%0x100/255, col%0x100/255
    local vertices = {}
    local t_end, t_start = p * (l_ref / 100), p * (l_ref / 100) * (1 - l_len / 100)
    for i = 0, res - 1 do
        local p1, p2 = t_start + (t_end - t_start) * (i / res), t_start + (t_end - t_start) * ((i + 1) / res)
        local vx1, vy1, vz1 = get_p(p1+ps); local vx2, vy2, vz2 = get_p(p2+ps)
        if mode == 1 then vx1,vy1,vz1=vx1-x0,vy1-y0,vz1-z0; vx2,vy2,vz2=vx2-x0,vy2-y0,vz2-z0 end
        local dx, dy = vx2-vx1, vy2-vy1; local len_seg = math.sqrt(dx*dx+dy*dy)
        if len_seg > 0 then
            local nx, ny = -dy/len_seg*width/2, dx/len_seg*width/2
            table.insert(vertices, {vx1-nx, vy1-ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx1+nx, vy1+ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2+nx, vy2+ny, vz2, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2-nx, vy2-ny, vz2, r_c, g_c, b_c, l_alpha/100})
        end
    end
    obj.drawpoly(vertices)
end

local function draw_inst(p_val, a_mul, col_mul)
    local vx, vy, vz, angle = get_p(p_val + ps)
    local dx, dy, dz = (mode == 1) and (vx - x0) or vx, (mode == 1) and (vy - y0) or vy, (mode == 1) and (vz - z0) or vz
    local sox, soy, soz, srz, sal = obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha
    obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox + dx, soy + dy, soz + dz, srz + angle * (rot / 100), sal * (alpha / 100) * a_mul
    if col_mul > 0 then
        local r1, g1, b1 = 255, 255, 255; local r2, g2, b2 = math.floor(rep_col/0x10000)%0x100, math.floor(rep_col/0x100)%0x100, rep_col%0x100
        obj.color(r1 + (r2-r1)*col_mul, g1 + (g2-g1)*col_mul, b1 + (b2-b1)*col_mul)
    end
    obj.draw(); obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox, soy, soz, srz, sal
end
if alpha > 0 then
    draw_inst(p, 1.0, 0)
    for i = 1, rep_num do draw_inst(p - i * (rep_dist / 100), math.max(0, 1 + i * (rep_alpha / 100)), math.min(1, i / rep_num)) end
end
obj.copybuffer("obj", "tempbuffer")

@N次関数
--infomation:Mathy_Su v1.0.0 by Suzuke
--label:配置\Mathy_Su
--track@xmin:X開始,-10000,10000,-500,0.01
--track@xmax:X終了,-10000,10000,500,0.01
--track@yscale:Y倍率,-10000,10000,100,0.01
--select@mode:モード,位置置換=0,線上に配置=1
--track@pos:配置位置,0,10000,10000,0.01,,0.1
--track@shift:シフト,0,10000,0,0.01,,0.1
--track@zs:Z始点,-10000,10000,0,0.01
--track@ze:Z終点,-10000,10000,0,0.01
--track@alpha:元画像透明度,0,100,100,0.01
--track@l_alpha:線透明度,0,100,0,0.01
--track@l_len:線描画比率,0,100,100,0.01
--track@l_ref:描画基準点,0,10000,100,0.01,,0.1
--color@col:線色,0xffffff
--track@width:線幅,0,1000,2,0.01
--track@res:分割数,1,10000,200,1
--track@rot:回転合わせ,0,100,100,0.01
--track@rep_num:個数,0,1000,0,1
--track@rep_dist:間隔,0,10000,10,0.01,,0.1
--track@rep_alpha:透明度変化,-100,100,0,0.01
--color@rep_col:終了色,0xffffff
--check@help:Help,0
--value@coeffs:係数,{0,1}
--value@PI:PI,{}

if help == 1 then
    local text = [[
[N次関数 / Polynomial Function (配置)]
式: y = a0 + a1*x + a2*x^2 + ...
係数を配列で指定します。
[共通パラメータ] (Helpを参照)
PI: {xmin, xmax, yscale, mode, pos, shift, zs, ze, alpha, l_alpha, l_len, l_ref, col, width, res, rot, rep_num, rep_dist, rep_alpha, rep_col, coeffs}
]]
    obj.load("text", text)
    obj.draw()
    return
end

local xmin, xmax, yscale, mode = (PI and tonumber(PI.xmin)) or xmin, (PI and tonumber(PI.xmax)) or xmax, (PI and tonumber(PI.yscale)) or yscale, (PI and tonumber(PI.mode)) or mode
local p, ps = ((PI and tonumber(PI.pos)) or pos) / 100, ((PI and tonumber(PI.shift)) or shift) / 100
local zs, ze, alpha, l_alpha = (PI and tonumber(PI.zs)) or zs, (PI and tonumber(PI.ze)) or ze, (PI and tonumber(PI.alpha)) or alpha, (PI and tonumber(PI.l_alpha)) or l_alpha
local l_len, l_ref, col, width = (PI and tonumber(PI.l_len)) or l_len, (PI and tonumber(PI.l_ref)) or l_ref, (PI and tonumber(PI.col)) or col, (PI and tonumber(PI.width)) or width
local res, rot, rep_num, rep_dist, rep_alpha, rep_col = (PI and tonumber(PI.res)) or res, (PI and tonumber(PI.rot)) or rot, (PI and tonumber(PI.rep_num)) or rep_num, (PI and tonumber(PI.rep_dist)) or rep_dist, (PI and tonumber(PI.rep_alpha)) or rep_alpha, (PI and tonumber(PI.rep_col)) or rep_col
local cf = (PI and PI.coeffs) or coeffs

local mw, mh = obj.screen_w, obj.screen_h
obj.setoption("drawtarget", "tempbuffer", mw, mh)

local function get_p(p_val)
    local x = xmin + (xmax - xmin) * p_val
    local y, dy = 0, 0
    for i, c in ipairs(cf) do
        y = y + c * math.pow(x, i-1)
        if i > 1 then dy = dy + (i-1) * c * math.pow(x, i-2) end
    end
    return x, -y * (yscale / 100), zs + (ze-zs)*p_val, math.atan2(-dy * (yscale / 100), 1) * 180 / math.pi
end

local x0, y0, z0 = get_p(ps)

if l_alpha > 0 then
    local r_c, g_c, b_c = math.floor(col/0x10000)%0x100/255, math.floor(col/0x100)%0x100/255, col%0x100/255
    local vertices = {}
    local t_end, t_start = p * (l_ref / 100), p * (l_ref / 100) * (1 - l_len / 100)
    for i = 0, res - 1 do
        local p1, p2 = t_start + (t_end - t_start) * (i / res), t_start + (t_end - t_start) * ((i + 1) / res)
        local vx1, vy1, vz1 = get_p(p1+ps); local vx2, vy2, vz2 = get_p(p2+ps)
        if mode == 1 then vx1,vy1,vz1=vx1-x0,vy1-y0,vz1-z0; vx2,vy2,vz2=vx2-x0,vy2-y0,vz2-z0 end
        local dx, dy = vx2-vx1, vy2-vy1; local len_seg = math.sqrt(dx*dx+dy*dy)
        if len_seg > 0 then
            local nx, ny = -dy/len_seg*width/2, dx/len_seg*width/2
            table.insert(vertices, {vx1-nx, vy1-ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx1+nx, vy1+ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2+nx, vy2+ny, vz2, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2-nx, vy2-ny, vz2, r_c, g_c, b_c, l_alpha/100})
        end
    end
    obj.drawpoly(vertices)
end

local function draw_inst(p_val, a_mul, col_mul)
    local vx, vy, vz, angle = get_p(p_val + ps)
    local dx, dy, dz = (mode == 1) and (vx - x0) or vx, (mode == 1) and (vy - y0) or vy, (mode == 1) and (vz - z0) or vz
    local sox, soy, soz, srz, sal = obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha
    obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox + dx, soy + dy, soz + dz, srz + angle * (rot / 100), sal * (alpha / 100) * a_mul
    if col_mul > 0 then
        local r1, g1, b1 = 255, 255, 255; local r2, g2, b2 = math.floor(rep_col/0x10000)%0x100, math.floor(rep_col/0x100)%0x100, rep_col%0x100
        obj.color(r1 + (r2-r1)*col_mul, g1 + (g2-g1)*col_mul, b1 + (b2-b1)*col_mul)
    end
    obj.draw(); obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox, soy, soz, srz, sal
end
if alpha > 0 then
    draw_inst(p, 1.0, 0)
    for i = 1, rep_num do draw_inst(p - i * (rep_dist / 100), math.max(0, 1 + i * (rep_alpha / 100)), math.min(1, i / rep_num)) end
end
