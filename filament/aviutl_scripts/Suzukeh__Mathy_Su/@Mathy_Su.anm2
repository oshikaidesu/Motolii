@スーパー楕円
--infomation:Mathy_Su v1.0.0 by Suzuke
--label:配置\Mathy_Su
--track@a:サイズX,0,10000,100,0.01
--track@b:サイズY,0,10000,100,0.01
--track@n:係数n,0,100,2.5,0.01
--select@mode:モード,位置置換=0,線上に配置=1
--track@pos:配置位置,0,10000,10000,0.01,,0.1
--track@shift:シフト,0,10000,0,0.01,,0.1
--track@zs:Z始点,-10000,10000,0,0.01
--track@ze:Z終点,-10000,10000,0,0.01
--track@alpha:元画像透明度,0,100,100,0.01
--track@l_alpha:線透明度,0,100,0,0.01
--track@l_len:線描画比率,0,100,100,0.01
--track@l_ref:描画基準点,0,10000,100,0.01,,0.1
--color@col:線色,0xffffff
--track@width:線幅,0,1000,2,0.01
--track@res:分割数,1,10000,200,1
--track@rot:回転合わせ,0,100,100,0.01
--track@rep_num:個数,0,1000,0,1
--track@rep_dist:間隔,0,10000,10,0.01,,0.1
--track@rep_alpha:透明度変化,-100,100,0,0.01
--color@rep_col:終了色,0xffffff
--check@help:Help,0
--value@PI:PI,{}

if help == 1 then
    local text = [[
[スーパー楕円 / Superellipse (配置)]
式: |x/a|^n + |y/b|^n = 1
nの値によって円(n=2)や正方形(n=∞)に近い形になります。
[共通パラメータ] (Helpを参照)
PI: {a, b, n, mode, pos, shift, zs, ze, alpha, l_alpha, l_len, l_ref, col, width, res, rot, rep_num, rep_dist, rep_alpha, rep_col}
]]
    obj.load("text", text)
    obj.draw()
    return
end

local a, b, na, mode = (PI and tonumber(PI.a)) or a, (PI and tonumber(PI.b)) or b, (PI and tonumber(PI.n)) or n, (PI and tonumber(PI.mode)) or mode
local p, ps = ((PI and tonumber(PI.pos)) or pos) / 100, ((PI and tonumber(PI.shift)) or shift) / 100
local zs, ze, alpha, l_alpha = (PI and tonumber(PI.zs)) or zs, (PI and tonumber(PI.ze)) or ze, (PI and tonumber(PI.alpha)) or alpha, (PI and tonumber(PI.l_alpha)) or l_alpha
local l_len, l_ref, col, width = (PI and tonumber(PI.l_len)) or l_len, (PI and tonumber(PI.l_ref)) or l_ref, (PI and tonumber(PI.col)) or col, (PI and tonumber(PI.width)) or width
local res, rot, rep_num, rep_dist, rep_alpha, rep_col = (PI and tonumber(PI.res)) or res, (PI and tonumber(PI.rot)) or rot, (PI and tonumber(PI.rep_num)) or rep_num, (PI and tonumber(PI.rep_dist)) or rep_dist, (PI and tonumber(PI.rep_alpha)) or rep_alpha, (PI and tonumber(PI.rep_col)) or rep_col

local mw, mh = obj.screen_w, obj.screen_h
obj.setoption("drawtarget", "tempbuffer", mw, mh)

local function get_p(p_val)
    local t = p_val * 2 * math.pi
    local cost, sint = math.cos(t), math.sin(t)
    local sgnc = (cost > 0) and 1 or (cost < 0 and -1 or 0)
    local sgns = (sint > 0) and 1 or (sint < 0 and -1 or 0)
    local x, y = a * sgnc * math.pow(math.abs(cost), 2/na), b * sgns * math.pow(math.abs(sint), 2/na)
    local dx, dy = -a*(2/na)*sgnc*math.pow(math.abs(cost), (2/na)-1)*sint, b*(2/na)*sgns*math.pow(math.abs(sint), (2/na)-1)*cost
    return x, y, zs+(ze-zs)*p_val, math.atan2(dy, dx)*180/math.pi
end

local x0, y0, z0 = get_p(ps)

if l_alpha > 0 then
    local r_c, g_c, b_c = math.floor(col/0x10000)%0x100/255, math.floor(col/0x100)%0x100/255, col%0x100/255
    local vertices = {}
    local t_end, t_start = p * (l_ref / 100), p * (l_ref / 100) * (1 - l_len / 100)
    for i = 0, res - 1 do
        local p1, p2 = t_start + (t_end - t_start) * (i / res), t_start + (t_end - t_start) * ((i + 1) / res)
        local vx1, vy1, vz1 = get_p(p1+ps); local vx2, vy2, vz2 = get_p(p2+ps)
        if mode == 1 then vx1,vy1,vz1=vx1-x0,vy1-y0,vz1-z0; vx2,vy2,vz2=vx2-x0,vy2-y0,vz2-z0 end
        local dx, dy = vx2-vx1, vy2-vy1; local len_seg = math.sqrt(dx*dx+dy*dy)
        if len_seg > 0 then
            local nx, ny = -dy/len_seg*width/2, dx/len_seg*width/2
            table.insert(vertices, {vx1-nx, vy1-ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx1+nx, vy1+ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2+nx, vy2+ny, vz2, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2-nx, vy2-ny, vz2, r_c, g_c, b_c, l_alpha/100})
        end
    end
    obj.drawpoly(vertices)
end

local function draw_inst(p_val, a_mul, col_mul)
    local vx, vy, vz, angle = get_p(p_val + ps)
    local dx, dy, dz = (mode == 1) and (vx - x0) or vx, (mode == 1) and (vy - y0) or vy, (mode == 1) and (vz - z0) or vz
    local sox, soy, soz, srz, sal = obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha
    obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox + dx, soy + dy, soz + dz, srz + angle * (rot / 100), sal * (alpha / 100) * a_mul
    if col_mul > 0 then
        local r1, g1, b1 = 255, 255, 255; local r2, g2, b2 = math.floor(rep_col/0x10000)%0x100, math.floor(rep_col/0x100)%0x100, rep_col%0x100
        obj.color(r1 + (r2-r1)*col_mul, g1 + (g2-g1)*col_mul, b1 + (b2-b1)*col_mul)
    end
    obj.draw(); obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox, soy, soz, srz, sal
end
if alpha > 0 then
    draw_inst(p, 1.0, 0)
    for i = 1, rep_num do draw_inst(p - i * (rep_dist / 100), math.max(0, 1 + i * (rep_alpha / 100)), math.min(1, i / rep_num)) end
end
