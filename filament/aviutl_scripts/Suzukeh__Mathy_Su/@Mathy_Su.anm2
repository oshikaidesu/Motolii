--check@help:Help,0
--value@PI:PI,{}

if help == 1 then
    local text = [[
[エピサイクロイド / Epicycloid (配置)]
式: x = (R+r)*cos(t) - r*cos((R+r)/r * t), y = (R+r)*sin(t) - r*sin((R+r)/r * t)
定円の周りを動円が外側に接しながら転がるときの定点の軌跡です。
[共通パラメータ] (Helpを参照)
PI: {R, r, rev, mode, pos, shift, zs, ze, alpha, l_alpha, l_len, l_ref, col, width, res, rot, rep_num, rep_dist, rep_alpha, rep_col}
]]
    obj.load("text", text)
    obj.draw()
    return
end

local R, ra, rev, mode = (PI and tonumber(PI.R)) or R, (PI and tonumber(PI.r)) or r, (PI and tonumber(PI.rev)) or rev, (PI and tonumber(PI.mode)) or mode
local p, ps = ((PI and tonumber(PI.pos)) or pos) / 100, ((PI and tonumber(PI.shift)) or shift) / 100
local zs, ze, alpha, l_alpha = (PI and tonumber(PI.zs)) or zs, (PI and tonumber(PI.ze)) or ze, (PI and tonumber(PI.alpha)) or alpha, (PI and tonumber(PI.l_alpha)) or l_alpha
local l_len, l_ref, col, width = (PI and tonumber(PI.l_len)) or l_len, (PI and tonumber(PI.l_ref)) or l_ref, (PI and tonumber(PI.col)) or col, (PI and tonumber(PI.width)) or width
local res, rot, rep_num, rep_dist, rep_alpha, rep_col = (PI and tonumber(PI.res)) or res, (PI and tonumber(PI.rot)) or rot, (PI and tonumber(PI.rep_num)) or rep_num, (PI and tonumber(PI.rep_dist)) or rep_dist, (PI and tonumber(PI.rep_alpha)) or rep_alpha, (PI and tonumber(PI.rep_col)) or rep_col

local mw, mh = obj.screen_w, obj.screen_h
obj.setoption("drawtarget", "tempbuffer", mw, mh)
local max_t = rev * 2 * math.pi

local function get_p(p_val)
    local t = p_val * max_t; local k = (R+ra)/ra
    local x, y = (R+ra)*math.cos(t) - ra*math.cos(k*t), (R+ra)*math.sin(t) - ra*math.sin(k*t)
    local dx, dy = -(R+ra)*math.sin(t) + ra*k*math.sin(k*t), (R+ra)*math.cos(t) - ra*k*math.cos(k*t)
    return x, y, zs+(ze-zs)*p_val, math.atan2(dy, dx)*180/math.pi
end

local x0, y0, z0 = get_p(ps)

if l_alpha > 0 then
    local r_c, g_c, b_c = math.floor(col/0x10000)%0x100/255, math.floor(col/0x100)%0x100/255, col%0x100/255
    local vertices = {}
    local t_end, t_start = p * (l_ref / 100), p * (l_ref / 100) * (1 - l_len / 100)
    for i = 0, res - 1 do
        local p1, p2 = t_start + (t_end - t_start) * (i / res), t_start + (t_end - t_start) * ((i + 1) / res)
        local vx1, vy1, vz1 = get_p(p1+ps); local vx2, vy2, vz2 = get_p(p2+ps)
        if mode == 1 then vx1,vy1,vz1=vx1-x0,vy1-y0,vz1-z0; vx2,vy2,vz2=vx2-x0,vy2-y0,vz2-z0 end
        local dx, dy = vx2-vx1, vy2-vy1; local len_seg = math.sqrt(dx*dx+dy*dy)
        if len_seg > 0 then
            local nx, ny = -dy/len_seg*width/2, dx/len_seg*width/2
            table.insert(vertices, {vx1-nx, vy1-ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx1+nx, vy1+ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2+nx, vy2+ny, vz2, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2-nx, vy2-ny, vz2, r_c, g_c, b_c, l_alpha/100})
        end
    end
    obj.drawpoly(vertices)
end

local function draw_inst(p_val, a_mul, col_mul)
    local vx, vy, vz, angle = get_p(p_val + ps)
    local dx, dy, dz = (mode == 1) and (vx - x0) or vx, (mode == 1) and (vy - y0) or vy, (mode == 1) and (vz - z0) or vz
    local sox, soy, soz, srz, sal = obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha
    obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox + dx, soy + dy, soz + dz, srz + angle * (rot / 100), sal * (alpha / 100) * a_mul
    if col_mul > 0 then
        local r1, g1, b1 = 255, 255, 255; local r2, g2, b2 = math.floor(rep_col/0x10000)%0x100, math.floor(rep_col/0x100)%0x100, rep_col%0x100
        obj.color(r1 + (r2-r1)*col_mul, g1 + (g2-g1)*col_mul, b1 + (b2-b1)*col_mul)
    end
    obj.draw(); obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox, soy, soz, srz, sal
end
if alpha > 0 then
    draw_inst(p, 1.0, 0)
    for i = 1, rep_num do draw_inst(p - i * (rep_dist / 100), math.max(0, 1 + i * (rep_alpha / 100)), math.min(1, i / rep_num)) end
end
obj.copybuffer("obj", "tempbuffer")

@ハイポサイクロイド
--infomation:Mathy_Su v1.0.0 by Suzuke
--label:配置\Mathy_Su
--track@R:定円半径,0,10000,100,0.01
--track@r:動円半径,0,10000,50,0.01
--track@rev:回転数,0,100,1,0.01
--select@mode:モード,位置置換=0,線上に配置=1
--track@pos:配置位置,0,10000,10000,0.01,,0.1
--track@shift:シフト,0,10000,0,0.01,,0.1
--track@zs:Z始点,-10000,10000,0,0.01
--track@ze:Z終点,-10000,10000,0,0.01
--track@alpha:元画像透明度,0,100,100,0.01
--track@l_alpha:線透明度,0,100,0,0.01
--track@l_len:線描画比率,0,100,100,0.01
--track@l_ref:描画基準点,0,10000,100,0.01,,0.1
--color@col:線色,0xffffff
--track@width:線幅,0,1000,2,0.01
--track@res:分割数,1,10000,200,1
--track@rot:回転合わせ,0,100,100,0.01
--track@rep_num:個数,0,1000,0,1
--track@rep_dist:間隔,0,10000,10,0.01,,0.1
--track@rep_alpha:透明度変化,-100,100,0,0.01
--color@rep_col:終了色,0xffffff
--check@help:Help,0
--value@PI:PI,{}

if help == 1 then
    local text = [[
[ハイポサイクロイド / Hypocycloid (配置)]
式: x = (R-r)*cos(t) + r*cos((R-r)/r * t), y = (R-r)*sin(t) - r*sin((R-r)/r * t)
定円の周りを動円が内側に接しながら転がるときの定点の軌跡です。
[共通パラメータ] (Helpを参照)
PI: {R, r, rev, mode, pos, shift, zs, ze, alpha, l_alpha, l_len, l_ref, col, width, res, rot, rep_num, rep_dist, rep_alpha, rep_col}
]]
    obj.load("text", text)
    obj.draw()
    return
end

local R, ra, rev, mode = (PI and tonumber(PI.R)) or R, (PI and tonumber(PI.r)) or r, (PI and tonumber(PI.rev)) or rev, (PI and tonumber(PI.mode)) or mode
local p, ps = ((PI and tonumber(PI.pos)) or pos) / 100, ((PI and tonumber(PI.shift)) or shift) / 100
local zs, ze, alpha, l_alpha = (PI and tonumber(PI.zs)) or zs, (PI and tonumber(PI.ze)) or ze, (PI and tonumber(PI.alpha)) or alpha, (PI and tonumber(PI.l_alpha)) or l_alpha
local l_len, l_ref, col, width = (PI and tonumber(PI.l_len)) or l_len, (PI and tonumber(PI.l_ref)) or l_ref, (PI and tonumber(PI.col)) or col, (PI and tonumber(PI.width)) or width
local res, rot, rep_num, rep_dist, rep_alpha, rep_col = (PI and tonumber(PI.res)) or res, (PI and tonumber(PI.rot)) or rot, (PI and tonumber(PI.rep_num)) or rep_num, (PI and tonumber(PI.rep_dist)) or rep_dist, (PI and tonumber(PI.rep_alpha)) or rep_alpha, (PI and tonumber(PI.rep_col)) or rep_col

local mw, mh = obj.screen_w, obj.screen_h
obj.setoption("drawtarget", "tempbuffer", mw, mh)
local max_t = rev * 2 * math.pi

local function get_p(p_val)
    local t = p_val * max_t; local k = (R-ra)/ra
    local x, y = (R-ra)*math.cos(t) + ra*math.cos(k*t), (R-ra)*math.sin(t) - ra*math.sin(k*t)
    local dx, dy = -(R-ra)*math.sin(t) - ra*k*math.sin(k*t), (R-ra)*math.cos(t) - ra*k*math.cos(k*t)
    return x, y, zs+(ze-zs)*p_val, math.atan2(dy, dx)*180/math.pi
end

local x0, y0, z0 = get_p(ps)

if l_alpha > 0 then
    local r_c, g_c, b_c = math.floor(col/0x10000)%0x100/255, math.floor(col/0x100)%0x100/255, col%0x100/255
    local vertices = {}
    local t_end, t_start = p * (l_ref / 100), p * (l_ref / 100) * (1 - l_len / 100)
    for i = 0, res - 1 do
        local p1, p2 = t_start + (t_end - t_start) * (i / res), t_start + (t_end - t_start) * ((i + 1) / res)
        local vx1, vy1, vz1 = get_p(p1+ps); local vx2, vy2, vz2 = get_p(p2+ps)
        if mode == 1 then vx1,vy1,vz1=vx1-x0,vy1-y0,vz1-z0; vx2,vy2,vz2=vx2-x0,vy2-y0,vz2-z0 end
        local dx, dy = vx2-vx1, vy2-vy1; local len_seg = math.sqrt(dx*dx+dy*dy)
        if len_seg > 0 then
            local nx, ny = -dy/len_seg*width/2, dx/len_seg*width/2
            table.insert(vertices, {vx1-nx, vy1-ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx1+nx, vy1+ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2+nx, vy2+ny, vz2, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2-nx, vy2-ny, vz2, r_c, g_c, b_c, l_alpha/100})
        end
    end
    obj.drawpoly(vertices)
end

local function draw_inst(p_val, a_mul, col_mul)
    local vx, vy, vz, angle = get_p(p_val + ps)
    local dx, dy, dz = (mode == 1) and (vx - x0) or vx, (mode == 1) and (vy - y0) or vy, (mode == 1) and (vz - z0) or vz
    local sox, soy, soz, srz, sal = obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha
    obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox + dx, soy + dy, soz + dz, srz + angle * (rot / 100), sal * (alpha / 100) * a_mul
    if col_mul > 0 then
        local r1, g1, b1 = 255, 255, 255; local r2, g2, b2 = math.floor(rep_col/0x10000)%0x100, math.floor(rep_col/0x100)%0x100, rep_col%0x100
        obj.color(r1 + (r2-r1)*col_mul, g1 + (g2-g1)*col_mul, b1 + (b2-b1)*col_mul)
    end
    obj.draw(); obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox, soy, soz, srz, sal
end
if alpha > 0 then
    draw_inst(p, 1.0, 0)
    for i = 1, rep_num do draw_inst(p - i * (rep_dist / 100), math.max(0, 1 + i * (rep_alpha / 100)), math.min(1, i / rep_num)) end
end
obj.copybuffer("obj", "tempbuffer")

@正多角形
--infomation:Mathy_Su v1.0.0 by Suzuke
--label:配置\Mathy_Su
--track@n:角数,3,10000,5,1
--track@r:半径,0,10000,100,0.01
--track@pos:配置位置,0,10000,0,0.01
--track@shift:シフト,0,10000,0,0.01
--track@alpha:元画像透明度,0,100,100,0.01
--track@l_alpha:線透明度,0,100,0,0.01
--track@zs:Z始点,-10000,10000,0,0.01
--track@ze:Z終点,-10000,10000,0,0.01
--check@rot:回転合わせ,1
--select@mode:モード,位置置換=0,線上に配置=1
--check@help:Help,0
--value@PI:PI,{}
--color@col:線色,0xffffff
--track@width:線幅,0,1000,2,0.01

if help == 1 then
    local text = [[
[正多角形 / Regular Polygon (配置)]
n: 角数, r: 半半径
n角形の各辺の上に配置します。
PI: {n, r, pos, shift, alpha, l_alpha, zs, ze, col, width}
]]
    obj.load("text", text)
    obj.draw()
    return
end

local n = (PI and tonumber(PI.n)) or n
local r = (PI and tonumber(PI.r)) or r
local p = ((PI and tonumber(PI.pos)) or pos) / 100
local ps = ((PI and tonumber(PI.shift)) or shift) / 100
local alpha = (PI and tonumber(PI.alpha)) or alpha
local l_alpha = (PI and tonumber(PI.l_alpha)) or l_alpha
local zs = (PI and tonumber(PI.zs)) or zs
local ze = (PI and tonumber(PI.ze)) or ze
local col = (PI and tonumber(PI.col)) or 0xffffff
local width = (PI and tonumber(PI.width)) or 2

obj.alpha = obj.alpha * (alpha / 100)

local function get_pos_poly(p_val)
    local seg_idx = math.floor(p_val * n)
    if seg_idx >= n then seg_idx = n - 1 end
    local seg_p = (p_val * n) - seg_idx
    local t1 = 2 * math.pi * seg_idx / n
    local t2 = 2 * math.pi * (seg_idx + 1) / n
    local vx1, vy1 = r * math.cos(t1), r * math.sin(t1)
    local vx2, vy2 = r * math.cos(t2), r * math.sin(t2)
    return vx1 + (vx2 - vx1) * seg_p, vy1 + (vy2 - vy1) * seg_p, t1, t2
end

local x, y, t1, t2 = get_pos_poly(p + ps)
local z = zs + (ze - zs) * (p + ps)

local x0, y0 = get_pos_poly(ps)
local z0 = zs + (ze - zs) * ps

if mode == 0 then
    obj.ox, obj.oy, obj.oz = obj.ox + x, obj.oy + y, obj.oz + z
    if rot == 1 then
        local vx1, vy1 = r * math.cos(t1), r * math.sin(t1)
        local vx2, vy2 = r * math.cos(t2), r * math.sin(t2)
        obj.rz = obj.rz + math.atan2(vy2 - vy1, vx2 - vx1) * 180 / math.pi
    end
elseif mode == 1 then
    obj.ox, obj.oy, obj.oz = obj.ox + (x - x0), obj.oy + (y - y0), obj.oz + (z - z0)
    if rot == 1 then
        local vx1, vy1 = r * math.cos(t1), r * math.sin(t1)
        local vx2, vy2 = r * math.cos(t2), r * math.sin(t2)
        obj.rz = obj.rz + math.atan2(vy2 - vy1, vx2 - vx1) * 180 / math.pi
    end
end

if l_alpha > 0 then
    local r_c, g_c, b_c = math.floor(col/0x10000)%0x100/255, math.floor(col/0x100)%0x100/255, col%0x100/255
    local ox_l, oy_l, oz_l = (mode == 0) and -x or -x0, (mode == 0) and -y or -y0, (mode == 0) and -z or -z0
    local vertices = {}
    for i = 0, n - 1 do
        local vt1 = 2 * math.pi * i / n
        local vt2 = 2 * math.pi * (i + 1) / n
        local vx1, vy1 = r * math.cos(vt1), r * math.sin(vt1)
        local vx2, vy2 = r * math.cos(vt2), r * math.sin(vt2)
        local vz1 = zs + (ze - zs) * (i / n)
        local vz2 = zs + (ze - zs) * ((i + 1) / n)
        local dx, dy = vx2 - vx1, vy2 - vy1
        local len = math.sqrt(dx*dx + dy*dy)
        if len > 0 then
            local nx, ny = -dy/len*width/2, dx/len*width/2
            table.insert(vertices, {vx1-nx+ox_l, vy1-ny+oy_l, vz1+oz_l, r_c, g_c, b_c, l_alpha / 100})
            table.insert(vertices, {vx1+nx+ox_l, vy1+ny+oy_l, vz1+oz_l, r_c, g_c, b_c, l_alpha / 100})
            table.insert(vertices, {vx2+nx+ox_l, vy2+ny+oy_l, vz2+oz_l, r_c, g_c, b_c, l_alpha / 100})
            table.insert(vertices, {vx2-nx+ox_l, vy2-ny+oy_l, vz2+oz_l, r_c, g_c, b_c, l_alpha / 100})
        end
    end
    obj.drawpoly(vertices)
end
obj.copybuffer("obj", "tempbuffer")

@星型多角形
--infomation:Mathy_Su v1.0.0 by Suzuke
--label:配置\Mathy_Su
--track@n:頂点数,3,10000,5,1
--track@skip:スキップ,1,10000,2,1
--track@r:半径,0,10000,100,0.01
--select@mode:モード,位置置換=0,線上に配置=1
--track@pos:配置位置,0,10000,10000,0.01,,0.1
--track@shift:シフト,0,10000,0,0.01,,0.1
--track@zs:Z始点,-10000,10000,0,0.01
--track@ze:Z終点,-10000,10000,0,0.01
--track@alpha:元画像透明度,0,100,100,0.01
--track@l_alpha:線透明度,0,100,0,0.01
--track@l_len:線描画比率,0,100,100,0.01
--track@l_ref:描画基準点,0,10000,100,0.01,,0.1
--color@col:線色,0xffffff
--track@width:線幅,0,1000,2,0.01
--track@res:分割数,1,10000,200,1
--track@rot:回転合わせ,0,100,100,0.01
--track@rep_num:個数,0,1000,0,1
--track@rep_dist:間隔,0,10000,10,0.01,,0.1
--track@rep_alpha:透明度変化,-100,100,0,0.01
--color@rep_col:終了色,0xffffff
--check@help:Help,0
--value@PI:PI,{}

if help == 1 then
    local text = [[
[星型多角形 / Star Polygon (配置)]
n個の頂点をskip個飛ばしで結んだ星型の上に配置します。
[共通パラメータ] (Helpを参照)
PI: {n, skip, r, mode, pos, shift, zs, ze, alpha, l_alpha, l_len, l_ref, col, width, res, rot, rep_num, rep_dist, rep_alpha, rep_col}
]]
    obj.load("text", text)
    obj.draw()
    return
end

local n, skip, ra, mode = (PI and tonumber(PI.n)) or n, (PI and tonumber(PI.skip)) or skip, (PI and tonumber(PI.r)) or r, (PI and tonumber(PI.mode)) or mode
local p, ps = ((PI and tonumber(PI.pos)) or pos) / 100, ((PI and tonumber(PI.shift)) or shift) / 100
local zs, ze, alpha, l_alpha = (PI and tonumber(PI.zs)) or zs, (PI and tonumber(PI.ze)) or ze, (PI and tonumber(PI.alpha)) or alpha, (PI and tonumber(PI.l_alpha)) or l_alpha
local l_len, l_ref, col, width = (PI and tonumber(PI.l_len)) or l_len, (PI and tonumber(PI.l_ref)) or l_ref, (PI and tonumber(PI.col)) or col, (PI and tonumber(PI.width)) or width
local res, rot, rep_num, rep_dist, rep_alpha, rep_col = (PI and tonumber(PI.res)) or res, (PI and tonumber(PI.rot)) or rot, (PI and tonumber(PI.rep_num)) or rep_num, (PI and tonumber(PI.rep_dist)) or rep_dist, (PI and tonumber(PI.rep_alpha)) or rep_alpha, (PI and tonumber(PI.rep_col)) or rep_col

local mw, mh = obj.screen_w, obj.screen_h
obj.setoption("drawtarget", "tempbuffer", mw, mh)

local function get_p(p_val)
    local seg_p = (p_val % 1.0) * n
    local idx = math.floor(seg_p); local f = seg_p - idx
    local t1, t2 = 2*math.pi*idx*skip/n, 2*math.pi*(idx+1)*skip/n
    local x1, y1 = ra*math.cos(t1), ra*math.sin(t1)
    local x2, y2 = ra*math.cos(t2), ra*math.sin(t2)
    return x1+(x2-x1)*f, y1+(y2-y1)*f, zs+(ze-zs)*p_val, math.atan2(y2-y1, x2-x1)*180/math.pi
end

local x0, y0, z0 = get_p(ps)

if l_alpha > 0 then
    local r_c, g_c, b_c = math.floor(col/0x10000)%0x100/255, math.floor(col/0x100)%0x100/255, col%0x100/255
    local vertices = {}
    local t_end, t_start = p * (l_ref / 100), p * (l_ref / 100) * (1 - l_len / 100)
    for i = 0, res - 1 do
        local p1, p2 = t_start + (t_end - t_start) * (i / res), t_start + (t_end - t_start) * ((i + 1) / res)
        local vx1, vy1, vz1 = get_p(p1+ps); local vx2, vy2, vz2 = get_p(p2+ps)
        if mode == 1 then vx1,vy1,vz1=vx1-x0,vy1-y0,vz1-z0; vx2,vy2,vz2=vx2-x0,vy2-y0,vz2-z0 end
        local dx, dy = vx2-vx1, vy2-vy1; local len_seg = math.sqrt(dx*dx+dy*dy)
        if len_seg > 0 then
            local nx, ny = -dy/len_seg*width/2, dx/len_seg*width/2
            table.insert(vertices, {vx1-nx, vy1-ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx1+nx, vy1+ny, vz1, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2+nx, vy2+ny, vz2, r_c, g_c, b_c, l_alpha/100})
            table.insert(vertices, {vx2-nx, vy2-ny, vz2, r_c, g_c, b_c, l_alpha/100})
        end
    end
    obj.drawpoly(vertices)
end

local function draw_inst(p_val, a_mul, col_mul)
    local vx, vy, vz, angle = get_p(p_val + ps)
    local dx, dy, dz = (mode == 1) and (vx - x0) or vx, (mode == 1) and (vy - y0) or vy, (mode == 1) and (vz - z0) or vz
    local sox, soy, soz, srz, sal = obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha
    obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox + dx, soy + dy, soz + dz, srz + angle * (rot / 100), sal * (alpha / 100) * a_mul
    if col_mul > 0 then
        local r1, g1, b1 = 255, 255, 255; local r2, g2, b2 = math.floor(rep_col/0x10000)%0x100, math.floor(rep_col/0x100)%0x100, rep_col%0x100
        obj.color(r1 + (r2-r1)*col_mul, g1 + (g2-g1)*col_mul, b1 + (b2-b1)*col_mul)
    end
    obj.draw(); obj.ox, obj.oy, obj.oz, obj.rz, obj.alpha = sox, soy, soz, srz, sal
end
if alpha > 0 then
    draw_inst(p, 1.0, 0)
    for i = 1, rep_num do draw_inst(p - i * (rep_dist / 100), math.max(0, 1 + i * (rep_alpha / 100)), math.min(1, i / rep_num)) end
end
obj.copybuffer("obj", "tempbuffer")

