@ストローク
--information:VectorCanvas v0.1.0 by もげ

--color@stroke_color:色,0xffffff
--track@opacity:透明度,0,100,100,0.1,,1
--track@linewidth:太さ,0,400,5,0.1
--group:破線

--check@dashed:破線にする,false
--value@dashed_intervals:破線パターン,{10, 10}
--track@dashed_phase:破線のずれ,-1000,1000,0,0.1
--group:形状制御

--select@linecap:端の形状=0,切断=0,四角=1,丸める=2
--select@linejoin:角の形状=0,尖らせる=0,丸める=1,ベベル=2
--value@miterlimit:角比率,4
--group:トリム

--track@trim_beg:開始位置,0,100,0,0.01,,1
--track@trim_end:終了位置,0,100,100,0.01,,1
--track@trim_overlap:オーバーラップ,0,100,100,0.01,,1

if _vectorcanvas == nil then
    print("@error", "ベクターキャンバスが作成されていません。「キャンバス@VectorCanvas」を追加してください。")
    return
end

local intervals = "{}"
if dashed then
    intervals = "{"
    for i = 1, #dashed_intervals do
        intervals = intervals .. " " .. dashed_intervals[i]
    end
    intervals = intervals .. " }"
end

local d = string.format(
    "stroke: #%06X %f %d %s %f %d %d %f %f %f %f %f",
    stroke_color,
    linewidth,
    dashed and 1 or 0,
    intervals,
    dashed_phase,
    linecap,
    linejoin,
    miterlimit,
    trim_beg / 100.0,
    trim_end / 100.0,
    trim_overlap / 100.0,
    opacity / 100.0
)
table.insert(_vectorcanvas.canvas, d)

