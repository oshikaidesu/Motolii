--information:Loop r3 by 猫愛
--label:配置

--group:個数
--track@amount_x:X個数,-1000,1000,3,1
--track@amount_y:Y個数,-1000,1000,3,1
--track@amount_z:Z個数,-1000,1000,1,1
--check@min0minus2_x:X個数0以下時-2,false
--check@min0minus2_y:Y個数0以下時-2,false
--check@min0minus2_z:Z個数0以下時-2,false
--group:間隔
--track@space_x:X間隔,-10000,10000,100,0.01
--track@space_y:Y間隔,-10000,10000,100,0.01
--track@space_z:Z間隔,-10000,10000,100,0.01
--group:整列,false
--select@align_x:X整列=2,無効=0,1列目で中央揃え=1,全体で中央揃え=2
--select@align_y:Y整列=2,無効=0,1列目で中央揃え=1,全体で中央揃え=2
--select@align_z:Z整列=2,無効=0,1列目で中央揃え=1,全体で中央揃え=2
--group:オフセット,false
--track@offset_x:Xオフセット,-10000,10000,0,0.01
--track@offset_y:Yオフセット,-10000,10000,0,0.01
--track@offset_z:Zオフセット,-10000,10000,0,0.01
--group:その他
--check@indiv_objects:個別オブジェクト,false
--check@IndMode:個別基準,false




local objdata = {}
local keys = {"ox","oy","oz","rx","ry","rz","zoom","alpha"}
for k, v in pairs(keys) do
	objdata[v] = obj[v]
end



local align = { align_x, align_y, align_z }

local reverse = { false, false, false }

local ZeroBorder = { min0minus2_x, min0minus2_y, min0minus2_z }

local spacing = { space_x, space_y, space_z }

local offset = { offset_x / 100, offset_y / 100, offset_z / 100 }



local gx, gy, gz
local ox, oy, oz = obj.ox, obj.oy, obj.oz
local w, h = obj.w, obj.h


--描画しない条件
if (not ZeroBorder[1] or not ZeroBorder[2] or not ZeroBorder[3]) then
  if amount_x * amount_y * amount_z == 0 then
    obj.draw(0,0,0,0,0)
    return
  end
end

if amount_x <= 0 then
  if ZeroBorder[1] then
    amount_x = amount_x - 2
  end
  reverse[1] = not reverse[1]
end
if amount_y <= 0 then
  if ZeroBorder[2] then
    amount_y = amount_y - 2
  end
  reverse[2] = not reverse[2]
end
if amount_z <= 0 then
  if ZeroBorder[3] then
    amount_z = amount_z - 2
  end
  reverse[3] = not reverse[3]
end

amount_x, amount_y, amount_z = math.abs(amount_x), math.abs(amount_y), math.abs(amount_z)

if IndMode then
  gx = spacing[1]
  gy = spacing[2]
  gz = spacing[3]
else
  gx = spacing[1] / 100 * w
  gy = spacing[2] / 100 * h
  gz = spacing[3] / 100 * math.max(w, h)
end


local function get_i(index)
  local xi = math.floor( index % amount_x )
  local yi = math.floor( index % (amount_x * amount_y) / amount_x )
  local zi = math.floor( index / (amount_x * amount_y) )
  -- debug_print(tostring(xi)..", "..tostring(yi)..", "..tostring(zi))
  return xi, yi, zi
end


local function calc_pos(xi,yi,zi)
  local def = {0,0,0}
  local x, y, z = 0, 0, 0
  local cx, cy, cz = 0,0,0
  if align[1] >= 1 then
    x = ox + gx * (xi - (amount_x - 1) / 2)
  else
    x = ox + xi * gx
  end

  if reverse[1] then
    x = x * -1
  end


  if align[2] >= 1 then
    y = oy + gy * (yi - (amount_y - 1) / 2)
  else
    y = oy + yi * gy
  end

  if reverse[2] then
    y = y * -1
  end


  if align[3] >= 1 then
    z = oz + gz * (zi - (amount_z - 1) / 2)
  else
    z = oz + zi * gz
  end


  if align[1]==2 then
    cx = gx * (offset[1] * (amount_y - 1)) / 2
  end
	if align[2]==2 then
    cy = gy * (offset[2] * (amount_x - 1)) / 2
	end
	if align[3]==2 then
	  cz = gz * (offset[3] * (amount_x + amount_y - 2) / 2) / 2
	end


  def[1] = x + gx * (offset[1] * yi) - cx
  def[2] = y + gy * (offset[2] * xi) - cy
  def[3] = z + gz * (offset[3] * (xi + yi) / 2) - cz

  if reverse[3] then
    def[3] = def[3] * -1
  end
  return unpack(def)
end


local num = amount_x * amount_y * amount_z


if indiv_objects then
  obj.copybuffer("cache:neac_loop","object")
  obj.multiobject(
    num,
    function()
      obj.copybuffer("object","cache:neac_loop")
      obj.ox, obj.oy, obj.oz = calc_pos(get_i(obj.index))
    end
  )
  obj.ox = 0
else
  obj.effect()
  for i = 0, num - 1 do
    obj.draw(calc_pos(get_i(i)))
  end
end
