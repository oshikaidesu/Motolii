--group:屈折設定,false
--track@refr_idx:屈折率,100,400,150,0.01,,0.5
--track@chrm_abrr:色収差,-100,100,3,0.001,,0.1
--group:光設定,false
--track@light_angle:光角度,-1440,1440,-20,0.01,,0.25
--track@refl_power:光沢,0,100,70,0.01
--track@refl_light:ハイライト,0,400,30,0.01,,0.25
--track@refl_shadow:シャドウ,0,400,30,0.01,,0.25
--checksection@light_screen:光角度を画面基準,false,false
--group:ぼかし設定,false
--track@blur:blur::範囲,0,1000,0,0.01,,0.2
--track@blur_aspect:blur::縦横比,-100,100,0,0.001
--track@blur_luma_weight:blur::光の強さ,0,60,0,0.1
--track@noise_intensity:noise::ノイズ,0,100,0,0.01,,0.1
--track@noise_seed:noise::シード,-65536,65535,10000,1
--track@noise_size:noise::ドットサイズ,100,6400,100,0.01,,0.0625
