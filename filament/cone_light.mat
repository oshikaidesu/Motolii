// Step two of the light of the cones and rods: ONE mesh (beam::cone_mesh), drawn once per (solid, colour step, way). What
// became of each corner is read from the texture that cone_walk.mat has just written; here the corner's brightness
// is worked out from itself and its six neighbours (beam::cone_bright) and the light is told how much to soften
// (beam::cone_light). Nothing about a cone comes from the CPU.
// Output as beam_light.mat: rgb = the light, a = light * distance flown (for the softening pass).
material {
    name : cone_light,
    shadingModel : unlit,
    blending : add,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    instanced : true,
    variables : [ light, land, there ],
    parameters : [
        { type : sampler2d, name : walk, precision : high, format : float },    // written by cone_walk.mat
        { type : float4[32], name : steps },                                    // rgb, index of refraction
        { type : float,  name : stepCount },
        { type : float,  name : wayCount },
        { type : float4, name : rows },                                         // beam::CONE_ROWS
        { type : float4, name : cols },                                         // beam::CONE_COLS
        { type : float,  name : first },                                        // the first cone of this renderable
        { type : float3, name : sunDir },
        { type : float,  name : sunTan },
        { type : float4[6], name : room, precision : high },                    // the stage: see recv_drop.glsl
        { type : float,  name : roomCount },
        { type : float4[16], name : blocks, precision : high },
        { type : float,  name : blockCount },
        { type : float,  name : recvCount },
        { type : float,  name : recvChooses },
        { type : float3, name : recvSun },
        { type : float,  name : pxScale },
        { type : float,  name : floorY },
        { type : float,  name : cap }                                           // beam::CONE_CAP
    ]
}

vertex {
#include "recv_drop.glsl"
    float rowsOf(int pch) { return pch == 0 ? materialParams.rows.x : (pch == 1 ? materialParams.rows.y : (pch == 2 ? materialParams.rows.z : materialParams.rows.w)); }
    float colsOf(int pch) { return pch == 0 ? materialParams.cols.x : (pch == 1 ? materialParams.cols.y : (pch == 2 ? materialParams.cols.z : materialParams.cols.w)); }
    // texel `part` (0 or 1) of corner (i, j) of a patch, for an instance
    vec4 cornerAt(int pch, float i, float j, int inst, int part) {
        int corner = int(i + 0.5) * int(colsOf(pch) + 1.5) + int(j + 0.5);
        for (int m = 0; m < 3; m++)
            if (m < pch) corner += int(rowsOf(m) + 1.5) * int(colsOf(m) + 1.5);
        return texelFetch(materialParams_walk, ivec2(corner * 2 + part, inst), 0);
    }
    void materialVertex(inout MaterialVertexInputs material) {
        int stepCount = int(materialParams.stepCount), wayCount = int(materialParams.wayCount);
        int per = stepCount * wayCount;
        int receivers = recvPer();
        int recv = getInstanceIndex() - (getInstanceIndex() / receivers) * receivers;   // which receiver this instance draws on (recv_drop.glsl)
        int inst = int(materialParams.first) * per + getInstanceIndex() / receivers;
        int rest = inst - (inst / per) * per;
        int stepAt = rest / wayCount;
        vec3 L = materialParams.sunDir;
        float i = mesh_position.x, j = mesh_position.y;
        int pch = int(mesh_position.z + 0.5);
        float rows = rowsOf(pch), cols = colsOf(pch);

        vec4 land = cornerAt(pch, i, j, inst, 0), on = cornerAt(pch, i, j, inst, 1);
        vec3 q = vec3(land.x, land.z, land.y), P = on.xyz;   // q: x, distance flown, z
        float weight = land.w, faces = floor(on.w), fade = on.w - faces;
        if (fade > 0.9985) fade = 1.0;
        float e = 0.0, fly = q.y;
        if (faces > 0.5) {
            // the corners around this one (beam::cone_around) and what became of them (beam::cone_bright)
            float fi[6];
            float fj[6];
            fi[0] = i + 1.0; fj[0] = j;
            fi[1] = i + 1.0; fj[1] = j + 1.0;
            fi[2] = i;       fj[2] = j + 1.0;
            fi[3] = i - 1.0; fj[3] = j;
            fi[4] = i - 1.0; fj[4] = j - 1.0;
            fi[5] = i;       fj[5] = j - 1.0;
            vec3 Pk[6];
            vec2 qk[6];
            bool same[6];
            float least = fade, most = weight;   // most: the brightest share among this corner and its neighbours
            for (int m = 0; m < 6; m++) {
                same[m] = false;
                Pk[m] = P;
                qk[m] = q.xz;
                if (!(fi[m] > -0.5 && fi[m] < rows + 0.5 && fj[m] > -0.5 && fj[m] < cols + 0.5)) continue;   // no such corner
                vec4 lk = cornerAt(pch, fi[m], fj[m], inst, 0), ok = cornerAt(pch, fi[m], fj[m], inst, 1);
                float ck = floor(ok.w), fk = ok.w - ck;
                if (fk > 0.9985) fk = 1.0;
                Pk[m] = ok.xyz;
                qk[m] = lk.xy;
                same[m] = abs(ck - faces) < 0.5;
                least = min(least, same[m] ? fk : 0.0);
                if (ck > 0.5) most = max(most, lk.w);
            }
            float before = 0.0, after = 0.0;
            for (int m = 0; m < 6; m++) {
                int o = m < 5 ? m + 1 : 0;
                if (!same[m] || !same[o]) continue;
                before += abs(dot(cross(Pk[m] - P, Pk[o] - P), L));
                after += abs((qk[m].x - q.x) * (qk[o].y - q.z) - (qk[m].y - q.z) * (qk[o].x - q.x));
            }
            if (before > 0.0 && weight > 0.0) e = weight * least * (after * materialParams.cap > before ? before / after : materialParams.cap);
            // every triangle at this corner is dark: tuck it under the cone, so that those triangles cover next to no pixels
            if (!(most > 0.0)) q = vec3(P.x, 0.0, P.z);
            if (weight > 0.0) {
                // soften by half the gap to where the neighbouring colour lands, so that the colour steps run into one another
                int other = stepAt + 1 < stepCount ? inst + wayCount : (stepAt > 0 ? inst - wayCount : inst);
                vec4 ln = cornerAt(pch, i, j, other, 0), on2 = cornerAt(pch, i, j, other, 1);
                float cn = floor(on2.w);
                if (cn > 0.5 && ln.w > 0.0) fly += 0.5 * length(ln.xy - q.xz) / materialParams.sunTan;
            }
        }
        if (faces < 0.5) q = vec3(P.x, 0.0, P.z);
        vec3 rgb = materialParams.steps[stepAt].rgb * e;
        float t, ok, owner;
        highp vec3 start;
        highp vec3 X = recvDrop(recv, q.xz, q.y, true, rgb, t, ok, owner, start);
        material.light = vec4(rgb, t + (fly - q.y));   // (as far as it flew to there, and the softening that joins the colour steps)
        material.land = vec4(start, owner);
        material.there = vec4(ok);
        material.worldPosition = recvNearer(mulMat4x4Float3(getWorldFromModelMatrix(), X), owner);
    }
}

fragment {
#include "recv_lands.glsl"
#include "recv_finish.glsl"
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = recvFinish(variable_light, variable_there.x, floor(variable_land.w + 0.5), variable_land.xyz, false);
    }
}
