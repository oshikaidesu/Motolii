// blade.mat: a lacquered blade: Filament's own lit surface with a clear coat, its colour running from dark at the root
// to light at the tip, mirroring the room (the white streaks are the room's lamps). One blade may be finely hatched.
material {
    name : blade,
    shadingModel : lit,
    requires : [ uv0 ],
    parameters : [
        { type : float3, name : dark },     // colour at the root
        { type : float3, name : light },    // and towards the tip
        { type : float, name : metal },     // 0 lacquer .. 1 steel
        { type : float, name : hatch }      // 0 none .. 1 a fine cross hatch
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = getUV0();
        vec3 c = mix(materialParams.dark, materialParams.light, smoothstep(0.15, 0.95, uv.x));
        float lines = step(0.5, fract(uv.x * 260.0 + uv.y * 9.0)) * step(0.5, fract(uv.x * 260.0 - uv.y * 9.0));
        c *= mix(1.0, 0.25 + 1.4 * lines, materialParams.hatch);
        material.baseColor = vec4(c, 1.0);
        material.metallic = materialParams.metal;
        material.roughness = 0.22;
        material.reflectance = 0.6;
        material.clearCoat = 1.0;
        material.clearCoatRoughness = 0.04;
    }
}
