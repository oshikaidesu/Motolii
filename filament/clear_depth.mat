// clear_depth.mat: nothing behind counts from here on. One triangle over the whole picture, drawn as Filament's own
// sky is (its Skybox material: the device's own coordinates, at the far end), but writing depth and no colour: what
// is drawn after it settles depth among itself alone. doc.h lays it first in a run of solid things.
material {
    name : clear_depth,
    vertexDomain : device,
    shadingModel : unlit,
    depthWrite : true,
    depthCulling : false,
    colorWrite : false,
    culling : none,
    variantFilter : [ skinning, shadowReceiver, vsm ]
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = vec4(0.0);
    }
}
