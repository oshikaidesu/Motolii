// effected.mat: a thing's picture with its effects on, laid over the stage where the thing lies (in its order).
// Filament's own sample material samples/materials/image.mat (Apache-2.0), as it is but for three things: it is laid
// over what is under it (blending transparent, premultiplied, as Filament's transparent takes it), no background
// colour is put where the picture is clear, and it lies only where the thing is seen (clipSpaceTransform). What Filament's makers say to do for an effect of one's own: draw it into
// a texture offscreen, then draw with that texture and a material of one's own (google/filament#1818, #7676, #3784).
material {
    name : Effected,
    parameters : [
        {
            type : sampler2d,
            name : image
        },
        {
            type : mat4,
            name : place
        },
        {
            type : float,
            name : glowing
        },
        {
            type : float,
            name : opacity
        },
        { type : sampler2d, name : matte0 }, { type : sampler2d, name : matte1 }, { type : sampler2d, name : matte2 }, { type : sampler2d, name : matte3 },
        { type : mat4, name : matteEye0 }, { type : mat4, name : matteEye1 }, { type : mat4, name : matteEye2 }, { type : mat4, name : matteEye3 },
        { type : float4, name : matteUse }, { type : float4, name : matteSoft }   // (matte.glsl, as flat.mat's: the thing cut after its effects)
    ],
    variables : [
        imageUV,
        worldAt
    ],
    vertexDomain : device,
    vertexDomainDeviceJittered : true,   // (Filament pads its picture to a multiple of 16 on the right and top and a camera's projection is told so; a device sheet is only with this: Renderer.cpp, surface_main.vs)
    depthWrite : false,
    depthCulling : false,
    blending : ${BLENDING},   // (kit_wgpu.sh builds it once for each way a sheet lies on what is behind, as flat.mat: transparent, add, multiply, screen)
    shadingModel : unlit,
    variantFilter : [ skinning, shadowReceiver, vsm ],
    culling: none
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.imageUV.st = getPosition().st * 0.5 + 0.5;
        material.clipSpaceTransform = materialParams.place;   // (where on the stage its picture lies: the box the thing is seen in, Filament's own way of moving a device-domain sheet)
        highp vec4 clip = materialParams.place * getPosition();   // (the point of the world it shows, as Filament's own computeWorldPosition finds one for a device-domain sheet, surface_getters.vs: there before the place, here after it;
        clip.xy = clip.xy * frameUniforms.clipTransform.xy + clip.w * frameUniforms.clipTransform.zw;   // (padded as the sheet is: the world's own matrices are)
        clip.z = clip.z * -0.5 + 0.5;                             //  in the world as the user has it, as getUserWorldPosition says it, surface_getters.fs)
        material.worldAt = getUserWorldFromWorldMatrix() * (getWorldFromClipMatrix() * clip);
    }
}

fragment {
#include "matte.glsl"
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        highp vec2 uv = saturate(variable_imageUV.st);
        uv.t = 1.0 - uv.t;
        material.baseColor = max(texture(materialParams_image, uv.st), 0.0);
        material.baseColor.rgb *= material.baseColor.a;   // (effects give straight colour, as OBS keeps its filters; Filament's transparent wants it times alpha: BlendingMode.TRANSPARENT)
        material.baseColor.rgb *= 1.0 + materialParams.glowing;   // (its glow after its effects: brighter than white, the stage's bloom takes it up, as flat.mat's)
        material.baseColor *= matteLeftAt(variable_worldAt.xyz / variable_worldAt.w) * materialParams.opacity;   // (cut where what clips it is not, its effects' picture and all; and how clear it is, after its effects as After Effects renders a layer: masks, effects, transform)
#if defined(LAY_multiply)
        material.baseColor.rgb += 1.0 - material.baseColor.a;   // (where it is clear, what is behind is left as it is: times one, as flat.mat)
#endif
    }
}
