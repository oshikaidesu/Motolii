// poster.mm: clear glass by Filament's own screen-space refraction, dispersion and thin film (the film colours what
// the glass mirrors; its thickness wanders over the solid, so a mirrored lamp runs through the colours).
// thickness: how deep the solid is, for the bend. lean: how far its faces lean from flat, slowly, this way and that.
// Film and lean go by uv in whole waves: a mesh says by its uv how fast they wander over it.
material {
    name : poster_glass,
    shadingModel : lit,
    blending : fade,
    refractionMode : screenspace,
    refractionType : solid,
    requires : [ uv0 ],
    parameters : [ { type : float, name : thickness }, { type : float, name : lean },
                   { type : float, name : film },         // how much thin film lies on the glass (0: none, 1: all)
                   { type : float, name : split } ]       // how far the colours part in the glass (Filament's dispersion)
}

fragment {
    void material(inout MaterialInputs material) {
        vec2 uv = getUV0();
        material.normal = normalize(vec3(materialParams.lean * vec2(sin(6.2832 * (8.0 * uv.x + uv.y)), sin(6.2832 * (5.0 * uv.x - 2.0 * uv.y) + 2.0)), 1.0));
        prepareMaterial(material);
        material.baseColor = vec4(1.0);
        material.metallic = 0.0;
        material.roughness = 0.0;
        material.reflectance = 0.5;
        material.absorption = vec3(0.048, 0.027, 0.015);
        material.transmission = 1.0;
        material.ior = 1.5;
        material.thickness = materialParams.thickness;
        material.dispersion = materialParams.split;
        material.iridescence = materialParams.film;
        material.iridescenceIor = 1.3;
        material.iridescenceThickness = 450.0 + 250.0 * sin(6.2832 * (3.0 * uv.x + uv.y)) * sin(6.2832 * (7.0 * uv.x - 2.0 * uv.y) + 1.0);
    }
}
