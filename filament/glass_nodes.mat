// EXPERIMENT (VBODY=1 in glass_scene): what a sight line through a glass solid ends up looking at, worked out not per
// pixel but at a grid of points on the solid's own faces: 17 x 17 on every four-sided face, once a frame, whatever
// the size of the picture. The sight line from the camera is bent in at the point, mirrored inside while the glass
// cannot let it out, bent out, and followed on through up to two more solids it meets (found here, per point, not
// per pixel); then where it lands on the floor is turned into a place in the picture, once for the red and once for
// the blue end of the spectrum. glass_vert.mat draws the faces from this table and only reads the backdrop.
// One line per (solid, face), ONE texel per point (289 across):
//   where the middle of the spectrum looks (place in the picture x, y; or its direction x, z if it looks at the sky),
//   the way it went, how much of the light is left (< 0: no way found).
//   The way: while it stays in its own solid and meets at most 4 faces inside, the faces themselves, as
//   (first + 1) + 41 (second + 1) + 41^2 (third + 1) + ... (mirrored at all but the last, let out at the last);
//   otherwise 4e6 and up (some number that is the same for the same way). + 0.5 if it ends on the sky.
// The table says WHICH way a point goes and lets a cell be tested; where a way leads is worked out afresh by
// glass_vert.mat at every corner it draws (the table's own places in the picture were found to be a few pixels off).
// Added onto a cleared target, so that all four numbers arrive as they are.
material {
    name : glass_nodes,
    shadingModel : unlit,
    vertexDomain : device,
    blending : add,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    flipUV : false,
    parameters : [
        { type : sampler2d, name : pose, precision : high, format : float },    // per solid (column): axis x + size; axis y; axis z; place
        { type : sampler2d, name : faces, precision : high, format : float },   // per solid (line), per face 4 texels: a corner (w: 1 if the face is drawn from this table), the two next to it, the outward normal; in the solid's own space
        { type : sampler2d, name : scene, precision : high, format : float },   // every solid's faces in world space (as glass_solid.mat)
        { type : int,    name : solidCount },
        { type : float4[64], name : spheres },
        { type : float,  name : mode },                                         // timing only: 1 = every texel returns at once; 2 = only the first of the three texels of a point is worked out; 3 (to count): texel 0 = faces met inside the own solid (9: never got out), solids gone through, way, weight
        { type : float,  name : search },                                       // 0: do not follow the sight line into other solids
        { type : float,  name : ior },
        { type : float,  name : abbe },
        { type : float,  name : spread },
        { type : float,  name : floorY }
    ]
}

fragment {
    // unpolarised Fresnel reflectance, n1 -> n2, 1 on total reflection
    float fresnel(float ci, float n1, float n2) {
        float s2 = (n1 / n2) * (n1 / n2) * (1.0 - ci * ci);
        if (s2 >= 1.0) return 1.0;
        float ct = sqrt(1.0 - s2);
        float rs = (n1 * ci - n2 * ct) / (n1 * ci + n2 * ct);
        float rp = (n1 * ct - n2 * ci) / (n1 * ct + n2 * ci);
        return 0.5 * (rs * rs + rp * rp);
    }

    const int MAXP = 40;

    // Every place a line o + t d crosses a cone (c: middle of the base, a: axis towards the tip, r, h), side or
    // base: how far and the outward normal there, nearest first. Returns how many (0 to 2). As beam::cone_crossings.
    int coneCross(vec3 c, vec3 a, float r, float h, vec3 o, vec3 d, out float t0, out vec3 n0, out float t1, out vec3 n1) {
        t0 = 0.0; t1 = 0.0;
        n0 = a; n1 = a;
        vec3 w = o - c;
        float k = r / h, y0 = dot(w, a), da = dot(d, a);
        vec3 wp = w - a * y0, dp = d - a * da;
        float A = dot(dp, dp) - k * k * da * da, B = dot(wp, dp) + k * da * (r - k * y0), C = dot(wp, wp) - (r - k * y0) * (r - k * y0);
        float root0 = 0.0, root1 = 0.0;
        int roots = 0;
        if (abs(A) > 1e-7) {
            float disc = B * B - A * C;
            if (disc > 0.0) {
                float sq = sqrt(disc);
                root0 = (-B - sq) / A;
                root1 = (-B + sq) / A;
                roots = 2;
            }
        } else if (abs(B) > 1e-7) {
            root0 = -C / (2.0 * B);
            roots = 1;
        }
        float slope = inversesqrt(1.0 + k * k);
        int count = 0;
        for (int i = 0; i < 2; i++) {
            if (i >= roots) break;
            float tt = i == 0 ? root0 : root1;
            float y = y0 + tt * da;
            if (y < 0.0 || y > h) continue;
            vec3 q = wp + dp * tt;
            float ql = length(q);
            vec3 nn = ql > 1e-6 * r ? (q / ql + a * k) * slope : a;
            if (count == 0) { t0 = tt; n0 = nn; } else { t1 = tt; n1 = nn; }
            count++;
        }
        if (abs(da) > 1e-7 && count < 2) {
            float tb = -y0 / da;
            vec3 q = wp + dp * tb;
            if (dot(q, q) <= r * r) {
                if (count == 0) { t0 = tb; n0 = -a; } else { t1 = tb; n1 = -a; }
                count++;
            }
        }
        if (count == 2 && t1 < t0) {
            float ts = t0; t0 = t1; t1 = ts;
            vec3 ns = n0; n0 = n1; n1 = ns;
        }
        return count;
    }
    // from a point in or on the cone along d: distance to its surface and the outward normal there
    float coneExit(vec3 c, vec3 a, float r, float h, vec3 o, vec3 d, out vec3 n) {
        float t0, t1;
        vec3 n0, n1;
        int count = coneCross(c, a, r, h, o, d, t0, n0, t1, n1);
        n = a;
        if (count >= 1 && t0 > 1e-5 * r && dot(n0, d) > 0.0) { n = n0; return t0; }
        if (count >= 2 && t1 > 1e-5 * r && dot(n1, d) > 0.0) { n = n1; return t1; }
        // nothing found (a sight line along the surface): leave where it stands
        n = normalize(d);
        return 0.0;
    }

    const int MAXS = 64;
    vec4 sceneAt(int x, int row) { return texelFetch(materialParams_scene, ivec2(x, row), 0); }
    // does a sight line in the air meet solid k? how far, and the face normal there
    bool meets(int k, vec3 o, vec3 d, out float t, out vec3 n) {
        vec4 info = sceneAt(1, k);
        int kind = int(info.y + 0.5);
        n = vec3(0.0, 1.0, 0.0);
        t = 0.0;
        if (kind == 1) {
            vec3 w = o - sceneAt(0, k).xyz;
            float b = dot(w, d), disc = b * b - (dot(w, w) - info.z * info.z);
            if (disc <= 0.0) return false;
            t = -b - sqrt(disc);
            if (t < -1e-5) return false;
            n = normalize(w + d * t);
            return true;
        }
        if (kind == 2) {
            vec3 a = sceneAt(2, k).xyz, w = o - sceneAt(0, k).xyz;
            float wa = dot(w, a), da = dot(d, a);
            vec3 wp = w - a * wa, dp = d - a * da;
            float tinS = -1e9, toutS = 1e9, tinC = -1e9, toutC = 1e9;
            if (abs(da) > 1e-6) {
                float t1 = (-info.w - wa) / da, t2 = (info.w - wa) / da;
                tinS = min(t1, t2);
                toutS = max(t1, t2);
            } else if (abs(wa) > info.w) return false;
            float A = dot(dp, dp), B = dot(wp, dp), C = dot(wp, wp) - info.z * info.z;
            if (A > 1e-9) {
                float disc = B * B - A * C;
                if (disc <= 0.0) return false;
                float sq = sqrt(disc);
                tinC = (-B - sq) / A;
                toutC = (-B + sq) / A;
            } else if (C > 0.0) return false;
            float tin = max(tinS, tinC), tout = min(toutS, toutC);
            if (tin >= tout || tin < -1e-5) return false;
            t = tin;
            if (tinC >= tinS) {
                vec3 q = w + d * t;
                n = normalize(q - a * dot(q, a));
            } else {
                n = da < 0.0 ? a : -a;
            }
            return true;
        }
        if (kind == 3) {
            float t1;
            vec3 n1;
            int count = coneCross(sceneAt(3, k).xyz, sceneAt(2, k).xyz, info.z, info.w, o, d, t, n, t1, n1);
            return count == 2 && t >= -1e-5 && dot(n, d) < 0.0;
        }
        int cnt = int(info.x + 0.5);
        float tin = -1e9, tout = 1e9;
        for (int j = 0; j < MAXP; j++) {
            if (j >= cnt) break;
            vec4 pl = sceneAt(3 + j, k);
            float dj = dot(pl.xyz, d), off = pl.w - dot(pl.xyz, o);
            if (dj < -1e-6) { float tt = off / dj; if (tt > tin) { tin = tt; n = pl.xyz; } }
            else if (dj > 1e-6) tout = min(tout, off / dj);
            else if (off < 0.0) return false;
        }
        t = tin;
        return tin < tout && tin >= -1e-5;
    }
    // the next solid a sight line in the air meets (not `from`): which one, how far, and the face normal there
    bool nextSolid(vec3 o, vec3 d, int from, out int S, out float t, out vec3 n) {
        t = 1e9;
        S = -1;
        n = vec3(0.0, 1.0, 0.0);
        for (int k = 0; k < MAXS; k++) {
            if (k >= materialParams.solidCount) break;
            if (k == from) continue;
            vec4 sp = materialParams.spheres[k];   // (the same numbers as texel 0 of the table, without a lookup per solid per pixel)
            vec3 rel = sp.xyz - o;
            float along = dot(rel, d);
            if (along < -sp.w || dot(rel, rel) - along * along > sp.w * sp.w) continue;
            float tk;
            vec3 nk;
            if (meets(k, o, d, tk, nk) && tk < t) { t = tk; S = k; n = nk; }
        }
        return S >= 0;
    }
    // from a point in or on solid k (world space) along d: distance to its surface and the outward normal there
    float exitWorld(int k, vec3 o, vec3 d, out vec3 n) {
        float t = 1e9;
        n = vec3(0.0, 1.0, 0.0);
        vec4 info = sceneAt(1, k);
        int kind = int(info.y + 0.5);
        if (kind == 1) {
            vec3 w = o - sceneAt(0, k).xyz;
            float b = dot(w, d);
            t = -b + sqrt(max(b * b - (dot(w, w) - info.z * info.z), 0.0));
            n = normalize(w + d * t);
            return max(t, 0.0);
        }
        if (kind == 2) {
            vec3 a = sceneAt(2, k).xyz, w = o - sceneAt(0, k).xyz;
            float wa = dot(w, a), da = dot(d, a);
            vec3 wp = w - a * wa, dp = d - a * da;
            float tS = 1e9, tC = 1e9;
            if (da > 1e-6) tS = (info.w - wa) / da;
            else if (da < -1e-6) tS = (-info.w - wa) / da;
            float A = dot(dp, dp), B = dot(wp, dp), C = dot(wp, wp) - info.z * info.z;
            if (A > 1e-9) tC = (-B + sqrt(max(B * B - A * C, 0.0))) / A;
            if (tC <= tS) {
                vec3 q = w + d * tC;
                n = normalize(q - a * dot(q, a));
                return max(tC, 0.0);
            }
            n = da > 0.0 ? a : -a;
            return max(tS, 0.0);
        }
        if (kind == 3) return coneExit(sceneAt(3, k).xyz, sceneAt(2, k).xyz, info.z, info.w, o, d, n);
        int cnt = int(info.x + 0.5);
        for (int j = 0; j < MAXP; j++) {
            if (j >= cnt) break;
            vec4 pl = sceneAt(3 + j, k);
            float den = dot(pl.xyz, d);
            if (den > 1e-6) {
                float ti = (pl.w - dot(pl.xyz, o)) / den;
                if (ti < t) { t = ti; n = pl.xyz; }
            }
        }
        return max(t, 0.0);
    }



    float iorAt(float nm) {
        // two-term Cauchy from the Abbe number, as beam::Glass::n
        float B = (materialParams.ior - 1.0) / (materialParams.abbe * (1.0 / (486.13 * 486.13) - 1.0 / (656.27 * 656.27)));
        return materialParams.ior + B * (1.0 / (nm * nm) - 1.0 / (587.56 * 587.56));
    }
    // where a sight line that has left the glass at p (the user's world space) along d looks: its place in the
    // picture, or false if it does not come down on the floor in front of the camera
    bool looksAt(vec3 p, vec3 d, vec3 shift, out vec2 uv) {
        uv = vec2(0.0);
        if (!(d.y < -1e-4)) return false;
        float t = (materialParams.floorY - p.y) / d.y;
        if (t < 0.0) return false;
        highp vec4 clip = getClipFromWorldMatrix() * vec4(p + d * t - shift, 1.0);
        if (!(clip.w > 1e-4)) return false;
        uv = clamp(clip.xy / clip.w * 0.5 + 0.5, vec2(0.001), vec2(0.999));
        return true;
    }

    // as exitWorld, for a flat-faced solid, and says which of its faces it is
    float exitFace(int k, vec3 o, vec3 d, out vec3 n, out int face) {
        float t = 1e9;
        n = vec3(0.0, 1.0, 0.0);
        face = -1;
        int cnt = int(sceneAt(1, k).x + 0.5);
        for (int j = 0; j < MAXP; j++) {
            if (j >= cnt) break;
            vec4 pl = sceneAt(3 + j, k);
            float den = dot(pl.xyz, d);
            if (den > 1e-6) {
                float ti = (pl.w - dot(pl.xyz, o)) / den;
                if (ti < t) { t = ti; n = pl.xyz; face = j; }
            }
        }
        return max(t, 0.0);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        ivec2 px = ivec2(gl_FragCoord.xy);
        int node = px.x, part = 0;
        int solid = px.y / 6, face = px.y - solid * 6;
        vec4 r0 = vec4(0.0, 0.0, 0.0, -1.0), r1 = vec4(-1.0), r2 = vec4(0.0, -1.0, 0.0, 0.0);
        vec4 f0 = texelFetch(materialParams_faces, ivec2(face * 4, solid), 0);
        if (solid < materialParams.solidCount && node < 289 && f0.w > 0.5 && (materialParams.mode < 0.5 + (part == 0 ? 2.0 : 0.0) || materialParams.mode > 2.5) && materialParams.mode != 1.0) {
            vec3 c1 = texelFetch(materialParams_faces, ivec2(face * 4 + 1, solid), 0).xyz;
            vec3 c2 = texelFetch(materialParams_faces, ivec2(face * 4 + 2, solid), 0).xyz;
            vec3 nf = texelFetch(materialParams_faces, ivec2(face * 4 + 3, solid), 0).xyz;
            vec4 ax = texelFetch(materialParams_pose, ivec2(solid, 0), 0);
            vec3 ay = texelFetch(materialParams_pose, ivec2(solid, 1), 0).xyz;
            vec3 az = texelFetch(materialParams_pose, ivec2(solid, 2), 0).xyz;
            vec3 at = texelFetch(materialParams_pose, ivec2(solid, 3), 0).xyz;
            int j = node / 17, i = node - j * 17;
            vec3 pl = f0.xyz + (c1 - f0.xyz) * (float(i) / 16.0) + (c2 - f0.xyz) * (float(j) / 16.0);
            vec3 P = (ax.xyz * pl.x + ay * pl.y + az * pl.z) * ax.w + at;
            vec3 nw = ax.xyz * nf.x + ay * nf.y + az * nf.z;
            vec3 shift = getUserWorldFromWorldMatrix()[3].xyz;     // Filament's world space is the user's, moved
            vec3 eye = getWorldCameraPosition() + shift;
            vec3 view = normalize(P - eye);
            if (dot(nw, view) < -1e-4) {
                float n0 = materialParams.ior;
                float way = 1.0 + float(face);
                vec3 rd = refract(view, nw, 1.0 / n0), ro = P;
                float path = 0.0, through = 1.0;
                vec3 lastIn = rd, lastN = nw;
                bool outOk = false;
                int cur = solid;
                float legs = 0.0, solids = 1.0, code = 0.0, place = 1.0;
                for (int seg = 0; seg < 3; seg++) {
                    bool left = false;
                    for (int b = 0; b < 6; b++) {
                        vec3 fn;
                        int met = -1;
                        float t = seg == 0 ? exitFace(cur, ro, rd, fn, met) : exitWorld(cur, ro, rd, fn);
                        if (t > 1e8) break;
                        ro += rd * t;
                        path += t;
                        if (seg == 0) {
                            legs += 1.0;
                            code += float(met + 1) * place;
                            place *= 41.0;
                        }
                        way = way * 1.37 + dot(fn, vec3(1.0, 2.0, 4.0)) + float(cur);
                        vec3 o1 = refract(rd, -fn, n0);
                        if (dot(o1, o1) > 0.0) {
                            lastIn = rd;
                            lastN = fn;
                            left = true;
                            break;
                        }
                        rd = reflect(rd, fn);
                    }
                    outOk = left;
                    if (!left || seg == 2 || materialParams.solidCount <= 1 || materialParams.search < 0.5) break;
                    // on through whatever other glass it meets
                    vec3 wd = refract(lastIn, -lastN, n0);
                    int nx;
                    float tn;
                    vec3 nn;
                    if (!nextSolid(ro, wd, cur, nx, tn, nn)) break;
                    through *= 1.0 - fresnel(dot(lastIn, lastN), n0, 1.0);
                    ro += wd * tn;
                    through *= 1.0 - fresnel(clamp(-dot(wd, nn), 0.0, 1.0), 1.0, n0);
                    rd = refract(wd, nn, 1.0 / n0);
                    cur = nx;
                    solids += 1.0;
                    way = way * 1.37 + float(nx) + 0.5;
                    outOk = false;
                }
                if (outOk) {
                    way = solids < 1.5 && legs < 4.5 ? code : 4.0e6 + mod(abs(way), 3.0e6) + (solids > 1.5 ? 4.0e6 : 0.0);
                    float weight = through * (1.0 - fresnel(dot(lastIn, lastN), n0, 1.0));
                    vec3 dMid = refract(lastIn, -lastN, n0);
                    vec3 dRed = refract(lastIn, -lastN, n0 + (iorAt(670.0) - n0) * materialParams.spread);
                    vec3 dBlue = refract(lastIn, -lastN, n0 + (iorAt(430.0) - n0) * materialParams.spread);
                    if (dot(dRed, dRed) <= 0.0) dRed = dMid;      // (a colour the glass would not let out here leaves with the middle)
                    if (dot(dBlue, dBlue) <= 0.0) dBlue = dMid;
                    vec2 uvM, uvR, uvB;
                    if (looksAt(ro, dMid, shift, uvM)) {
                        if (!looksAt(ro, dRed, shift, uvR)) uvR = uvM;
                        if (!looksAt(ro, dBlue, shift, uvB)) uvB = uvM;
                        r0 = vec4(uvM, way, weight);
                        r1 = vec4(uvR, uvB);
                    } else {
                        r0 = vec4(dMid.xz, way + 0.5, weight);      // the sky: its direction stands in for the place
                    }
                    r2 = vec4(dMid, path);
                }
                if (materialParams.mode > 2.5) r0 = vec4(outOk ? legs : 9.0, solids, way, outOk ? 1.0 : 0.5);
            }
        }
        material.baseColor = part == 0 ? r0 : (part == 1 ? r1 : r2);
    }
}
