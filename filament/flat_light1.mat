// EXPERIMENT (RAINBOW1=1 in glass_scene): flat_light.mat drawing every piece ONCE instead of once per colour step.
// flat_walk1.mat gives, per piece, where it lands with the red end of the spectrum and where with the blue end.
// The piece is drawn half way between, with the strip along every edge pulled out to both ends. A pixel asks for
// which stretch of the way from red to blue the piece, sliding along, covers it, and takes the colours of exactly
// that stretch: the difference of a running sum of the spectrum (`rainbow`) at the two ends of the stretch.
// Colours are continuous (no steps), and there is a ninth of the corners to work out. The second instance of each
// solid is the white light mirrored off the outside, as before.
material {
    name : flat_light1,
    shadingModel : unlit,
    blending : add,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    instanced : true,
    flipUV : false,
    requires : [ uv0 ],
    variables : [ light, where, slide, land ],
    parameters : [
        { type : sampler2d, name : walk, precision : high, format : float },    // written by flat_walk.mat
        { type : sampler2d, name : hull, precision : high, format : float },    // beam::FlatShape::hull, one line per shape
        { type : float,  name : shape },                                        // which line of `hull`
        { type : float4[32], name : rainbow },                                  // the spectrum summed up from the red end (0) to the blue end (1)
        { type : float,  name : stepCount },                                    // colour steps + 1 (the last: mirrored off the outside, white)
        { type : float4[16], name : solids },                                   // which solids have this shape (their columns in the pose table), 4 per entry
        { type : float4[6], name : room, precision : high },                    // the stage: see recv_drop.glsl
        { type : float,  name : roomCount },
        { type : float4[16], name : blocks, precision : high },
        { type : float,  name : blockCount },
        { type : float,  name : recvCount },
        { type : float,  name : recvChooses },
        { type : float3, name : recvSun },
        { type : float,  name : pxScale },
        { type : float,  name : floorY }
    ]
}

vertex {
#include "recv_drop.glsl"
    // the three carried corners of a piece on one line of the walk: where they land (x, z, distance flown), how bright, which way
    void carried(int piece, int line, out vec3 l0, out vec3 l1, out vec3 l2, out float gain, out float way) {
        vec4 t0 = texelFetch(materialParams_walk, ivec2(piece * 3, line), 0);
        vec4 t1 = texelFetch(materialParams_walk, ivec2(piece * 3 + 1, line), 0);
        vec4 t2 = texelFetch(materialParams_walk, ivec2(piece * 3 + 2, line), 0);
        l0 = t0.xyz; l1 = t1.xyz; l2 = t2.xyz;
        gain = t0.w;
        way = t1.w;
    }
    void materialVertex(inout MaterialVertexInputs material) {
        int stepsAll = int(materialParams.stepCount);
        int per = recvPer();
        int recv = getInstanceIndex() - (getInstanceIndex() / per) * per;   // which receiver this instance draws on (recv_drop.glsl)
        int inst = getInstanceIndex() / per;
        int stretches = (stepsAll - 1) / 2;            // the spectrum is drawn in this many stretches, then once mirrored
        int which = inst / (stretches + 1);
        int stretch = inst - which * (stretches + 1);
        bool mirrored = stretch == stretches;
        int solid = int(materialParams.solids[which / 4][which - (which / 4) * 4] + 0.5);
        int line = solid * stepsAll + (mirrored ? stepsAll - 1 : stretch * 2);
        int piece = int(floor(mesh_position.x + 0.25));
        bool outer = mesh_position.x - float(piece) > 0.25;
        vec2 ab = mesh_position.yz;

        vec3 l0, l1, l2;
        float gain, way;
        carried(piece, line, l0, l1, l2, gain, way);
        vec2 toNext = vec2(0.0), toPrev = vec2(0.0);   // how far the piece slides from where it is drawn to the blue / to the red end, in (a, b)
        if (gain > 0.0 && !mirrored) {
            int shape = int(materialParams.shape + 0.5);
            vec2 middle = texelFetch(materialParams_hull, ivec2(piece * 5 + 4, shape), 0).xy;
            vec3 b0, b1, b2;
            float gainB = 0.0, wayB = 0.0;
            carried(piece, line + 1, b0, b1, b2, gainB, wayB);
            if (gainB > 0.0) {
                vec2 red = (l0 + (l1 - l0) * middle.x + (l2 - l0) * middle.y).xy, blue = (b0 + (b1 - b0) * middle.x + (b2 - b0) * middle.y).xy;
                // drawn half way between the two ends
                l0 = 0.5 * (l0 + b0);
                l1 = 0.5 * (l1 + b1);
                l2 = 0.5 * (l2 + b2);
                vec2 e1 = (l1 - l0).xy, e2 = (l2 - l0).xy;
                float det = e1.x * e2.y - e1.y * e2.x;
                if (abs(det) > 1e-12) {
                    vec2 gap = 0.5 * (blue - red);
                    toNext = vec2(gap.x * e2.y - gap.y * e2.x, e1.x * gap.y - e1.y * gap.x) / det;
                    toPrev = -toNext;
                }
            }
            if (outer) {
                // the outer side of the strip along an edge: pulled out as far as the smear goes on that side
                vec2 facing = mesh_uv0;
                if (dot(facing, toNext) > 0.0) ab += toNext;
                else if (dot(facing, toPrev) > 0.0) ab += toPrev;
            }
        }
        vec3 q = l0 + (l1 - l0) * ab.x + (l2 - l0) * ab.y;   // x, z, distance flown
        vec3 rgb = vec3(gain);
        vec2 span = mirrored ? vec2(0.0, 1.0) : vec2(float(stretch), float(stretch + 1)) / float(stretches);   // this stretch of the spectrum
        float t, ok, owner;
        highp vec3 start;
        highp vec3 X = recvDrop(recv, q.xy, q.z, true, rgb, t, ok, owner, start);
        material.light = vec4(rgb.x, span, t);
        material.where = vec4(ab, float(piece), ok);
        material.slide = vec4(toNext, toPrev);
        material.land = vec4(start, owner);
        material.worldPosition = recvNearer(mulMat4x4Float3(getWorldFromModelMatrix(), X), owner);
    }
}

fragment {
#include "recv_lands.glsl"
#include "recv_finish.glsl"
    // the spectrum summed up from the red end to s (0 red .. 1 blue); all of it is white, 1
    vec3 rainbowTo(float s) {
        float x = clamp(s, 0.0, 1.0) * 31.0;
        int i = min(int(x), 30);
        return mix(materialParams.rainbow[i].rgb, materialParams.rainbow[i + 1].rgb, x - float(i));
    }
    // for how much of the stretch from p to p - d the point is inside the half plane left of the edge a -> b: narrows [lo, hi]
    void keep(vec2 a, vec2 b, vec2 p, vec2 d, inout float lo, inout float hi) {
        vec2 e = b - a;
        float h = e.x * (p.y - a.y) - e.y * (p.x - a.x);   // > 0 inside
        float s = e.x * d.y - e.y * d.x;                    // inside-ness falls by this much over the whole stretch
        if (abs(s) < 1e-9) {
            if (h < 0.0) hi = -1.0;
        } else if (s > 0.0) hi = min(hi, h / s);
        else lo = max(lo, h / s);
    }
    // the stretch [lo, hi] of the way along d (from the piece where it is, 0, to the piece moved by d, 1) for which the
    // piece covers p; false: none
    bool covered(vec2 p, vec2 d, bool square, int piece, out float lo, out float hi) {
        lo = 0.0;
        hi = 1.0;
        if (square) {
            keep(vec2(0.0, 0.0), vec2(1.0, 0.0), p, d, lo, hi);
            keep(vec2(1.0, 0.0), vec2(1.0, 1.0), p, d, lo, hi);
            keep(vec2(1.0, 1.0), vec2(0.0, 1.0), p, d, lo, hi);
            keep(vec2(0.0, 1.0), vec2(0.0, 0.0), p, d, lo, hi);
        } else {
            int shape = int(materialParams.shape + 0.5);
            vec4 c0 = texelFetch(materialParams_hull, ivec2(piece * 5, shape), 0);
            vec4 c1 = texelFetch(materialParams_hull, ivec2(piece * 5 + 1, shape), 0);
            vec4 c2 = texelFetch(materialParams_hull, ivec2(piece * 5 + 2, shape), 0);
            vec4 c3 = texelFetch(materialParams_hull, ivec2(piece * 5 + 3, shape), 0);
            keep(c0.xy, c0.zw, p, d, lo, hi);
            keep(c0.zw, c1.xy, p, d, lo, hi);
            keep(c1.xy, c1.zw, p, d, lo, hi);
            keep(c1.zw, c2.xy, p, d, lo, hi);
            keep(c2.xy, c2.zw, p, d, lo, hi);
            keep(c2.zw, c3.xy, p, d, lo, hi);
            keep(c3.xy, c3.zw, p, d, lo, hi);
            keep(c3.zw, c0.xy, p, d, lo, hi);
        }
        return hi > lo;
    }
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 span = variable_light.yz;
        vec4 c = vec4(vec3(variable_light.x), variable_light.w);
        vec4 slide = variable_slide;
        if (dot(slide, slide) > 1e-14) {
            int piece = int(variable_where.z + 0.5);
            int shape = int(materialParams.shape + 0.5);
            bool square = texelFetch(materialParams_hull, ivec2(piece * 5 + 4, shape), 0).z > 0.5;
            // the colours of the stretch of the spectrum for which the piece, sliding from red (0) over where it is
            // drawn (0.5) to blue (1), covers this pixel
            vec3 colours = vec3(0.0);
            float lo, hi;
            float mid = 0.5 * (span.x + span.y), half_ = 0.5 * (span.y - span.x);
            if (covered(variable_where.xy, slide.xy, square, piece, lo, hi)) colours += rainbowTo(mid + half_ * hi) - rainbowTo(mid + half_ * lo);
            if (covered(variable_where.xy, slide.zw, square, piece, lo, hi)) colours += rainbowTo(mid - half_ * lo) - rainbowTo(mid - half_ * hi);
            c.rgb *= colours;
        } else {
            c.rgb *= rainbowTo(span.y) - rainbowTo(span.x);   // (the colours of this stretch all land on one another)
        }
        material.baseColor = recvFinish(c, variable_where.w, floor(variable_land.w + 0.5), variable_land.xyz, false);
    }
}
