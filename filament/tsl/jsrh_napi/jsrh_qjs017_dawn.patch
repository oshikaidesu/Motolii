+// Motolii: napi_add_finalizer, which this file lacks (Dawn's dawn.node uses it), made of napi_create_external's own
+// parts: an ExternalData whose class finalizer runs the callback once, held by the object under a symbol of its own
+// (non-enumerable), so it goes when the object goes.
+napi_status napi_add_finalizer(napi_env env, napi_value js_object, void* finalize_data, napi_finalize finalize_cb, void* finalize_hint, napi_ref* result) {
+  CHECK_ENV(env);
+  CHECK_ARG(env, js_object);
+  CHECK_ARG(env, finalize_cb);
+
+  JSValue jsObject = ToJSValue(js_object);
+  if (!JS_IsObject(jsObject)) {
+    return napi_set_last_error(env, napi_object_expected);
+  }
+  JSRuntime* rt = JS_GetRuntime(env->context);
+  InitClassIds(rt);
+
+  JSValue holder = JS_NewObjectClass(env->context, js_external_class_id);
+  JS_SetOpaque(holder, new ExternalData(env, finalize_data, finalize_cb, finalize_hint));
+  JSValue key = JS_NewSymbol(env->context, "napi_finalizer", false);
+  JSAtom atom = JS_ValueToAtom(env->context, key);
+  JS_FreeValue(env->context, key);
+  JS_DefinePropertyValue(env->context, jsObject, atom, holder, 0);
+  JS_FreeAtom(env->context, atom);
+
+  if (result != nullptr) {
+    CHECK_NAPI(napi_create_reference(env, js_object, 0, result));
+  }
+  napi_clear_last_error(env);
+  return napi_ok;
+}
+
+// Motolii: instance data, which this file lacks, kept on the env as NativeScript/runtimes's quickjs-api.c keeps it
+// (napi_set_instance_data, napi_get_instance_data).
+napi_status napi_set_instance_data(napi_env env, void* data, napi_finalize finalize_cb, void* finalize_hint) {
+  CHECK_ENV(env);
+  env->instance_data = data;
+  env->instance_data_finalize_cb = finalize_cb;
+  env->instance_data_finalize_hint = finalize_hint;
+  napi_clear_last_error(env);
+  return napi_ok;
+}
+
+napi_status napi_get_instance_data(napi_env env, void** data) {
+  CHECK_ENV(env);
+  CHECK_ARG(env, data);
+  *data = env->instance_data;
+  napi_clear_last_error(env);
+  return napi_ok;
+}
