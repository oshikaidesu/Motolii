+import type { Node } from "three/webgpu"
+import { abs, mix, smoothstep, uniform, vec2, viewportUV } from "three/tsl"
+import { gaussianBlur } from "three/examples/jsm/tsl/display/GaussianBlurNode.js"
+
+// The mix from webgpu-tiltshift.ts. sceneColor is the picture already in hand; the cube scene stays in that file.
+export function tiltShiftColor(sceneColor: Node, focus = 0.5, blurAmount = 1, gradientRadius = 0.1): Node {
+  const focusPosUniform = uniform(focus)
+  const blurAmountUniform = uniform(blurAmount)
+  const gradientRadiusUniform = uniform(gradientRadius)
+
+  const blurDirection = vec2(blurAmountUniform, blurAmountUniform)
+  const blurredScene = gaussianBlur(sceneColor, blurDirection, 4)
+
+  const uv = viewportUV
+  const dist = abs(uv.y.sub(focusPosUniform))
+  const blurStrength = smoothstep(gradientRadiusUniform, gradientRadiusUniform.add(0.2), dist)
+
+  return mix(sceneColor, blurredScene, blurStrength) as Node
+}
