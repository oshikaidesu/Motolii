diff --git a/quickjs/quickjs-api.c b/quickjs/quickjs-api.c
index d7b23e5..70c776b 100644
--- a/quickjs/quickjs-api.c
+++ b/quickjs/quickjs-api.c
@@ -2205,7 +2205,18 @@ napi_status napi_coerce_to_object(napi_env env, napi_value value,
   CHECK_ARG(value)
   CHECK_ARG(result)
 
-  return napi_clear_last_error(env);
+  // As BabylonJS/JsRuntimeHost does it (Core/Node-API/Source/js_native_api_quickjs.cc:868-889, 980cfb0): the
+  // value through the global Object(), which hands an object back as it is.
+  JSValue global = JS_GetGlobalObject(env->context);
+  JSValue objectCtor = JS_GetPropertyStr(env->context, global, "Object");
+  JSValueConst args[1] = {ToJS(value)};
+  JSValue jsObject = JS_Call(env->context, objectCtor, JS_UNDEFINED, 1, args);
+  JS_FreeValue(env->context, objectCtor);
+  JS_FreeValue(env->context, global);
+  if (JS_IsException(jsObject)) {
+    return napi_set_last_error(env, napi_pending_exception, NULL, 0, NULL);
+  }
+  return CreateScopedResult(env, jsObject, result);
 }
 
 napi_status napi_coerce_to_string(napi_env env, napi_value value,
