+// as a GPUDevice, made as GPUAdapter::requestDevice makes one (GPUAdapter.cpp:250-255), lent (GPUDevice::Lent).
+Napi::Value WrapDevice(const Napi::CallbackInfo& info) {
+    Napi::Env env = info.Env();
+    bool exact = false;
+    auto device = reinterpret_cast<WGPUDevice>(info[0].As<Napi::BigInt>().Uint64Value(&exact));
