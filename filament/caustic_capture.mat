material {
    name : caustic_capture,
    shadingModel : lit,
    specularAntiAliasing : false,
    parameters : [
        { type : float3, name : origin },
        { type : float3, name : dir }
    ]
}

fragment {
    vec2 octEncode(vec3 n) {
        n /= abs(n.x) + abs(n.y) + abs(n.z);
        if (n.z < 0.0) n.xy = (vec2(1.0) - abs(n.yx)) * sign(n.xy);
        return n.xy * 0.5 + 0.5;
    }
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 n = normalize(getWorldNormalVector());
        float d = dot(getWorldPosition().xyz, materialParams.dir);
        material.baseColor = vec4(0.0);
        material.roughness = 1.0;
        material.metallic = 0.0;
        material.reflectance = 0.0;
        material.emissive = vec4(octEncode(n), d, 0.0);
    }
}
