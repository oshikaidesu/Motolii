// One pixel, one ray. The quad pass reads this texture instead of walking again.
material {
    name : xcube_hit,
    shadingModel : unlit,
    vertexDomain : device,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    parameters : [
        { type : float3, name : center },
        { type : float3, name : ax },
        { type : float3, name : ay },
        { type : float3, name : az },
        { type : float3, name : dir },
        { type : float3, name : tangent },
        { type : float3, name : bitangent },
        { type : float, name : halfExtent },
        { type : float, name : extent },
        { type : float, name : grid },
        { type : float, name : bands },
        { type : float, name : ior },
        { type : float, name : dispersion },
        { type : float, name : hitW },
        { type : float, name : hitH },
        { type : float, name : bevel },
        { type : float, name : tilt }
    ],
    requires : [ uv0 ]
}

fragment {
    float dot3(vec3 a, vec3 b) { return dot(a, b); }

    float n_of(float nm) {
        float offset = 0.70795215 + (nm - 486.1) / (656.3 - 486.1) * (-0.29204785 - 0.70795215);
        float P = materialParams.dispersion / 20.0;
        return max(1.05, materialParams.ior + P * (materialParams.ior - 1.0) * offset);
    }

    float fresnel(float cosi, float n1, float n2) {
        float r0 = (n1 - n2) / (n1 + n2);
        r0 *= r0;
        float c = clamp(1.0 - cosi, 0.0, 1.0);
        return r0 + (1.0 - r0) * c * c * c * c * c;
    }

    bool bend(vec3 I, vec3 N, float eta, inout vec3 T) {
        float cosi = clamp(-dot3(I, N), -1.0, 1.0);
        float k = 1.0 - eta * eta * (1.0 - cosi * cosi);
        if (k < 0.0) return false;
        T = normalize(I * eta + N * (eta * cosi - sqrt(k)));
        return true;
    }

    bool ray_box(vec3 ro, vec3 rd, inout float tNear, inout float tFar, inout int faceFar) {
        vec3 ax = materialParams.ax;
        vec3 ay = materialParams.ay;
        vec3 az = materialParams.az;
        vec3 o = vec3(dot3(ro - materialParams.center, ax), dot3(ro - materialParams.center, ay), dot3(ro - materialParams.center, az));
        vec3 d = vec3(dot3(rd, ax), dot3(rd, ay), dot3(rd, az));
        tNear = -1e9;
        tFar = 1e9;
        faceFar = 0;
        float h = materialParams.halfExtent;
        for (int i = 0; i < 3; i++) {
            if (abs(d[i]) < 1e-6) {
                if (o[i] < -h || o[i] > h) return false;
            } else {
                float ta = (-h - o[i]) / d[i];
                float tb = (h - o[i]) / d[i];
                int fa = i * 2;
                int fb = i * 2 + 1;
                if (ta > tb) {
                    float ts = ta; ta = tb; tb = ts;
                    int fs = fa; fa = fb; fb = fs;
                }
                if (ta > tNear) tNear = ta;
                if (tb < tFar) { tFar = tb; faceFar = fb; }
                if (tNear > tFar) return false;
            }
        }
        return tFar > 0.0;
    }

    vec3 face_n(int face) {
        vec3 a = face / 2 == 0 ? materialParams.ax : (face / 2 == 1 ? materialParams.ay : materialParams.az);
        return a * ((face - (face / 2) * 2) == 1 ? 1.0 : -1.0);
    }

    float coat_R(int which, float nm) {
        if (which == 0) return nm >= 600.0 ? 1.0 : 0.0;
        return nm < 490.0 ? 1.0 : 0.0;
    }

    bool in_cube(vec3 p) {
        float h = materialParams.halfExtent + 0.001;
        vec3 q = p - materialParams.center;
        if (abs(dot3(q, materialParams.ax)) > h) return false;
        if (abs(dot3(q, materialParams.ay)) > h) return false;
        if (abs(dot3(q, materialParams.az)) > h) return false;
        return true;
    }

    vec3 bevel_n(vec3 p, vec3 N) {
        float b = materialParams.bevel;
        if (b < 0.0001) return N;
        float h = materialParams.halfExtent;
        vec3 q = p - materialParams.center;
        vec3 n = N;
        float cx = dot3(q, materialParams.ax);
        float cy = dot3(q, materialParams.ay);
        float cz = dot3(q, materialParams.az);
        if (abs(cx) > h - b && abs(dot3(N, materialParams.ax)) < 0.5) n += materialParams.ax * sign(cx);
        if (abs(cy) > h - b && abs(dot3(N, materialParams.ay)) < 0.5) n += materialParams.ay * sign(cy);
        if (abs(cz) > h - b && abs(dot3(N, materialParams.az)) < 0.5) n += materialParams.az * sign(cz);
        return normalize(n);
    }

    bool coat_hit(vec3 o, vec3 d, vec3 n0, inout float tLim, inout vec3 hn) {
        vec3 tangent = normalize(cross(materialParams.ay, n0));
        float band = (2.0 * materialParams.halfExtent) / 3.0;
        bool any = false;
        for (int k = -1; k <= 1; k++) {
            float ang = float(k) * materialParams.tilt;
            vec3 n = normalize(n0 * cos(ang) + tangent * sin(ang));
            float den = dot3(d, n);
            if (abs(den) < 1e-5) continue;
            vec3 origin = materialParams.center + materialParams.ay * (float(k) * band);
            float tp = dot3(origin - o, n) / den;
            if (tp <= 0.0012 || tp >= tLim) continue;
            vec3 p = o + d * tp;
            if (!in_cube(p)) continue;
            float along = dot3(p - materialParams.center, materialParams.ay);
            if (abs(along - float(k) * band) > band * 0.55) continue;
            tLim = tp;
            hn = n;
            any = true;
        }
        return any;
    }

    vec3 walk(int ix, int iy, int path, float nm, float n) {
        float cell = (2.0 * materialParams.extent) / (materialParams.grid - 1.0);
        float su = -materialParams.extent + float(ix) * cell;
        float sv = -materialParams.extent + float(iy) * cell;
        vec3 rd = materialParams.dir;
        vec3 ro = materialParams.center - rd * 1.6 + materialParams.tangent * su + materialParams.bitangent * sv;
        float tNear, tFar;
        int faceFar;
        if (!ray_box(ro, rd, tNear, tFar, faceFar) || tNear <= 0.001) return vec3(0.0);
        float t0 = tNear;
        int f0 = 0;
        float best = 1e9;
        for (int f = 0; f < 6; f++) {
            vec3 fn = face_n(f);
            float den = dot3(rd, fn);
            if (abs(den) < 1e-6) continue;
            float t = dot3((materialParams.center + fn * materialParams.halfExtent) - ro, fn) / den;
            if (t > 0.001 && abs(t - t0) < abs(best - t0)) { best = t; f0 = f; }
        }
        vec3 N = bevel_n(ro + rd * t0, face_n(f0));
        if (dot3(rd, N) > 0.0) N = -N;
        vec3 T;
        if (!bend(rd, N, 1.0 / n, T)) return vec3(0.0);
        vec3 o = ro + rd * t0 + T * 0.0002;
        vec3 d = T;
        float e = 1.0 - fresnel(clamp(-dot3(rd, N), 0.0, 1.0), 1.0, n);
        int reflA = (path == 3 || path == 5 || path == 6) ? 1 : 0;
        int reflB = (path == 4 || path == 5 || path == 7) ? 1 : 0;
        int exitAt = (path == 1 || path == 6 || path == 7) ? 1 : (path == 2 ? 2 : 0);
        if (reflA == 0 && reflB == 0) e *= 0.22;
        int exits = 0;
        bool didA = false;
        bool didB = false;
        vec3 nA = normalize(materialParams.ax - materialParams.az);
        vec3 nB = normalize(materialParams.ax + materialParams.az);
        for (int step = 0; step < 8; step++) {
            if (e < 0.02) return vec3(0.0);
            int ff = 0;
            if (!ray_box(o, d, tNear, tFar, ff) || tFar < 0.0001) return vec3(0.0);
            float tHit = tFar;
            int kind = 0;
            vec3 hn = face_n(ff);
            if (!didA && coat_hit(o, d, nA, tHit, hn)) kind = 1;
            if (!didB && coat_hit(o, d, nB, tHit, hn)) kind = 2;
            vec3 p = o + d * tHit;
            if (kind == 0) {
                hn = bevel_n(p, hn);
                if (dot3(d, hn) > 0.0) hn = -hn;
                float c2 = clamp(-dot3(d, hn), 0.0, 1.0);
                vec3 Tout;
                bool ok = bend(d, hn, n, Tout);
                if (ok) {
                    if (exits == exitAt) {
                        if (Tout.y < -0.001) {
                            float t = -p.y / Tout.y;
                            if (t > 0.002 && t < 6.0) {
                                vec3 hit = p + Tout * t;
                                return vec3(hit.x, hit.z, e * (1.0 - fresnel(c2, n, 1.0)));
                            }
                        }
                        return vec3(0.0);
                    }
                    exits = exits + 1;
                    vec3 R = d - hn * (2.0 * dot3(d, hn));
                    o = p + R * 0.0002;
                    d = R;
                    e *= fresnel(c2, n, 1.0);
                } else {
                    vec3 R = reflect(d, hn);
                    o = p + R * 0.0002;
                    d = R;
                }
            } else {
                if (dot3(d, hn) > 0.0) hn = -hn;
                bool want = kind == 1 ? (reflA == 1) : (reflB == 1);
                float Rc = coat_R(kind - 1, nm);
                if (want) {
                    e *= Rc * 2.4;
                    vec3 Rdir = d - hn * (2.0 * dot3(d, hn));
                    o = p + Rdir * 0.0002;
                    d = Rdir;
                } else {
                    e *= 1.0 - Rc;
                    o = p + d * 0.0002;
                }
                if (kind == 1) didA = true;
                else didB = true;
            }
        }
        return vec3(0.0);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        int w = int(materialParams.hitW);
        int h = int(materialParams.hitH);
        int x = int(getUV0().x * materialParams.hitW);
        int y = int(getUV0().y * materialParams.hitH);
        if (x >= w) x = w - 1;
        if (y >= h) y = h - 1;
        if (x < 0) x = 0;
        if (y < 0) y = 0;
        int grid = int(materialParams.grid);
        int gx = x - (x / grid) * grid;
        int band = x / grid;
        int gy = y - (y / grid) * grid;
        int path = y / grid;
        float nm = 450.0 + 220.0 * ((float(band) + 0.5) / materialParams.bands);
        vec3 hit = walk(gx, gy, path, nm, n_of(nm));
        material.baseColor = vec4(hit, hit.z > 0.0 ? 1.0 : 0.0);
    }
}
