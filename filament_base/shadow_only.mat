// Draws nothing, casts a shadow. Lets a block that is drawn by its own material (and left out of the
// backdrop picture) still shadow the floor in every view.
material {
    name : shadow_only,
    shadingModel : unlit,
    blending : opaque,
    colorWrite : false,
    depthWrite : false,
    culling : none
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = vec4(0.0);
    }
}
