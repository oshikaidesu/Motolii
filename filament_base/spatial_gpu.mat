material {
    name : spatial_gpu,
    shadingModel : unlit,
    blending : opaque,
    culling : none,
    doubleSided : true,
    variables : [
        section
    ],
    parameters : [
        { type : float4[16], name : controls },
        { type : float, name : samples },
        { type : float, name : sides },
        { type : float, name : radius }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        int sides = int(materialParams.sides + 0.5);
        int samples = int(materialParams.samples + 0.5);
        int v = getVertexIndex();
        int ring = v / sides;
        int k = v - ring * sides;
        int span = clamp(ring / samples, 0, 3);
        int i = ring - span * samples;
        float t = float(i) / float(samples);
        float ang = float(k) / float(sides) * 6.2831853;
        float4 p0 = materialParams.controls[span * 4 + 0];
        float4 p1 = materialParams.controls[span * 4 + 1];
        float4 p2 = materialParams.controls[span * 4 + 2];
        float4 p3 = materialParams.controls[span * 4 + 3];
        float u = 1.0 - t;
        float3 b = ((u * u * u) * p0.xyz) + ((3.0 * u * u * t) * p1.xyz)
                 + ((3.0 * u * t * t) * p2.xyz) + ((t * t * t) * p3.xyz);
        float3 d = (3.0 * u * u) * (p1.xyz - p0.xyz) + (6.0 * u * t) * (p2.xyz - p1.xyz)
                 + (3.0 * t * t) * (p3.xyz - p2.xyz);
        float len = length(d);
        float3 T = len > 1e-4 ? d / len : float3(1.0, 0.0, 0.0);
        float3 up = abs(T.z) > 0.98 ? float3(0.0, 1.0, 0.0) : float3(0.0, 0.0, 1.0);
        float3 side = normalize(cross(T, up));
        float3 lift = normalize(cross(side, T));
        float3 radial = cos(ang) * lift + sin(ang) * side;
        material.worldPosition.xyz += b + materialParams.radius * radial;
        material.section = float4(ang, t, float(span), 1.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        float ang = variable_section.x;
        material.baseColor = float4(0.55 + 0.4 * cos(ang), 0.4 + 0.35 * sin(ang), 0.72, 1.0);
    }
}
