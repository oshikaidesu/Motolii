// Reflected sightline of the internal films. The mesh is only a mask over the
// cube. Direct film hits are skipped; the color is the film seen after the
// view has bounced off the glass boundary.
material {
    name : xcube_echo,
    shadingModel : unlit,
    blending : fade,
    culling : back,
    depthWrite : false,
    parameters : [
        { type : float3, name : eye },
        { type : float3, name : center },
        { type : float3, name : ax },
        { type : float3, name : ay },
        { type : float3, name : az },
        { type : float3, name : colorA },
        { type : float3, name : colorB },
        { type : float, name : halfExtent },
        { type : float, name : bevel },
        { type : float, name : tilt },
        { type : float, name : ior },
        { type : float, name : bounces }
    ]
}

fragment {
    float dot3(vec3 a, vec3 b) { return dot(a, b); }

    bool bend(vec3 I, vec3 N, float eta, inout vec3 T) {
        float cosi = clamp(-dot3(I, N), -1.0, 1.0);
        float k = 1.0 - eta * eta * (1.0 - cosi * cosi);
        if (k < 0.0) return false;
        T = normalize(I * eta + N * (eta * cosi - sqrt(k)));
        return true;
    }

    bool ray_box(vec3 ro, vec3 rd, inout float tNear, inout float tFar, inout int faceFar) {
        vec3 ax = materialParams.ax;
        vec3 ay = materialParams.ay;
        vec3 az = materialParams.az;
        vec3 o = vec3(dot3(ro - materialParams.center, ax), dot3(ro - materialParams.center, ay), dot3(ro - materialParams.center, az));
        vec3 d = vec3(dot3(rd, ax), dot3(rd, ay), dot3(rd, az));
        tNear = -1e9;
        tFar = 1e9;
        faceFar = 0;
        float h = materialParams.halfExtent;
        for (int i = 0; i < 3; i++) {
            if (abs(d[i]) < 1e-6) {
                if (o[i] < -h || o[i] > h) return false;
            } else {
                float ta = (-h - o[i]) / d[i];
                float tb = (h - o[i]) / d[i];
                int fa = i * 2;
                int fb = i * 2 + 1;
                if (ta > tb) {
                    float ts = ta; ta = tb; tb = ts;
                    int fs = fa; fa = fb; fb = fs;
                }
                if (ta > tNear) tNear = ta;
                if (tb < tFar) { tFar = tb; faceFar = fb; }
                if (tNear > tFar) return false;
            }
        }
        return tFar > 0.0;
    }

    vec3 face_n(int face) {
        vec3 a = face / 2 == 0 ? materialParams.ax : (face / 2 == 1 ? materialParams.ay : materialParams.az);
        return a * ((face - (face / 2) * 2) == 1 ? 1.0 : -1.0);
    }

    bool in_cube(vec3 p) {
        float h = materialParams.halfExtent + 0.001;
        vec3 q = p - materialParams.center;
        if (abs(dot3(q, materialParams.ax)) > h) return false;
        if (abs(dot3(q, materialParams.ay)) > h) return false;
        if (abs(dot3(q, materialParams.az)) > h) return false;
        return true;
    }

    vec3 bevel_n(vec3 p, vec3 N) {
        float b = materialParams.bevel;
        if (b < 0.0001) return N;
        float h = materialParams.halfExtent;
        vec3 q = p - materialParams.center;
        vec3 n = N;
        float cx = dot3(q, materialParams.ax);
        float cy = dot3(q, materialParams.ay);
        float cz = dot3(q, materialParams.az);
        if (abs(cx) > h - b && abs(dot3(N, materialParams.ax)) < 0.5) n += materialParams.ax * sign(cx);
        if (abs(cy) > h - b && abs(dot3(N, materialParams.ay)) < 0.5) n += materialParams.ay * sign(cy);
        if (abs(cz) > h - b && abs(dot3(N, materialParams.az)) < 0.5) n += materialParams.az * sign(cz);
        return normalize(n);
    }

    bool coat_hit(vec3 o, vec3 d, vec3 n0, inout float tLim, inout vec3 hn) {
        vec3 tangent = normalize(cross(materialParams.ay, n0));
        float band = (2.0 * materialParams.halfExtent) / 3.0;
        bool any = false;
        for (int k = -1; k <= 1; k++) {
            float ang = float(k) * materialParams.tilt;
            vec3 n = normalize(n0 * cos(ang) + tangent * sin(ang));
            float den = dot3(d, n);
            if (abs(den) < 1e-5) continue;
            vec3 origin = materialParams.center + materialParams.ay * (float(k) * band);
            float tp = dot3(origin - o, n) / den;
            if (tp <= 0.0012 || tp >= tLim) continue;
            vec3 p = o + d * tp;
            if (!in_cube(p)) continue;
            float along = dot3(p - materialParams.center, materialParams.ay);
            if (abs(along - float(k) * band) > band * 0.55) continue;
            tLim = tp;
            hn = n;
            any = true;
        }
        return any;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 cam = materialParams.eye;
        vec3 rd0 = getWorldPosition() - cam;
        float rdLen = length(rd0);
        if (rdLen < 1e-5) {
            material.baseColor = vec4(0.0);
            return;
        }
        rd0 /= rdLen;
        float tNear, tFar;
        int faceFar;
        if (!ray_box(cam, rd0, tNear, tFar, faceFar) || tNear <= 0.001) {
            material.baseColor = vec4(0.0);
            return;
        }
        float t0 = tNear;
        int f0 = 0;
        float best = 1e9;
        for (int f = 0; f < 6; f++) {
            vec3 fn = face_n(f);
            float den = dot3(rd0, fn);
            if (abs(den) < 1e-6) continue;
            float t = dot3((materialParams.center + fn * materialParams.halfExtent) - cam, fn) / den;
            if (t > 0.001 && abs(t - t0) < abs(best - t0)) { best = t; f0 = f; }
        }
        vec3 N = bevel_n(cam + rd0 * t0, face_n(f0));
        if (dot3(rd0, N) > 0.0) N = -N;
        vec3 rd;
        if (!bend(rd0, N, 1.0 / materialParams.ior, rd)) {
            material.baseColor = vec4(0.0);
            return;
        }
        vec3 ro = cam + rd0 * t0 + rd * 0.0008;
        vec3 nA = normalize(materialParams.ax - materialParams.az);
        vec3 nB = normalize(materialParams.ax + materialParams.az);
        int maxB = int(materialParams.bounces + 0.5);
        int reflections = 0;
        vec3 seen = vec3(0.0);
        float seenA = 0.0;
        bool found = false;
        for (int step = 0; step < 6; step++) {
            if (!ray_box(ro, rd, tNear, tFar, faceFar) || tFar < 0.0001) break;
            if (reflections >= 1) {
                float tHit = tFar;
                int kind = 0;
                vec3 hn = face_n(faceFar);
                if (coat_hit(ro, rd, nA, tHit, hn)) kind = 1;
                if (coat_hit(ro, rd, nB, tHit, hn)) kind = 2;
                if (kind != 0) {
                    vec3 col = kind == 1 ? materialParams.colorA : materialParams.colorB;
                    float gain = reflections == 1 ? 0.50 : 0.26;
                    seen = col * gain;
                    seenA = reflections == 1 ? 0.70 : 0.55;
                    found = true;
                    break;
                }
            }
            vec3 p = ro + rd * tFar;
            vec3 hn = bevel_n(p, face_n(faceFar));
            rd = rd - hn * (2.0 * dot3(rd, hn));
            ro = p + rd * 0.0008;
            reflections += 1;
            if (reflections > maxB) break;
        }
        material.baseColor = vec4(seen, seenA);
    }
}
