{
  "_": "Who owns what between Motolii and its Rerun host (docs/reviews/2026-09-24-rerun-host-semantic-layer.md). Read by scripts/check-host-ownership.py. Motolii owns meaning; the host owns GPU execution. An entry here is a responsibility, not a line: add one only with the reason a reviewer would accept.",

  "motolii": {
    "sources": ["motolii/crates/*/src/**/*.rs", "motolii/ui/native/src/**/*.rs", "motolii/ui/extensions/*/src/**/*.rs"],
    "boundaries": [
      {"role": "EMBEDDER", "file": "motolii/crates/motolii-render/src/compositor/device.rs", "item": "with_device",
       "why": "Opens the renderer's first frame on the device it was given, as eframe does for re_viewer."},
      {"role": "EMBEDDER", "file": "motolii/crates/motolii-render/src/compositor/sequential.rs", "item": "next_frame",
       "why": "The frame boundary: before_submit hands the frame to the queue, begin_frame opens the next."},
      {"role": "EMBEDDER", "file": "motolii/ui/native/src/lib.rs",
       "why": "The window bridge: imports the window's IOSurface as the target and waits for the GPU on shutdown."},
      {"role": "EMBEDDER", "file": "motolii/ui/native/src/frames.rs",
       "why": "Presentation: tells the window when the GPU finished a presented picture."},
      {"role": "OFFLINE", "file": "motolii/crates/motolii-render/src/compositor/headless.rs", "item": "wait_offline",
       "why": "Export, freeze and tests wait for the GPU in this one place; the drawing route never waits."},
      {"role": "SEMANTIC_LOWERING", "file": "motolii/crates/motolii-render/src/compositor/effects/mod.rs", "item": "FeedbackState",
       "why": "A Feedback effect's history: pictures of the host's pool kept across frames, keyed by Motolii's meaning."}
    ]
  },

